# ----------------------------------------------------- Cloudflare Tunnel (cloudflared) ---
install_cloudflared() {
  ok "正在下载并安装官方 cloudflared 二进制..."
  local cf_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${ARCH}"
  local tmp_bin
  tmp_bin=$(mktemp /tmp/cloudflared.XXXXXX) || { err "无法创建临时文件"; return 1; }
  if curl -fsSL --connect-timeout 10 --max-time 120 "$cf_url" -o "$tmp_bin"; then
    chmod 755 "$tmp_bin"
    if "$tmp_bin" --version >/dev/null 2>&1; then
      mv -f "$tmp_bin" /usr/local/bin/cloudflared
      ok "cloudflared 安装成功: $(/usr/local/bin/cloudflared --version 2>/dev/null | head -n1)"
      return 0
    fi
  fi
  rm -f "$tmp_bin"
  err "cloudflared 下载或校验失败"
  return 1
}

cloudflared_status_json() {
  local inst=false ver="" running=false has_token=false
  if [[ -x /usr/local/bin/cloudflared ]]; then
    inst=true
    ver=$(/usr/local/bin/cloudflared --version 2>/dev/null | awk '{print$3}' || echo "")
  fi
  if svc_ok cloudflared; then
    running=true
  fi
  local tok; tok=$(conf_get '.cloudflared.token // ""')
  [[ -n $tok ]] && has_token=true

  jq -cn --argjson inst "$inst" --arg ver "$ver" --argjson run "$running" --argjson tok "$has_token" \
    '{installed:$inst, version:$ver, running:$run, token_configured:$tok}'
}

cloudflared_set_token() {
  local tok="${1:-}"
  [[ -z $tok ]] && { cli_json '{"ok":false,"error":"Token 不能为空"}'; return 1; }

  if [[ ! -x /usr/local/bin/cloudflared ]]; then
    install_cloudflared || { cli_json '{"ok":false,"error":"cloudflared 安装失败"}'; return 1; }
  fi

  conf_set '.cloudflared.token' "$tok"
  conf_set '.cloudflared.enable' "true"

  cat <<EOF >/etc/systemd/system/cloudflared.service
[Unit]
Description=Cloudflare Tunnel (cloudflared)
After=network.target

[Service]
TimeoutStartSec=0
Type=notify
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --token $tok
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable cloudflared >/dev/null 2>&1
  systemctl restart cloudflared >/dev/null 2>&1
  sleep 2
  if svc_ok cloudflared; then
    cli_json '{"ok":true,"message":"Cloudflare Tunnel 已成功启动并保持运行"}'
  else
    cli_json '{"ok":false,"error":"Cloudflare Tunnel 启动失败，请检查 Token"}'
  fi
}

cloudflared_stop_service() {
  systemctl stop cloudflared >/dev/null 2>&1 || true
  systemctl disable cloudflared >/dev/null 2>&1 || true
  conf_set '.cloudflared.enable' "false"
  cli_json '{"ok":true,"message":"Cloudflare Tunnel 服务已停止"}'
}

cloudflared_start_service() {
  local tok; tok=$(conf_get '.cloudflared.token // ""')
  [[ -z $tok ]] && { cli_json '{"ok":false,"error":"尚未配置 Tunnel Token"}'; return 1; }
  systemctl daemon-reload
  systemctl enable cloudflared >/dev/null 2>&1
  systemctl restart cloudflared >/dev/null 2>&1
  sleep 1
  if svc_ok cloudflared; then
    cli_json '{"ok":true,"message":"Cloudflare Tunnel 已启动"}'
  else
    cli_json '{"ok":false,"error":"启动失败"}'
  fi
}

cloudflared_quick_tunnel() {
  local p="${1:-}"
  [[ -z $p ]] && p=$(panel_port)
  if [[ ! -x /usr/local/bin/cloudflared ]]; then
    install_cloudflared || { cli_json '{"ok":false,"error":"cloudflared 安装失败"}'; return 1; }
  fi
  pkill -f 'cloudflared.*tunnel.*--url' >/dev/null 2>&1 || true
  nohup /usr/local/bin/cloudflared tunnel --url "http://127.0.0.1:$p" > /tmp/cf-quick.log 2>&1 &
  sleep 4
  local qurl
  qurl=$(grep -oE 'https://[a-zA-Z0-9.-]+\.trycloudflare\.com' /tmp/cf-quick.log | head -n1 || true)
  if [[ -n $qurl ]]; then
    cli_json "$(jq -cn --arg url "$qurl" '{ok:true, url:$url, message:("临时快速隧道已就绪: " + $url)}')"
  else
    cli_json '{"ok":false,"error":"快速隧道启动超时，请稍后重试"}'
  fi
}


resetPassword() {
  conf_init
  any_proto || die "尚未安装"
  echo "将生成新 UUID(即所有协议共用的密码/用户名),旧节点立即失效,订阅自动更新。"
  echo "vless/trojan 的 WS path 由 UUID 派生,会同步轮换。"
  read -rsp "确认重置? [y/N]: " -n1 a; echo
  [[ "$a" =~ ^[Yy] ]] || { ok "已取消"; return; }
  conf_raw '.uuids' "[\"$(xray_uuid_gen)\"]"
  regen_all
  ok "UUID/密码已重置,全部协议同步生效"

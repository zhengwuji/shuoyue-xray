# ================================================================= nginx =====
install_nginx() {
  ok "安装 nginx..."
  # Debian 与 Ubuntu 官方源自适应; 源不可用时回退发行版包
  local distro suite
  distro=$(. /etc/os-release 2>/dev/null; echo "${ID:-debian}")
  suite=$(. /etc/os-release 2>/dev/null; echo "${VERSION_CODENAME:-}")
  rm -f /etc/apt/sources.list.d/nginx.list
  if [[ -n $suite ]]; then
    local base="https://nginx.org/packages/debian"
    [[ $distro == "ubuntu" ]] && base="https://nginx.org/packages/ubuntu"
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://nginx.org/keys/nginx_signing.key -o /etc/apt/keyrings/nginx-archive-keyring.asc 2>/dev/null
    if [[ -s /etc/apt/keyrings/nginx-archive-keyring.asc ]]; then
      echo "deb [signed-by=/etc/apt/keyrings/nginx-archive-keyring.asc] $base $suite nginx" >/etc/apt/sources.list.d/nginx.list
      apt-get update -qq 2>/dev/null
    fi
  fi
  if ! apt-cache policy nginx 2>/dev/null | grep -q 'nginx.org'; then
    rm -f /etc/apt/sources.list.d/nginx.list
    apt-get update -qq 2>/dev/null
  fi
  apt-get install -y -qq nginx 2>/dev/null || apt-get install -y -qq nginx-core 2>/dev/null || true
  systemctl stop nginx >/dev/null 2>&1
  command -v nginx >/dev/null || die "nginx 安装失败"
  mkdir -p /etc/nginx/conf.d /etc/nginx/stream.d "$WEBDIR" "$SSLDIR" /var/log/nginx
  if [[ ! -f $SSLDIR/dhparam.pem ]]; then
    ok "生成 dhparam (2048)..."
    openssl dhparam -out "$SSLDIR/dhparam.pem" 2048 >/dev/null 2>&1
  fi
  systemctl enable nginx >/dev/null 2>&1
}


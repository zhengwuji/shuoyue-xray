# =========================================================== TLS 证书 acme.sh ==
ssl_install_dir() {
  mkdir -p "$SSLDIR"
  rm -f "$SSLDIR"/*.cer "$SSLDIR"/*.key
  [[ -f $SSLDIR/dhparam.pem ]] || openssl dhparam -out "$SSLDIR/dhparam.pem" 2048 >/dev/null 2>&1
}

make_ssl_webroot() {   # 443: HTTP 验证
  local domain; domain=$(conf_get '.domain')
  ok "申请证书 (webroot): $domain"
  curl -s https://get.acme.sh | sh -s email=admin@"$domain" >/dev/null 2>&1
  /root/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1
  ssl_install_dir
  # 临时 80 站点供验证
  cat <<'EOF' >/etc/nginx/conf.d/default.conf
server {
    listen 80 default_server reuseport;
    server_name __DOMAIN__;
    root /var/www/html;
}
EOF
  sed -i "s/__DOMAIN__/$domain/" /etc/nginx/conf.d/default.conf
  nginx -t >/dev/null 2>&1 && systemctl restart nginx
  if ! /root/.acme.sh/acme.sh --issue -d "$domain" -w "$WEBDIR" -k ec-256 --server letsencrypt; then
    die "证书签发失败(检查域名解析是否指向本机,且 80 端口可访问)"
  fi
  /root/.acme.sh/acme.sh --install-cert -d "$domain" --ecc \
    --key-file "$SSLDIR/de_GWD.key" --fullchain-file "$SSLDIR/de_GWD.cer" \
    --reloadcmd "nginx -s reload" >/dev/null 2>&1
  chown root:www-data "$SSLDIR"/*.key 2>/dev/null && chmod 640 "$SSLDIR"/*.key 2>/dev/null
  chmod 644 "$SSLDIR"/*.cer "$SSLDIR/dhparam.pem" 2>/dev/null
}

make_ssl_cf() {   # 非 443 端口: Cloudflare DNS API 验证(支持 Token 或全局 Key)
  local domain port token zoneid key email
  domain=$(conf_get '.domain'); port=$(conf_get '.port')
  ok "申请证书 (Cloudflare DNS): $domain"
  echo "Cloudflare 凭据(用于 DNS 验证,二选一):"
  echo "  [1] API Token (推荐,权限 Zone.DNS Edit)"
  echo "  [2] Global API Key + 邮箱 (旧式)"
  local style; style=$(ask "选择 [1/2]: ")
  if [[ $style == "2" ]]; then
    key=$(ask_secret "CF Global API Key: "); email=$(ask "CF Email: ")
    export CF_Key="$key" CF_Email="$email"
  else
    token=$(ask_secret "CF API Token: ")
    zoneid=$(ask "CF Zone ID (可选,回车跳过): ")
    export CF_Token="$token"
    [[ -n $zoneid ]] && export CF_Zone_ID="$zoneid"
  fi
  local top; top=$(echo "$domain" | rev | awk -F. '{print $1"."$2}' | rev)
  curl -s https://get.acme.sh | sh -s email=admin@"$domain" >/dev/null 2>&1
  /root/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1
  ssl_install_dir
  if ! /root/.acme.sh/acme.sh --issue --dns dns_cf -d "$top" -d "*.$top" -k ec-256 --server letsencrypt --dnssleep 120; then
    die "证书签发失败(检查 Cloudflare 凭据)"
  fi
  /root/.acme.sh/acme.sh --install-cert -d "$top" --ecc \
    --key-file "$SSLDIR/de_GWD.key" --fullchain-file "$SSLDIR/de_GWD.cer" \
    --reloadcmd "nginx -s reload" >/dev/null 2>&1
  chmod 600 "$SSLDIR"/*.key 2>/dev/null
  chown root:www-data "$SSLDIR"/*.key 2>/dev/null && chmod 640 "$SSLDIR"/*.key 2>/dev/null
  chmod 644 "$SSLDIR"/*.cer "$SSLDIR/dhparam.pem" 2>/dev/null
}

# ============================================================ Xray 配置生成 ===
xray_uuid_gen() { cat /proc/sys/kernel/random/uuid; }
uuid6() { printf %s "$1" | tr -d '-' | tail -c 6; }
proto_on() { [[ $(conf_get ".protos.$1") == "true" ]]; }
any_proto() { [[ -n $(conf_get '.protos' | jq -r 'to_entries | map(select(.value==true)) | .[0].key // empty' 2>/dev/null) ]]; }
domain_proto_on() { proto_on vmess || proto_on vless || proto_on trojan || proto_on trojantcp; }
sb_proto_on() { proto_on hy2 || proto_on tuic || proto_on anytls; }

# 自签证书(hy2/tuic/anytls 在无域名证书时使用, 分享链接带 insecure=1)
ensure_self_cert() {
  [[ -s $SSLDIR/self.cer && -s $SSLDIR/self.key ]] && return 0
  mkdir -p "$SSLDIR"
  openssl req -new -x509 -nodes -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
    -keyout "$SSLDIR/self.key" -out "$SSLDIR/self.cer" -days 3650 -subj "/CN=de_GWD" >/dev/null 2>&1
  chown root:www-data "$SSLDIR/self.key" 2>/dev/null; chmod 640 "$SSLDIR/self.key" 2>/dev/null
  chmod 644 "$SSLDIR/self.cer" 2>/dev/null
}
# 输出: <证书> <私钥> <自签标记0/1>
tls_cert_pair() {
  if [[ -s $SSLDIR/de_GWD.cer && -s $SSLDIR/de_GWD.key ]]; then
    echo "$SSLDIR/de_GWD.cer $SSLDIR/de_GWD.key 0"
  else
    ensure_self_cert
    echo "$SSLDIR/self.cer $SSLDIR/self.key 1"
  fi
}

xray_inbound_vmess() {
  jq -n --arg id "$(conf_get '.uuids[0]')" --arg path "$(conf_get '.path')" '{
    listen: "127.0.0.1", port: 9890, protocol: "vmess",
    settings: { clients: [{ id: $id, alterId: 0 }] },
    streamSettings: { network: "ws", security: "none",
      wsSettings: { path: $path },
      sockopt: { tcpFastOpen: true, tcpMptcp: true } },
    sniffing: { enabled: true, destOverride: ["http","tls","quic"] } }'
}
xray_inbound_vless_ws() {
  jq -n --arg id "$(conf_get '.uuids[0]')" --arg path "/v-$(uuid6 "$(conf_get '.uuids[0]')")" '{
    listen: "127.0.0.1", port: 9891, protocol: "vless",
    settings: { clients: [{ id: $id }], decryption: "none" },
    streamSettings: { network: "ws", security: "none",
      wsSettings: { path: $path },
      sockopt: { tcpFastOpen: true, tcpMptcp: true } },
    sniffing: { enabled: true, destOverride: ["http","tls","quic"] } }'
}
xray_inbound_trojan_ws() {
  jq -n --arg id "$(conf_get '.uuids[0]')" --arg path "/t-$(uuid6 "$(conf_get '.uuids[0]')")" '{
    listen: "127.0.0.1", port: 9892, protocol: "trojan",
    settings: { clients: [{ password: $id }] },
    streamSettings: { network: "ws", security: "none",
      wsSettings: { path: $path },
      sockopt: { tcpFastOpen: true, tcpMptcp: true } },
    sniffing: { enabled: true, destOverride: ["http","tls"] } }'
}
xray_inbound_trojan_tcp() {
  local cert key; read -r cert key _ <<< "$(tls_cert_pair)"
  jq -n --arg id "$(conf_get '.uuids[0]')" --arg c "$cert" --arg k "$key" '{
    listen: "0.0.0.0", port: 8442, protocol: "trojan",
    settings: { clients: [{ password: $id }] },
    streamSettings: { network: "tcp", security: "tls",
      tlsSettings: { certificates: [{ certificateFile: $c, keyFile: $k }] } },
    sniffing: { enabled: true, destOverride: ["http","tls"] } }'
}
xray_inbound_ss() {
  jq -n --arg pw "$(conf_get '.uuids[0]')" '{
    listen: "0.0.0.0", port: 8388, protocol: "shadowsocks",
    settings: { method: "chacha20-ietf-poly1305", password: $pw, network: "tcp,udp" } }'
}
xray_inbound_reality() {   # VLESS + Reality (免域名)
  local port priv uuids
  port=$(conf_get '.reality.port'); priv=$(conf_get '.reality.private')
  uuids=$(conf_get '.uuids[]')
  local clients="[]"
  clients=$(echo "$uuids" | while read -r u; do
    [[ -z $u ]] && continue
    jq -cn --arg id "$u" '[{id:$id, flow:"xtls-rprx-vision"}]'
  done | jq -s 'add // []')
  jq -n --argjson clients "$clients" --arg priv "$priv" --argjson port "$port" \
        --arg dest "$(conf_get '.reality.dest')" --arg sni "$(conf_get '.reality.sni')" \
        --arg sid "$(conf_get '.reality.shortid')" '
  {
    listen: "0.0.0.0",
    port: $port,
    protocol: "vless",
    settings: { clients: $clients, decryption: "none" },
    streamSettings: {
      network: "tcp",
      security: "reality",
      realitySettings: {
        show: false,
        dest: $dest,
        xver: 0,
        serverNames: [$sni],
        privateKey: $priv,
        shortIds: [$sid]
      }
    },
    sniffing: { enabled: true, destOverride: ["http","tls","quic"] }
  }'
}

xray_gen_config() {
  local inbounds="[]"
  if proto_on vmess;     then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_vmess)" '. + [$i]'); fi
  if proto_on vless;     then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_vless_ws)" '. + [$i]'); fi
  if proto_on trojan;    then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_trojan_ws)" '. + [$i]'); fi
  if proto_on trojantcp; then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_trojan_tcp)" '. + [$i]'); fi
  if proto_on ss;        then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_ss)" '. + [$i]'); fi
  if proto_on reality && [[ -n $(conf_get '.reality.private') ]]; then
    inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_reality)" '. + [$i]')
  fi
  local outbounds='[
    {"tag":"direct","protocol":"freedom","streamSettings":{"sockopt":{"tcpFastOpen":true,"tcpNoDelay":true}}},
    {"tag":"blocked","protocol":"blackhole","settings":{"response":{"type":"http"}}}
  ]'
  jq -n --argjson inb "$inbounds" --argjson outb "$outbounds" '{
    log: { access: "none", error: "/var/log/xray-error.log", loglevel: "warning" },
    routing: { rules: [] },
    inbounds: $inb,
    outbounds: $outb
  }' > "$XRAYDIR/config.json"
  chmod 640 "$XRAYDIR/config.json" 2>/dev/null
  if [[ $XTLSUSER != "root" ]]; then chown $XTLSUSER:$XTLSUSER "$XRAYDIR/config.json"; fi
  return 0
}

reality_keygen() {
  local keys pub priv sni shortid dest port
  keys=$(/usr/local/bin/xray x25519 2>/dev/null) || die "xray x25519 失败"
  pub=$(echo "$keys" | awk '/Public key/{print$3}')
  priv=$(echo "$keys" | awk '/Private key/{print$3}')
  [[ -z $pub || -z $priv ]] && die "reality 密钥解析失败"
  shortid=$(openssl rand -hex 8)
  dest=$(ask "Reality dest (回车=www.microsoft.com:443): "); dest=${dest:-www.microsoft.com:443}
  sni=${dest%%:*}
  port=$(ask "Reality 端口 (回车=8443): "); port=${port:-8443}
  conf_raw '.reality' "{\"enable\":true,\"port\":$port,\"private\":\"$priv\",\"public\":\"$pub\",\"shortid\":\"$shortid\",\"dest\":\"$dest\",\"sni\":\"$sni\"}"
  conf_raw '.protos' "$(conf_get '.protos // {}' | jq '. + {reality:true}')"
}

# ====================================================== sing-box (hy2/tuic/anytls) ==
install_singbox() {
  [[ $1 != "--force" && -x $BASE/singbox/sing-box ]] && return 0
  ok "安装 sing-box (官方 release)..."
  mkdir -p "$BASE/singbox"
  fetch_release "SagerNet/sing-box" "sing-box-.*-linux-${ARCH}\\.tar\\.gz$" /tmp/singbox.tar.gz || die "sing-box 下载失败"
  rm -rf /tmp/sb-ex && mkdir -p /tmp/sb-ex
  tar -xzf /tmp/singbox.tar.gz -C /tmp/sb-ex
  local bin; bin=$(find /tmp/sb-ex -name sing-box -type f | head -n1)
  [[ -z $bin ]] && die "sing-box 解包失败"
  mv -f "$bin" "$BASE/singbox/sing-box" && chmod 755 "$BASE/singbox/sing-box"
  rm -rf /tmp/singbox.tar.gz /tmp/sb-ex
  cat <<EOF >/etc/systemd/system/sing-box.service
[Unit]
Description=de_GWD sing-box server (Hysteria2/TUIC/AnyTLS)
After=network.target

[Service]
User=www-data
ExecStart=$BASE/singbox/sing-box run -c $BASE/singbox/config.json
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/ssl
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF
  chown -R www-data:www-data "$BASE/singbox" 2>/dev/null
  systemctl enable sing-box >/dev/null 2>&1
}

singbox_gen_config() {
  local cert key; read -r cert key _ <<< "$(tls_cert_pair)"
  local inb="[]"
  if proto_on hy2; then
    inb=$(jq -n --argjson a "$inb" --arg c "$cert" --arg k "$key" --arg pw "$(conf_get '.uuids[0]')" \
      '$a + [{type:"hysteria2", tag:"hy2-in", listen:"::", listen_port:8444,
              users:[{name:"u1", password:$pw}],
              tls:{enabled:true, certificate_path:$c, key_path:$k}}]')
  fi
  if proto_on tuic; then
    inb=$(jq -n --argjson a "$inb" --arg c "$cert" --arg k "$key" --arg id "$(conf_get '.uuids[0]')" \
      '$a + [{type:"tuic", tag:"tuic-in", listen:"::", listen_port:8445,
              users:[{name:"u1", uuid:$id, password:$id}],
              congestion_control:"bbr", zero_rtt_handshake:false,
              tls:{enabled:true, alpn:["h3"], certificate_path:$c, key_path:$k}}]')
  fi
  if proto_on anytls; then
    inb=$(jq -n --argjson a "$inb" --arg c "$cert" --arg k "$key" --arg pw "$(conf_get '.uuids[0]')" \
      '$a + [{type:"anytls", tag:"atls-in", listen:"::", listen_port:8446, password:$pw,
              tls:{enabled:true, certificate_path:$c, key_path:$k}}]')
  fi
  jq -n --argjson inb "$inb" '{
    log: { level: "warn", timestamp: true },
    inbounds: $inb,
    outbounds: [{ type: "direct", tag: "direct" }],
    route: { final: "direct" }
  }' > "$BASE/singbox/config.json"
  chmod 640 "$BASE/singbox/config.json" 2>/dev/null
  chown www-data:www-data "$BASE/singbox/config.json" 2>/dev/null
}

# ================================================================ 分享链接 ====
# 逐行输出所有已启用协议的 v2rayN 兼容分享链接
gen_links() {
  local uuid0 host u6 port
  uuid0=$(conf_get '.uuids[0]'); u6=$(uuid6 "$uuid0")
  host=$(conf_get '.domain'); [[ -z $host ]] && host=$(wan_ip)
  local _c _k insc; read -r _c _k insc <<< "$(tls_cert_pair)"
  if proto_on vmess; then
    port=$(conf_get '.port')
    local vj
    vj=$(jq -cn --arg add "$host" --arg port "$port" --arg id "$uuid0" \
      --arg path "$(conf_get '.path')" --arg host "$host" \
      '{v:"2",ps:($add+"-vmess"),add:$add,port:$port,id:$id,aid:"0",scy:"auto",
        net:"ws",type:"none",host:$host,path:$path,tls:"tls",sni:$host}')
    echo "vmess://$(printf %s "$vj" | base64 -w0)"
  fi
  if proto_on vless; then
    port=$(conf_get '.port')
    echo "vless://$uuid0@$host:$port?encryption=none&security=tls&sni=$host&fp=chrome&type=ws&host=$host&path=/v-$u6#vless-ws"
  fi
  if proto_on trojan; then
    port=$(conf_get '.port')
    echo "trojan://$uuid0@$host:$port?security=tls&sni=$host&type=ws&host=$host&path=/t-$u6#trojan-ws"
  fi
  if proto_on trojantcp; then
    echo "trojan://$uuid0@$host:8442?security=tls&sni=$host&type=tcp#trojan-tcp"
  fi
  if proto_on ss; then
    local sup; sup=$(printf %s "chacha20-ietf-poly1305:$uuid0" | base64 -w0 | tr '+/' '-_' | tr -d '=')
    echo "ss://$sup@$host:8388#shadowsocks"
  fi
  if proto_on reality && [[ -n $(conf_get '.reality.public') ]]; then
    local rp pbk sni sid
    rp=$(conf_get '.reality.port'); pbk=$(conf_get '.reality.public')
    sni=$(conf_get '.reality.sni'); sid=$(conf_get '.reality.shortid')
    echo "vless://$uuid0@$host:$rp?security=reality&encryption=none&pbk=$pbk&fp=chrome&type=tcp&flow=xtls-rprx-vision&sni=$sni&sid=$sid#reality"
  fi
  if proto_on hy2; then
    echo "hy2://$uuid0@$host:8444?sni=$host&insecure=$insc#hysteria2"
  fi
  if proto_on tuic; then
    echo "tuic://$uuid0:$uuid0@$host:8445?congestion_control=bbr&alpn=h3&sni=$host&allow_insecure=$insc#tuic"
  fi
  if proto_on anytls; then
    echo "anytls://$uuid0@$host:8446?sni=$host&insecure=$insc#anytls"
  fi
  return 0
}

# 订阅文件: base64(全部链接), 由 nginx 以 /sub/<token> 提供
gen_sub_all() {
  local token; token=$(conf_get '.subtoken')
  [[ -z $token || ! -d $WEBDIR ]] && return 0
  mkdir -p "$WEBDIR/sub"
  gen_links | base64 -w0 > "$WEBDIR/sub/$token"
  chmod 644 "$WEBDIR/sub/$token"
  systemctl is-active nginx >/dev/null 2>&1 && nginx -s reload >/dev/null 2>&1
  return 0
}

# ================================================================= 安装流程 ===
ask_domain_port() {
  local dp domain port
  while :; do
    dp=$(ask "输入域名(可带端口,如 a.com 或 a.com:8443): ")
    [[ "$dp" =~ ^[A-Za-z0-9.-]+(:[0-9]+)?$ ]] && break
    warn "域名格式不正确"
  done
  domain=${dp%%:*}
  port=$(echo "$dp" | grep -q ':' && echo "${dp##*:}" || echo 443)
  conf_set '.domain' "$domain"; conf_set '.port' "$port"
}

installGWD() {
  echo
  echo -e "${CYAN}=== de_GWD Remake 安装 (多协议) ===${cRES}"
  echo "  [1] vmess+WS+TLS    (需域名, nginx 443, 原版同款)"
  echo "  [2] vless+WS+TLS    (需域名, nginx 443)"
  echo "  [3] trojan+WS+TLS   (需域名, nginx 443)"
  echo "  [4] trojan+TCP+TLS  (需域名, 端口 8442)"
  echo "  [5] vless+Reality   (免域名, 端口 8443)"
  echo "  [6] Shadowsocks     (端口 8388, tcp+udp)"
  echo "  [7] Hysteria2       (UDP, 端口 8444)"
  echo "  [8] TUIC v5         (UDP, 端口 8445)"
  echo "  [9] AnyTLS          (端口 8446)"
  echo "  [A] 全部(推荐)"
  local sel; sel=$(ask "选择协议(数字/字母组合, 空格分隔, 回车=A): "); sel=${sel:-A}
  conf_init
  local protos='{}' tok
  if [[ "$sel" =~ ^[Aa]$ ]]; then
    protos='{"vmess":true,"vless":true,"trojan":true,"trojantcp":true,"reality":true,"ss":true,"hy2":true,"tuic":true,"anytls":true}'
  else
    for tok in $sel; do
      case $tok in
        1) protos=$(echo "$protos" | jq '. + {vmess:true}') ;;
        2) protos=$(echo "$protos" | jq '. + {vless:true}') ;;
        3) protos=$(echo "$protos" | jq '. + {trojan:true}') ;;
        4) protos=$(echo "$protos" | jq '. + {trojantcp:true}') ;;
        5) protos=$(echo "$protos" | jq '. + {reality:true}') ;;
        6) protos=$(echo "$protos" | jq '. + {ss:true}') ;;
        7) protos=$(echo "$protos" | jq '. + {hy2:true}') ;;
        8) protos=$(echo "$protos" | jq '. + {tuic:true}') ;;
        9) protos=$(echo "$protos" | jq '. + {anytls:true}') ;;
        *) warn "忽略: $tok" ;;
      esac
    done
  fi
  conf_raw '.protos' "$protos"
  any_proto || die "未选择任何协议"

  conf_raw '.uuids' "[\"$(xray_uuid_gen)\"]"
  conf_set '.path' "/$(uuid6 "$(conf_get '.uuids[0]')")"
  conf_set '.subtoken' "$(openssl rand -hex 8)"

  if domain_proto_on; then
    ask_domain_port
  else
    conf_set '.domain' ""; conf_set '.port' "443"
  fi

  ok "基线环境..."
  apt_baseline; pkg_dep; limits_conf; sysctl_conf
  unbound_conf
  svc_restart unbound && ok "unbound" || warn "unbound 未启动"
  shaping_conf; nftables_conf
  svc_restart nftables && ok "nftables + CAKE 整形" || warn "nftables 未启动"

  install_xray

  if domain_proto_on; then
    install_nginx
    install_doh
    svc_restart doh-server && ok "DoH 服务" || warn "DoH 未启动"
    decoy_site
    if [[ $(conf_get '.port') == "443" ]]; then
      make_ssl_webroot
    else
      make_ssl_cf
    fi
  fi

  if proto_on reality && [[ -z $(conf_get '.reality.private') ]]; then
    reality_keygen
  fi

  if sb_proto_on; then
    install_singbox
    singbox_gen_config
    svc_restart sing-box && ok "sing-box (Hysteria2/TUIC/AnyTLS)" || warn "sing-box 未启动"
  fi

  xray_gen_config
  if domain_proto_on; then
    nginx_main_conf; ssl_params_conf; nginx_web_conf
    nginx -t >/dev/null 2>&1 && systemctl restart nginx && ok "nginx" || warn "nginx 配置异常,请检查 nginx -t"
  fi
  svc_restart xray && ok "Xray" || { err "Xray 未启动"; journalctl -u xray -n 20 --no-pager; }

  gen_sub_all
  enable_autoupdate_ask
  printNode
  echo
  ok "安装完成!以上即全部节点信息(v2rayN 导入示例见上)。"
  ok "随时输入 shuoyue 打开管理菜单(一键脚本用户)或 bash server。"
}

updateGWD() {
  echo -e "${CYAN}=== 更新 de_GWD Remake ===${cRES}"
  conf_init
  any_proto || die "尚未安装,请先选择菜单 1"
  apt_baseline
  pkg_dep
  install_xray
  if domain_proto_on; then
    install_nginx
    install_doh
    svc_restart doh-server
    [[ -f $SSLDIR/de_GWD.cer ]] || { [[ $(conf_get '.port') == "443" ]] && make_ssl_webroot || make_ssl_cf; }
    nginx_main_conf; ssl_params_conf; nginx_web_conf
    systemctl restart nginx
  fi
  if sb_proto_on; then
    install_singbox --force
    singbox_gen_config
    svc_restart sing-box
  else
    systemctl stop sing-box >/dev/null 2>&1
    systemctl disable sing-box >/dev/null 2>&1
  fi
  svc_restart unbound
  xray_gen_config
  svc_restart xray
  svc_restart nftables 2>/dev/null
  /etc/rc_online.local 2>/dev/null
  gen_sub_all
  printNode
  ok "更新完成"
}

# ================================================================ 菜单功能 ===
changeDomain() {
  conf_init
  domain_proto_on || die "当前未启用需要域名的协议(先在菜单 6 开启)"
  ask_domain_port
  if [[ $(conf_get '.port') == "443" ]]; then
    make_ssl_webroot
  else
    make_ssl_cf
  fi
  nginx_main_conf; ssl_params_conf; nginx_web_conf
  nginx -t >/dev/null 2>&1 && systemctl restart nginx && ok "域名已更换" || warn "nginx 配置异常"
  gen_sub_all
  printNode
}

changeXrayVerify() {
  conf_init
  any_proto || die "尚未安装"
  local nu np
  nu=$(ask "输入新 UUID (回车=随机生成): ")
  [[ -z $nu ]] && nu=$(xray_uuid_gen)
  conf_raw '.uuids' "[\"$nu\"]"
  np=$(ask "输入新 WS path (回车=随机): ")
  [[ -z $np ]] && np="/$(uuid6 "$nu")"
  conf_set '.path' "$np"
  xray_gen_config
  if domain_proto_on; then nginx_web_conf; systemctl restart nginx; fi
  if sb_proto_on; then singbox_gen_config; svc_restart sing-box; fi
  svc_restart xray && ok "UUID/path 已更换(所有协议同步)"
  gen_sub_all
  printNode
}

enable_autoupdate_ask() {
  local a; a=$(ask "开启每日自动更新? [y/N]: ")
  [[ "$a" =~ ^[Yy] ]] && autoupdate_on || autoupdate_off
}
autoupdate_on() {
  cat <<EOF >"$BASE/autoUpdate"
#!/bin/bash
lv="$VERSION"
rv=\$(curl -fsSL --max-time 15 "$REMOTE_BASE/version" 2>/dev/null | head -n1)
[[ -z \$rv ]] && exit 0
if [[ \$(printf '%s\n%s\n' "\$lv" "\$rv" | sort -V | head -n1) == "\$lv" && "\$lv" != "\$rv" ]]; then
  curl -fsSL --max-time 60 "$REMOTE_BASE/server" -o /tmp/de_GWD_server_new || exit 0
  [[ \$(du -sk /tmp/de_GWD_server_new | awk '{print\$1}') -lt 30 ]] && exit 0
  bash /tmp/de_GWD_server_new --update
  rm -f /tmp/de_GWD_server_new
fi
EOF
  chmod +x "$BASE/autoUpdate"
  (crontab -l 2>/dev/null | grep -v de_GWD/autoUpdate; echo "30 4 * * * $BASE/autoUpdate") | crontab -
  ok "自动更新已开启(每日 04:30)"
}
autoupdate_off() {
  (crontab -l 2>/dev/null | grep -v de_GWD/autoUpdate) | crontab -
  rm -f "$BASE/autoUpdate"
  ok "自动更新已关闭"
}
autoUpdateGWD() {
  read -rsp "按 Y 开启 / N 关闭: " -n1 a; echo
  [[ "$a" =~ ^[Yy] ]] && autoupdate_on || autoupdate_off
}

printNode() {
  conf_init
  any_proto || die "尚未安装"
  local host port suburl link first=1
  host=$(conf_get '.domain'); [[ -z $host ]] && host=$(wan_ip)
  echo
  echo -e "${CYAN}=============== 节点信息 (v2rayN 7.25.4 可直接导入) ===============${cRES}"
  gen_links > /tmp/gwd_links.$$
  while IFS= read -r link; do
    echo -e "${WHITE}$link${cRES}"
    if [[ $first == 1 ]]; then
      echo
      qrencode -t UTF8 -s 1 -m 2 "$link" 2>/dev/null
      echo
      first=0
    fi
  done < /tmp/gwd_links.$$
  rm -f /tmp/gwd_links.$$
  if domain_proto_on; then
    port=$(conf_get '.port'); local ps=""; [[ $port != "443" ]] && ps=":$port"
    suburl="https://$host$ps/sub/$(conf_get '.subtoken')"
    echo -e "${WHITE}订阅地址: ${GREEN}$suburl${cRES}"
    qrencode -t UTF8 -s 1 -m 2 "$suburl" 2>/dev/null
    echo
  fi
  echo -e "${CYAN}v2rayN 导入示例:${cRES}"
  echo "  单节点: 复制上方链接 → v2rayN 主界面 Ctrl+V (从剪贴板导入批量URL)"
  echo "  订  阅: 订阅分组 → 订阅分组设置 → 添加 → 粘贴订阅地址 → 更新订阅(可设自动更新)"
  echo "  说明: vmess/vless/trojan/ss 由 Xray 内核承载; Hysteria2/TUIC/AnyTLS 由 sing-box 内核承载,"
  echo "        v2rayN 7.x 会按协议自动调用对应内核, 无需手动配置"
  echo -e "${CYAN}===================================================================${cRES}"
}

# ------------------------------------------------------------------- WARP ----
changeWGCF() {
  [[ $VIRT_TYPE == "container" ]] && die "容器环境不支持 WARP"
  read -rsp "[1] 启用 Cloudflare WARP 出站  [2] 删除: " -n1 a; echo
  local nic laddr; nic=$(detect_nic); laddr=$(local_ip)
  [[ -z $laddr ]] && die "未检测到本机 IPv4"
  apt-get install -y -qq wireguard-tools >/dev/null 2>&1
  if [[ $a == "1" ]]; then
    # 内核 >= 5.6 才有 wireguard
    if [[ $(printf '%s\n5.6\n' "$(uname -r)" | sort -rV | head -n1) != "$(uname -r)" ]]; then
      die "内核 $(uname -r) < 5.6, 请先升级内核"
    fi
    ok "下载 wgcf..."
    fetch_release "ViRb3/wgcf" "^wgcf_.*_linux_${ARCH}$" /usr/local/bin/wgcf || die "wgcf 下载失败"
    chmod 755 /usr/local/bin/wgcf
    (cd /tmp && echo | wgcf register >/dev/null 2>&1 && wgcf generate >/dev/null 2>&1)
    [[ ! -f /tmp/wgcf-profile.conf ]] && die "wgcf 注册失败"
    local spk cpk
    cpk=$(awk '/PrivateKey/{print$3}' /tmp/wgcf-profile.conf)
    spk=$(awk '/PublicKey/{print$3}' /tmp/wgcf-profile.conf)
    rm -f /tmp/wgcf-account.toml /tmp/wgcf-profile.conf
    cat <<EOF >/etc/wireguard/wgcf.conf
[Interface]
PrivateKey = $cpk
Address = 172.16.0.2/24
DNS = 1.1.1.1
MTU = 1420
PostUp = ip rule add from $laddr lookup main; ip rule add ipproto udp dport 53 lookup main;
PostDown = ip rule del from $laddr lookup main; ip rule del ipproto udp dport 53 lookup main;

[Peer]
PublicKey = $spk
EndPoint = engage.cloudflareclient.com:2408
AllowedIPs = 0.0.0.0/0
AllowedIPs = ::/0
PersistentKeepalive = 15
EOF
    chmod 600 /etc/wireguard/wgcf.conf
    systemctl enable wg-quick@wgcf >/dev/null 2>&1
    systemctl restart wg-quick@wgcf >/dev/null 2>&1
    sleep 3
    # 修正原版: 先记录前 IP 再对比,判断更稳
    local after; after=$(wan_ip); local before; before=$laddr
    if [[ -n $after && "$after" != "$before" ]]; then
      ok "WARP 已启用, 出口 IP: $after"
    else
      warn "WARP 启动但出口未变化, 检查 wgcf (wg show wgcf)"
    fi
    /etc/rc_online.local 2>/dev/null
  else
    systemctl disable wg-quick@wgcf >/dev/null 2>&1
    systemctl stop wg-quick@wgcf >/dev/null 2>&1
    rm -f /etc/wireguard/wgcf.conf
    /etc/rc_online.local 2>/dev/null
    ok "WARP 已删除"
  fi
}

# ------------------------------------------------- HAProxy TCP 端口转发(多组) --
relay_gen() {
  local entries; entries=$(conf_get '.relay')
  if [[ -z $entries || $entries == "null" || $(echo "$entries" | jq 'length') -eq 0 ]]; then
    systemctl stop haproxy >/dev/null 2>&1; systemctl disable haproxy >/dev/null 2>&1
    return
  fi
  apt-get install -y -qq haproxy >/dev/null 2>&1
  {
    cat <<'EOF'
global
    ulimit-n 500000
    maxconn 200000
defaults
    mode tcp
    option dontlognull
    timeout connect 10s
    timeout client 1m
    timeout server 1m
    timeout check 10s
resolvers local
    nameserver dns 127.0.0.1:53
    resolve_retries 3
    timeout retry 3s
    hold valid 10s
    accepted_payload_size 8192
EOF
    echo "$entries" | jq -c '.[]' | while read -r e; do
      local up port
      up=$(echo "$e" | jq -r '.upstream'); port=$(echo "$e" | jq -r '.port')
      cat <<EOF
frontend fwd_$port
    bind :$port
    default_backend be_$port
backend be_$port
    server endpoint $up check resolvers local init-addr none
EOF
    done
  } > /etc/haproxy/haproxy.cfg
  systemctl enable haproxy >/dev/null 2>&1
  systemctl restart haproxy >/dev/null 2>&1 && ok "HAProxy 转发生效" || err "HAProxy 启动失败(haproxy -c -f /etc/haproxy/haproxy.cfg 检查)"
}
changeTCPPF() {
  conf_init
  read -rsp "[1] 添加转发  [2] 删除一条  [3] 清空全部: " -n1 a; echo
  local entries
  entries=$(conf_get '.relay')
  [[ -z $entries || $entries == "null" ]] && entries="[]"
  case $a in
    1)
      local up port
      up=$(ask "上游地址(域名或IP:端口, 如 relay.example.com:443): ")
      [[ "$up" =~ ^[A-Za-z0-9.-]+:[0-9]+$ ]] || die "格式: host:port"
      port=$(ask "本地监听端口: ")
      [[ "$port" =~ ^[0-9]+$ ]] || die "端口必须为数字"
      entries=$(echo "$entries" | jq --arg u "$up" --arg p "$port" '. + [{upstream:$u, port:($p|number)}]')
      conf_raw '.relay' "$entries"
      relay_gen
      ok "转发: 本机:$port -> $up"
      ;;
    2)
      echo "$entries" | jq -r 'to_entries[] | "\(.key): :\(.value.port) -> \(.value.upstream)"' | nl
      local i; i=$(ask "删除序号: ")
      entries=$(echo "$entries" | jq --argjson i "$i" 'del(.[ $i - 1 ])')
      conf_raw '.relay' "$entries"
      relay_gen
      ;;
    3)
      conf_raw '.relay' '[]'; relay_gen; ok "已清空"
      ;;
  esac
}

# -------------------------------------------------------------- CF speedtest --
CFspeedTest() {
  ok "下载 cfspeed..."
  if fetch_release "makotom/cfspeed" "linux.*${ARCH}" /tmp/cfspeed.bin; then
    if tar -tzf /tmp/cfspeed.bin >/dev/null 2>&1; then
      rm -rf /tmp/cfspeed-ex && mkdir -p /tmp/cfspeed-ex
      tar -xzf /tmp/cfspeed.bin -C /tmp/cfspeed-ex
      local bin; bin=$(find /tmp/cfspeed-ex -type f -executable | head -n1)
      [[ -z $bin ]] && bin=$(find /tmp/cfspeed-ex -type f | grep -v '\.' | head -n1)
      [[ -n $bin ]] && chmod 755 "$bin" && "$bin"
      rm -rf /tmp/cfspeed.bin /tmp/cfspeed-ex
    else
      chmod 755 /tmp/cfspeed.bin && /tmp/cfspeed.bin; rm -f /tmp/cfspeed.bin
    fi
  else
    warn "cfspeed 资产未找到(上游 release 结构可能变化)"
  fi
}

# ----------------------------------------------------------------- 内核升级 ---
installkernel() {
  [[ $VIRT_TYPE == "container" ]] && die "容器环境不支持更换内核"
  read -rsp "[1] Zabbly stable 内核: " -n1 a; echo
  if [[ $a == "1" ]]; then
    local codename; codename=$(. /etc/os-release; echo "$VERSION_CODENAME")
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://zabbly.com/key.asc -o /etc/apt/keyrings/zabbly.asc
    cat <<EOF >/etc/apt/sources.list.d/zabbly-kernels-stable.sources
Enabled: yes
Types: deb
URIs: https://zabbly.com/kernel/stable
Suites: $codename
Components: main
Signed-By: /etc/apt/keyrings/zabbly.asc
EOF
  apt-get update -qq
  apt-get install -y -qq linux-zabbly || die "Zabbly 内核不支持该发行版/套件($codename), 仅支持 Debian 12/13 与 Ubuntu 22.04/24.04"
  ok "内核已安装, 重启生效"
    read -rsp "现在重启? [y/N]: " -n1 r; echo
    [[ "$r" =~ ^[Yy] ]] && reboot
  fi
}


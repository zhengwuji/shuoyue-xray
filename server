    fi
    # Web 面板反代(如果装了面板): 随机路径段, 反代到 127.0.0.1:3000
    local ppanel; ppanel=$(conf_get '.panel.path')
    if [[ -n $ppanel ]] && systemctl is-enabled degwd-panel >/dev/null 2>&1; then
      cat <<EOF

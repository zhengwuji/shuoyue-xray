# ----------------------------------------------------------- Cloudflare WARP & Cloudflared ----
warp_ensure_account() {
  local force="${1:-0}"
  local priv v4
  priv=$(conf_get '.warp.private_key')
  v4=$(conf_get '.warp.v4')

  if [[ "$force" == "0" && -n "$priv" && -n "$v4" ]]; then
    return 0
  fi

  log "正在生成并向 Cloudflare 注册 WARP 账号与密钥..."
  local reg_json
  reg_json=$(python3 -c '
import urllib.request, json, subprocess, base64, sys

try:
    res = subprocess.run(["xray", "wg"], capture_output=True, text=True)
    lines = [l.strip() for l in res.stdout.splitlines() if l.strip()]
    priv = [l.split(":")[-1].strip() for l in lines if "Private" in l or "key" in l.lower()][0]
    pub = [l.split(":")[-1].strip() for l in lines if "Public" in l][0]
except Exception:
    try:
        from cryptography.hazmat.primitives.asymmetric import x25519
        from cryptography.hazmat.primitives import serialization
        key = x25519.X25519PrivateKey.generate()
        priv = base64.b64encode(key.private_bytes(serialization.Encoding.Raw, serialization.PrivateFormat.Raw, serialization.NoEncryption())).decode()
        pub = base64.b64encode(key.public_key().public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)).decode()
    except Exception:
        sys.exit(1)

req = urllib.request.Request(
    "https://api.cloudflareclient.com/v0a2158/reg",
    data=json.dumps({"key": pub, "install_id": "", "fcm_token": "", "tos": "2020-01-22T00:00:00.000Z", "model": "Linux", "serial_number": "", "locale": "zh_CN"}).encode("utf-8"),
    headers={"Content-Type": "application/json; charset=UTF-8", "User-Agent": "okhttp/3.12.1"}
)
try:
    with urllib.request.urlopen(req, timeout=12) as r:
        data = json.loads(r.read().decode("utf-8"))
    v4 = data["config"]["interface"]["addresses"]["v4"]
    v6 = data["config"]["interface"]["addresses"]["v6"]
    peer_pub = data["config"]["peers"][0]["public_key"]
    cid = data["config"].get("client_id", "")
    try:
        reserved = list(base64.b64decode(cid)) if cid else [0, 0, 0]
    except Exception:
        reserved = [0, 0, 0]
    out = {
        "private_key": priv,
        "public_key": pub,
        "v4": v4,
        "v6": v6,
        "reserved": reserved,
        "peer_pub": peer_pub,
        "endpoint": "engage.cloudflareclient.com:2408"
    }
    print(json.dumps(out))
except Exception:
    sys.exit(2)
' 2>/dev/null || true)

  if [[ -z $reg_json || ! "$reg_json" =~ "private_key" ]]; then
    # 若直接 API 注册未成功，尝试通过 wgcf 备用注册
    if command -v wgcf >/dev/null 2>&1 || fetch_release "ViRb3/wgcf" "^wgcf_.*_linux_${ARCH}$" /usr/local/bin/wgcf; then
      chmod 755 /usr/local/bin/wgcf 2>/dev/null || true
      (cd /tmp && echo | wgcf register >/dev/null 2>&1 && wgcf generate >/dev/null 2>&1)
      if [[ -f /tmp/wgcf-profile.conf ]]; then
        local spk cpk
        cpk=$(awk '/PrivateKey/{print$3}' /tmp/wgcf-profile.conf)
        spk=$(awk '/PublicKey/{print$3}' /tmp/wgcf-profile.conf)
        v4=$(awk '/Address/{print$3}' /tmp/wgcf-profile.conf | cut -d/ -f1 | head -n1)
        local v6; v6=$(awk '/Address/{print$3}' /tmp/wgcf-profile.conf | grep -E ':' | cut -d/ -f1 | head -n1)
        rm -f /tmp/wgcf-account.toml /tmp/wgcf-profile.conf
        reg_json=$(jq -cn --arg priv "$cpk" --arg pub "" --arg v4 "${v4:-172.16.0.2}" --arg v6 "$v6" \
                          --arg pp "$spk" --arg ep "engage.cloudflareclient.com:2408" \
                          '{private_key:$priv, public_key:$pub, v4:$v4, v6:$v6, reserved:[0,0,0], peer_pub:$pp, endpoint:$ep}')
      fi
    fi
  fi

  [[ -z $reg_json || ! "$reg_json" =~ "private_key" ]] && {
    err "Cloudflare WARP 账号注册失败，请检查机器公网网络连接"
    return 1
  }

  local cur_mode cur_en
  cur_mode=$(conf_get '.warp.mode // "warp_google"')
  cur_en=$(conf_get '.warp.enable // true')
  conf_raw '.warp' "$(echo "$reg_json" | jq -c --arg m "$cur_mode" --argjson en "$cur_en" '. + {enable:$en, mode:$m}')"
  ok "Cloudflare WARP 账号就绪 (IPv4: $(conf_get '.warp.v4'))"
  return 0
}


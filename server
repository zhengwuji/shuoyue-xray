# ---------------------------------------------------------------- helpers ---
ok()   { echo -e "${WHITE}[ ${GREEN}✓${WHITE} ]${cRES} $*"; log "OK   $*"; }
warn() { echo -e "${WHITE}[ ${YELLOW}!${WHITE} ]${cRES} $*"; log "WARN $*"; }
err()  { echo -e "${WHITE}[ ${RED}✕${WHITE} ]${cRES} $*"; log "ERR  $*"; }
die()  { err "$*"; exit 1; }

# 统一日志(追加写,失败静默: 日志不可写不应中断安装)
log() {
  local ts; ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
  printf '%s %s\n' "$ts" "$*" >>"$LOG_FILE" 2>/dev/null || true
}

# 原子写: $1=目标文件 $2=权限, 内容从 stdin 读
write_atomic() {   # $1=dest $2=mode
  local t; t=$(mktemp "$1.XXXXXX") || return 1
  cat > "$t" || { rm -f "$t"; return 1; }
  chmod "$2" "$t" && mv -f "$t" "$1"
}

# 模板渲染插值的转义: 让值能安全放进 bash ${s//pat/rep} 的替换串。
# 为什么不用 sed: sed 替换串里 \ 是转义字符(会被吃掉)、& 表示「已匹配文本」。
# 于是 Alt-Svc 的值 'h3=\":443\"' 落盘时反斜杠消失, 变成 "h3=":443";ma=86400"
# —— 引号边界被拆成多个 token, add_header 参数个数就可能不对(实测见 .probe/t_sed_altsvc.sh)。
# bash 参数展开的替换串里 \ 会保留但 \\ 会折叠成一个 \, 且 & 同样是特殊字符,
# 故 \ 与 & 各转义一次即无损(12 组值实测全对, 见 .probe/t_subst_esc.sh)。
esc_rep() {   # $1=原值 -> 可安全作为 ${s//pat/rep} 替换串的文本
  local v="$1"
  v=${v//\\/\\\\}
  v=${v//&/\\&}
  printf '%s' "$v"
}

# 模板渲染: $1=文件, 之后按 KEY VALUE 成对给出 __KEY__ 占位符的字面替换值。
# 用 bash 参数展开而非 sed: 值里的 \ & 不会被静默改写(见 esc_rep 说明)。
# 权限沿用原文件(取不到时退回 644)。
render_tpl() {   # $1=file, 其后 KEY VALUE ...
  local f="$1"; shift
  (( $# >= 2 && $# % 2 == 0 )) || { warn "render_tpl 参数不成对"; return 1; }
  local mode; mode=$(stat -c '%a' "$f" 2>/dev/null) || mode=644
  local c k v
  c=$(cat "$f" 2>/dev/null) || return 1
  while [[ $# -ge 2 ]]; do
    k="$1"; v=$(esc_rep "$2"); shift 2
    c=${c//"__${k}__"/$v}
  done
  printf '%s\n' "$c" | write_atomic "$f" "$mode"
}

ask()  { local v; read -r -p "$1" v; echo "$v"; }
ask_secret() { local v; read -rsp "$1" v; echo; echo "$v"; }

# 非交互模式: --cli / Web 面板调用时置 1。任何会 ask 的函数都必须先看它,
# 否则在 systemd 单元(无 tty)里会一直等输入, 表现为面板请求挂起直到超时。
NONINTERACTIVE="${DEGWD_NONINTERACTIVE:-0}"
is_tty() { [[ ${NONINTERACTIVE} != "1" && -t 0 ]]; }

# URL 百分号编码(用于把 VLESS 加密串/path 放进查询参数)
urlenc() {
  local s="$1" i c out=""
  for (( i=0; i<${#s}; i++ )); do
    c=${s:i:1}
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s\n' "$out"
}

# 端口合法性: 1-65535 且不是本方案自用/系统保留端口
RESERVED_PORTS=" 53 80 443 1080 3000 8388 8442 8443 8444 8445 8446 8447 8448 8449 8450 8451 8452 9853 9890 9891 9892 9893 9894 9895 9896 9899 51820 "
port_valid() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  (( p >= 1 && p <= 65535 )) || return 1
  [[ $RESERVED_PORTS == *" $p "* ]] && return 1
  return 0
}

# nginx 服务端口(conf .port): 443 是本方案的标准端口, 必须放行。
# port_valid 把 443 当保留端口(它服务于 HAProxy 转发场景), 不能直接复用到服务端口上,
# 否则 Web 面板/--cli 永远无法把端口设回 443。
# 允许 443 或 1024-65535, 并排除本方案内部监听端口。
service_port_valid() {
  local p="$1" x
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  (( p == 443 || (p >= 1024 && p <= 65535) )) || return 1
  for x in 3000 8388 8442 8443 8444 8445 8446 8447 8448 8449 8450 8451 8452 \
           9853 9890 9891 9892 9893 9894 1080 51820; do
    [[ $p == "$x" ]] && return 1
  done
  return 0
}


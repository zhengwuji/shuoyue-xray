uninstallGWD() {
  read -rp "确认卸载? 将删除 全部配置/证书/节点数据/网站目录,输入 yes 确认: " c
  [[ $c == "yes" ]] || { ok "已取消"; return; }
  ok "停止服务..."
  local s
  for s in xray sing-box doh-server haproxy wg-quick@wgcf nginx degwd-nftables degwd-shaping nftables unbound degwd-panel; do
    systemctl stop "$s" >/dev/null 2>&1
    systemctl disable "$s" >/dev/null 2>&1
  done
  # 只删本方案自建表, 不动 Docker/firewalld 等其他 nft 表
  nft delete table inet degwd_bypassflow 2>/dev/null
  nft delete table inet degwd_filter 2>/dev/null
  nft delete table inet degwd_router 2>/dev/null
  ok "移除服务单元与文件..."
  rm -f /etc/systemd/system/xray.service /etc/systemd/system/sing-box.service \
        /etc/systemd/system/doh-server.service /etc/systemd/system/unbound.service \
        /etc/systemd/system/degwd-nftables.service /etc/systemd/system/degwd-shaping.service \
        /etc/systemd/system/degwd-panel.service
  rm -rf /etc/systemd/system/networking.service.d
  # 恢复发行版 nginx 默认站点(安装时备份过)
  if [[ -e $BASE/backup/nginx-sites-enabled-default && ! -e /etc/nginx/sites-enabled/default ]]; then
    cp -a "$BASE/backup/nginx-sites-enabled-default" /etc/nginx/sites-enabled/default 2>/dev/null
  fi
  systemctl daemon-reload
  (crontab -l 2>/dev/null | grep -vE 'de_GWD|acme\.sh') | crontab - 2>/dev/null
  rm -rf /root/.acme.sh
  rm -rf "$BASE" "$SSLDIR" "$WEBDIR"
  rm -f /etc/wireguard/wgcf.conf /usr/local/bin/xray /usr/local/bin/shuoyue /etc/rc_online.local
  rm -rf /usr/local/share/xray
  # 移除本方案写入的 drop-in 配置(不动用户原有的 sysctl/limits 配置)
  rm -f /etc/sysctl.d/99-degwd.conf /etc/security/limits.d/99-degwd.conf
  rm -f /etc/apt/apt.conf.d/01deGWD
  rm -f /etc/apt/sources.list.d/zabbly-kernels-stable.sources /etc/apt/keyrings/zabbly.asc
  rm -f /etc/apt/sources.list.d/nginx.list /etc/apt/keyrings/nginx-archive-keyring.asc
  rm -f /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/80.conf \
        /etc/nginx/conf.d/.HSTS /etc/nginx/conf.d/.ssl_certs
  read -rsp "同时卸载 nginx/unbound/haproxy 组件? [y/N]: " -n1 r; echo
  if [[ "$r" =~ ^[Yy] ]]; then
    apt-get purge -y -qq nginx nginx-* unbound haproxy >/dev/null 2>&1
    apt-get autoremove -y -qq >/dev/null 2>&1
  fi
  rm -f /etc/resolv.conf
  printf 'nameserver 1.1.1.1\n' > /etc/resolv.conf
  sysctl --system >/dev/null 2>&1
  ok "卸载完成(已移除本方案的 sysctl/limits drop-in 与自建 nft 表;重装可直接跑一键脚本)"
}


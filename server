  else
    pkill -f 'cloudflared.*tunnel.*--url' >/dev/null 2>&1 || true
    nohup /usr/local/bin/cloudflared tunnel --url "http://127.0.0.1:$target_port" > /tmp/cf-argo-quick.log 2>&1 &
    local qdomain=""
    for _ in {1..8}; do
      sleep 1
      qdomain=$(grep -oE '[a-zA-Z0-9.-]+\.trycloudflare\.com' /tmp/cf-argo-quick.log 2>/dev/null | head -n1 || true)
      [[ -n $qdomain ]] && break
    done
    if [[ -n $qdomain ]]; then
      conf_set '.argo.quick_domain' "$qdomain"
    fi
  fi
}


      svc_restart doh-server
      [[ -f $SSLDIR/de_GWD.cer ]] || { [[ $(conf_get '.port') == "443" ]] && make_ssl_webroot || make_ssl_cf; }
      nginx_main_conf; ssl_params_conf; nginx_web_conf
      systemctl restart nginx
    fi
    if sb_proto_on; then
      install_singbox --force
      singbox_gen_config
      svc_restart sing-box
    else
      systemctl stop sing-box >/dev/null 2>&1
      systemctl disable sing-box >/dev/null 2>&1
    fi
    svc_restart unbound
    xray_gen_config
    svc_restart xray
    svc_restart degwd-nftables 2>/dev/null
    /etc/rc_online.local 2>/dev/null
    gen_sub_all
    printNode
  fi

  ok "升级完成！核心、Web 面板及运行环境已全部同步为最新状态。"
  if [[ -f /etc/systemd/system/degwd-panel.service ]]; then
    show_panel_info
  fi
}


install_doh() {
  ok "安装 DoH 服务 (dnsproxy)..."
  local garch=$ARCH
  fetch_release "AdguardTeam/dnsproxy" "^dnsproxy-linux-$garch-.*\\.tar\\.gz$" /tmp/dnsproxy.tar.gz || die "dnsproxy 下载失败"
  rm -rf /tmp/dnsproxy-ex && mkdir -p /tmp/dnsproxy-ex
  tar -xzf /tmp/dnsproxy.tar.gz -C /tmp/dnsproxy-ex
  local bin; bin=$(find /tmp/dnsproxy-ex -name dnsproxy -type f | head -n1)
  [[ -z $bin ]] && die "dnsproxy 解包失败"
  mv -f "$bin" "$BASE/dnsproxy" && chmod 755 "$BASE/dnsproxy"
  rm -rf /tmp/dnsproxy.tar.gz /tmp/dnsproxy-ex

  # <<EOF(不加引号) 以便按 $BASE 展开; 单元文件内无其它 shell 变量
  write_atomic /etc/systemd/system/doh-server.service 644 <<EOF
[Unit]
Description=de_GWD DoH Server (dnsproxy)
After=network.target unbound.service
Wants=unbound.service

[Service]
ExecStart=$BASE/dnsproxy --listen=127.0.0.1 --https-port=9853 --tls-crt=/var/www/ssl/de_GWD.cer --tls-key=/var/www/ssl/de_GWD.key --upstream=udp://127.0.0.1:53 --upstream=tcp://127.0.0.1:53 --cache --cache-size=8192 --cache-min-ttl=60
Restart=always
RestartSec=2
LimitNOFILE=1000000
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/ssl

[Install]
WantedBy=multi-user.target
EOF
  systemctl enable doh-server >/dev/null 2>&1
}

# ================================================================= unbound ====
unbound_conf() {
  ok "配置 unbound (本地递归/转发 DNS)..."
  cat <<'EOF' >/etc/unbound/unbound.conf
server:
    verbosity: 0
    interface: 127.0.0.1
    port: 53
    do-ip4: yes
    do-udp: yes
    do-tcp: yes
    do-ip6: no
    prefer-ip6: no
    edns-buffer-size: 1232
    prefetch: yes
    prefetch-key: yes
    qname-minimisation: yes
    aggressive-nsec: yes
    so-reuseport: yes
    so-rcvbuf: 4m
    so-sndbuf: 4m
    num-threads: 2
    msg-cache-size: 128m
    rrset-cache-size: 256m
    msg-cache-slabs: 4
    rrset-cache-slabs: 4
    infra-cache-slabs: 4
    key-cache-slabs: 4
    auto-trust-anchor-file: "/var/lib/unbound/root.key"
forward-zone:
    name: "."
    forward-addr: 1.1.1.1
    forward-addr: 8.8.8.8
    forward-addr: 9.9.9.9
    forward-first: no
EOF
  unbound-anchor -a /var/lib/unbound/root.key 2>/dev/null || true
  # DNSSEC 信任锚: 上面已写入 auto-trust-anchor-file, 这里做真实校验(原版是 grep -q ... || true 空操作)
  if [[ -s /var/lib/unbound/root.key ]]; then
    if ! unbound-checkconf /etc/unbound/unbound.conf >/dev/null 2>&1; then
      warn "unbound 配置校验未通过, DNSSEC 可能未生效(请检查 /var/lib/unbound/root.key)"
    else
      # 不用 `... | grep -q`: grep 提前退出会让 unbound-host 收 SIGPIPE,
      # set -o pipefail 下管道被判失败, 校验通过会被误读为不通过。
      local uhout=""
      uhout=$(unbound-host -C /etc/unbound/unbound.conf -v -t A dnssec-failed.org 2>&1 || true)
      if grep -q 'validation failure' <<<"$uhout"; then
        ok "unbound DNSSEC 校验链路正常(已验证 dnssec-failed.org 被正确拒绝)"
      else
        warn "unbound DNSSEC 验证未确认(网络受限时属正常), 信任锚已存在"
      fi
    fi
  else
    warn "未生成 /var/lib/unbound/root.key, DNSSEC 验证将不可用"
  fi
  write_atomic /etc/systemd/system/unbound.service 644 <<'EOF'
[Unit]
Description=de_GWD unbound DNS
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/unbound -d
Restart=on-failure
ReadOnlyPaths=/etc/unbound
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
  systemctl stop systemd-resolved >/dev/null 2>&1
  systemctl disable systemd-resolved >/dev/null 2>&1
  systemctl mask systemd-resolved >/dev/null 2>&1
  # 直接落实体文件(兼容 Ubuntu systemd-resolved 的 stub 符号链接场景)
  rm -f /etc/resolv.conf
  printf 'nameserver 127.0.0.1\nnameserver 1.1.1.1\n' > /etc/resolv.conf
  systemctl enable unbound >/dev/null 2>&1
}

# =========================================================== TLS 证书 acme.sh ==
ssl_install_dir() {
  mkdir -p "$SSLDIR"
  # 只删将被覆盖的域名证书, 保留自签 self.cer/self.key(hy2/tuic/anytls 依赖)
  rm -f "$SSLDIR/de_GWD.cer" "$SSLDIR/de_GWD.key"
  [[ -f $SSLDIR/dhparam.pem ]] || openssl dhparam -out "$SSLDIR/dhparam.pem" 2048 >/dev/null 2>&1
}

# 猜测 zone 顶点域名(用于通配符证书): 处理常见的多级公共后缀
apex_domain() {
  local d="${1,,}" n i label
  # 去掉可能的端口与末尾点
  d="${d%%:*}"; d="${d%.}"
  # 纯 IP 没有"顶点域"概念, 原样返回(后续 acme 会自然失败并给出明确提示)
  [[ $d =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && { printf '%s\n' "$d"; return 0; }
  local -a parts; IFS='.' read -r -a parts <<< "$d"
  n=${#parts[@]}
  (( n <= 2 )) && { printf '%s\n' "$d"; return 0; }
  # 常见的两段式公共后缀(不追求覆盖完整 PSL, 覆盖绝大多数场景)
  local two="ac.uk co.uk org.uk gov.uk me.uk net.uk sch.uk co.jp ne.jp or.jp ac.jp "
  two+="com.cn net.cn org.cn gov.cn edu.cn com.hk org.hk edu.hk com.tw org.tw "
  two+="com.au net.au org.au edu.au co.nz net.nz org.nz co.kr or.kr com.br com.mx "
  two+="co.in net.in org.in co.za com.sg com.my co.id com.tr com.ar com.pl com.ru"
  local tail2="${parts[$((n-2))]}.${parts[$((n-1))]}"
  for label in $two; do
    if [[ $label == "$tail2" ]]; then
      # 两段式后缀: 顶点是"后三段"; 后三段不足时说明本身就是顶点
      (( n >= 3 )) && { printf '%s\n' "${parts[$((n-3))]}.${tail2}"; return 0; }
      printf '%s\n' "$tail2"; return 0
    fi
  done
  printf '%s\n' "$tail2"
}

make_ssl_webroot() {   # 443: HTTP 验证
  local domain; domain=$(conf_get '.domain')
  ok "申请证书 (webroot): $domain"
  curl -s https://get.acme.sh | sh -s email=admin@"$domain" >/dev/null 2>&1
  /root/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1
  ssl_install_dir
  # 临时 80 站点供验证
  cat <<'EOF' >/etc/nginx/conf.d/default.conf
server {
    listen 80 default_server reuseport;
    server_name __DOMAIN__;
    root /var/www/html;
}
EOF
  render_tpl /etc/nginx/conf.d/default.conf DOMAIN "$domain"
  nginx -t >/dev/null 2>&1 && systemctl restart nginx
  if ! /root/.acme.sh/acme.sh --issue -d "$domain" -w "$WEBDIR" -k ec-256 --server letsencrypt; then
    die "证书签发失败(检查域名解析是否指向本机,且 80 端口可访问)"
  fi
  /root/.acme.sh/acme.sh --install-cert -d "$domain" --ecc \
    --key-file "$SSLDIR/de_GWD.key" --fullchain-file "$SSLDIR/de_GWD.cer" \
    --reloadcmd "nginx -s reload" >/dev/null 2>&1
  chown root:www-data "$SSLDIR"/*.key 2>/dev/null && chmod 640 "$SSLDIR"/*.key 2>/dev/null
  chmod 644 "$SSLDIR"/*.cer "$SSLDIR/dhparam.pem" 2>/dev/null
}

make_ssl_cf() {   # 非 443 端口: Cloudflare DNS API 验证(支持 Token 或全局 Key)
  local domain port token zoneid key email
  domain=$(conf_get '.domain'); port=$(conf_get '.port')
  # 非交互(--cli / 面板)时无法询问 CF 凭据, 提前失败比挂死好
  if ! is_tty; then
    err "非交互模式无法申请证书(需要 Cloudflare 凭据)。"
    err "请先在菜单 [1] 安装流程中完成证书签发, 或在交互式终端执行 shuoyue。"
    return 1
  fi
  ok "申请证书 (Cloudflare DNS): $domain"
  echo "Cloudflare 凭据(用于 DNS 验证,二选一):"
  echo "  [1] API Token (推荐,权限 Zone.DNS Edit)"
  echo "  [2] Global API Key + 邮箱 (旧式)"
  local style; style=$(ask "选择 [1/2]: ")
  if [[ $style == "2" ]]; then
    key=$(ask_secret "CF Global API Key: "); email=$(ask "CF Email: ")
    export CF_Key="$key" CF_Email="$email"
  else
    token=$(ask_secret "CF API Token: ")
    zoneid=$(ask "CF Zone ID (可选,回车跳过): ")
    export CF_Token="$token"
    [[ -n $zoneid ]] && export CF_Zone_ID="$zoneid"
  fi
  # 通配符证书必须签在 zone 顶点(example.com), 而不是被猜出来的"后两段" ——
  # example.co.uk / my.site.com.cn 这类多级后缀靠截取后两段会得到错的域。
  local top; top=$(apex_domain "$domain")
  local input
  input=$(ask "证书主体域名 [回车=$top]: "); [[ -n $input ]] && top=$input
  [[ "$top" =~ ^[A-Za-z0-9.-]+$ ]] || die "域名格式非法: $top"
  curl -s https://get.acme.sh | sh -s email=admin@"$domain" >/dev/null 2>&1
  /root/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1
  ssl_install_dir
  if ! /root/.acme.sh/acme.sh --issue --dns dns_cf -d "$top" -d "*.$top" -k ec-256 --server letsencrypt --dnssleep 120; then
    die "证书签发失败(检查 Cloudflare 凭据与域名 $top 是否属于该账号)"
  fi
  /root/.acme.sh/acme.sh --install-cert -d "$top" --ecc \
    --key-file "$SSLDIR/de_GWD.key" --fullchain-file "$SSLDIR/de_GWD.cer" \
    --reloadcmd "nginx -s reload" >/dev/null 2>&1
  chown root:www-data "$SSLDIR"/*.key 2>/dev/null && chmod 640 "$SSLDIR"/*.key 2>/dev/null
  chmod 644 "$SSLDIR"/*.cer "$SSLDIR/dhparam.pem" 2>/dev/null
}

# ============================================================ Xray 配置生成 ===
xray_uuid_gen() { cat /proc/sys/kernel/random/uuid; }
uuid6() { printf %s "$1" | tr -d '-' | tail -c 6; }
proto_on() { [[ $(conf_get ".protos.$1") == "true" ]]; }
any_proto() { [[ -n $(conf_get '.protos' | jq -r 'to_entries | map(select(.value==true)) | .[0].key // empty' 2>/dev/null) ]]; }
# 需要域名(nginx 443/8442)的协议: 只要有一个开着就需要证书与 nginx
domain_proto_on() {
  local p
  for p in $(proto_ids); do
    [[ $(proto_needs_domain "$p") == "1" ]] && proto_on "$p" && return 0
  done
  return 1
}
# 需要 sing-box 内核的协议
sb_proto_on() {
  local p
  for p in $(proto_ids); do
    [[ $(proto_kernel "$p") == "singbox" ]] && proto_on "$p" && return 0
  done
  return 1
}
# 需要 Xray 内核的协议
xray_proto_on() {
  local p
  for p in $(proto_ids); do
    [[ $(proto_kernel "$p") == "xray" ]] && proto_on "$p" && return 0
  done
  return 1
}
# 需要 VLESS 加密(mlkem768x25519plus)的协议
vlessenc_proto_on() {
  proto_on xhttpenc || proto_on wsenc || proto_on realityxhttp
}

# 自签证书(hy2/tuic/anytls 在无域名证书时使用, 分享链接带 insecure=1)
ensure_self_cert() {
  [[ -s $SSLDIR/self.cer && -s $SSLDIR/self.key ]] && return 0
  mkdir -p "$SSLDIR"
  openssl req -new -x509 -nodes -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
    -keyout "$SSLDIR/self.key" -out "$SSLDIR/self.cer" -days 3650 -subj "/CN=de_GWD" >/dev/null 2>&1
  chown root:www-data "$SSLDIR/self.key" 2>/dev/null; chmod 640 "$SSLDIR/self.key" 2>/dev/null
  chmod 644 "$SSLDIR/self.cer" 2>/dev/null
}
open_all_ports() {
  if which iptables >/dev/null 2>&1; then
    iptables -I INPUT -p tcp --dport 1024:65535 -j ACCEPT 2>/dev/null || true
    iptables -I INPUT -p udp --dport 1024:65535 -j ACCEPT 2>/dev/null || true
  fi
  if which ufw >/dev/null 2>&1; then
    ufw allow 1024:65535/tcp >/dev/null 2>&1 || true
    ufw allow 1024:65535/udp >/dev/null 2>&1 || true
  fi
  if which nft >/dev/null 2>&1; then
    nft add rule inet filter input tcp dport 1024-65535 accept 2>/dev/null || true
    nft add rule inet filter input udp dport 1024-65535 accept 2>/dev/null || true
  fi
  ok "已执行开放系统 1024-65535 所有高位端口"
}

# 输出: <证书> <私钥> <自签标记0/1>
tls_cert_pair() {
  local alns; alns=$(conf_get '.alns // empty')
  if [[ $alns == "y" && -s $SSLDIR/de_GWD.cer && -s $SSLDIR/de_GWD.key ]]; then
    echo "$SSLDIR/de_GWD.cer $SSLDIR/de_GWD.key 0"
  elif [[ -s $SSLDIR/de_GWD.cer && -s $SSLDIR/de_GWD.key && $alns != "n" && $alns != "off" ]]; then
    echo "$SSLDIR/de_GWD.cer $SSLDIR/de_GWD.key 0"
  else
    ensure_self_cert
    echo "$SSLDIR/self.cer $SSLDIR/self.key 1"
  fi
}

xray_inbound_vmess() {
  jq -n --arg id "$(conf_get '.uuids[0]')" --arg path "$(conf_get '.path')" '{
    listen: "127.0.0.1", port: 9890, protocol: "vmess",
    settings: { clients: [{ id: $id, alterId: 0 }] },
    streamSettings: { network: "ws", security: "none",
      wsSettings: { path: $path },
      sockopt: { tcpFastOpen: true, tcpMptcp: true } },
    sniffing: { enabled: true, destOverride: ["http","tls","quic"] } }'
}
xray_inbound_vless_ws() {
  jq -n --arg id "$(conf_get '.uuids[0]')" --arg path "/v-$(uuid6 "$(conf_get '.uuids[0]')")" '{
    listen: "127.0.0.1", port: 9891, protocol: "vless",
    settings: { clients: [{ id: $id }], decryption: "none" },
    streamSettings: { network: "ws", security: "none",
      wsSettings: { path: $path },
      sockopt: { tcpFastOpen: true, tcpMptcp: true } },
    sniffing: { enabled: true, destOverride: ["http","tls","quic"] } }'
}
xray_inbound_trojan_ws() {
  jq -n --arg id "$(conf_get '.uuids[0]')" --arg path "/t-$(uuid6 "$(conf_get '.uuids[0]')")" '{
    listen: "127.0.0.1", port: 9892, protocol: "trojan",
    settings: { clients: [{ password: $id }] },
    streamSettings: { network: "ws", security: "none",
      wsSettings: { path: $path },
      sockopt: { tcpFastOpen: true, tcpMptcp: true } },
    sniffing: { enabled: true, destOverride: ["http","tls"] } }'
}
xray_inbound_trojan_tcp() {
  local cert key port; read -r cert key _ <<< "$(tls_cert_pair)"
  port=$(proto_port trojantcp)
  jq -n --arg id "$(conf_get '.uuids[0]')" --arg c "$cert" --arg k "$key" --argjson port "$port" '{
    listen: "0.0.0.0", port: $port, protocol: "trojan",
    settings: { clients: [{ password: $id }] },
    streamSettings: { network: "tcp", security: "tls",
      tlsSettings: { certificates: [{ certificateFile: $c, keyFile: $k }] } },
    sniffing: { enabled: true, destOverride: ["http","tls"] } }'
}
xray_inbound_ss() {
  local port; port=$(proto_port ss)
  jq -n --arg pw "$(ss2022_key)" --argjson port "$port" '{
    listen: "0.0.0.0", port: $port, protocol: "shadowsocks",
    settings: { method: "2022-blake3-aes-128-gcm", password: $pw, network: "tcp,udp" } }'
}
xray_inbound_reality() {   # VLESS + Reality (免域名)
  local port priv uuids
  port=$(proto_port reality); priv=$(conf_get '.reality.private')
  uuids=$(conf_get '.uuids[]')
  local clients="[]"
  clients=$(echo "$uuids" | while read -r u; do
    [[ -z $u ]] && continue
    jq -cn --arg id "$u" '[{id:$id, flow:"xtls-rprx-vision"}]'
  done | jq -s 'add // []')
  jq -n --argjson clients "$clients" --arg priv "$priv" --argjson port "$port" \
        --arg dest "$(conf_get '.reality.dest')" --arg sni "$(conf_get '.reality.sni')" \
        --arg sid "$(conf_get '.reality.shortid')" '
  {
    listen: "0.0.0.0",
    port: $port,
    protocol: "vless",
    settings: { clients: $clients, decryption: "none" },
    streamSettings: {
      network: "tcp",
      security: "reality",
      realitySettings: {
        show: false,
        dest: $dest,
        xver: 0,
        serverNames: [$sni],
        privateKey: $priv,
        shortIds: [$sid]
      }
    },
    sniffing: { enabled: true, destOverride: ["http","tls","quic"] }
  }'
}


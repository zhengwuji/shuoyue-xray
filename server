protos_menu() {
  conf_init
  any_proto || die "尚未安装"
  echo "当前启用: $(conf_get '.protos // {}' | jq -r 'to_entries | map(select(.value==true) | .key) | join(", ")')"
  echo "输入要切换的协议编号(空格/逗号分隔, 回车=不变):"
  protos_print_menu
  local sel tok id
  sel=$(ask "切换: "); sel=${sel//,/ }
  [[ -z $sel ]] && return
  for tok in $sel; do
    [[ "$tok" =~ ^[0-9]+$ ]] || { warn "忽略: $tok"; continue; }
    id=$(printf '%s\n' "$PROTO_TABLE" | sed -n "${tok}p" | cut -d'|' -f1)
    [[ -z $id ]] && { warn "编号越界: $tok"; continue; }
    if proto_on "$id"; then
      conf_raw '.protos' "$(conf_get '.protos // {}' | jq --arg k "$id" '.[$k]=false')"
      ok "已关闭: $id"
    else
      conf_raw '.protos' "$(conf_get '.protos // {}' | jq --arg k "$id" '.[$k]=true')"
      ok "已开启: $id"
      if [[ $id == reality || $id == realityxhttp || $id == anyreality ]] && [[ -z $(conf_get '.reality.private') ]]; then
        reality_keygen
      fi
    fi
  done
  apply_protos
  gen_sub_all
  printNode

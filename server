# ---------------------------------------------------------------- helpers ---
ok()   { echo -e "${WHITE}[ ${GREEN}✓${WHITE} ]${cRES} $*"; }
warn() { echo -e "${WHITE}[ ${YELLOW}!${WHITE} ]${cRES} $*"; }
err()  { echo -e "${WHITE}[ ${RED}✕${WHITE} ]${cRES} $*"; }

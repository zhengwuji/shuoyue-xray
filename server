# ----------------------------------------------------------------- 内核升级 ---
# Zabbly stable 内核仓库只收录「稳定」套件:
#   Debian: bookworm / trixie      Ubuntu: jammy / noble / resolute
# testing(forky)/sid 与 Ubuntu 非 LTS(questing/plucky/oracular 等)没有对应目录,
# 直接写源会让 apt-get update 报 404。这里先探测 Release, 探测失败再退到同家族
# 的稳定套件(只用于取 linux-zabbly 内核包, 不引入其它软件)。
zabbly_suite_ok() {   # $1=suite
  local code
  code=$(curl -fsS -o /dev/null -w '%{http_code}' --max-time 15 \
         -I "https://pkgs.zabbly.com/kernel/stable/dists/$1/Release" 2>/dev/null)
  [[ $code == "200" ]]
}

zabbly_pick_suite() {   # $1=codename; 回显可用套件, 无则回显空串
  local cn=$1 fb=""
  [[ -z $cn ]] && { echo ""; return 0; }
  if zabbly_suite_ok "$cn"; then echo "$cn"; return 0; fi
  case "$cn" in
    forky|sid|trixie)              fb=trixie  ;;
    bookworm|bullseye|buster)      fb=bookworm ;;
    questing|plucky|oracular|noble|jammy) fb=noble ;;
    resolute)                      fb=resolute ;;
  esac
  if [[ -n $fb ]] && zabbly_suite_ok "$fb"; then echo "$fb"; return 0; fi
  echo ""
}

installkernel() {
  [[ $VIRT_TYPE == "container" ]] && die "容器环境不支持更换内核"
  read -rsp "[1] Zabbly stable 内核: " -n1 a; echo
  if [[ $a == "1" ]]; then
    local codename; codename=$(. /etc/os-release; echo "$VERSION_CODENAME")
    local zsuite; zsuite=$(zabbly_pick_suite "$codename")
    if [[ -z $zsuite ]]; then
      warn "Zabbly 内核仓库没有 $codename 对应套件(仅收录 Debian bookworm/trixie 与 Ubuntu jammy/noble/resolute), 已跳过内核升级"
      return 0
    fi
    [[ $zsuite != "$codename" ]] && \
      warn "Zabbly 无 $codename 套件, 回退使用 $zsuite 的 linux-zabbly 内核包"
    mkdir -p /etc/apt/keyrings
    # 原 https://zabbly.com/key.asc 可用; 源 URI 原为 zabbly.com/kernel/stable(404/502), 实测 pkgs.zabbly.com 200
    curl -fsSL https://pkgs.zabbly.com/key.asc -o /etc/apt/keyrings/zabbly.asc || die "Zabbly GPG key 下载失败"
    # 校验指纹: 只信任 Zabbly Kernel Builds 官方 key, 防止上游被投毒
    local ZABBLY_FPR="4EFC590696CB15B87C73A3AD82CC8797C838DCFD" fpr=""
    fpr=$(gpg --show-keys --with-fingerprint --with-colons /etc/apt/keyrings/zabbly.asc 2>/dev/null \
          | awk -F: '/^fpr:/{print $10; exit}')
    if [[ -z $fpr ]]; then
      # 老版本 gpg 无 --show-keys: 导到临时 keyring 再取指纹, 不污染用户 keyring
      local kd; kd=$(mktemp -d)
      GNUPGHOME="$kd" gpg --import /etc/apt/keyrings/zabbly.asc >/dev/null 2>&1
      fpr=$(GNUPGHOME="$kd" gpg --with-colons --fingerprint 2>/dev/null | awk -F: '/^fpr:/{print $10; exit}')
      rm -rf "$kd"
    fi
    if [[ "$fpr" != "$ZABBLY_FPR" ]]; then
      rm -f /etc/apt/keyrings/zabbly.asc
      die "Zabbly GPG key 指纹不匹配(期望 $ZABBLY_FPR, 实际 ${fpr:-无法读取}), 已中止安装"
    fi
    ok "Zabbly GPG key 指纹校验通过: ${fpr:0:16}..."
    cat <<EOF >/etc/apt/sources.list.d/zabbly-kernels-stable.sources
Enabled: yes
Types: deb
URIs: https://pkgs.zabbly.com/kernel/stable
Suites: $zsuite
Components: main
Signed-By: /etc/apt/keyrings/zabbly.asc
EOF
  apt-get update -qq
  apt-get install -y -qq linux-zabbly || die "linux-zabbly 安装失败(Zabbly 套件 $zsuite); 可执行 rm -f /etc/apt/sources.list.d/zabbly-kernels-stable.sources 后重试"
  ok "内核已安装, 重启生效"
    read -rsp "现在重启? [y/N]: " -n1 r; echo
    [[ "$r" =~ ^[Yy] ]] && reboot
  fi
  return 0
}


warp_set_mode() {
  local mode="${1:-warp_google}"
  case "$mode" in
    direct)
      conf_set '.warp.enable' "false"
      conf_set '.warp.mode' "direct"
      ;;
    warp_google|warp_ai|warp_media_ai|warp_all)
      warp_ensure_account 0 || {
        cli_json '{"ok":false,"error":"注册 Cloudflare WARP 账号失败"}'
        return 1
      }
      conf_set '.warp.enable' "true"
      conf_set '.warp.mode' "$mode"
      ;;
    *)
      cli_json '{"ok":false,"error":"无效的出口代理模式"}'
      return 1
      ;;
  esac

  warp_apply

  local desc=""
  case "$mode" in
    direct) desc="已切换为原生 IP 直连（关闭 WARP 出口代理）" ;;
    warp_google) desc="已启用 WARP 出口：仅解锁 Gemini & 谷歌全家桶（其余原生直连）" ;;

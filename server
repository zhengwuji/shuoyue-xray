    warp_all) desc="已启用 WARP 全局出站：全部流量走 Cloudflare 出口" ;;
  esac

  cli_json "$(jq -cn --arg m "$mode" --arg msg "$desc" '{ok:true, mode:$m, message:$msg}')"
}

warp_test_unlock() {
  local test_port=9899
  local proxy_opt=""
  local ssout=""
  ssout=$(ss -tln 2>/dev/null || true)
  if grep -qE ":$test_port\s" <<<"$ssout"; then
    proxy_opt="socks5://127.0.0.1:$test_port"
  fi

  python3 -c '
import subprocess, json, sys

proxy_str = "'"${proxy_opt}"'"
proxy = ["-x", proxy_str] if proxy_str else []

def test_url(url, timeout=6):
    cmd = ["curl", "-sI", "--max-time", str(timeout)] + proxy + [url]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
        first = r.stdout.splitlines()[0] if r.stdout else ""
        ok = bool("200" in first or "301" in first or "302" in first or "304" in first)
        return {"ok": ok, "status": first or "超时无响应"}
    except Exception as e:
        return {"ok": False, "status": str(e)}

def test_cf_trace():
    cmd = ["curl", "-s", "--max-time", "6"] + proxy + ["https://cloudflare.com/cdn-cgi/trace"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
        d = {}
        for line in r.stdout.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                d[k.strip()] = v.strip()
        return d
    except Exception:
        return {}

cf = test_cf_trace()
gemini = test_url("https://gemini.google.com")
google = test_url("https://www.google.com")
chatgpt = test_url("https://chatgpt.com")
youtube = test_url("https://www.youtube.com")

res = {
    "ok": True,
    "warp_on": cf.get("warp") == "on",
    "warp_ip": cf.get("ip", ""),
    "warp_loc": cf.get("loc", ""),
    "gemini": gemini,
    "google": google,
    "chatgpt": chatgpt,
    "youtube": youtube,
}
print(json.dumps(res, ensure_ascii=False))
' 2>/dev/null || echo '{"ok":false,"error":"测试执行失败"}'
}


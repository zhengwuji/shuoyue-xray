  } > /etc/nginx/conf.d/default.conf

  sed -i "s|__PORT__|$port|g; s|__DOMAIN__|$domain|g; s|__VMPATH__|$vmpath|g; s|__VLPATH__|/v-$u6|g; s|__TRPATH__|/t-$u6|g; s|__TR2PATH__|/tw-$u6|g; s|__VEPATH__|/ve-$u6|g" /etc/nginx/conf.d/default.conf

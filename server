xray_gen_config() {
  local inbounds="[]"
  if proto_on vmess;     then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_vmess)" '. + [$i]'); fi
  if proto_on vless;     then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_vless_ws)" '. + [$i]'); fi
  if proto_on trojan;    then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_trojan_ws)" '. + [$i]'); fi
  if proto_on trojanws;  then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_trojan_ws2)" '. + [$i]'); fi
  if proto_on wsenc;     then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_vless_ws_enc)" '. + [$i]'); fi
  if proto_on trojantcp; then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_trojan_tcp)" '. + [$i]'); fi
  if proto_on ss;        then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_ss)" '. + [$i]'); fi
  if proto_on socks5;    then inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_socks5)" '. + [$i]'); fi
  if proto_on reality && [[ -n $(conf_get '.reality.private') ]]; then
    inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_reality)" '. + [$i]')
  fi
  if proto_on realityxhttp; then
    inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_reality_xhttp)" '. + [$i]')
  fi
  if proto_on xhttptls || proto_on xhttpupip; then
    inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_xhttp_tls)" '. + [$i]')
  fi
  if proto_on xhttpenc; then
    inbounds=$(echo "$inbounds" | jq --argjson i "$(xray_inbound_xhttp_enc)" '. + [$i]')
  fi
  local outbounds='[
    {"tag":"direct","protocol":"freedom","streamSettings":{"sockopt":{"tcpFastOpen":true,"tcpNoDelay":true}}},
    {"tag":"blocked","protocol":"blackhole","settings":{"response":{"type":"http"}}}
  ]'
  local cfg_tmp; cfg_tmp=$(mktemp "$XRAYDIR/config.json.XXXXXX") || die "无法创建临时配置文件"
  if ! jq -n --argjson inb "$inbounds" --argjson outb "$outbounds" '{
    log: { access: "none", error: "/var/log/xray-error.log", loglevel: "warning" },
    routing: { rules: [] },
    inbounds: $inb,
    outbounds: $outb
  }' > "$cfg_tmp" || ! jq -e . "$cfg_tmp" >/dev/null 2>&1; then
    rm -f "$cfg_tmp"
    die "Xray 配置生成/校验失败, 已保留旧配置 $XRAYDIR/config.json"
  fi
  chmod 640 "$cfg_tmp" 2>/dev/null
  if [[ $XTLSUSER != "root" ]]; then chown $XTLSUSER:$XTLSUSER "$cfg_tmp"; fi
  mv -f "$cfg_tmp" "$XRAYDIR/config.json" || { rm -f "$cfg_tmp"; die "Xray 配置替换失败"; }
  return 0
}

reality_keygen() {
  local pub priv sni shortid dest port
  read -r priv pub <<< "$(xray_x25519_keygen)" || die "reality 密钥解析失败(xray x25519 输出格式无法识别)"
  [[ -z $pub || -z $priv ]] && die "reality 密钥解析失败"
  shortid=$(openssl rand -hex 8)
  # 交互式(菜单)时询问; 非交互(--cli / 面板)时直接用默认值, 否则会永久阻塞
  if is_tty; then
    dest=$(ask "Reality dest (回车=www.microsoft.com:443): "); dest=${dest:-www.microsoft.com:443}
    port=$(ask "Reality 端口 (回车=8443): "); port=${port:-8443}
  else
    dest="www.microsoft.com:443"; port="8443"
  fi
  sni=${dest%%:*}
  conf_raw '.reality' "{\"enable\":true,\"port\":$port,\"private\":\"$priv\",\"public\":\"$pub\",\"shortid\":\"$shortid\",\"dest\":\"$dest\",\"sni\":\"$sni\"}"
  conf_raw '.protos' "$(conf_get '.protos // {}' | jq '. + {reality:true}')"
}

# ====================================================== sing-box (hy2/tuic/anytls) ==
install_singbox() {
  [[ ${1:-} != "--force" && -x $BASE/singbox/sing-box ]] && return 0
  ok "安装 sing-box (官方 release)..."
  mkdir -p "$BASE/singbox"
  fetch_release "SagerNet/sing-box" "sing-box-.*-linux-${ARCH}\\.tar\\.gz$" /tmp/singbox.tar.gz || die "sing-box 下载失败"
  rm -rf /tmp/sb-ex && mkdir -p /tmp/sb-ex
  tar -xzf /tmp/singbox.tar.gz -C /tmp/sb-ex
  local bin; bin=$(find /tmp/sb-ex -name sing-box -type f | head -n1)
  [[ -z $bin ]] && die "sing-box 解包失败"
  mv -f "$bin" "$BASE/singbox/sing-box" && chmod 755 "$BASE/singbox/sing-box"
  rm -rf /tmp/singbox.tar.gz /tmp/sb-ex
  write_atomic /etc/systemd/system/sing-box.service 644 <<EOF
[Unit]
Description=de_GWD sing-box server (Hysteria2/TUIC/AnyTLS)
After=network.target

[Service]
User=www-data
ExecStart=$BASE/singbox/sing-box run -c $BASE/singbox/config.json
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/ssl
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF
  chown -R www-data:www-data "$BASE/singbox" 2>/dev/null
  systemctl enable sing-box >/dev/null 2>&1
}

singbox_gen_config() {
  local cert key; read -r cert key _ <<< "$(tls_cert_pair)"
  local inb="[]"
  if proto_on hy2; then
    inb=$(jq -n --argjson a "$inb" --arg c "$cert" --arg k "$key" --arg pw "$(conf_get '.uuids[0]')" \
      '$a + [{type:"hysteria2", tag:"hy2-in", listen:"::", listen_port:8444,
              users:[{name:"u1", password:$pw}],
              tls:{enabled:true, certificate_path:$c, key_path:$k}}]')
  fi
  if proto_on tuic; then
    inb=$(jq -n --argjson a "$inb" --arg c "$cert" --arg k "$key" --arg id "$(conf_get '.uuids[0]')" \
      '$a + [{type:"tuic", tag:"tuic-in", listen:"::", listen_port:8445,
              users:[{name:"u1", uuid:$id, password:$id}],
              congestion_control:"bbr", zero_rtt_handshake:false,
              tls:{enabled:true, alpn:["h3"], certificate_path:$c, key_path:$k}}]')
  fi
  if proto_on anytls; then
    # 注意: anytls 只认 users[] , 顶层 password 字段会被 sing-box 拒绝
    inb=$(jq -n --argjson a "$inb" --arg c "$cert" --arg k "$key" --arg pw "$(conf_get '.uuids[0]')" \
      '$a + [{type:"anytls", tag:"atls-in", listen:"::", listen_port:8446,
              users:[{name:"u1", password:$pw}],
              tls:{enabled:true, certificate_path:$c, key_path:$k}}]')
  fi
  if proto_on naive; then
    # naive inbound: users 字段名是 username (不是 name); 不限定 network, 让 h2/h3 都可用
    inb=$(jq -n --argjson a "$inb" --arg c "$cert" --arg k "$key" --arg u "$(uuid6 "$(conf_get '.uuids[0]')")" \
                --arg pw "$(conf_get '.uuids[0]')" \
      '$a + [{type:"naive", tag:"naive-in", listen:"::", listen_port:8447,
              users:[{username:$u, password:$pw}],
              quic_congestion_control:"bbr",
              tls:{enabled:true, alpn:["h2","http/1.1"], certificate_path:$c, key_path:$k}}]')
  fi
  if proto_on sssb; then
    # SS2022 口令必须是 16 字节 base64, 不能拿 UUID 顶替(否则 sing-box 启动即报错)
    inb=$(jq -n --argjson a "$inb" --arg pw "$(ss2022_key)" \
      '$a + [{type:"shadowsocks", tag:"sssb-in", listen:"::", listen_port:8452,
              method:"2022-blake3-aes-128-gcm", password:$pw}]')
  fi
  if proto_on anyreality; then
    local rpriv rpub rsid rdst rsni
    read -r rpriv rpub <<< "$(sb_reality_pair)" || { warn "sing-box REALITY 密钥生成失败, 跳过 anyreality"; rpriv=""; }
    if [[ -n $rpriv ]]; then
      rsid=$(conf_get '.reality.shortid'); rdst=$(conf_get '.reality.dest'); rsni=$(conf_get '.reality.sni')
      inb=$(jq -n --argjson a "$inb" --arg priv "$rpriv" --arg dest "$rdst" \
                  --arg sni "$rsni" --arg sid "$rsid" --arg id "$(conf_get '.uuids[0]')" \
        '$a + [{type:"vless", tag:"anyreality-in", listen:"::", listen_port:8451,
                users:[{name:"u1", uuid:$id, flow:"xtls-rprx-vision"}],
                tls:{enabled:true, server_name:$sni,
                     reality:{enabled:true, handshake:{server:$dest, server_port:443},
                              private_key:$priv, short_id:[$sid]}}}]')
    fi
  fi
  local cfg_tmp
  cfg_tmp=$(mktemp "$BASE/singbox/config.json.XXXXXX") || die "无法创建 sing-box 临时配置"
  if ! jq -n --argjson inb "$inb" '{
    log: { level: "warn", timestamp: true },
    inbounds: $inb,
    outbounds: [{ type: "direct", tag: "direct" }],
    route: { final: "direct" }
  }' > "$cfg_tmp" || ! jq -e . "$cfg_tmp" >/dev/null 2>&1; then
    rm -f "$cfg_tmp"
    warn "sing-box 配置生成失败, 已保留旧配置 $BASE/singbox/config.json"
    return 1
  fi
  chmod 640 "$cfg_tmp" 2>/dev/null
  chown www-data:www-data "$cfg_tmp" 2>/dev/null
  mv -f "$cfg_tmp" "$BASE/singbox/config.json" || { rm -f "$cfg_tmp"; warn "sing-box 配置替换失败"; return 1; }
  return 0
}

# ================================================================ 分享链接 ====
# 链接发射器: GEN_LINKS_TAGGED 非空时输出 "id|显示名|链接", 否则只输出链接
# 节点名统一加 conf .prefix 前缀(面板可改), 便于客户端里区分
emit_link() {
  local id="$1" link="$2" pfx tag; pfx=$(conf_get '.prefix'); tag=$(proto_name "$id")
  if [[ -n $pfx ]]; then
    if [[ $link == *'#'* ]]; then
      link="${link%%#*}#${pfx}${link#*#}"
    else
      # 没有 '#' 片段时直接追加。原写法 `${link%%#*}#${pfx}${link#*#}` 在无 '#'
      # 时 %%#* 与 #*# 都返回整串 → 整条链接被复制一遍:
      #   vmess://eyJ...  →  vmess://eyJ...#朔月vmess://eyJ...
      # vmess 的节点名在 base64 内的 ps 字段, 链接本身不带 '#', 必然命中。
      link="${link}#${pfx}${tag}"
    fi
  fi
  if [[ -n ${GEN_LINKS_TAGGED:-} ]]; then
    printf '%s|%s|%s\n' "$id" "$tag" "$link"
  else
    printf '%s\n' "$link"
  fi
}

# 逐行输出所有已启用协议的 v2rayN 兼容分享链接
# 注意: v2rayN 只认这些 scheme: vmess/ss/socks/vless/trojan/hysteria2/tuic/wireguard/anytls/naive
gen_links() {
  local uuid0 host u6 port
  uuid0=$(conf_get '.uuids[0]'); u6=$(uuid6 "$uuid0")
  host=$(conf_get '.domain'); [[ -z $host ]] && host=$(wan_ip)
  local _c _k insc; read -r _c _k insc <<< "$(tls_cert_pair)"
  # CDN 优选 IP / 落地域名(UpIP), 缺省回落到 host
  local upip; upip=$(conf_get '.upip'); [[ -z $upip ]] && upip=$host
  if proto_on vmess; then
    port=$(conf_get '.port')
    local vj
    vj=$(jq -cn --arg add "$host" --arg port "$port" --arg id "$uuid0" \
      --arg path "$(conf_get '.path')" --arg host "$host" \
      '{v:"2",ps:($add+"-vmess"),add:$add,port:$port,id:$id,aid:"0",scy:"auto",
        net:"ws",type:"none",host:$host,path:$path,tls:"tls",sni:$host}')
    emit_link vmess "vmess://$(printf %s "$vj" | base64 -w0)"
  fi
  if proto_on vless; then
    port=$(conf_get '.port')
    emit_link vless "vless://$uuid0@$host:$port?encryption=none&security=tls&sni=$host&fp=chrome&type=ws&host=$host&path=/v-$u6#vless-ws"
  fi
  if proto_on trojan; then
    port=$(conf_get '.port')
    emit_link trojan "trojan://$uuid0@$host:$port?security=tls&sni=$host&type=ws&host=$host&path=/t-$u6#trojan-ws"
  fi
  if proto_on trojanws; then
    port=$(conf_get '.port')
    emit_link trojanws "trojan://$uuid0@$host:$port?security=tls&sni=$host&type=ws&host=$host&path=/tw-$u6#trojan-ws2"
  fi
  if proto_on trojantcp; then
    emit_link trojantcp "trojan://$uuid0@$host:8442?security=tls&sni=$host&type=tcp#trojan-tcp"
  fi
  # ---- VLESS + WebSocket + VLESS 加密 -------------------------------------
  if proto_on wsenc; then
    port=$(conf_get '.port')
    local wenc; wenc=$(vless_enc_pair 2>/dev/null); wenc=${wenc#* }
    emit_link wsenc "vless://$uuid0@$host:$port?encryption=$(urlenc "$wenc")&security=tls&sni=$host&fp=chrome&type=ws&host=$host&path=/ve-$u6#vless-ws-enc"
  fi
  if proto_on ss; then
    local sk; sk=$(ss2022_key)
    local sup; sup=$(printf %s "2022-blake3-aes-128-gcm:$sk" | base64 -w0 | tr '+/' '-_' | tr -d '=')
    emit_link ss "ss://$sup@$host:8388#shadowsocks-2022"
  fi
  if proto_on socks5; then
    emit_link socks5 "socks://$(printf %s "$(socks5_user):$uuid0" | base64 -w0 | tr '+/' '-_' | tr -d '=')@$host:1080#socks5"
  fi
  if proto_on reality && [[ -n $(conf_get '.reality.public') ]]; then
    local rp pbk sni sid
    rp=$(conf_get '.reality.port'); pbk=$(conf_get '.reality.public')
    sni=$(conf_get '.reality.sni'); sid=$(conf_get '.reality.shortid')
    emit_link reality "vless://$uuid0@$host:$rp?security=reality&encryption=none&pbk=$pbk&fp=chrome&type=tcp&flow=xtls-rprx-vision&sni=$sni&sid=$sid#reality"
  fi
  # ---- XHTTP 系列 ---------------------------------------------------------
  if proto_on xhttptls || proto_on xhttpupip; then
    local xp xpath
    xp=$(proto_port xhttptls); xpath="/xt-$u6"
    emit_link xhttptls "vless://$uuid0@$host:$xp?encryption=none&security=tls&sni=$host&fp=chrome&type=xhttp&host=$host&path=$(urlenc "$xpath")&mode=auto#xhttp-tls"
    if proto_on xhttpupip && [[ $upip != "$host" ]]; then
      emit_link xhttpupip "vless://$uuid0@$upip:$xp?encryption=none&security=tls&sni=$host&fp=chrome&type=xhttp&host=$host&path=$(urlenc "$xpath")&mode=auto#xhttp-tls-upip"
    fi
  fi
  if proto_on xhttpenc; then
    local xe xepath xenc; xe=$(proto_port xhttpenc); xepath="/xe-$u6"
    xenc=$(vless_enc_pair 2>/dev/null); xenc=${xenc#* }
    emit_link xhttpenc "vless://$uuid0@$host:$xe?encryption=$(urlenc "$xenc")&security=tls&sni=$host&fp=chrome&type=xhttp&host=$host&path=$(urlenc "$xepath")&mode=auto#xhttp-enc"
  fi
  if proto_on realityxhttp && [[ -n $(conf_get '.reality.public') ]]; then
    local xr pbk2 sni2 sid2 xrpath
    xr=$(proto_port realityxhttp); pbk2=$(conf_get '.reality.public')
    sni2=$(conf_get '.reality.sni'); sid2=$(conf_get '.reality.shortid')
    xrpath="/xr-$u6"
    emit_link realityxhttp "vless://$uuid0@$host:$xr?security=reality&encryption=none&pbk=$pbk2&fp=chrome&type=xhttp&path=$(urlenc "$xrpath")&mode=auto&sni=$sni2&sid=$sid2#xhttp-reality"
  fi
  # ---- sing-box 系 --------------------------------------------------------
  if proto_on hy2; then
    emit_link hy2 "hysteria2://$uuid0@$host:8444?sni=$host&insecure=$insc#hysteria2"
  fi
  if proto_on tuic; then
    emit_link tuic "tuic://$uuid0:$uuid0@$host:8445?congestion_control=bbr&alpn=h3&sni=$host&allow_insecure=$insc#tuic"
  fi
  if proto_on anytls; then
    emit_link anytls "anytls://$uuid0@$host:8446?sni=$host&insecure=$insc#anytls"
  fi
  if proto_on naive; then
    emit_link naive "naive://$(urlenc "$(uuid6 "$uuid0"):$uuid0")@$host:8447?sni=$host&insecure=$insc#naive"
  fi
  if proto_on sssb; then
    local sk2; sk2=$(ss2022_key)
    local sup2; sup2=$(printf %s "2022-blake3-aes-128-gcm:$sk2" | base64 -w0 | tr '+/' '-_' | tr -d '=')
    emit_link sssb "ss://$sup2@$host:8452#ss2022-sb"
  fi
  if proto_on anyreality && [[ -n $(conf_get '.reality.public') ]]; then
    local ap pbk3 sni3 sid3
    ap=$(proto_port anyreality); pbk3=$(conf_get '.reality.public')
    sni3=$(conf_get '.reality.sni'); sid3=$(conf_get '.reality.shortid')
    emit_link anyreality "vless://$uuid0@$host:$ap?security=reality&encryption=none&pbk=$pbk3&fp=chrome&type=tcp&flow=xtls-rprx-vision&sni=$sni3&sid=$sid3#any-reality"
  fi
  return 0
}

# 订阅文件: base64(全部链接), 由 nginx 以 /sub/<token> 提供
gen_sub_all() {
  local token; token=$(conf_get '.subtoken')
  [[ -z $token || ! -d $WEBDIR ]] && return 0
  # 订阅开关关闭时不生成文件(默认开启, 只有显式设为 false 才关)
  if [[ $(conf_get '.sub_on') == "false" ]]; then
    rm -f "$WEBDIR/sub/$token"
    return 0
  fi
  mkdir -p "$WEBDIR/sub"
  # 原子写: 订阅文件写坏会让客户端直接拉不到节点
  if ! gen_links | base64 -w0 | write_atomic "$WEBDIR/sub/$token" 644; then
    warn "订阅文件写入失败: $WEBDIR/sub/$token"
    return 1
  fi
  systemctl is-active nginx >/dev/null 2>&1 && nginx -s reload >/dev/null 2>&1
  return 0
}

sub_toggle() {   # on|off: 控制 /sub/<token> 是否可访问
  local want="${1:-on}" token; token=$(conf_get '.subtoken')
  if [[ $want == "on" ]]; then
    conf_set '.sub_on' "true"
    gen_sub_all
    ok "订阅已启用: https://$(conf_get '.domain')/sub/$token"
  else
    conf_set '.sub_on' "false"
    [[ -n $token ]] && rm -f "$WEBDIR/sub/$token"
    ok "订阅已关闭(订阅文件已删除, 客户端将拉不到节点)"
  fi
}

# ================================================================= 安装流程 ===
ask_domain_port() {
  local dp domain port
  while :; do
    dp=$(ask "输入域名(可带端口,如 a.com 或 a.com:8443): ")
    [[ "$dp" =~ ^[A-Za-z0-9.-]+(:[0-9]+)?$ ]] && break
    warn "域名格式不正确"
  done
  domain=${dp%%:*}
  port=$(echo "$dp" | grep -q ':' && echo "${dp##*:}" || echo 443)
  conf_set '.domain' "$domain"; conf_set '.port' "$port"
}

# 协议勾选(菜单/--cli 共用): 打印 PROTO_TABLE 编号表并解析用户选择 -> conf .protos
# 支持 "1 3 5" / "1,3,5" / "A" / "all"
protos_print_menu() {
  local i=0 id name port dom desc
  echo -e "${CYAN}  可用协议 (来自 PROTO_TABLE)${cRES}"
  while IFS='|' read -r id name _ port dom desc; do
    [[ -z $id ]] && continue
    i=$((i+1))
    printf '  [%2d] %-28s %-5s %s\n' "$i" "$name" "$([[ $dom == 1 ]] && echo '需域名' || echo '免域名')" "$desc"
  done <<< "$PROTO_TABLE"
  echo "  [ A] 全部安装 (推荐)"
}
protos_select() {
  local sel tok i id out='{}'
  sel=$(ask "选择协议(编号/组合, 空格或逗号分隔, 回车=A): "); sel=${sel:-A}
  sel=${sel//,/ }
  if [[ "$sel" =~ ^[Aa]([Ll][Ll])?$ ]]; then
    while IFS='|' read -r id _ _ _ _ _; do
      [[ -z $id ]] && continue
      out=$(echo "$out" | jq --arg k "$id" '. + {($k):true}')
    done <<< "$PROTO_TABLE"
  else
    for tok in $sel; do
      [[ $tok =~ ^[0-9]+$ ]] || { warn "忽略: $tok"; continue; }
      id=$(printf '%s\n' "$PROTO_TABLE" | sed -n "${tok}p" | cut -d'|' -f1)
      [[ -z $id ]] && { warn "编号越界: $tok"; continue; }
      out=$(echo "$out" | jq --arg k "$id" '. + {($k):true}')
    done
  fi
  conf_raw '.protos' "$out"
}

installGWD() {
  echo
  echo -e "${CYAN}=== de_GWD Remake 安装 (多协议) ===${cRES}"
  protos_print_menu
  conf_init
  protos_select
  any_proto || die "未选择任何协议"

  conf_raw '.uuids' "[\"$(xray_uuid_gen)\"]"
  conf_set '.path' "/$(uuid6 "$(conf_get '.uuids[0]')")"
  conf_set '.subtoken' "$(openssl rand -hex 8)"

  if domain_proto_on; then
    ask_domain_port
  else
    conf_set '.domain' ""; conf_set '.port' "443"
  fi

  ok "基线环境..."
  apt_baseline; pkg_dep; limits_conf; sysctl_conf
  unbound_conf
  svc_restart unbound && ok "unbound" || warn "unbound 未启动"
  shaping_conf; nftables_conf
  svc_restart degwd-shaping 2>/dev/null
  svc_restart degwd-nftables && ok "nftables + CAKE 整形" || warn "nftables 未启动"

  install_xray

  if domain_proto_on; then
    install_nginx
    install_doh
    svc_restart doh-server && ok "DoH 服务" || warn "DoH 未启动"
    decoy_site
    if [[ $(conf_get '.port') == "443" ]]; then
      make_ssl_webroot
    else
      make_ssl_cf
    fi
  fi

  if proto_on reality || proto_on realityxhttp || proto_on anyreality; then
    [[ -z $(conf_get '.reality.private') ]] && reality_keygen
  fi
  # 用到 VLESS 加密的协议需要一对 decryption/encryption
  if vlessenc_proto_on; then
    vless_enc_pair >/dev/null 2>&1 || warn "VLESS 加密密钥生成失败, 相关协议将退化为 encryption=none"
  fi

  if sb_proto_on; then
    install_singbox
    singbox_gen_config
    svc_restart sing-box && ok "sing-box (Hysteria2/TUIC/AnyTLS/Naive/SS2022/AnyReality)" || warn "sing-box 未启动"
  fi

  xray_gen_config
  if domain_proto_on; then
    nginx_main_conf; ssl_params_conf; nginx_web_conf
    nginx -t >/dev/null 2>&1 && systemctl restart nginx && ok "nginx" || warn "nginx 配置异常,请检查 nginx -t"
  fi
  svc_restart xray && ok "Xray" || { err "Xray 未启动"; journalctl -u xray -n 20 --no-pager; }

  gen_sub_all
  enable_autoupdate_ask
  printNode
  echo
  ok "安装完成!以上即全部节点信息(v2rayN 导入示例见上)。"
  ok "随时输入 shuoyue 打开管理菜单(一键脚本用户)或 bash server。"
}

updateGWD() {
  echo -e "${CYAN}=== 更新 de_GWD Remake ===${cRES}"
  conf_init
  any_proto || die "尚未安装,请先选择菜单 1"
  apt_baseline
  pkg_dep
  install_xray
  if domain_proto_on; then
    install_nginx
    install_doh
    svc_restart doh-server
    [[ -f $SSLDIR/de_GWD.cer ]] || { [[ $(conf_get '.port') == "443" ]] && make_ssl_webroot || make_ssl_cf; }
    nginx_main_conf; ssl_params_conf; nginx_web_conf
    systemctl restart nginx
  fi
  if sb_proto_on; then
    install_singbox --force
    singbox_gen_config
    svc_restart sing-box
  else
    systemctl stop sing-box >/dev/null 2>&1
    systemctl disable sing-box >/dev/null 2>&1
  fi
  svc_restart unbound
  xray_gen_config
  svc_restart xray
  svc_restart degwd-nftables 2>/dev/null
  /etc/rc_online.local 2>/dev/null
  gen_sub_all
  printNode
  ok "更新完成"
}


  else
    active_str="${RED}未运行 (inactive)${cRES}"
  fi

  echo
  echo -e "${CYAN}=====================================================${cRES}"
  echo -e "${WHITE}   朔月 Shuoyue — Web 控制面板完整地址与状态${cRES}"

cli_links() {
  conf_init
  local out='[]' line id name link nd
  # GEN_LINKS_TAGGED=1 -> gen_links 输出 "id|显示名|链接"
  while IFS='|' read -r id name link; do
    [[ -z $id || -z $link ]] && continue
    # 注意: 不能写 $(proto_needs_domain "$id" && echo true || echo false) ——
    # proto_needs_domain 自己会打印字段值(0/1), 于是命令替换拿到两行
    # "1\ntrue", 交给 --argjson 直接报 invalid JSON text, 整条链接被丢弃。
    # 必须先取值再比较。
    nd=false
    [[ $(proto_needs_domain "$id") == "1" ]] && nd=true
    out=$(printf '%s' "$out" | jq -c --arg id "$id" --arg n "$name" --arg l "$link" \
      --argjson p "$(proto_port "$id")" --argjson d "$nd" \
      '. + [{id:$id,name:$n,link:$l,port:$p,needs_domain:$d}]')
  done < <(GEN_LINKS_TAGGED=1 gen_links)
  jq -cn --argjson links "$out" '{ok:true, links:$links}'
}

cli_regen() {
  conf_init
  any_proto || { cli_json '{"ok":false,"error":"not installed"}'; return 1; }
  conf_raw '.uuids' "[\"$(xray_uuid_gen)\"]"
  conf_set '.path' "/$(uuid6 "$(conf_get '.uuids[0]')")"
  conf_set '.subtoken' "$(openssl rand -hex 8)"
  conf_raw '.vlessenc' '{}'
  apply_protos
  gen_sub_all
  cli_json '{"ok":true}'
}

cli_reset() {
  conf_init
  any_proto || { cli_json '{"ok":false,"error":"not installed"}'; return 1; }
  conf_raw '.uuids' "[\"$(xray_uuid_gen)\"]"
  conf_raw '.vlessenc' '{}'
  conf_raw '.ss2022key' '""'
  conf_raw '.reality' '{}'
  conf_set '.path' "/$(uuid6 "$(conf_get '.uuids[0]')")"
  conf_set '.subtoken' "$(openssl rand -hex 8)"
  if proto_on reality || proto_on realityxhttp || proto_on anyreality; then
    reality_keygen
  fi
  apply_protos
  gen_sub_all
  cli_json '{"ok":true}'
}

cli_protos() {
  conf_init
  local want="${1:-}" id out='{}'
  if [[ "$want" == "none" || "$want" == "clear" || -z "$want" ]]; then
    conf_raw '.protos' '{}'
    ( apply_protos ) 1>&2 || true
    gen_sub_all
    cli_json '{"ok":true,"message":"已卸载并停用所有协议"}'
    return 0
  fi
  for id in $want; do
    proto_valid "$id" || { cli_json "{\"ok\":false,\"error\":\"unknown proto: $id\"}"; return 1; }
    out=$(printf '%s' "$out" | jq -c --arg k "$id" '. + {($k):true}')
  done
  printf '%s' "$out" | jq -e 'length > 0' >/dev/null 2>&1 || { cli_json '{"ok":false,"error":"empty proto list"}'; return 1; }
  # UUID 缺失时先生成: tuic / vmess / vless 等协议的用户凭据都取自 .uuids[0],
  # 为空会生成一份内核直接拒绝加载的配置(sing-box: missing uuid for user 0;
  # xray: 空 id 的 clients 同样非法)。菜单安装流程会先跑 gen_uuid, 但 --cli 与
  # Web 面板可以只勾协议、从没走过安装流程, 所以这里必须自己兜底。
  [[ -n $(conf_get '.uuids[0]') ]] || { conf_raw '.uuids' "[\"$(xray_uuid_gen)\"]"; conf_set '.path' "/$(uuid6 "$(conf_get '.uuids[0]')")"; }
  # 需要域名的协议被勾选, 但还没装 nginx / 没证书 -> 先补齐
  # 注意 proto_needs_domain 自身会打印 0/1, 必须用 [[ ]] 比较, 不能 && echo true 追加一行
  local domain_want=0 sb_want=0 rl_want=0 i
  for i in $want; do
    [[ $(proto_needs_domain "$i") == "1" ]] && domain_want=1
    [[ $(proto_kernel "$i") == "singbox" ]] && sb_want=1
    case $i in reality|realityxhttp|anyreality) rl_want=1 ;; esac
  done
  if [[ $domain_want == 1 && -z $(conf_get '.domain') ]]; then
    cli_json '{"ok":false,"error":"所选协议需要域名, 请先在全局配置中填写域名并保存"}'; return 1
  fi

  # 事务性, 两重保险:
  # ① 前置步骤(装 nginx/DoH、签证书、拉 ~90 MB 内核) 全部放在写 .protos **之前**。
  #    这些步骤内部用 die -> exit 1, 而且耗时可能超过面板的 CLI 超时(180s)被直接
  #    杀掉 —— 只要还没写盘, 进程无论怎么死都不会留下「面板显示已勾选、配置却没
  #    生成」的半应用状态。m00453 要求「安装后 会生效」, 半应用状态正是它的反例。
  # ② 真正的应用链仍包在子 shell 里: die 只终结子 shell 并回传非 0, 不再像以前那样
  #    直接杀掉整个 --cli 进程(server 的 cli_dispatch 是直接调用, 非子 shell);
  #    失败再把 .protos 回滚回旧值并重建配置, 保持盘上配置与 conf 一致。
  local old_protos rc=0
  old_protos=$(conf_get '.protos // {}')
  # 子 shell 的 stdout 全部改走 stderr: --cli 的 stdout 只允许出现最终那一行 JSON,
  # 否则安装过程打印的进度文本会和 JSON 混在同一条流里, 面板解析不到。
  (
    if [[ $domain_want == 1 ]]; then
      install_nginx
      install_doh
      svc_restart doh-server
      [[ -f $SSLDIR/de_GWD.cer ]] || { [[ $(conf_get '.port') == "443" ]] && make_ssl_webroot || make_ssl_cf; }
      nginx_main_conf; ssl_params_conf
    fi
    if [[ $rl_want == 1 ]]; then
      [[ -n $(conf_get '.reality.private') ]] || reality_keygen
    fi
    if [[ $sb_want == 1 ]]; then install_singbox; fi
    # 前置条件都就绪了, 到这里才落盘选择(见上面 ① 的理由)
    conf_raw '.protos' "$out"
    apply_protos
    gen_sub_all
  ) 1>&2 || rc=$?
  if [[ $rc != 0 ]]; then
    # 回滚选择, 并把配置重建回旧选择对应的状态(否则盘上的配置与 conf 又会不一致)
    conf_raw '.protos' "$old_protos"
    ( apply_protos ) 1>&2 || true
    cli_json "{\"ok\":false,\"error\":\"apply failed\",\"code\":$rc}"
    return 1
  fi
  cli_json '{"ok":true}'
}

cli_cfg() {
  conf_init
  local j="$1" k v
  # 参数为 - 时从标准输入读取 JSON：避免复杂参数在命令行上被转义/改写
  if [[ $j == "-" ]]; then
    [[ -t 0 ]] && { cli_json '{"ok":false,"error":"cfg - 需要从标准输入提供 JSON"}'; return 1; }
    j=$(cat)
  fi
  printf '%s' "$j" | jq -e . >/dev/null 2>&1 || { cli_json '{"ok":false,"error":"invalid json"}'; return 1; }
  for k in domain uuid subtoken subid prefix name reality_sni reym reality_dest upip cfip cdn alns hyjpt cdnym warp ippz oap sub subpt argo agn agk; do
    v=$(printf '%s' "$j" | jq -r --arg k "$k" '.[$k] // empty')
    [[ -z $v ]] && continue
    case $k in
      domain)
        [[ "$v" =~ ^[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || { cli_json '{"ok":false,"error":"bad domain"}'; return 1; }
        conf_set '.domain' "${v%%:*}"
        [[ $v == *:* ]] && conf_set '.port' "${v##*:}"
        ;;
      uuid)
        [[ "$v" =~ ^[0-9a-fA-F-]{36}$ ]] || { cli_json '{"ok":false,"error":"bad uuid"}'; return 1; }
        conf_raw '.uuids' "[\"$v\"]"
        ;;
      subtoken|subid)
        [[ "$v" =~ ^[A-Za-z0-9._~-]{1,128}$ ]] || { cli_json '{"ok":false,"error":"bad subtoken"}'; return 1; }
        conf_set '.subtoken' "$v"
        ;;
      prefix|name)
        conf_set '.prefix' "$v"
        ;;
      reality_sni|reym)
        conf_set '.reality.sni' "$v"
        ;;
      reality_dest)
        conf_set '.reality.dest' "$v"
        ;;
      upip|cfip)
        [[ "$v" =~ ^[A-Za-z0-9.:\ -]+$ ]] || { cli_json '{"ok":false,"error":"bad upip"}'; return 1; }
        conf_set '.upip' "$v"
        ;;
      cdn)
        conf_set '.cdn' "$v"
        ;;
      alns)
        conf_set '.alns' "$v"
        ;;
      hyjpt)
        conf_set '.hyjpt' "$v"
        ;;
      cdnym)
        conf_set '.cdnym' "$v"
        ;;
      warp)
        warp_set_mode "$v" >&2 || true
        ;;
      ippz)
        conf_set '.ippz' "$v"
        ;;
      oap)
        conf_set '.oap' "$v"
        [[ "$v" == "y" ]] && open_all_ports >&2 || true
        ;;
      sub)
        if [[ $v == "y" || $v == "true" || $v == "on" ]]; then
          conf_raw '.sub_on' "true"
          conf_set '.sub' "y"
        else
          conf_raw '.sub_on' "false"
          conf_set '.sub' ""
        fi
        ;;
      subpt)
        if [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 1024 && v <= 65535 )); then
          conf_raw '.sub_port' "$v"
        fi
        ;;
      argo)
        conf_set '.argo.mode' "$v"
        if [[ $v == "on" || $v == "1" || $v == "y" ]]; then
          argo_start >&2 || true
        else
          argo_stop >&2 || true
        fi
        ;;
      agn)
        conf_set '.argo.domain' "$v"
        ;;
      agk)
        conf_set '.argo.token' "$v"
        if [[ $(conf_get '.argo.mode // "off"') =~ ^(on|1|y)$ ]]; then
          argo_start >&2 || true
        fi
        ;;
    esac
  done
  for k in port reality_port; do
    v=$(printf '%s' "$j" | jq -r --arg k "$k" '.[$k] // empty')
    [[ -z $v ]] && continue
    if [[ $k == port ]]; then
      service_port_valid "$v" || { cli_json "{\"ok\":false,\"error\":\"invalid port(需 443 或 1024-65535, 且不能占用内核内部端口)\"}"; return 1; }
      conf_set '.port' "$v"
    else
      port_valid "$v" || { cli_json '{"ok":false,"error":"invalid reality_port"}'; return 1; }
      conf_set '.reality.port' "$v"
    fi
  done
  local pports; pports=$(printf '%s' "$j" | jq -c '.proto_ports // empty')
  if [[ -n $pports && "$pports" != "null" ]]; then
    for pid in $(echo "$pports" | jq -r 'keys[]'); do
      local pval; pval=$(echo "$pports" | jq -r --arg k "$pid" '.[$k]')
      if [[ "$pval" =~ ^[0-9]+$ ]] && (( pval >= 1024 && pval <= 65535 )); then
        conf_raw ".proto_ports[\"$pid\"]" "$pval"
        [[ "$pid" == "reality" ]] && conf_raw '.reality.port' "$pval"
      fi
    done
  fi
  apply_protos
  gen_sub_all
  cli_json '{"ok":true}'
}

cli_dispatch() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    status)  cli_status ;;
    detect)  detect_proxy_servers_json ;;
    protos)  cli_protos "${1:-}" ;;
    links)   cli_links ;;
    regen)   cli_regen ;;
    reset)   cli_reset ;;
    cfg)     cli_cfg "${1:-}" ;;
    ports)
      conf_init
      local p_act="${1:-}"; shift || true
      case "$p_act" in
        randomize|rand)
          randomize_all_proto_ports >&2
          regen_all >&2
          cli_json "{\"ok\":true,\"protolist\":$(proto_table_json)}"
          ;;
        reset)
          reset_all_proto_ports >&2
          regen_all >&2
          cli_json "{\"ok\":true,\"protolist\":$(proto_table_json)}"
          ;;
        set)
          set_single_proto_port "${1:-}" "${2:-}" >&2 || return 1
          regen_all >&2
          cli_json "{\"ok\":true,\"protolist\":$(proto_table_json)}"
          ;;
        list|"")
          cli_json "{\"ok\":true,\"protolist\":$(proto_table_json)}"
          ;;
        *)
          cli_json '{"ok":false,"error":"未知 ports 操作，支持: randomize | reset | set <id> <port> | list"}'
          return 1
          ;;
      esac
      ;;
    warp)
      conf_init
      local w_act="${1:-}"; shift || true
      case "$w_act" in
        mode|set) warp_set_mode "${1:-warp_google}" ;;
        on)       warp_set_mode "${1:-warp_google}" ;;
        off)      warp_set_mode "direct" ;;
        test)     warp_test_unlock ;;
        regen)    warp_ensure_account 1 && warp_apply && cli_json '{"ok":true,"message":"WARP 账号已重置并生效"}' || cli_json '{"ok":false,"error":"WARP 账号重置失败"}' ;;
        status)   cli_json "$(warp_status_json 2>/dev/null || echo '{"ok":true}')" ;;
        *)        cli_json '{"ok":false,"error":"warp on|off|mode <m>|test|regen|status"}' ; return 1 ;;
      esac
      ;;
    cf_tunnel)
      conf_init
      local cf_act="${1:-}"; shift || true
      case "$cf_act" in
        status)   cloudflared_status_json ;;
        install)  install_cloudflared && cli_json '{"ok":true,"message":"cloudflared 安装成功"}' || cli_json '{"ok":false,"error":"安装失败"}' ;;
        token|set_token) cloudflared_set_token "${1:-}" ;;
        stop)     cloudflared_stop_service ;;
        start)    cloudflared_start_service ;;
        quick)    cloudflared_quick_tunnel "${1:-}" ;;
        *)        cli_json '{"ok":false,"error":"cf_tunnel status|install|token <tok>|stop|start|quick"}' ; return 1 ;;
      esac
      ;;
    sub)     conf_init; sub_toggle "${1:-on}" >/dev/null 2>&1; cli_json "{\"ok\":true,\"sub_on\":$(conf_get '.sub_on' | grep -q false && echo false || echo true)}" ;;
    suburl)  conf_init; local h; h=$(conf_get '.domain'); [[ -z $h ]] && h=$(wan_ip); printf 'https://%s/sub/%s\n' "$h" "$(conf_get '.subtoken')" ;;
    kill_tp) cli_kill_tp "${1:-}" ;;
    uninstall)
      local keep_p=0 purge_p=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --keep-panel) keep_p=1 ;;
          --purge-pkgs) purge_p=1 ;;
        esac
        shift
      done
      local u_args=(-f)
      [[ $keep_p -eq 1 ]] && u_args+=(--keep-panel)
      [[ $purge_p -eq 1 ]] && u_args+=(--purge-pkgs)
      uninstallGWD "${u_args[@]}" >&2
      cli_json '{"ok":true,"message":"卸载完成"}'
      ;;
    *)       cli_json '{"ok":false,"error":"unknown subcommand"}' ; return 1 ;;
  esac
}

# -------------------------------------------------------------------- 入口 ---
case "${1:-}" in
  --update)        updateGWD; exit 0 ;;
  --install)       installGWD; exit 0 ;;
  --install-cli)   cli_install_legacy; exit 0 ;;
  --uninstall|uninstall|del|-u)
                   shift; uninstallGWD "$@"; exit 0 ;;
  --version)       echo "$VERSION"; exit 0 ;;
  --detect|-d)     show_proxy_detection; exit 0 ;;
  --kill-tp)       shift; stop_or_uninstall_third_party "$@"; exit $? ;;
  --ports)         changePort; exit 0 ;;
  --random-ports)  randomize_all_proto_ports; regen_all; printNode; exit 0 ;;
  --warp)          cloudflare_menu; exit 0 ;;
  --warp-mode)     shift; warp_set_mode "${1:-warp_google}"; exit $? ;;
  --warp-test)     warp_test_interactive; exit 0 ;;
  --cloudflared)   cloudflared_menu; exit 0 ;;
  --panel-info)    show_panel_info; exit 0 ;;
  --panel-port)    shift; change_panel_port "${1:-}"; exit 0 ;;
  --panel)         panel_menu; exit 0 ;;
  --panel-install) shift; install_panel; exit 0 ;;
  --cli)           shift; NONINTERACTIVE=1; cli_dispatch "$@"; exit $? ;;
esac
if [[ "${BASH_SOURCE[0]}" == "${0}" ]] && is_tty; then
  start_menu
fi

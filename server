reality_menu() {
  conf_init
  any_proto || die "尚未安装"
  read -rsp "[1] 启用/重新生成 Reality  [2] 关闭 Reality: " -n1 a; echo
  case $a in
    1)
      reality_keygen
      xray_gen_config
      svc_restart xray
      gen_sub_all
      printNode
      ;;
    2)
      conf_raw '.protos' "$(conf_get '.protos // {}' | jq '.reality=false')"
      xray_gen_config
      svc_restart xray
      gen_sub_all
      ok "Reality 已关闭"
      ;;
  esac
}

protos_menu() {
  conf_init
  any_proto || die "尚未安装"
  echo "当前启用: $(conf_get '.protos // {}' | jq -r 'to_entries | map(select(.value==true) | .key) | join(", ")')"
  echo "输入要切换的协议编号(空格分隔, 回车=不变):"
  echo "  1 vmess  2 vless  3 trojan  4 trojantcp  5 reality"
  echo "  6 ss  7 hy2(Hysteria2)  8 tuic  9 anytls"
  local sel tok; sel=$(ask "切换: ")
  [[ -z $sel ]] && return
  local names=(vmess vless trojan trojantcp reality ss hy2 tuic anytls)
  for tok in $sel; do
    [[ "$tok" =~ ^[1-9]$ ]] || { warn "忽略: $tok"; continue; }
    local p=${names[$((tok-1))]}
    if proto_on "$p"; then
      conf_raw '.protos' "$(conf_get '.protos // {}' | jq --arg k "$p" '.[$k]=false')"
      ok "已关闭: $p"
    else
      conf_raw '.protos' "$(conf_get '.protos // {}' | jq --arg k "$p" '.[$k]=true')"
      ok "已开启: $p"
      if [[ $p == "reality" && -z $(conf_get '.reality.private') ]]; then
        reality_keygen
      fi
    fi
  done
  if sb_proto_on; then
    install_singbox
    singbox_gen_config
    svc_restart sing-box
  else
    systemctl stop sing-box >/dev/null 2>&1
    systemctl disable sing-box >/dev/null 2>&1
  fi
  xray_gen_config
  if domain_proto_on && [[ -f /etc/nginx/conf.d/default.conf ]]; then
    nginx_web_conf
    systemctl reload nginx 2>/dev/null
  fi
  svc_restart xray
  gen_sub_all
  printNode
}


# 生成 /etc/nginx/conf.d/default.conf (标记块幂等重建,保留用户自定义段)
# 生成 /etc/nginx/conf.d/default.conf (标记块幂等重建,保留用户自定义段)
# 按 .protos 启用情况生成 vmess/vless/trojan 的 WS 反代 location
nginx_web_conf() {
  local domain port u6 vmpath custom=""
  domain=$(conf_get '.domain'); port=$(conf_get '.port')
  u6=$(uuid6 "$(conf_get '.uuids[0]')")
  vmpath=$(conf_get '.path')

  # 保留用户自定义段(最后一段 V2_END 之后的原始内容)
  if [[ -f /etc/nginx/conf.d/default.conf ]] && grep -q '# V2_END' /etc/nginx/conf.d/default.conf; then
    custom=$(sed -n '/# V2_END/,$p' /etc/nginx/conf.d/default.conf | tail -n +2 | sed '$ d')
  fi

  local quic_enabled=0 altsvc=""
  if nginx -V 2>&1 | grep -q 'with-http_v3_module'; then
    quic_enabled=1
    altsvc='add_header Alt-Svc "h3=\":'"$port"'\";ma=86400" always;'
  fi
  # nginx >= 1.25 用 http2 on 指令, 旧版(如 Debian 1.22)用 listen http2
  local h2line="    http2 on;"
  local ngver; ngver=$(nginx -v 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)
  if [[ -z $ngver || $(printf '%s\n1.25.0\n' "$ngver" | sort -V | head -n1) != "1.25.0" ]]; then
    h2line=""
  fi

  {
    cat <<'EOF'
# SERVER_BASE_START
upstream xray_vmess {
    server 127.0.0.1:9890;
    keepalive 32;
}
upstream xray_vless {
    server 127.0.0.1:9891;
    keepalive 32;
}
upstream xray_trojan {
    server 127.0.0.1:9892;
    keepalive 32;
}
server {
    listen __PORT__ default_server ssl fastopen=500 reuseport;
EOF
    if [[ $quic_enabled == 1 ]]; then
      echo "    listen __PORT__ default_server quic reuseport;"
      echo "$h2line"
    else
      echo "$h2line"
    fi
    cat <<'EOF'
    server_name __DOMAIN__;
    root /var/www/html;
    index index.html index.htm;
    error_page 497 https://$host:__PORT__$request_uri;
    __ALTSVC__
    include /etc/nginx/conf.d/.HSTS;
    add_header Referrer-Policy "origin" always;
    include /etc/nginx/conf.d/.ssl_certs;

# DOH_START
    location = /dns-query {
        proxy_pass https://127.0.0.1:9853;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 60s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        add_header Cache-Control no-cache;
    }
# DOH_END
EOF
    if proto_on vmess; then
      cat <<'EOF'
# VMESS_START
    location __VMPATH__ {
        if ($http_upgrade != "websocket") { return 404; }
        proxy_pass http://xray_vmess;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade "websocket";
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 600s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        chunked_transfer_encoding off;
        proxy_buffering off;
        add_header Cache-Control no-cache;
    }
# VMESS_END
EOF
    fi
    if proto_on vless; then
      cat <<'EOF'
# VLESS_START
    location __VLPATH__ {
        if ($http_upgrade != "websocket") { return 404; }
        proxy_pass http://xray_vless;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade "websocket";
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 600s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        chunked_transfer_encoding off;
        proxy_buffering off;
        add_header Cache-Control no-cache;
    }
# VLESS_END
EOF
    fi
    if proto_on trojan; then
      cat <<'EOF'
# TROJAN_START
    location __TRPATH__ {
        if ($http_upgrade != "websocket") { return 404; }
        proxy_pass http://xray_trojan;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade "websocket";
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 600s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        chunked_transfer_encoding off;
        proxy_buffering off;
        add_header Cache-Control no-cache;
    }
# TROJAN_END
EOF
    fi
    echo "# V2_END"
    [[ -n $custom ]] && echo "$custom"
    echo "}"
  } > /etc/nginx/conf.d/default.conf

  sed -i "s|__PORT__|$port|g; s|__DOMAIN__|$domain|g; s|__VMPATH__|$vmpath|g; s|__VLPATH__|/v-$u6|g; s|__TRPATH__|/t-$u6|g" /etc/nginx/conf.d/default.conf
  sed -i "s|__ALTSVC__|$altsvc|" /etc/nginx/conf.d/default.conf

  if [[ $port == "443" ]]; then
    cat <<'EOF' >/etc/nginx/conf.d/80.conf
server {
    listen 80 default_server reuseport;
    server_name _;
    return 301 https://$host$request_uri;
}
EOF
  else
    rm -f /etc/nginx/conf.d/80.conf
  fi
}


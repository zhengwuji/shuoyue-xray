changePath() {
  conf_init
  proto_on vmess || die "vmess 未启用(WS path 仅 vmess 使用; vless/trojan 的路径由 UUID 派生)"
  local np; np=$(ask "输入新 WS path (回车=随机): ")
  [[ -z $np ]] && np="/$(uuid6 "$(conf_get '.uuids[0]')")"
  [[ "$np" != /* ]] && np="/$np"

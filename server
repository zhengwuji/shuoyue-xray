# ------------------------------------------------- HAProxy TCP 端口转发(多组) --
relay_gen() {
  local entries; entries=$(conf_get '.relay')
  if [[ -z $entries || $entries == "null" || $(echo "$entries" | jq 'length') -eq 0 ]]; then
    systemctl stop haproxy >/dev/null 2>&1; systemctl disable haproxy >/dev/null 2>&1
    return
  fi
  apt-get install -y -qq haproxy >/dev/null 2>&1
  {
    cat <<'EOF'
global
    ulimit-n 500000
    maxconn 200000
defaults
    mode tcp
    option dontlognull
    timeout connect 10s
    timeout client 1m
    timeout server 1m
    timeout check 10s
resolvers local
    nameserver dns1 127.0.0.1:53
    nameserver dns2 1.1.1.1:53
    nameserver dns3 8.8.8.8:53
    resolve_retries 3
    timeout retry 3s
    hold valid 10s
    accepted_payload_size 8192
EOF
    echo "$entries" | jq -c '.[]' | while read -r e; do
      local up port
      up=$(echo "$e" | jq -r '.upstream'); port=$(echo "$e" | jq -r '.port')
      cat <<EOF
frontend fwd_$port
    bind :$port
    default_backend be_$port
backend be_$port
    server endpoint $up check resolvers local init-addr none
EOF
    done
  } > /etc/haproxy/haproxy.cfg
  systemctl enable haproxy >/dev/null 2>&1
  systemctl restart haproxy >/dev/null 2>&1 && ok "HAProxy 转发生效" || err "HAProxy 启动失败(haproxy -c -f /etc/haproxy/haproxy.cfg 检查)"
}
changeTCPPF() {
  conf_init
  read -rsp "[1] 添加转发  [2] 删除一条  [3] 清空全部: " -n1 a; echo
  local entries
  entries=$(conf_get '.relay')
  [[ -z $entries || $entries == "null" ]] && entries="[]"
  case $a in
    1)
      local up port
      up=$(ask "上游地址(域名或IP:端口, 如 relay.example.com:443): ")
      [[ "$up" =~ ^[A-Za-z0-9.-]+:[0-9]+$ ]] || die "格式: host:port"
      port=$(ask "本地监听端口: ")
      port_valid "$port" || die "端口无效: 必须是 1-65535, 且不能是本方案保留端口(53/80/443/3000/8442-8446/9853/9890-9892/9896/51820)"
      local ssrelay=""
      ssrelay=$(ss -lntp 2>/dev/null || true)
      grep -q ":$port " <<<"$ssrelay" && die "端口 $port 已被占用"
      entries=$(echo "$entries" | jq --arg u "$up" --arg p "$port" '. + [{upstream:$u, port:($p|number)}]')
      conf_raw '.relay' "$entries"
      relay_gen
      ok "转发: 本机:$port -> $up"
      ;;
    2)
      echo "$entries" | jq -r 'to_entries[] | "\(.key): :\(.value.port) -> \(.value.upstream)"' | nl
      local i; i=$(ask "删除序号: ")
      entries=$(echo "$entries" | jq --argjson i "$i" 'del(.[ $i - 1 ])')
      conf_raw '.relay' "$entries"
      relay_gen
      ;;
    3)
      conf_raw '.relay' '[]'; relay_gen; ok "已清空"
      ;;
  esac
}


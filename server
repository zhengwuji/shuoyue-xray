# 从仓库拉 panel.py(多源回退 + 内容校验)
fetch_panel_py() {
  local dest="$1" url
  mkdir -p "$(dirname "$dest")"
  for url in "$REMOTE_BASE/panel.py" \
             "https://ghproxy.net/$REMOTE_BASE/panel.py" \
             "https://cdn.jsdelivr.net/gh/zhengwuji/shuoyue-xray@main/panel.py"; do
    curl -fsSL --max-time 60 -o "$dest" "$url" 2>/dev/null || continue
    [[ -s $dest ]] || continue
    grep -q '朔月\|de_GWD\|PANEL_TOKEN' "$dest" || continue
    python3 -m py_compile "$dest" >/dev/null 2>&1 || continue
    return 0
  done
  return 1
}

panel_unit_conf() {
  write_atomic /etc/systemd/system/degwd-panel.service 644 <<EOF
[Unit]
Description=Shuoyue de_GWD Web Panel
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$PANEL_DIR
Environment=DEGWD_BASE=$BASE
Environment=DEGWD_PANEL_BIND=$PANEL_BIND
Environment=DEGWD_PANEL_PORT=$PANEL_PORT
ExecStart=$(command -v python3) $PANEL_PY
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=$BASE /etc/nginx/conf.d /etc/systemd/system
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

# 把面板挂到 nginx: 直接重建 default.conf —— nginx_web_conf 会按
# conf .panel.path 自动插入 # PANEL_START 段(反代到 127.0.0.1:3000)
nginx_panel_conf() {
  local path; path=$(conf_get '.panel.path')
  [[ -z $path ]] && return 0
  [[ -f /etc/nginx/conf.d/default.conf ]] || return 0
  local bak; bak=$(mktemp /tmp/gwd-panel-nginx.XXXXXX) || return 1
  cp -a /etc/nginx/conf.d/default.conf "$bak" || { rm -f "$bak"; return 1; }
  nginx_web_conf
  if ! nginx -t >/dev/null 2>&1; then
    cp -a "$bak" /etc/nginx/conf.d/default.conf
    rm -f "$bak"
    warn "nginx 配置校验失败, 已回滚 default.conf"
    return 1
  fi
  rm -f "$bak"
  systemctl restart nginx >/dev/null 2>&1
  return 0
}

# 探测面板是否真的起来了(最多等 10 秒), 返回 0 表示 HTTP 有响应
panel_health_check() {
  local i
  for i in $(seq 1 20); do
    if curl -fsS --max-time 2 -o /dev/null \
         "http://127.0.0.1:$PANEL_PORT/$1/?t=$2" 2>/dev/null; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

install_panel() {
  echo -e "${CYAN}=== 安装 Web 面板 ===${cRES}"
  conf_init
  command -v python3 >/dev/null 2>&1 || {
    apt-get install -y -qq python3 >/dev/null 2>&1
    command -v python3 >/dev/null 2>&1 || die "python3 不可用, 无法安装面板"
  }
  mkdir -p "$PANEL_DIR"
  echo -n "下载 panel.py... "
  fetch_panel_py "$PANEL_PY" || die "panel.py 下载或语法校验失败"
  chmod 755 "$PANEL_PY"
  ok "OK"

  # 首次运行会生成并落盘 .panel.token / .panel.path
  local tok path
  tok=$(conf_get '.panel.token'); path=$(conf_get '.panel.path')
  if [[ -z $tok || -z $path ]]; then
    python3 - <<PYEOF
import json, os, secrets
conf = "$CONF"
d = {}
if os.path.exists(conf):
    try: d = json.load(open(conf, encoding="utf-8"))
    except Exception: d = {}
p = d.get("panel") if isinstance(d.get("panel"), dict) else {}
if not p.get("token"): p["token"] = secrets.token_urlsafe(24)
if not p.get("path"):  p["path"] = "".join(secrets.choice("abcdefghijklmnopqrstuvwxyz0123456789") for _ in range(10))
d["panel"] = p
tmp = conf + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh: json.dump(d, fh, ensure_ascii=False)
os.chmod(tmp, 0o600); os.replace(tmp, conf)
PYEOF
    tok=$(conf_get '.panel.token'); path=$(conf_get '.panel.path')
  fi
  [[ -n $tok && -n $path ]] || die "面板凭据生成失败"

  panel_unit_conf
  systemctl enable degwd-panel >/dev/null 2>&1
  svc_restart degwd-panel && ok "degwd-panel 已启动" || { err "面板启动失败"; journalctl -u degwd-panel -n 20 --no-pager; return 1; }

  # 真正验证面板能响应(而不是只看 systemd 状态), 否则"装完不生效"很难排查
  if panel_health_check "$path" "$tok"; then
    ok "面板本机自检通过 (127.0.0.1:$PANEL_PORT)"
  else
    err "面板无响应, 请检查: journalctl -u degwd-panel -n 50 --no-pager"
    return 1
  fi

  # 只有装了需要域名的协议(即已有 nginx 443 站点)才挂反代
  if domain_proto_on && [[ -f /etc/nginx/conf.d/default.conf ]]; then
    if nginx_panel_conf; then
      ok "面板已挂到 nginx (https://$(conf_get '.domain')/$path/)"
    else
      warn "写入面板反代失败, 面板仍可本机访问 127.0.0.1:$PANEL_PORT"
    fi
  else
    warn "当前无 nginx 站点, 面板仅本机可访问(127.0.0.1:$PANEL_PORT)"
  fi

  local host; host=$(conf_get '.domain')
  echo
  ok "面板安装完成"
  if [[ -n $host && -f /etc/nginx/conf.d/default.conf ]]; then
    echo -e "  面板地址: ${GREEN}https://$host/$path/?t=$tok${cRES}"
  else
    echo -e "  本机地址: ${GREEN}http://127.0.0.1:$PANEL_PORT/$path/?t=$tok${cRES}"
    echo "  (SSH 隧道: ssh -L 3000:127.0.0.1:3000 root@<服务器IP> 后访问上面地址)"
  fi
  echo "  重新查看: shuoyue --cli status | jq -r '.panel_path'"
  echo "  凭据存储: $CONF 的 .panel.token / .panel.path (chmod 600)"
}

uninstall_panel() {
  systemctl stop degwd-panel >/dev/null 2>&1
  systemctl disable degwd-panel >/dev/null 2>&1
  rm -f /etc/systemd/system/degwd-panel.service
  systemctl daemon-reload >/dev/null 2>&1
  rm -rf "$PANEL_DIR"
  if [[ -f /etc/nginx/conf.d/default.conf ]]; then
    sed -i '/^# PANEL_START$/,/^# PANEL_END$/d' /etc/nginx/conf.d/default.conf
  fi
  ok "Web 面板已移除"
}

# =============================================================== CLI (面板) ====
# 全部子命令输出单行 JSON, 供 panel.py 调用; 不打印任何交互提示
#   --cli status                 运行状态 + 协议元数据 + 当前配置
#   --cli protos "id1 id2 ..."   设置启用协议并立即生效
#   --cli links                  输出全部分享链接 (JSON 数组)
#   --cli regen                  重新生成密钥/path/subtoken 并生效
#   --cli reset                  重置全部密钥 (UUID / SS2022 / VLESS加密 / Reality)
#   --cli cfg '<json>'           写入面板可控的全局配置项
#   --cli suburl                 输出订阅地址
cli_json() { printf '%s\n' "$1"; }

cli_status() {
  conf_init
  local protos links_ready
  protos=$(conf_get '.protos // {}' | jq -c 'to_entries | map(select(.value==true) | .key)')
  local suburl=""
  local token; token=$(conf_get '.subtoken')
  local host; host=$(conf_get '.domain'); [[ -z $host ]] && host=$(wan_ip)
  [[ -n $token ]] && suburl="https://$host/sub/$token"
  # 带上 links: 面板加载时就能直接渲染分享链接区。否则首屏永远是「暂无链接」,
  # 用户必须先去点「重新拉取链接」才看得到东西 —— 而 cli_links 的输出本就是
  # 一份现成的结构化数据, 没有任何理由不顺手带上。
  local links; links=$(cli_links 2>/dev/null | jq -c '.links // []' 2>/dev/null)
  [[ -z $links ]] && links='[]'
  jq -cn \
    --arg version "$VERSION" \
    --arg domain "$(conf_get '.domain')" \
    --argjson port "$(conf_get '.port // 443')" \
    --arg uuid "$(conf_get '.uuids[0]')" \
    --arg path "$(conf_get '.path')" \
    --arg subtoken "$token" \
    --arg suburl "$suburl" \
    --arg panel_path "$(conf_get '.panel.path // ""')" \
    --argjson protos "$protos" \
    --argjson installed "$(any_proto && echo true || echo false)" \
    --argjson xray "$(svc_ok xray && echo true || echo false)" \
    --argjson nginx "$(svc_ok nginx && echo true || echo false)" \
    --argjson singbox "$(svc_ok sing-box && echo true || echo false)" \
    --argjson reality_ready "$([[ -n $(conf_get '.reality.public') ]] && echo true || echo false)" \
    --argjson warp "$([[ $(conf_get '.warp') == "true" ]] && echo true || echo false)" \
    --argjson sub_on "$([[ $(conf_get '.sub_on') == "false" ]] && echo false || echo true)" \
    --argjson protolist "$(proto_table_json)" \
    --argjson links "$links" \
    --argjson cfg "$(cli_cfg_json)" \
    '{version:$version, installed:$installed, domain:$domain, port:$port, uuid:$uuid,
      path:$path, subtoken:$subtoken, suburl:$suburl, panel_path:$panel_path,
      protos:$protos, protolist:$protolist, links:$links, cfg:$cfg, warp:$warp,
      sub_on:$sub_on, svc:{xray:$xray, nginx:$nginx, singbox:$singbox},
      reality_ready:$reality_ready}'
}

# 协议元数据 -> JSON 数组 (面板据此渲染勾选框)
proto_table_json() {
  local id name kern port dom desc out='[]'
  while IFS='|' read -r id name kern port dom desc; do
    [[ -z $id ]] && continue
    out=$(printf '%s' "$out" | jq -c --arg id "$id" --arg n "$name" --arg k "$kern" \
      --argjson p "$port" --argjson d "$dom" --arg ds "$desc" \
      '. + [{id:$id,name:$n,kernel:$k,port:$p,needs_domain:($d==1),desc:$ds}]')
  done <<< "$PROTO_TABLE"
  printf '%s\n' "$out"
}

# 面板可编辑的全局配置项
cli_cfg_json() {
  jq -cn \
    --arg uuid "$(conf_get '.uuids[0]')" \
    --arg prefix "$(conf_get '.prefix')" \
    --arg reality_sni "$(conf_get '.reality.sni')" \
    --arg reality_dest "$(conf_get '.reality.dest')" \
    --arg upip "$(conf_get '.upip')" \
    --arg cdns "$(conf_get '.cdn')" \
    --arg port "$(conf_get '.port')" \
    --arg rport "$(conf_get '.reality.port')" \
    '{uuid:$uuid, prefix:$prefix, reality_sni:$reality_sni, reality_dest:$reality_dest,
      reality_port:$rport, upip:$upip, cdn:$cdns, port:$port}'
}

cli_links() {
  conf_init
  local out='[]' line id name link nd
  # GEN_LINKS_TAGGED=1 -> gen_links 输出 "id|显示名|链接"
  while IFS='|' read -r id name link; do
    [[ -z $id || -z $link ]] && continue
    # 注意: 不能写 $(proto_needs_domain "$id" && echo true || echo false) ——
    # proto_needs_domain 自己会打印字段值(0/1), 于是命令替换拿到两行
    # "1\ntrue", 交给 --argjson 直接报 invalid JSON text, 整条链接被丢弃。
    # 必须先取值再比较。
    nd=false
    [[ $(proto_needs_domain "$id") == "1" ]] && nd=true
    out=$(printf '%s' "$out" | jq -c --arg id "$id" --arg n "$name" --arg l "$link" \
      --argjson p "$(proto_port "$id")" --argjson d "$nd" \
      '. + [{id:$id,name:$n,link:$l,port:$p,needs_domain:$d}]')
  done < <(GEN_LINKS_TAGGED=1 gen_links)
  jq -cn --argjson links "$out" '{ok:true, links:$links}'
}

cli_regen() {
  conf_init
  any_proto || { cli_json '{"ok":false,"error":"not installed"}'; return 1; }
  conf_raw '.uuids' "[\"$(xray_uuid_gen)\"]"
  conf_set '.path' "/$(uuid6 "$(conf_get '.uuids[0]')")"
  conf_set '.subtoken' "$(openssl rand -hex 8)"
  conf_raw '.vlessenc' '{}'
  apply_protos
  gen_sub_all
  cli_json '{"ok":true}'
}

cli_reset() {
  conf_init
  any_proto || { cli_json '{"ok":false,"error":"not installed"}'; return 1; }
  conf_raw '.uuids' "[\"$(xray_uuid_gen)\"]"
  conf_raw '.vlessenc' '{}'
  conf_raw '.ss2022key' '""'
  conf_raw '.reality' '{}'
  conf_set '.path' "/$(uuid6 "$(conf_get '.uuids[0]')")"
  conf_set '.subtoken' "$(openssl rand -hex 8)"
  if proto_on reality || proto_on realityxhttp || proto_on anyreality; then
    reality_keygen
  fi
  apply_protos
  gen_sub_all
  cli_json '{"ok":true}'
}

cli_protos() {
  conf_init
  local want="$1" id out='{}'
  for id in $want; do
    proto_valid "$id" || { cli_json "{\"ok\":false,\"error\":\"unknown proto: $id\"}"; return 1; }
    out=$(printf '%s' "$out" | jq -c --arg k "$id" '. + {($k):true}')
  done
  printf '%s' "$out" | jq -e 'length > 0' >/dev/null 2>&1 || { cli_json '{"ok":false,"error":"empty proto list"}'; return 1; }
  # UUID 缺失时先生成: tuic / vmess / vless 等协议的用户凭据都取自 .uuids[0],
  # 为空会生成一份内核直接拒绝加载的配置(sing-box: missing uuid for user 0;
  # xray: 空 id 的 clients 同样非法)。菜单安装流程会先跑 gen_uuid, 但 --cli 与
  # Web 面板可以只勾协议、从没走过安装流程, 所以这里必须自己兜底。
  [[ -n $(conf_get '.uuids[0]') ]] || { conf_raw '.uuids' "[\"$(xray_uuid_gen)\"]"; conf_set '.path' "/$(uuid6 "$(conf_get '.uuids[0]')")"; }
  # 需要域名的协议被勾选, 但还没装 nginx / 没证书 -> 先补齐
  # 注意 proto_needs_domain 自身会打印 0/1, 必须用 [[ ]] 比较, 不能 && echo true 追加一行
  local domain_want=0 sb_want=0 rl_want=0 i
  for i in $want; do
    [[ $(proto_needs_domain "$i") == "1" ]] && domain_want=1
    [[ $(proto_kernel "$i") == "singbox" ]] && sb_want=1
    case $i in reality|realityxhttp|anyreality) rl_want=1 ;; esac
  done
  if [[ $domain_want == 1 && -z $(conf_get '.domain') ]]; then
    cli_json '{"ok":false,"error":"domain required for selected protos"}'; return 1
  fi

  # 事务性, 两重保险:
  # ① 前置步骤(装 nginx/DoH、签证书、拉 ~90 MB 内核) 全部放在写 .protos **之前**。
  #    这些步骤内部用 die -> exit 1, 而且耗时可能超过面板的 CLI 超时(180s)被直接
  #    杀掉 —— 只要还没写盘, 进程无论怎么死都不会留下「面板显示已勾选、配置却没
  #    生成」的半应用状态。m00453 要求「安装后 会生效」, 半应用状态正是它的反例。
  # ② 真正的应用链仍包在子 shell 里: die 只终结子 shell 并回传非 0, 不再像以前那样
  #    直接杀掉整个 --cli 进程(server 的 cli_dispatch 是直接调用, 非子 shell);
  #    失败再把 .protos 回滚回旧值并重建配置, 保持盘上配置与 conf 一致。
  local old_protos rc=0
  old_protos=$(conf_get '.protos // {}')
  # 子 shell 的 stdout 全部改走 stderr: --cli 的 stdout 只允许出现最终那一行 JSON,
  # 否则安装过程打印的进度文本会和 JSON 混在同一条流里, 面板解析不到。
  (
    if [[ $domain_want == 1 ]]; then
      install_nginx
      install_doh
      svc_restart doh-server
      [[ -f $SSLDIR/de_GWD.cer ]] || { [[ $(conf_get '.port') == "443" ]] && make_ssl_webroot || make_ssl_cf; }
      nginx_main_conf; ssl_params_conf
    fi
    if [[ $rl_want == 1 ]]; then
      [[ -n $(conf_get '.reality.private') ]] || reality_keygen
    fi
    if [[ $sb_want == 1 ]]; then install_singbox; fi
    # 前置条件都就绪了, 到这里才落盘选择(见上面 ① 的理由)
    conf_raw '.protos' "$out"
    apply_protos
    gen_sub_all
  ) 1>&2 || rc=$?
  if [[ $rc != 0 ]]; then
    # 回滚选择, 并把配置重建回旧选择对应的状态(否则盘上的配置与 conf 又会不一致)
    conf_raw '.protos' "$old_protos"
    ( apply_protos ) 1>&2 || true
    cli_json "{\"ok\":false,\"error\":\"apply failed\",\"code\":$rc}"
    return 1
  fi
  cli_json '{"ok":true}'
}

cli_cfg() {
  conf_init
  local j="$1" k v
  # 参数为 - 时从标准输入读取 JSON：避免复杂参数在命令行上被转义/改写
  if [[ $j == "-" ]]; then
    [[ -t 0 ]] && { cli_json '{"ok":false,"error":"cfg - 需要从标准输入提供 JSON"}'; return 1; }
    j=$(cat)
  fi
  printf '%s' "$j" | jq -e . >/dev/null 2>&1 || { cli_json '{"ok":false,"error":"invalid json"}'; return 1; }
  for k in domain uuid subtoken prefix reality_sni reality_dest upip cdn; do
    v=$(printf '%s' "$j" | jq -r --arg k "$k" '.[$k] // empty')
    [[ -z $v ]] && continue
    case $k in
      domain)
        [[ "$v" =~ ^[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || { cli_json '{"ok":false,"error":"bad domain"}'; return 1; }
        conf_set '.domain' "${v%%:*}"
        [[ $v == *:* ]] && conf_set '.port' "${v##*:}"
        ;;
      uuid)
        [[ "$v" =~ ^[0-9a-fA-F-]{36}$ ]] || { cli_json '{"ok":false,"error":"bad uuid"}'; return 1; }
        conf_raw '.uuids' "[\"$v\"]"
        ;;
      subtoken)
        [[ "$v" =~ ^[A-Za-z0-9._~-]{1,128}$ ]] || { cli_json '{"ok":false,"error":"bad subtoken"}'; return 1; }
        conf_set '.subtoken' "$v"
        ;;
      prefix)
        conf_set '.prefix' "$v"
        ;;
      reality_sni)
        conf_set '.reality.sni' "$v"
        ;;
      reality_dest)
        conf_set '.reality.dest' "$v"
        ;;
      upip)
        [[ "$v" =~ ^[A-Za-z0-9.:-]+$ ]] || { cli_json '{"ok":false,"error":"bad upip"}'; return 1; }
        conf_set '.upip' "$v"
        ;;
      cdn)
        conf_set '.cdn' "$v"
        ;;
    esac
  done
  for k in port reality_port; do
    v=$(printf '%s' "$j" | jq -r --arg k "$k" '.[$k] // empty')
    [[ -z $v ]] && continue
    if [[ $k == port ]]; then
      service_port_valid "$v" || { cli_json "{\"ok\":false,\"error\":\"invalid port(需 443 或 1024-65535, 且不能占用内核内部端口)\"}"; return 1; }
      conf_set '.port' "$v"
    else
      port_valid "$v" || { cli_json '{"ok":false,"error":"invalid reality_port"}'; return 1; }
      conf_set '.reality.port' "$v"
    fi
  done
  apply_protos
  gen_sub_all
  cli_json '{"ok":true}'
}

cli_dispatch() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    status)  cli_status ;;
    protos)  cli_protos "${1:-}" ;;
    links)   cli_links ;;
    regen)   cli_regen ;;
    reset)   cli_reset ;;
    cfg)     cli_cfg "${1:-}" ;;
    warp)    conf_init; case "${1:-}" in on) warp_enable || { cli_json '{"ok":false,"error":"warp enable failed"}'; return 1; };; off) warp_disable;; *) cli_json '{"ok":false,"error":"warp on|off"}'; return 1;; esac; cli_json '{"ok":true}' ;;
    sub)     conf_init; sub_toggle "${1:-on}" >/dev/null 2>&1; cli_json "{\"ok\":true,\"sub_on\":$(conf_get '.sub_on' | grep -q false && echo false || echo true)}" ;;
    suburl)  conf_init; local h; h=$(conf_get '.domain'); [[ -z $h ]] && h=$(wan_ip); printf 'https://%s/sub/%s\n' "$h" "$(conf_get '.subtoken')" ;;
    *)       cli_json '{"ok":false,"error":"unknown subcommand"}' ; return 1 ;;
  esac
}

# -------------------------------------------------------------------- 入口 ---
case "${1:-}" in
  --update)   updateGWD; exit 0 ;;
  --install)  installGWD; exit 0 ;;
  --version)  echo "$VERSION"; exit 0 ;;
  --cli)      shift; NONINTERACTIVE=1; cli_dispatch "$@"; exit $? ;;
  --panel-install) shift; install_panel; exit 0 ;;
esac
start_menu

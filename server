pkg_dep() {
  local need="" p
  for p in sudo wget curl git jq bc qrencode socat cron ca-certificates \
           gnupg unzip dnsutils net-tools nftables chrony ethtool screen \
           libmimalloc2.0 resolvconf unbound; do
    dpkg -s "$p" >/dev/null 2>&1 || need="$need $p"
  done
  # irqbalance 多核有益
  [[ $(nproc --all) -gt 1 ]] && ! dpkg -s irqbalance >/dev/null 2>&1 && need="$need irqbalance"
  if [[ -n $need ]]; then
    apt-get update -qq
    if ! apt-get install -y -qq $need; then
      # 旧发行版可能缺个别包: 逐个尝试, 缺的跳过不中断
      local failed="" p2
      warn "批量安装失败, 逐个尝试(旧系统可能缺少个别包)..."
      for p2 in $need; do
        apt-get install -y -qq "$p2" >/dev/null 2>&1 || failed="$failed $p2"
      done
      [[ -n $failed ]] && warn "以下包不可用已跳过:${failed}"
    fi
  fi
  for p in ipset haveged systemd-timesyncd os-prober subversion; do
    dpkg -s "$p" >/dev/null 2>&1 && apt-get remove --purge -y "$p" >/dev/null 2>&1
  done
}


# 修改 Web 控制面板端口
change_panel_port() {
  conf_init
  local cur_port np
  cur_port=$(panel_port)
  echo
  echo -e "${CYAN}=== 修改 Web 控制面板端口 ===${cRES}"
  echo -e "当前面板端口: ${YELLOW}$cur_port${cRES}"
  if [[ -n "${1:-}" ]]; then
    np="$1"
  else
    np=$(ask "请输入新的面板端口 (1024-65535, 直接回车则随机生成): ")
  fi
  if [[ -z $np ]]; then
    np=$(panel_rand_port)
    ok "已随机生成端口: $np"
  fi

  [[ "$np" =~ ^[0-9]+$ ]] || { warn "端口必须是纯数字"; return 1; }
  (( np >= 1024 && np <= 65535 )) || { warn "端口范围必须在 1024 - 65535 之间"; return 1; }
  [[ $RESERVED_PORTS == *" $np "* ]] && { warn "端口 $np 是系统/代理协议保留端口，请换一个"; return 1; }

  local existing_port rport
  existing_port=$(conf_get '.port')
  if [[ -n $existing_port && "$existing_port" == "$np" ]]; then
    warn "端口 $np 已被当前业务服务 (Nginx) 占用，请换一个"; return 1
  fi
  rport=$(conf_get '.reality.port')
  if [[ -n $rport && "$rport" == "$np" ]]; then
    warn "端口 $np 已被 Reality 服务占用，请换一个"; return 1
  fi

  if command -v ss >/dev/null 2>&1; then
    local ssout2=""
    ssout2=$(ss -tln 2>/dev/null || true)
    if grep -qE ":$np\s" <<<"$ssout2"; then
      local pids
      pids=$(lsof -ti :$np 2>/dev/null || true)
      local pstatus=""
      pstatus=$(systemctl status degwd-panel 2>/dev/null || true)
      if [[ -n $pids ]] && ! grep -q "$pids" <<<"$pstatus"; then
        warn "端口 $np 已被其他系统进程占用，请换一个"; return 1
      fi
    fi
  fi

  ok "更新面板端口为 $np..."
  conf_set '.panel.port' "$np"

  panel_unit_conf
  svc_restart degwd-panel && ok "degwd-panel 已重启生效" || warn "degwd-panel 重启异常"

  if ufw_active; then
    ufw allow "$np/tcp" >/dev/null 2>&1 && ok "ufw 已放行 $np/tcp"
    if [[ "$cur_port" != "$np" && "$cur_port" != "3000" ]]; then
      ufw delete allow "$cur_port/tcp" >/dev/null 2>&1 || true
    fi
  fi

  if domain_proto_on && [[ -f /etc/nginx/conf.d/default.conf ]]; then
    nginx_panel_conf && ok "Nginx 反向代理配置已同步更新" || warn "Nginx 反代配置更新失败"
  fi

  local path tok
  path=$(conf_get '.panel.path')
  tok=$(conf_get '.panel.token')
  if panel_health_check "$path" "$tok"; then
    ok "面板健康检查通过 (127.0.0.1:$np)"
  else
    warn "面板在新端口未及时响应，请检查: journalctl -u degwd-panel -n 30 --no-pager"
  fi

  show_panel_info
}

# 重置面板安全 Token 与随机路径
reset_panel_secrets() {
  read -rsp "确认重新生成面板 Token 与访问路径? 旧地址将无法访问 [y/N]: " -n1 c; echo
  [[ "$c" =~ ^[Yy] ]] || { ok "已取消"; return 0; }
  python3 - <<PYEOF
import json, os, secrets
conf = "$CONF"
d = {}
if os.path.exists(conf):
    try: d = json.load(open(conf, encoding="utf-8"))
    except Exception: d = {}
p = d.get("panel") if isinstance(d.get("panel"), dict) else {}
p["token"] = secrets.token_urlsafe(24)
p["path"] = "".join(secrets.choice("abcdefghijklmnopqrstuvwxyz0123456789") for _ in range(10))
d["panel"] = p
tmp = conf + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh: json.dump(d, fh, ensure_ascii=False)
os.chmod(tmp, 0o600); os.replace(tmp, conf)
PYEOF
  svc_restart degwd-panel
  if domain_proto_on && [[ -f /etc/nginx/conf.d/default.conf ]]; then
    nginx_panel_conf
  fi
  ok "面板凭据已重新生成！"
  show_panel_info
}

# Web 面板控制台
panel_menu() {
  conf_init
  local tok; tok=$(conf_get '.panel.token')
  if [[ -z $tok ]]; then
    echo
    echo -e "${YELLOW}尚未安装 Web 面板。${cRES}"
    read -rsp "是否立即安装 Web 控制面板? [Y/n]: " a; echo
    [[ "$a" =~ ^[Nn] ]] && return 0
    install_panel
    return $?
  fi

  while :; do
    show_panel_info
    echo "--- Web 面板管理选项 ---"
    echo "  [1] 修改 Web GUI 监听端口"
    echo "  [2] 重启 Web 面板服务"
    echo "  [3] 重新生成安全 Token 与访问路径 (旧链接立即失效)"
    echo "  [4] 重新部署 / 修复 Web 面板组件"
    echo "  [q] 返回主菜单"
    echo
    read -rp "请选择 [1-4, q 退出]: " opt
    case $opt in
      1) change_panel_port ;;
      2)
        svc_restart degwd-panel && ok "degwd-panel 已重启" || err "重启失败"
        ;;
      3)
        reset_panel_secrets
        ;;
      4)
        install_panel
        ;;
      [Qq]|"")
        break
        ;;
      *)
        warn "无效输入"
        ;;
    esac
  done
}

# -------------------------------------------------- 服务端组件与运行环境自动检测 ---
# 自动扫描系统内已安装的 v2rayN 支持的核心服务端二进制(Xray/V2Ray/Singbox/Hysteria/TUIC/SS/Trojan/Cloudflared等)
# 以及当前正在运行的代理进程、配置文件、监听端口，输出结构化 JSON，供终端/Web 面板消费
detect_proxy_servers_json() {
  local binaries='[]' running='[]'
  local bins=(
    "Xray-core|xray|xray version"
    "V2Ray-core|v2ray|v2ray version"
    "Sing-box|sing-box|sing-box version"
    "Hysteria2|hysteria|hysteria version"
    "Hysteria2|hy2|hy2 version"
    "TUIC-server|tuic-server|tuic-server -v"
    "Shadowsocks|ssserver|ssserver --version"
    "Shadowsocks|ss-server|ss-server -h"
    "Trojan-Go|trojan-go|trojan-go -v"
    "Trojan|trojan|trojan -v"
    "NaiveProxy|naive|naive --version"
    "Cloudflared|cloudflared|cloudflared --version"
    "Snell-server|snell-server|snell-server -v"
    "Juicity|juicity-server|juicity-server version"
    "Nginx|nginx|nginx -v"
    "Caddy|caddy|caddy version"
    "HAProxy|haproxy|haproxy -v"
  )

  local seen_names=" "
  local item bname bcmd bver_cmd bpath bver
  for item in "${bins[@]}"; do
    IFS='|' read -r bname bcmd bver_cmd <<< "$item"
    [[ "$seen_names" == *" $bname "* ]] && continue
    bpath=$(command -v "$bcmd" 2>/dev/null || true)
    [[ -z $bpath && -x "/usr/local/bin/$bcmd" ]] && bpath="/usr/local/bin/$bcmd"
    [[ -z $bpath && -x "/usr/bin/$bcmd" ]] && bpath="/usr/bin/$bcmd"
    [[ -z $bpath && -x "/opt/$bcmd/$bcmd" ]] && bpath="/opt/$bcmd/$bcmd"
    if [[ -n $bpath && -x $bpath ]]; then
      seen_names="$seen_names$bname "
      bver=$($bver_cmd 2>&1 | head -n2 | grep -oE 'v?[0-9]+(\.[0-9]+)+(-[a-zA-Z0-9.]+)?' | head -n1 || true)
      [[ -z $bver ]] && bver="已安装"
      binaries=$(printf '%s' "$binaries" | jq -c \
        --arg n "$bname" --arg p "$bpath" --arg v "$bver" \
        '. + [{name:$n, path:$p, version:$v, installed:true}]')
    fi
  done

  # 端口映射 PID -> 端口列表 (兼容 mawk / gawk / nawk / busybox)
  local port_map=""
  if command -v ss >/dev/null 2>&1; then
    port_map=$(ss -tulpn -H 2>/dev/null | awk '{
      proto = $1
      n = split($5, a, ":")
      port = a[n]
      if (match($0, /pid=[0-9]+/)) {
        pid = substr($0, RSTART + 4, RLENGTH - 4)
        print pid, port "/" proto
      }
    }' | sort -u)
  fi

  # 扫描代理进程
  local p_out
  p_out=$(ps -eo pid,user,args 2>/dev/null | grep -E 'xray|v2ray|sing-box|hysteria|hy2|tuic|trojan|ssserver|ss-server|shadowsocks|naive|cloudflared|snell|juicity' | grep -vE 'grep|panel\.py|python|degwd-panel|bash.*server|detect_test' || true)

  local degwd_count=0 third_count=0
  while read -r pid u cmd; do
    [[ -z $pid || ! "$pid" =~ ^[0-9]+$ ]] && continue

    local sname="未知代理"
    case "$cmd" in
      *xray*)        sname="Xray-core" ;;
      *v2ray*)       sname="V2Ray-core" ;;
      *sing-box*)    sname="Sing-box" ;;
      *hysteria*|*hy2*) sname="Hysteria2" ;;
      *tuic*)        sname="TUIC" ;;
      *trojan*)      sname="Trojan" ;;
      *ssserver*|*shadowsocks*|*ss-server*) sname="Shadowsocks" ;;
      *naive*)       sname="NaiveProxy" ;;
      *cloudflared*) sname="Cloudflared" ;;
      *snell*)       sname="Snell" ;;
      *juicity*)     sname="Juicity" ;;
    esac

    local real_exe=""
    if [[ -d "/proc/$pid" ]]; then
      real_exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
    fi

    # 如果有该进程的二进制但上面未扫出(如位于 /root/ 或 /opt/ 自定义目录), 补入 binaries
    if [[ -n $real_exe && "$seen_names" != *" $sname "* ]]; then
      seen_names="$seen_names$sname "
      local bver="运行中"
      binaries=$(printf '%s' "$binaries" | jq -c \
        --arg n "$sname" --arg p "$real_exe" --arg v "$bver" \
        '. + [{name:$n, path:$p, version:$v, installed:true, custom_path:true}]')
    fi

    local conf=""
    if [[ "$cmd" =~ (-c|-config|--config)[[:space:]]+([^[:space:]]+) ]]; then
      conf="${BASH_REMATCH[2]}"
    fi

    local is_degwd=false
    if [[ "$cmd" == *"/opt/de_GWD"* || "$conf" == *"/opt/de_GWD"* || "$conf" == *"/usr/local/etc/xray"* || "$cmd" == *"/usr/local/bin/xray"* ]]; then
      is_degwd=true
      ((degwd_count++)) || true
    else
      ((third_count++)) || true
    fi

    local p_ports=""
    if [[ -n $port_map ]]; then
      p_ports=$(awk -v p="$pid" '$1==p {print $2}' <<< "$port_map" | tr '\n' ',' | sed 's/,$//; s/,/, /g')
    fi

    local links='[]'
    if [[ "$is_degwd" != "true" ]]; then
      local py_cmd=""
      if [[ -f "$PANEL_PY" ]]; then
        py_cmd="$PANEL_PY"
      elif [[ -f "$(dirname "$0")/panel.py" ]]; then
        py_cmd="$(dirname "$0")/panel.py"
      elif [[ -f "$BASE/panel.py" ]]; then
        py_cmd="$BASE/panel.py"
      fi
      if [[ -n $py_cmd ]] && command -v python3 >/dev/null 2>&1; then
        links=$(python3 "$py_cmd" --extract-links "$conf" "$real_exe" "$pid" 2>/dev/null || echo '[]')
        [[ -z $links || "$links" != \[*\] ]] && links='[]'
      fi
    fi

    running=$(printf '%s' "$running" | jq -c \
      --arg pid "$pid" --arg u "$u" --arg n "$sname" --arg c "$cmd" \
      --arg exe "$real_exe" --arg cfg "$conf" --arg ports "$p_ports" --argjson degwd "$is_degwd" \
      --argjson links "$links" \
      '. + [{pid:$pid, user:$u, name:$n, exe:$exe, cmd:$c, config:$cfg, ports:$ports, is_degwd:$degwd, links:$links}]')
  done <<< "$p_out"

  local total_bins total_run
  total_bins=$(printf '%s' "$binaries" | jq 'length')
  total_run=$(printf '%s' "$running" | jq 'length')

  jq -cn --argjson bins "$binaries" --argjson run "$running" \
    --argjson t_bins "$total_bins" --argjson t_run "$total_run" \
    --argjson d_run "$degwd_count" --argjson o_run "$third_count" \
    '{
      binaries: $bins,
      running: $run,
      summary: {
        total_installed: $t_bins,
        total_running: $t_run,
        degwd_running: $d_run,
        third_party_running: $o_run,
        has_third_party: ($o_run > 0)
      }
    }'
}

show_proxy_detection() {
  local raw
  raw=$(detect_proxy_servers_json 2>/dev/null || true)
  [[ -z $raw ]] && { warn "检测服务端环境失败"; return 1; }
  echo
  echo -e "${CYAN}=====================================================${cRES}"
  echo -e "${WHITE}       当前服务器代理服务端与环境自动检测报告       ${cRES}"
  echo -e "${CYAN}=====================================================${cRES}"
  echo
  echo -e "${WHITE}[已安装服务端核心 / 工具]${cRES}"
  local bcount; bcount=$(echo "$raw" | jq '.binaries | length')
  if [[ $bcount -eq 0 ]]; then
    echo -e "  ${GREY}暂未检测到标准代理核心二进制${cRES}"
  else
    local i bname bpath bver bcustom
    for ((i=0; i<bcount; i++)); do
      bname=$(echo "$raw" | jq -r ".binaries[$i].name")
      bpath=$(echo "$raw" | jq -r ".binaries[$i].path")
      bver=$(echo "$raw" | jq -r ".binaries[$i].version")
      bcustom=$(echo "$raw" | jq -r ".binaries[$i].custom_path // false")
      if [[ "$bcustom" == "true" ]]; then
        printf "  ${GREEN}✓${cRES} ${WHITE}%-14s${cRES} : ${YELLOW}%s${cRES} (%s) [自定义/运行中]\n" "$bname" "$bver" "$bpath"
      else
        printf "  ${GREEN}✓${cRES} ${WHITE}%-14s${cRES} : ${GREEN}%s${cRES} (%s)\n" "$bname" "$bver" "$bpath"
      fi
    done
  fi
  echo
  echo -e "${WHITE}[运行中的代理进程与监听端口]${cRES}"
  local pcount; pcount=$(echo "$raw" | jq '.running | length')
  if [[ $pcount -eq 0 ]]; then
    echo -e "  ${GREY}当前无运行中的代理服务进程${cRES}"
  else
    local j pid user name exe cfg ports is_degwd tag
    for ((j=0; j<pcount; j++)); do
      pid=$(echo "$raw" | jq -r ".running[$j].pid")
      user=$(echo "$raw" | jq -r ".running[$j].user")
      name=$(echo "$raw" | jq -r ".running[$j].name")
      cfg=$(echo "$raw" | jq -r ".running[$j].config // empty")
      ports=$(echo "$raw" | jq -r ".running[$j].ports // empty")
      is_degwd=$(echo "$raw" | jq -r ".running[$j].is_degwd")
      if [[ "$is_degwd" == "true" ]]; then
        tag="${GREEN}[本系统托管]${cRES}"
      else
        tag="${YELLOW}[⚠️ 第三方/已有脚本]${cRES}"
      fi
      echo -e "  ${WHITE}$((j+1)).${cRES} $tag ${WHITE}${name}${cRES} (PID: ${CYAN}${pid}${cRES}, 用户: ${user})"
      [[ -n $ports ]] && echo -e "     监听端口: ${PURPLE}${ports}${cRES}"
      [[ -n $cfg ]] && echo -e "     配置文件: ${cfg}"
      if [[ "$is_degwd" != "true" ]]; then
        local lcount; lcount=$(echo "$raw" | jq ".running[$j].links | length // 0")
        if (( lcount > 0 )); then
          echo -e "     ${CYAN}提取到的原 v2rayN 链接:${cRES}"
          local k lk
          for ((k=0; k<lcount; k++)); do
            lk=$(echo "$raw" | jq -r ".running[$j].links[$k]")
            echo -e "       ${GREEN}●${cRES} ${WHITE}${lk}${cRES}"
          done
        fi
        echo -e "     ${YELLOW}👉 释放端口或卸载: 运行 bash server --kill-tp stop ${pid} (或 uninstall) / 亦可在 Web 面板一键操作${cRES}"
      fi
    done
  fi
  echo
  local t_bins t_run d_run o_run
  t_bins=$(echo "$raw" | jq -r '.summary.total_installed // 0')
  t_run=$(echo "$raw" | jq -r '.summary.total_running // 0')
  d_run=$(echo "$raw" | jq -r '.summary.degwd_running // 0')
  o_run=$(echo "$raw" | jq -r '.summary.third_party_running // 0')
  echo -e "${WHITE}[检测统计]${cRES} 已检出核心: ${GREEN}${t_bins}${cRES} 个 | 运行中进程: ${GREEN}${t_run}${cRES} 个 (系统托管: ${d_run}, 外部已有: ${o_run})"
  if (( o_run > 0 )); then
    echo -e "  ${YELLOW}⚠️ 提示: 检测到服务器上正在运行外部已有代理进程并占用了端口。${cRES}"
    echo -e "     配置本系统协议时系统会自动检测避开冲突端口，亦可点击一键停止/卸载以释放原端口。"
  fi
  echo -e "${CYAN}=====================================================${cRES}"
  echo
}

# ------------------------------------------------ 外部第三方代理一键停止 / 卸载 ---
stop_or_uninstall_third_party() {
  local action="${1:-stop}"
  local target_pid="${2:-}"
  local target_name="${3:-}"
  local target_exe="${4:-}"
  local target_conf="${5:-}"

  # 如果是 JSON 格式传参 (如 cli_kill_tp 转发)
  if [[ "$action" =~ ^\{.*\}$ ]]; then
    local json="$action"
    action=$(echo "$json" | jq -r '.action // "stop"')
    target_pid=$(echo "$json" | jq -r '.pid // ""')
    target_name=$(echo "$json" | jq -r '.name // ""')
    target_exe=$(echo "$json" | jq -r '.exe // ""')
    target_conf=$(echo "$json" | jq -r '.config // ""')
  fi

  [[ -z $target_pid || ! "$target_pid" =~ ^[0-9]+$ ]] && {
    cli_json '{"ok":false,"error":"无效的 PID"}'
    return 1
  }

  # 安全防御保护：绝对禁止停止或误删系统核心服务、面板自身
  if [[ "$target_exe" == *"/opt/de_GWD"* || ("$target_exe" == *"python"* && "$target_conf" == *"panel.py"*) ]]; then
    cli_json '{"ok":false,"error":"不能终止系统自身的面板管理进程"}'
    return 1
  fi
  if [[ "$target_pid" -eq 1 || "$target_exe" == *"/sbin/init"* || "$target_exe" == *"sshd"* ]]; then
    cli_json '{"ok":false,"error":"受系统保护的关键系统服务不可终止"}'
    return 1
  fi

  # 1. 查找是否存在 systemd 单元管理此进程
  local svc_found=""
  if [[ -f "/proc/$target_pid/cgroup" ]]; then
    svc_found=$(grep -oE '[a-zA-Z0-9@_-]+\.service' "/proc/$target_pid/cgroup" | head -n1 || true)
  fi
  if [[ -z $svc_found && -n $target_exe ]]; then
    local bname; bname=$(basename "$target_exe")
    svc_found=$(grep -l -E "ExecStart=.*$bname" /etc/systemd/system/*.service 2>/dev/null | head -n1 | xargs -r basename 2>/dev/null || true)
  fi

  # 2. 若存在 systemd 单元，执行 stop（若卸载则 disable 并清理 unit）
  if [[ -n $svc_found ]]; then
    systemctl stop "$svc_found" >/dev/null 2>&1 || true
    if [[ "$action" == "uninstall" ]]; then
      systemctl disable "$svc_found" >/dev/null 2>&1 || true
      rm -f "/etc/systemd/system/$svc_found" "/etc/systemd/system/multi-user.target.wants/$svc_found" 2>/dev/null || true
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
  fi

  # 3. 确保进程退出并释放端口
  if [[ -d "/proc/$target_pid" ]]; then
    kill -15 "$target_pid" >/dev/null 2>&1 || true
    sleep 0.3
    if [[ -d "/proc/$target_pid" ]]; then
      kill -9 "$target_pid" >/dev/null 2>&1 || true
    fi
  fi

  # 4. 彻底卸载时的文件安全清理 (严格防误删)
  local cleaned_files='[]'
  if [[ "$action" == "uninstall" ]]; then
    local pdir=""
    if [[ -n $target_conf && -f $target_conf ]]; then
      pdir=$(dirname "$target_conf")
    elif [[ -n $target_exe && -f $target_exe ]]; then
      pdir=$(dirname "$target_exe")
    fi

    if [[ -n $pdir && -d $pdir ]]; then
      pdir=$(readlink -f "$pdir" 2>/dev/null || echo "$pdir")
      case "$pdir" in
        /|/root|/root/|/usr|/usr/bin|/usr/local|/usr/local/bin|/etc|/var|/opt|/tmp|/home)
          # 顶级或系统目录：绝不删除整目录！仅删除特定二进制与配置
          if [[ -n $target_exe && -f $target_exe && "$target_exe" != *"/opt/de_GWD"* ]]; then
            rm -f "$target_exe" 2>/dev/null || true
            cleaned_files=$(printf '%s' "$cleaned_files" | jq -c --arg f "$target_exe" '. + [$f]')
          fi
          if [[ -n $target_conf && -f $target_conf && "$target_conf" != *"/opt/de_GWD"* ]]; then
            rm -f "$target_conf" 2>/dev/null || true
            cleaned_files=$(printf '%s' "$cleaned_files" | jq -c --arg f "$target_conf" '. + [$f]')
          fi
          ;;
        *)
          # 专属自定义子目录 (如 /root/agsbx, /etc/xray 等)
          if [[ "$pdir" =~ ^/(root|opt|etc|var|usr/local)/[a-zA-Z0-9._-]+$ && "$pdir" != *"/opt/de_GWD"* ]]; then
            rm -rf "$pdir" 2>/dev/null || true
            cleaned_files=$(printf '%s' "$cleaned_files" | jq -c --arg f "$pdir" '. + [$f]')
          fi
          ;;
      esac
    fi
  fi

  local msg
  if [[ "$action" == "uninstall" ]]; then
    msg="已停止服务并彻底清理相关文件 (PID: $target_pid)"
  else
    msg="已停止外部进程并释放其占用的端口 (PID: $target_pid)"
  fi
  jq -cn --arg act "$action" --argjson pid "$target_pid" --arg msg "$msg" \
         --arg svc "$svc_found" --argjson files "$cleaned_files" \
    '{ok:true, action:$act, pid:$pid, service:$svc, cleaned:$files, message:$msg}'
}


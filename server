# ------------------------------------------------- Xray 密钥解析 (兼容多版本) ---
# Xray 二进制定位: 官方安装器落在 /usr/local/bin/xray, 但容器/自定义安装可能在
# /usr/bin/xray。写死路径会导致密钥生成整段失败, 故统一走这里。
xray_bin() {
  if [[ -x /usr/local/bin/xray ]]; then printf '%s' /usr/local/bin/xray
  elif command -v xray >/dev/null 2>&1; then command -v xray
  else printf '%s' /usr/local/bin/xray; fi
}
# Xray <=24 输出:  "Private key: xxx" / "Public key: xxx"
# Xray >=25 输出:  "PrivateKey: xxx" / "Password (PublicKey): xxx" / "Hash32: xxx"
# 两种都解析, 避免升级 Xray 后 reality_keygen 直接 die
xray_x25519_keygen() {   # 输出: "<private> <public>"
  local out priv pub
  out=$($(xray_bin) x25519 2>/dev/null) || return 1
  priv=$(printf '%s\n' "$out" | awk -F': *' '/^[[:space:]]*(Private key|PrivateKey)/{print $2; exit}' | tr -d ')')
  pub=$(printf '%s\n' "$out" | awk -F': *' '/(Public key|PublicKey)/{print $2; exit}' | tr -d ')')
  [[ -z $priv || -z $pub ]] && return 1
  printf '%s %s\n' "$priv" "$pub"
}

# VLESS Encryption (Xray >= 25): 生成服务端 decryption 与客户端 encryption 串
# 返回 JSON: {"decryption":"mlkem768x25519plus...","encryption":"mlkem768x25519plus..."}
vless_enc_keygen() {
  local out dec enc
  out=$($(xray_bin) vlessenc 2>/dev/null) || return 1
  # 取 ML-KEM-768(后量子) 那一组的 600s decryption / 0rtt encryption
  dec=$(printf '%s\n' "$out" | grep -oE '"decryption":[[:space:]]*"[^"]+"' | head -n1 | sed 's/.*"\([^"]*\)"$/\1/')
  enc=$(printf '%s\n' "$out" | grep -oE '"encryption":[[:space:]]*"[^"]+"' | head -n1 | sed 's/.*"\([^"]*\)"$/\1/')
  [[ -z $dec || -z $enc ]] && return 1
  jq -cn --arg d "$dec" --arg e "$enc" '{decryption:$d, encryption:$e}'
}
# 已存的 VLESS 加密密钥(缺失则生成并落盘 conf.json), 输出 "<decryption> <encryption>"
vless_enc_pair() {
  local dec enc
  dec=$(conf_get '.vlessenc.decryption'); enc=$(conf_get '.vlessenc.encryption')
  if [[ -z $dec || -z $enc ]]; then
    local j; j=$(vless_enc_keygen) || return 1
    conf_raw '.vlessenc' "$j"
    dec=$(conf_get '.vlessenc.decryption'); enc=$(conf_get '.vlessenc.encryption')
  fi
  [[ -z $dec || -z $enc ]] && return 1
  printf '%s %s\n' "$dec" "$enc"
}
# sing-box 侧 REALITY 密钥(xray x25519 的 private 可直接用于 sing-box)
sb_reality_pair() {
  local priv pub
  priv=$(conf_get '.reality.private'); pub=$(conf_get '.reality.public')
  if [[ -z $priv || -z $pub ]]; then
    read -r priv pub <<< "$(xray_x25519_keygen)" || return 1
    local sid dest sni
    sid=$(openssl rand -hex 8)
    dest="www.microsoft.com:443"; sni="${dest%%:*}"
    conf_raw '.reality' "{\"enable\":true,\"port\":8443,\"private\":\"$priv\",\"public\":\"$pub\",\"shortid\":\"$sid\",\"dest\":\"$dest\",\"sni\":\"$sni\"}"
  fi
  [[ -z $priv || -z $pub ]] && return 1
  printf '%s %s\n' "$priv" "$pub"
}

# Shadowsocks 2022 密钥 (2022-blake3-aes-128-gcm 需要 16 字节 base64)
# 旧的 chacha20-ietf-poly1305 直接用 uuid 当口令, 这里升级为真正的 SS2022 密钥
ss2022_key() {
  local k; k=$(conf_get '.ss2022key')
  if [[ -z $k ]]; then
    k=$(openssl rand -base64 16) || return 1
    k=${k//$'\n'/}
    conf_set '.ss2022key' "$k"
  fi
  printf '%s\n' "$k"
}
# SOCKS5 用户名(uuid 前 8 位)
socks5_user() { conf_get '.uuids[0]' | cut -c1-8; }

# 物理网卡(继承原版判据: realpath 落在 /sys/devices 下且非 virtual/ifb)
detect_nic() {
  find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \
    | grep 'device' | grep -v 'virtual' | grep -v 'ifb' | awk -F'/' '{print$NF}' | head -n1
}
local_ip() {
  local nic; nic=$(detect_nic); [[ -z $nic ]] && return
  ip -4 a show "$nic" 2>/dev/null | grep -Po 'inet \K\d{1,3}(\.\d{1,3}){3}' | head -n1
}
wan_ip() { curl -4fsS --max-time 8 whatismyip.akamai.com 2>/dev/null || curl -4fsS --max-time 8 ifconfig.me 2>/dev/null; }

svc_ok() { systemctl is-active "$1" >/dev/null 2>&1; }
# 重启服务;容器/受限环境不支持 Nice= 时自动去除后重试(继承原版兜底模式)
svc_restart() {
  local s="$1"
  systemctl daemon-reload >/dev/null 2>&1
  systemctl restart "$s" >/dev/null 2>&1
  if ! svc_ok "$s"; then
    local u="/etc/systemd/system/$s.service" d
    grep -q '^Nice=' "$u" 2>/dev/null || return 1
    # 不再 sed -i 改磁盘 unit(会永久删掉 Nice= 且不可恢复)
    # 改用 /run 下的临时 drop-in 覆盖,重启后自动消失
    d="/run/systemd/system/$s.service.d"
    mkdir -p "$d" || return 1
    printf '[Service]\nNice=0\n' >"$d/10-degwd-nice.conf"
    systemctl daemon-reload
    systemctl restart "$s" >/dev/null 2>&1
  fi
  svc_ok "$s"
}

# ------------------------------------------------------- conf.json storage ---
conf_init() {
  mkdir -p "$BASE" "$BASE/.repo" "$XRAYDIR"
  [[ -f $CONF ]] && return
  echo '{}' > "$CONF"; chmod 600 "$CONF"
}
conf_get() { [[ -f $CONF ]] && jq -r "$1 // empty" "$CONF" 2>/dev/null; }

# 带 flock + 原子替换的配置写入; 值一律经文件交给 jq, 不出现在 argv。
# 原实现把值拼进 jq 命令行(--argjson v "..."), 私钥/uuid/订阅 token/SS2022 密钥
# 都能被同机任意用户用 `ps aux` 读到; 且固定临时名 ${CONF}.tmp 在 cron 与菜单
# 并发时会互相截断。这里与 client 的 conf_write 保持一致。
conf_write() {   # $1=jq 表达式, 其余为传给 jq 的参数
  local expr="$1"; shift
  local t; t=$(mktemp "${CONF}.XXXXXX") || return 1
  if command -v flock >/dev/null 2>&1; then
    (
      flock -x 9 || exit 1
      jq "$@" "$expr" "$CONF" > "$t" || exit 1
      chmod 600 "$t" && mv -f "$t" "$CONF"
    ) 9>"${CONF}.lock"
  else
    (
      jq "$@" "$expr" "$CONF" > "$t" || exit 1
      chmod 600 "$t" && mv -f "$t" "$CONF"
    )
  fi
  local rc=$?
  rm -f "$t"
  return $rc
}
# 字符串写入: conf_set .domain "a.com"
conf_set() {   # $1=路径 $2=字符串值
  local valf; valf=$(mktemp "$BASE/.val.XXXXXX") || return 1
  printf '%s' "$2" > "$valf"; chmod 600 "$valf"
  conf_write "$1 = \$v" --rawfile v "$valf"
  local rc=$?; rm -f "$valf"; return $rc
}
# 原始 JSON 写入: conf_raw '.relay' '[{...}]'
conf_raw() {   # $1=路径 $2=单个 JSON 值
  local compact cf
  compact=$(printf '%s' "$2" | jq -c . 2>/dev/null) || return 1
  cf=$(mktemp "$BASE/.raw.XXXXXX") || return 1
  printf '%s' "$compact" > "$cf"; chmod 600 "$cf"
  conf_write "$1 = \$c[0]" --slurpfile c "$cf"
  local rc=$?; rm -f "$cf"; return $rc
}

# ------------------------------------------------ GitHub release downloader ---
# 用法: fetch_release <owner/repo> <asset_regex> <dest_file>
# 通过 GitHub API 解析 latest release 资产;若仓库提供 checksums.txt 则校验 sha256
fetch_release() {
  local repo="$1" pattern="$2" dest="$3"
  local api json url name tmpdir
  api="https://api.github.com/repos/$repo/releases/latest"
  json=$(curl -fsSL --max-time 30 "$api" 2>/dev/null) || return 1
  # 不用 jq 的正则内建: OpenWrt 的 jq 常以 --without-oniguruma 编译, 一调用就报
  # "jq was compiled without ONIGURUMA regex library"。
  # 改为把 "name<TAB>url" 交给 awk 做 ERE 匹配, 语义等价且到处都能跑。
  url=$(printf '%s' "$json" \
        | jq -r '.assets[]? | "\(.name)\t\(.browser_download_url)"' 2>/dev/null \
        | awk -F'\t' -v re="$pattern" '$2 ~ /^https:\/\// && $1 ~ re { print $2; exit }')
  [[ -z $url ]] && return 1
  name="${url##*/}"
  # 下载落到 mktemp 目录,避免上游文件名含 / 或 .. 造成越界写
  tmpdir=$(mktemp -d /tmp/gwd-dl.XXXXXX) || return 1
  curl -fsSL --max-time 300 -o "$tmpdir/$name" "$url" || { rm -rf "$tmpdir"; return 1; }

  local sums sumurl
  sumurl=$(echo "$json" | jq -r '.assets[] | select(.name=="checksums.txt" or .name=="sha256sums.txt") | .browser_download_url' | head -n1)
  if [[ -n $sumurl ]]; then
    sums=$(curl -fsSL --max-time 30 "$sumurl" 2>/dev/null)
    # 只接受精确匹配的文件名(原 index($0,n) 模糊匹配可能命中别的文件哈希)
    local want; want=$(echo "$sums" | awk -v n="$name" '$2==n{print$1}' | head -n1)
    if [[ -n $want ]]; then
      local got; got=$(sha256sum "$tmpdir/$name" | awk '{print$1}')
      [[ "$got" != "$want" ]] && { rm -rf "$tmpdir"; return 1; }
    else
      warn "未校验: $name 不在上游 checksums 清单中(仅凭 HTTPS 传输)"
    fi
  else
    warn "未校验: $repo 未提供 checksums.txt/sha256sums.txt"
  fi
  mv -f "$tmpdir/$name" "$dest"
  rmdir "$tmpdir" 2>/dev/null
  return 0
}

# ====================================================== 系统基线 (preInstall) ==
swap_on() {
  [[ $(systemctl is-active swap.target 2>/dev/null) == "active" ]] && return
  systemctl unmask swap.target >/dev/null 2>&1; systemctl start swap.target >/dev/null 2>&1
  [[ $(free -m | awk 'NR==3{print$2}') != "0" ]] && return
  if [[ $(df -T / | awk '{print$2}' | tail -n1) == "btrfs" ]]; then
    btrfs subvolume create /swap 2>/dev/null
    btrfs filesystem mkswapfile --size 1g --uuid clear /swap/swapfile 2>/dev/null && swapon /swap/swapfile
    grep -q '/swap/swapfile' /etc/fstab || echo "/swap/swapfile none swap defaults 0 0" >>/etc/fstab
  else
    fallocate -l 1G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=1024 status=none
    chmod 600 /swapfile; mkswap -U clear /swapfile >/dev/null; swapon /swapfile
    grep -q '/swapfile' /etc/fstab || echo "/swapfile none swap defaults 0 0" >>/etc/fstab
  fi
  echo "RESUME=" >/etc/initramfs-tools/conf.d/resume 2>/dev/null
}

tcpTime() {
  # 不引用定界符(<<EOF) => 写入时即展开 $BASE, 无需事后 sed 字面替换
  cat <<EOF >"$BASE/tcpTime"
d=\$(wget -qSO- --max-redirect=0 whatismyip.akamai.com 2>&1 | grep '^  Date:' | cut -d' ' -f5-8)
[[ -z \$d ]] && d=\$(curl -sI --max-time 8 cloudflare.com | grep -i '^date:' | cut -d' ' -f2-)
[[ -n \$d ]] && date -s "\$d" >/dev/null 2>&1 && hwclock -w
EOF
  chmod +x "$BASE/tcpTime"
}

limits_conf() {
  sed -i '/ulimit -SHn/d;/HISTCONTROL=/d;/alias reboot=/d' /etc/profile
  cat <<'EOF' >>/etc/profile
ulimit -SHn 1000000
HISTCONTROL=ignoredups
alias reboot="systemctl reboot"
EOF
  grep -q 'pam_limits.so' /etc/pam.d/common-session || echo -e "session required\tpam_limits.so" >>/etc/pam.d/common-session
  # 不再整体覆盖 /etc/security/limits.conf(会抹掉用户已有调优), 改用 limits.d drop-in
  mkdir -p /etc/security/limits.d
  cat <<'EOF' >/etc/security/limits.d/99-degwd.conf
root     soft  nofile  1000000
root     hard  nofile  1000000
root     soft  nproc   1000000
root     hard  nproc   1000000
www-data soft  nofile  1000000
www-data hard  nofile  1000000
www-data soft  nproc   1000000
www-data hard  nproc   1000000
*        soft  nofile  1000000
*        hard  nofile  1000000
EOF
  sed -i '/DefaultLimitCORE/d;/DefaultLimitNOFILE/d;/DefaultLimitNPROC/d' /etc/systemd/system.conf
  cat <<'EOF' >>/etc/systemd/system.conf
# DefaultLimitCORE 留空: 无限制 core 会写出巨大 dump, 且对服务性能无帮助
DefaultLimitNOFILE=1000000
DefaultLimitNPROC=1000000
EOF
  systemctl daemon-reload
}

pkg_dep() {
  local need="" p
  # 只装真正用到的包。已删除:
  #   socat/screen  —— 全文无任何调用(实测计数为 1, 即只出现在本列表)
  #   resolvconf    —— 会接管 /etc/resolv.conf, 与本脚本手写的
  #                    nameserver 127.0.0.1(unbound) 冲突
  #   dnsutils      —— 无 dig/host/nslookup 调用(用 unbound-host 代替)
  #   net-tools     —— 无 ifconfig/netstat/route 调用(全用 iproute2 的 ip)
  #   git/bc/sudo/unzip —— 全文无调用
  # 补: unbound-anchor / unbound-host 在 Debian 是**独立的二进制包**,
  #     unbound 包自 bookworm 起已不再 Depends 它俩 → 不装则 DNSSEC
  #     信任锚生成与校验(server 里的 unbound-anchor / unbound-host 调用)静默失败
  for p in wget curl jq qrencode cron ca-certificates \
           gnupg nftables chrony ethtool unbound unbound-anchor unbound-host; do
    dpkg -s "$p" >/dev/null 2>&1 || need="$need $p"
  done
  # mimalloc 包名随 Debian 版本变化: bookworm=libmimalloc2.0, trixie+=libmimalloc3
  local mi codename=""
  codename=$(. /etc/os-release 2>/dev/null; echo "${VERSION_CODENAME:-}")
  case "$codename" in
    bookworm|bullseye) mi=libmimalloc2.0 ;;
    trixie|forky|sid)  mi=libmimalloc3 ;;
    *)                 mi="" ;;   # 未知版本交给 apt 兜底, 不硬编码
  esac
  if [[ -n $mi ]] && ! dpkg -s "$mi" >/dev/null 2>&1; then
    need="$need $mi"
  fi
  # irqbalance 多核有益
  [[ $(nproc --all) -gt 1 ]] && ! dpkg -s irqbalance >/dev/null 2>&1 && need="$need irqbalance"
  if [[ -n $need ]]; then
    apt-get update -qq
    if ! apt-get install -y -qq $need; then
      # 旧发行版可能缺个别包: 逐个尝试, 缺的跳过不中断
      local failed="" p2
      warn "批量安装失败, 逐个尝试(旧系统可能缺少个别包)..."
      for p2 in $need; do
        apt-get install -y -qq "$p2" >/dev/null 2>&1 || failed="$failed $p2"
      done
      [[ -n $failed ]] && warn "以下包不可用已跳过:${failed}"
    fi
  fi
  # 不再 --purge 卸载用户机器上已有组件(可能另有用途), 仅提示
  local gone=""
  for p in ipset haveged systemd-timesyncd os-prober subversion; do
    dpkg -s "$p" >/dev/null 2>&1 && gone="$gone $p"
  done
  [[ -n $gone ]] && warn "检测到以下包与本方案功能重叠, 未做任何改动(如需可自行处理):${gone}"
  return 0
}


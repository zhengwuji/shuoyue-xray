protos_menu() {
  conf_init
  any_proto || die "尚未安装"
  echo "当前启用: $(conf_get '.protos // {}' | jq -r 'to_entries | map(select(.value==true) | .key) | join(", ")')"
  echo "输入要切换的协议编号(空格/逗号分隔, 回车=不变):"
  protos_print_menu
  local sel tok id
  sel=$(ask "切换: "); sel=${sel//,/ }
  [[ -z $sel ]] && return
  for tok in $sel; do
    [[ "$tok" =~ ^[0-9]+$ ]] || { warn "忽略: $tok"; continue; }
    id=$(printf '%s\n' "$PROTO_TABLE" | sed -n "${tok}p" | cut -d'|' -f1)
    [[ -z $id ]] && { warn "编号越界: $tok"; continue; }
    if proto_on "$id"; then
      conf_raw '.protos' "$(conf_get '.protos // {}' | jq --arg k "$id" '.[$k]=false')"
      ok "已关闭: $id"
    else
      conf_raw '.protos' "$(conf_get '.protos // {}' | jq --arg k "$id" '.[$k]=true')"
      ok "已开启: $id"
      if [[ $id == reality || $id == realityxhttp || $id == anyreality ]] && [[ -z $(conf_get '.reality.private') ]]; then
        reality_keygen
      fi
    fi
  done
  apply_protos
  gen_sub_all
  printNode
}

# 协议变更后统一生效: 重生成配置 + 重启内核 + 重载 nginx (供菜单/--cli/面板共用)
apply_protos() {
  if sb_proto_on; then
    install_singbox
    singbox_gen_config
    svc_restart sing-box
  else
    systemctl stop sing-box >/dev/null 2>&1
    systemctl disable sing-box >/dev/null 2>&1
  fi
  xray_gen_config
  if domain_proto_on && [[ -f /etc/nginx/conf.d/default.conf ]]; then
    # 与其他路径统一用 restart; 先用 nginx -t 校验, 失败则回滚 default.conf 并中止
    local _ngbak=""
    _ngbak=$(mktemp /tmp/gwd-nginx-conf.XXXXXX) && cp -a /etc/nginx/conf.d/default.conf "$_ngbak"
    nginx_web_conf
    if ! nginx -t >/dev/null 2>&1; then
      [[ -n $_ngbak && -s $_ngbak ]] && cp -a "$_ngbak" /etc/nginx/conf.d/default.conf
      [[ -n $_ngbak ]] && rm -f "$_ngbak"
      die "nginx 配置校验失败, 已回滚 /etc/nginx/conf.d/default.conf (请运行 nginx -t 查看详情)"
    fi
    [[ -n $_ngbak ]] && rm -f "$_ngbak"
    systemctl restart nginx >/dev/null 2>&1
  fi
  svc_restart xray
  if [[ $(conf_get '.argo.mode // "off"') =~ ^(on|1|y)$ ]]; then
    argo_start >&2 || true
  fi
  return 0
}

# =============================================================== Web 面板 ====
# 单文件 Python3 标准库面板(panel.py), 监听 0.0.0.0 (支持 DEGWD_PANEL_BIND 覆盖)
# 默认端口随机生成并落盘于 conf .panel.port, 可通过菜单自由修改与查询
PANEL_DIR="$BASE/panel"
PANEL_PY="$PANEL_DIR/panel.py"
PANEL_BIND="${DEGWD_PANEL_BIND:-0.0.0.0}"

# 产生 10000 - 60000 间随机未占用的端口(规避保留端口与正在监听的端口)
panel_rand_port() {
  if command -v python3 >/dev/null 2>&1; then
    python3 - <<'PYEOF'
import random, socket
reserved = {53, 80, 443, 1080, 3000, 8388, 8442, 8443, 8444, 8445, 8446, 8447, 8448, 8449, 8450, 8451, 8452, 9853, 9890, 9891, 9892, 9893, 9894, 9895, 9896, 51820}
found = None
for _ in range(100):
    p = random.randint(10000, 60000)
    if p in reserved:
        continue
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(("0.0.0.0", p))
            found = p
            break
    except Exception:
        continue
print(found or random.randint(20000, 50000))
PYEOF
  else
    shuf -i 10000-60000 -n 1 2>/dev/null || awk 'BEGIN{srand(); print int(rand()*(60000-10000)+10000)}'
  fi
}

# 获取当前面板端口; 若未设置则自动随机分配并落盘
panel_port() {
  local p
  p=$(conf_get '.panel.port')
  if [[ -n $p && $p =~ ^[0-9]+$ ]] && (( p >= 1 && p <= 65535 )); then
    echo "$p"
    return 0
  fi
  if [[ -n ${DEGWD_PANEL_PORT:-} && $DEGWD_PANEL_PORT =~ ^[0-9]+$ ]] && (( DEGWD_PANEL_PORT >= 1 && DEGWD_PANEL_PORT <= 65535 )); then
    echo "$DEGWD_PANEL_PORT"
    return 0
  fi
  p=$(panel_rand_port)
  conf_set '.panel.port' "$p" 2>/dev/null || true
  echo "$p"
}

# 从仓库拉 panel.py(多源回退 + 内容校验)
fetch_panel_py() {
  local dest="$1" url
  mkdir -p "$(dirname "$dest")"
  if [[ -f "$BASE/panel.py" && "$BASE/panel.py" != "$dest" ]]; then
    cp -a "$BASE/panel.py" "$dest" && chmod 755 "$dest" && return 0
  fi
  for url in "$REMOTE_BASE/panel.py" \
             "https://ghproxy.net/$REMOTE_BASE/panel.py" \
             "https://cdn.jsdelivr.net/gh/zhengwuji/shuoyue-xray@main/panel.py"; do
    curl -fsSL --max-time 60 -o "$dest" "$url" 2>/dev/null || continue
    [[ -s $dest ]] || continue
    grep -q '朔月\|de_GWD\|PANEL_TOKEN' "$dest" || continue
    python3 -m py_compile "$dest" >/dev/null 2>&1 || continue
    return 0
  done
  return 1
}

panel_unit_conf() {
  local pport; pport=$(panel_port)
  write_atomic /etc/systemd/system/degwd-panel.service 644 <<EOF
[Unit]
Description=Shuoyue de_GWD Web Panel
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$PANEL_DIR
Environment=DEGWD_BASE=$BASE
Environment=DEGWD_PANEL_BIND=$PANEL_BIND
Environment=DEGWD_PANEL_PORT=$pport
ExecStart=$(command -v python3) $PANEL_PY
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

# 把面板挂到 nginx: 直接重建 default.conf —— nginx_web_conf 会按
# conf .panel.path 自动插入 # PANEL_START 段(反代到 127.0.0.1:<pport>)
nginx_panel_conf() {
  local path; path=$(conf_get '.panel.path')
  [[ -z $path ]] && return 0
  [[ -f /etc/nginx/conf.d/default.conf ]] || return 0
  local bak; bak=$(mktemp /tmp/gwd-panel-nginx.XXXXXX) || return 1
  cp -a /etc/nginx/conf.d/default.conf "$bak" || { rm -f "$bak"; return 1; }
  nginx_web_conf
  if ! nginx -t >/dev/null 2>&1; then
    cp -a "$bak" /etc/nginx/conf.d/default.conf
    rm -f "$bak"
    warn "nginx 配置校验失败, 已回滚 default.conf"
    return 1
  fi
  rm -f "$bak"
  systemctl restart nginx >/dev/null 2>&1
  return 0
}

# 探测面板是否真的起来了(最多等 10 秒), 返回 0 表示 HTTP 有响应
panel_health_check() {
  local pport; pport=$(panel_port)
  local i
  for i in $(seq 1 20); do
    if curl -fsS --max-time 2 -o /dev/null \
         "http://127.0.0.1:$pport/$1/?t=$2" 2>/dev/null; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

install_panel() {
  echo -e "${CYAN}=== 安装 Web 面板 ===${cRES}"
  conf_init
  command -v python3 >/dev/null 2>&1 || {
    apt-get install -y -qq python3 >/dev/null 2>&1
    command -v python3 >/dev/null 2>&1 || die "python3 不可用, 无法安装面板"
  }
  mkdir -p "$PANEL_DIR" /etc/nginx/conf.d
  echo -n "下载 panel.py... "
  fetch_panel_py "$PANEL_PY" || die "panel.py 下载或语法校验失败"
  chmod 755 "$PANEL_PY"
  ok "OK"

  # 首次运行会生成并落盘 .panel.token / .panel.path / .panel.port
  local tok path pport
  tok=$(conf_get '.panel.token'); path=$(conf_get '.panel.path'); pport=$(conf_get '.panel.port')
  if [[ -z $tok || -z $path || -z $pport ]]; then
    python3 - <<PYEOF
import json, os, secrets, random, socket
conf = "$CONF"
d = {}
if os.path.exists(conf):
    try: d = json.load(open(conf, encoding="utf-8"))
    except Exception: d = {}
p = d.get("panel") if isinstance(d.get("panel"), dict) else {}
if not p.get("token"): p["token"] = secrets.token_urlsafe(24)
if not p.get("path"):  p["path"] = "".join(secrets.choice("abcdefghijklmnopqrstuvwxyz0123456789") for _ in range(10))
if not p.get("port"):
    reserved = {53, 80, 443, 1080, 3000, 8388, 8442, 8443, 8444, 8445, 8446, 8447, 8448, 8449, 8450, 8451, 8452, 9853, 9890, 9891, 9892, 9893, 9894, 9895, 9896, 51820}
    env_p = os.environ.get("DEGWD_PANEL_PORT")
    if env_p and env_p.isdigit():
        p["port"] = int(env_p)
    else:
        found = None
        for _ in range(100):
            cand = random.randint(10000, 60000)
            if cand in reserved: continue
            try:
                with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                    s.bind(("0.0.0.0", cand))
                    found = cand
                    break
            except Exception:
                continue
        p["port"] = found or random.randint(20000, 50000)
d["panel"] = p
tmp = conf + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh: json.dump(d, fh, ensure_ascii=False)
os.chmod(tmp, 0o600); os.replace(tmp, conf)
PYEOF
    tok=$(conf_get '.panel.token'); path=$(conf_get '.panel.path'); pport=$(conf_get '.panel.port')
  fi
  [[ -n $tok && -n $path && -n $pport ]] || die "面板凭据生成失败"

  panel_unit_conf
  systemctl enable degwd-panel >/dev/null 2>&1
  svc_restart degwd-panel && ok "degwd-panel 已启动 (端口 $pport)" || { err "面板启动失败"; journalctl -u degwd-panel -n 20 --no-pager; return 1; }

  # 真正验证面板能响应(而不是只看 systemd 状态), 否则"装完不生效"很难排查
  if panel_health_check "$path" "$tok"; then
    ok "面板本机自检通过 (127.0.0.1:$pport)"
  else
    err "面板无响应, 请检查: journalctl -u degwd-panel -n 50 --no-pager"
    return 1
  fi

  # 只有装了需要域名的协议(即已有 nginx 443 站点)才挂反代
  if domain_proto_on && [[ -f /etc/nginx/conf.d/default.conf ]]; then
    if nginx_panel_conf; then
      ok "面板已挂到 nginx (https://$(conf_get '.domain')/$path/)"
    else
      warn "写入面板反代失败, 面板仍可通过端口 $pport 访问"
    fi
  fi

  local host wan; host=$(conf_get '.domain'); wan=$(wan_ip 2>/dev/null || true)
  echo
  ok "Web 面板服务已就绪"
  if [[ -n $host && -f /etc/nginx/conf.d/default.conf ]]; then
    echo -e "  域名地址: ${GREEN}https://$host/$path/?t=$tok${cRES}"
  fi
  echo -e "  直连地址: ${GREEN}http://${wan:-127.0.0.1}:$pport/$path/?t=$tok${cRES}"
  echo "  监听端口: $pport"
  echo "  重新查看: shuoyue (菜单 P) 或 shuoyue --panel-info"
  echo "  凭据存储: $CONF 的 .panel.token / .panel.path / .panel.port (chmod 600)"
}

uninstall_panel() {
  systemctl stop degwd-panel >/dev/null 2>&1
  systemctl disable degwd-panel >/dev/null 2>&1
  rm -f /etc/systemd/system/degwd-panel.service
  systemctl daemon-reload >/dev/null 2>&1
  rm -rf "$PANEL_DIR"
  if [[ -f /etc/nginx/conf.d/default.conf ]]; then
    sed -i '/^# PANEL_START$/,/^# PANEL_END$/d' /etc/nginx/conf.d/default.conf
  fi
  ok "Web 面板已移除"
}

# 查看 Web 面板完整访问地址与状态

# =============================================== 流量整形 (CAKE + ifb, 继承原版) ==
shaping_conf() {
  # 容器内 tc/ifb 不可用
  [[ $VIRT_TYPE == "container" ]] && return 0
  cat <<'EOF' >/etc/rc_online.local
#!/bin/bash
# CAKE 双向整形(不限速,纯 AQM 抗 bufferbloat): lo 50us / 虚拟 200us / 物理 besteffort
THP=/sys/kernel/mm/transparent_hugepage/enabled
[[ -f $THP ]] && echo madvise > "$THP" 2>/dev/null

nic_phys() {
  find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \
    | grep 'device' | grep -v 'virtual' | grep -v 'ifb' | awk -F'/' '{print$NF}'
}
del_ifb() {  # 清理同名残留 ifb
  local d
  for d in $(find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \
      | grep 'ifb' | awk -F'/' '{print$NF}'); do
    ip link set "$d" down 2>/dev/null; ip link delete "$d" 2>/dev/null
  done
}

# 本地路由初始窗口
for r in $(ip route show table local | grep -Ev 'linkdown|broadcast' | awk '{print$1}'); do
  ip route change "$r" mtu 1500 initcwnd 32 initrwnd 32 fastopen_no_cookie 1 congctl lock cubic 2>/dev/null
done
ip route change local 127.0.0.0/8 dev lo table local mtu 65520 initcwnd 32 initrwnd 32 fastopen_no_cookie 1 congctl lock cubic 2>/dev/null
for r in $(ip route | grep -E ' dev [a-z0-9@]+ ' | awk '{print$1" via "$3" dev "$5}' 2>/dev/null); do :; done
defr=$(ip route show default | head -n1)
[[ -n $defr ]] && ip route change $defr fastopen_no_cookie 1 2>/dev/null

ip link set lo qlen 10000 mtu 65520
del_ifb

# ---- lo: 本机 nginx<->xray 回环也纳入 AQM
tc qdisc del dev lo root 2>/dev/null
tc qdisc add dev lo root cake unlimited rtt 50us diffserv4 dual-srchost nonat nowash no-split-gso ack-filter-aggressive raw egress
tc qdisc del dev lo ingress 2>/dev/null
tc qdisc add dev lo handle ffff: ingress 2>/dev/null
if ! ip link show ifb4lo >/dev/null 2>&1; then ip link add name ifb4lo type ifb; fi
ip link set ifb4lo qlen 10000 mtu 65520; ip link set ifb4lo up
tc qdisc del dev ifb4lo root 2>/dev/null
tc qdisc add dev ifb4lo root cake unlimited rtt 50us diffserv4 dual-dsthost nonat nowash no-split-gso no-ack-filter raw ingress
tc filter del dev lo ingress 2>/dev/null
tc filter add dev lo parent ffff: matchall action mirred egress redirect dev ifb4lo 2>/dev/null

# ---- 虚拟网卡(排除 docker/ifb/lo/wg)
for line in $(find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \
    | grep 'virtual' | grep -v 'ifb' | awk -F'/' '{print$NF}' | grep -v '^lo$' | grep -v '^docker0$'); do
  tc qdisc del dev "$line" root 2>/dev/null
  tc qdisc add dev "$line" root cake unlimited rtt 200us diffserv4 dual-srchost nonat nowash no-split-gso ack-filter raw overhead 18 mpu 64 egress
  tc qdisc del dev "$line" ingress 2>/dev/null
  tc qdisc add dev "$line" handle ffff: ingress 2>/dev/null
  ifb="ifb4$(echo "$line" | cut -c1-11)"
  if ! ip link show "$ifb" >/dev/null 2>&1; then ip link add name "$ifb" type ifb; fi
  ip link set "$ifb" up
  tc qdisc del dev "$ifb" root 2>/dev/null
  tc qdisc add dev "$ifb" root cake unlimited rtt 200us diffserv4 dual-dsthost nonat nowash no-split-gso no-ack-filter raw overhead 18 mpu 64 ingress
  tc filter del dev "$line" ingress 2>/dev/null
  tc filter add dev "$line" parent ffff: matchall action mirred egress redirect dev "$ifb" 2>/dev/null
done

# ---- 物理网卡
for line in $(nic_phys); do
  tc qdisc del dev "$line" root 2>/dev/null
  tc qdisc add dev "$line" root cake unlimited besteffort dual-srchost nonat nowash no-split-gso ack-filter ethernet egress
  tc qdisc del dev "$line" ingress 2>/dev/null
  tc qdisc add dev "$line" handle ffff: ingress 2>/dev/null
  ifb="ifb4$(echo "$line" | cut -c1-11)"
  if ! ip link show "$ifb" >/dev/null 2>&1; then ip link add name "$ifb" type ifb; fi
  ip link set "$ifb" up
  tc qdisc del dev "$ifb" root 2>/dev/null
  tc qdisc add dev "$ifb" root cake unlimited diffserv4 dual-dsthost nonat nowash no-split-gso no-ack-filter ethernet ingress
  tc filter del dev "$line" ingress 2>/dev/null
  tc filter add dev "$line" parent ffff: matchall action mirred egress redirect dev "$ifb" 2>/dev/null
  # 2.5G/10G 网卡上强制 duplex full 可能掉链路 => 不再设置, 交由网卡自协商
  # 保留 GRO/GSO/TSO 开启: 关闭会让 CAKE 走逐包路径, 吞吐显著下降
  # (no-split-gso 参数本就依赖 GSO 存在; ufo 在 5.x 内核已移除)
  ethtool -K "$line" rx on tx on sg on gro on gso on tso on tx-gso-partial on lro off 2>/dev/null
done

ip tcp_metrics flush >/dev/null 2>&1
ip route flush cache >/dev/null 2>&1
EOF
  chmod +x /etc/rc_online.local

  # 原版把 ExecStartPost 挂到 networking.service.d/override.conf, 但
  # NetworkManager / systemd-networkd 系统上 networking.service 根本不存在 => 独立单元
  rm -f /etc/systemd/system/networking.service.d/override.conf 2>/dev/null
  rmdir /etc/systemd/system/networking.service.d 2>/dev/null
  write_atomic /etc/systemd/system/degwd-shaping.service 644 <<'EOF'
[Unit]
Description=de_GWD CAKE shaping (tc/ifb)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/rc_online.local

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable degwd-shaping >/dev/null 2>&1
}

# ================================================================ nftables ====
nftables_conf() {
  [[ $VIRT_TYPE == "container" ]] && return 0
  mkdir -p "$BASE/nftables"
  # flowtable 设备集启动时动态生成
  # 注意: 此处用 <<EOF(不加引号) 以便展开 $BASE; 生成脚本内的 shell 变量
  # 必须转义(\$interface_FT), 否则会在写文件时被外层展开成空串
  # 空集合陷阱: 原写法用 `xargs -n1 | tr '\n' ','` 拼接, 但 xargs -n1 在
  # 空输入时会输出一个空行, tr 把它变成 ",", 于是变量非空 -> 兜底不触发
  # -> ${interface_FT%,} 变成空串 -> 产出 `define flowtable_eth = {  };`
  # (空设备集合是非法规则, 整张 nft 表加载失败)。
  # 改为 client 侧已验证的写法: tr 后用 sed 's/,$//' 把纯 "," 还原成空串。
  cat <<EOF >"$BASE/nftables/flowtable_eth.sh"
#!/bin/bash
interface_FT=\$(find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \\
  | grep 'device' | awk -F'/' '{print\$NF}' | grep -v '^lo\$' | grep -v '^ifb4' | sort -u | tr '\\n' ',' | sed 's/,\$//; s/,/, /g')
[[ -z \$interface_FT ]] && interface_FT="lo"
echo "define flowtable_eth = { \$interface_FT };" > $BASE/nftables/flowtable.eth
EOF
  chmod +x "$BASE/nftables/flowtable_eth.sh"

  cat <<EOF >"$BASE/nftables/default.nft"
include "$BASE/nftables/flowtable.eth"

table inet degwd_bypassflow {
    flowtable Acceleration {
        hook ingress priority -300; devices = \$flowtable_eth;
    }
    chain bypasschain {
        type filter hook forward priority -300; policy accept;
        ip daddr 172.16.0.0/24 flow offload @Acceleration   # WARP 子网
        ip saddr 172.16.0.0/24 flow offload @Acceleration
        ip daddr 172.17.0.0/16 flow offload @Acceleration   # docker 子网
        ip saddr 172.17.0.0/16 flow offload @Acceleration
    }
}

table inet degwd_filter {
    chain INPUT {
        type filter hook input priority 0; policy accept;
        iifname "lo" accept
        iifname "wgcf" accept
        iifname "docker0" accept
        iifname "ifb4lo" accept
        iifname "ifb4wgcf" accept
        ct state established,related accept
        tcp flags != syn ct state new drop
        tcp flags & (fin|syn) == (fin|syn) drop
        tcp flags & (syn|rst) == (syn|rst) drop
        tcp flags & (fin|syn|rst|psh|ack|urg) == 0 drop
        tcp flags & (fin|psh|urg) == (fin|psh|urg) drop
        ct state invalid counter drop
        meta l4proto { tcp, udp } th dport 4711 drop
    }
    chain FORWARD {
        type filter hook forward priority 0; policy accept;
        iifname "wgcf" accept
        oifname "wgcf" accept
        counter jump degwd_docker_user
        counter jump degwd_docker_isolation_1
        oifname "docker0" ct state related,established counter accept
        oifname "docker0" counter jump degwd_docker
        iifname "docker0" oifname != "docker0" counter accept
        iifname "docker0" oifname "docker0" counter accept
    }
    chain OUTPUT { type filter hook output priority 0; policy accept; }
    chain degwd_docker { }
    chain degwd_docker_user { counter accept }
    chain degwd_docker_isolation_1 { iifname "docker0" oifname != "docker0" counter jump degwd_docker_isolation_2; counter return }
    chain degwd_docker_isolation_2 { oifname "docker0" counter drop; counter return }
}

table inet degwd_router {
    chain degwd_docker { }
    chain PREROUTING {
        type nat hook prerouting priority dstnat; policy accept;
        tcp flags & (syn|rst) == syn counter tcp option maxseg size set 1460
    }
    chain POSTROUTING {
        type nat hook postrouting priority srcnat; policy accept;
        oifname != "docker0" ip saddr 172.17.0.0/16 counter masquerade
    }
}
EOF

  # 不覆盖发行版 /etc/systemd/system/nftables.service, 使用自建单元名
  # <<EOF(不加引号) 以便按 $BASE 展开; 单元文件内无其它 shell 变量
  write_atomic /etc/systemd/system/degwd-nftables.service 644 <<EOF
[Unit]
Description=de_GWD nftables + CAKE shaping
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=null
ProtectSystem=full
ProtectHome=true
ExecStart=$BASE/nftables/flowtable_eth.sh
ExecStart=/usr/sbin/nft -f $BASE/nftables/default.nft
# CAKE 整形已由独立的 degwd-shaping.service 负责(After=network-online.target),
# 此处不再重复 ExecStart=/etc/rc_online.local
# 原为 nft flush ruleset: 会清空整机所有 nft 表(Docker/firewalld 全丢)
# 改为只删本方案自建表; '-' 前缀容忍表不存在
ExecStop=-/usr/sbin/nft delete table inet degwd_bypassflow
ExecStop=-/usr/sbin/nft delete table inet degwd_filter
ExecStop=-/usr/sbin/nft delete table inet degwd_router

[Install]
WantedBy=sysinit.target
EOF
  systemctl daemon-reload
  systemctl enable degwd-nftables >/dev/null 2>&1
}

# ============================================================ 组件安装: Xray ==
install_xray() {
  ok "安装 Xray-core (官方源)..."
  # 原版 curl | bash 无锁版本无校验; 改为先落地临时文件 + bash -n 语法校验再执行
  local _xtmp _xver_before="" _xver_after=""
  _xver_before=$(/usr/local/bin/xray version 2>/dev/null | head -n1)
  _xtmp=$(mktemp /tmp/xray-install.XXXXXX.sh) || die "无法创建临时文件"
  if ! curl -fsSL --max-time 60 https://github.com/XTLS/Xray-install/raw/main/install-release.sh -o "$_xtmp"; then
    rm -f "$_xtmp"; die "Xray 官方安装器下载失败"
  fi
  if ! bash -n "$_xtmp" 2>/dev/null; then
    rm -f "$_xtmp"; die "Xray 官方安装器语法校验失败(上游文件可能损坏/被篡改), 已中止"
  fi
  warn "Xray 安装器为上游 main 分支最新版(无版本锁定), 语法校验已通过但内容未经哈希校验"
  bash "$_xtmp" install || { rm -f "$_xtmp"; die "Xray 安装失败"; }
  rm -f "$_xtmp"
  _xver_after=$(/usr/local/bin/xray version 2>/dev/null | head -n1)
  [[ -n $_xver_before ]] && warn "Xray 版本变更(回滚参考): ${_xver_before} -> ${_xver_after:-未知}"
  [[ ! -x /usr/local/bin/xray ]] && die "Xray 安装失败"
  mkdir -p "$XRAYDIR"
  # dat 资产放官方位置,服务里用环境变量指向
  mkdir -p /usr/local/share/xray
  # Nice=-8 必须写在 [Service] 段内。
  # 原实现是「先写完整个单元, 再 cat >> 追加 Nice=-8」, 追加位置在 [Install] 之后,
  # 而 systemd 只认键所属的最近一个节头 -> [Install] 里的 Nice= 无意义, 被静默忽略
  # (仅日志一行 "Unknown key name 'Nice' ... ignoring"), 服务端 Xray 实际从未拿到
  # 调度优先级。这里改成在 [Service] 段落内按条件插入。
  local _nice=""
  [[ $VIRT_TYPE != "container" ]] && _nice="Nice=-8"
  # 自有 systemd 单元(带 hardening,继承原版)
  write_atomic /etc/systemd/system/xray.service 644 <<EOF
[Unit]
Description=de_GWD Xray Service
After=network.target nss-lookup.target

[Service]
User=$XTLSUSER
ExecStart=/usr/local/bin/xray run -confdir $XRAYDIR
Restart=on-failure
RestartPreventExitStatus=23
Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray
LimitNOFILE=10000000
LimitNPROC=10000000
LimitCORE=10000000
$_nice
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
  if [[ $XTLSUSER != "root" ]]; then
    chown -R $XTLSUSER:$XTLSUSER "$XRAYDIR" 2>/dev/null
    chmod 750 "$XRAYDIR"; chmod 640 "$XRAYDIR"/config.json 2>/dev/null
    # reality 私钥等只读给运行用户
  fi
}

# ================================================================= nginx =====
install_nginx() {
  ok "安装 nginx..."
  # Debian 与 Ubuntu 官方源自适应; 源不可用时回退发行版包
  local distro suite
  distro=$(. /etc/os-release 2>/dev/null; echo "${ID:-debian}")
  suite=$(. /etc/os-release 2>/dev/null; echo "${VERSION_CODENAME:-}")
  rm -f /etc/apt/sources.list.d/nginx.list
  if [[ -n $suite ]]; then
    local base="https://nginx.org/packages/debian"
    [[ $distro == "ubuntu" ]] && base="https://nginx.org/packages/ubuntu"
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://nginx.org/keys/nginx_signing.key -o /etc/apt/keyrings/nginx-archive-keyring.asc 2>/dev/null
    if [[ -s /etc/apt/keyrings/nginx-archive-keyring.asc ]]; then
      echo "deb [signed-by=/etc/apt/keyrings/nginx-archive-keyring.asc] $base $suite nginx" >/etc/apt/sources.list.d/nginx.list
      apt-get update -qq 2>/dev/null
    fi
  fi
  if ! apt-cache policy nginx 2>/dev/null | grep -q 'nginx.org'; then
    rm -f /etc/apt/sources.list.d/nginx.list
    apt-get update -qq 2>/dev/null
  fi
  apt-get install -y -qq nginx 2>/dev/null || apt-get install -y -qq nginx-core 2>/dev/null || true
  systemctl stop nginx >/dev/null 2>&1
  command -v nginx >/dev/null || die "nginx 安装失败"
  mkdir -p /etc/nginx/conf.d /etc/nginx/stream.d "$WEBDIR" "$SSLDIR" /var/log/nginx
  if [[ ! -f $SSLDIR/dhparam.pem ]]; then
    ok "生成 dhparam (2048)..."
    openssl dhparam -out "$SSLDIR/dhparam.pem" 2048 >/dev/null 2>&1
  fi
  systemctl enable nginx >/dev/null 2>&1
}


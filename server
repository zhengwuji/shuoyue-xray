  jq -n --argjson clients "$clients" --arg priv "$priv" --argjson port "$port" \
        --arg dest "$(conf_get '.reality.dest')" --arg sni "$(conf_get '.reality.sni')" \
        --arg sid "$(conf_get '.reality.shortid')" --arg path "$path" --arg dec "$dec" '
  {
    listen: "0.0.0.0", port: $port, protocol: "vless",
    settings: { clients: $clients, decryption: $dec },
    streamSettings: {
      network: "xhttp",
      security: "reality",
      xhttpSettings: { path: $path, mode: "auto",
        extra: { xPaddingBytes: "100-1000", noSSEHeader: true } },
      realitySettings: {
        show: false, dest: $dest, xver: 0,
        serverNames: [$sni], privateKey: $priv, shortIds: [$sid]

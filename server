uninstallGWD() {
  local force=0 keep_panel=0 purge_pkgs=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force|-y|--yes|--noninteractive) force=1 ;;
      --keep-panel) keep_panel=1 ;;
      --purge-pkgs) purge_pkgs=1 ;;
    esac
    shift
  done

  if [[ $force -eq 0 ]]; then
    read -rp "确认卸载? 将删除 全部配置/证书/节点数据/网站目录,输入 yes 确认: " c
    [[ $c == "yes" ]] || { ok "已取消"; return 0; }
    read -rsp "同时卸载 nginx/unbound/haproxy 等底层软件包? [y/N]: " -n1 r; echo
    [[ "$r" =~ ^[Yy] ]] && purge_pkgs=1
  fi

  ok "停止服务与清理后台进程..."
  local s
  local svcs=(xray sing-box doh-server haproxy wg-quick@wgcf nginx degwd-nftables degwd-shaping nftables unbound cloudflared)
  [[ $keep_panel -eq 0 ]] && svcs+=(degwd-panel)
  for s in "${svcs[@]}"; do
    systemctl stop "$s" >/dev/null 2>&1 || true
    systemctl disable "$s" >/dev/null 2>&1 || true
  done

  # 杀灭可能的残留与孤儿进程
  pkill -9 -f 'cloudflared.*tunnel' 2>/dev/null || true
  pkill -9 -f 'xray run' 2>/dev/null || true
  pkill -9 -f 'sing-box run' 2>/dev/null || true
  pkill -9 -f 'doh-server' 2>/dev/null || true
  if [[ $keep_panel -eq 0 ]]; then
    pkill -9 -f 'degwd.*panel\.py' 2>/dev/null || true
    pkill -9 -f 'python.*panel\.py' 2>/dev/null || true
  fi

  # 清理 WireGuard 网络设备
  wg-quick down wgcf 2>/dev/null || true
  ip link delete wgcf 2>/dev/null || true

  # 只删本方案自建表, 不动 Docker/firewalld 等其他 nft 表
  nft delete table inet degwd_bypassflow 2>/dev/null || true
  nft delete table inet degwd_filter 2>/dev/null || true
  nft delete table inet degwd_router 2>/dev/null || true

  ok "移除服务单元与文件..."
  local units=(
    /etc/systemd/system/xray.service
    /etc/systemd/system/sing-box.service
    /etc/systemd/system/cloudflared.service
    /etc/systemd/system/doh-server.service
    /etc/systemd/system/unbound.service
    /etc/systemd/system/degwd-nftables.service
    /etc/systemd/system/degwd-shaping.service
  )
  [[ $keep_panel -eq 0 ]] && units+=(/etc/systemd/system/degwd-panel.service)
  rm -f "${units[@]}"
  rm -rf /etc/systemd/system/networking.service.d

  # 恢复发行版 nginx 默认站点(安装时备份过)
  if [[ -e $BASE/backup/nginx-sites-enabled-default && ! -e /etc/nginx/sites-enabled/default ]]; then
    cp -a "$BASE/backup/nginx-sites-enabled-default" /etc/nginx/sites-enabled/default 2>/dev/null
  fi
  systemctl daemon-reload 2>/dev/null || true

  # 清理计划任务 (crontab)
  (crontab -l 2>/dev/null | grep -vE 'de_GWD|shuoyue|acme\.sh|cloudflared|cf_speed') | crontab - 2>/dev/null || true

  # 清理证书与密钥
  rm -rf /root/.acme.sh
  rm -rf "$SSLDIR"
  rm -rf "$WEBDIR/sub" 2>/dev/null || true

  # 清理核心二进制及共享数据
  rm -f /usr/local/bin/xray /usr/local/bin/sing-box /usr/local/bin/cloudflared /usr/local/bin/shuoyue /usr/local/bin/de_GWD /etc/rc_online.local
  rm -rf /usr/local/share/xray /usr/local/share/sing-box
  rm -f /etc/wireguard/wgcf.conf /etc/wireguard/wgcf-account.toml /etc/wireguard/wgcf-profile.conf

  # 移除本方案写入的 drop-in 配置(不动用户原有的 sysctl/limits 配置)
  rm -f /etc/sysctl.d/99-degwd.conf /etc/security/limits.d/99-degwd.conf
  rm -f /etc/apt/apt.conf.d/01deGWD
  rm -f /etc/apt/sources.list.d/zabbly-kernels-stable.sources /etc/apt/keyrings/zabbly.asc
  rm -f /etc/apt/sources.list.d/nginx.list /etc/apt/keyrings/nginx-archive-keyring.asc
  rm -f /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/80.conf \
        /etc/nginx/conf.d/.HSTS /etc/nginx/conf.d/.ssl_certs

  # 清理基准工作目录 (若保留面板用于响应退出，则仅保留 panel 目录)
  if [[ $keep_panel -eq 1 ]]; then
    find "$BASE" -mindepth 1 -maxdepth 1 ! -name 'panel' -exec rm -rf {} + 2>/dev/null || true
  else
    rm -rf "$BASE" "$WEBDIR"
  fi

  # 软件包清理
  if [[ $purge_pkgs -eq 1 ]]; then
    ok "正在卸载底层软件包 (nginx/unbound/haproxy/cloudflared)..."
    apt-get purge -y -qq nginx nginx-* unbound haproxy cloudflared >/dev/null 2>&1 || true
    apt-get autoremove -y -qq >/dev/null 2>&1 || true
  else
    # 保留 nginx 时，重载以恢复默认干净配置
    if command -v nginx >/dev/null 2>&1; then
      nginx -t >/dev/null 2>&1 && systemctl restart nginx >/dev/null 2>&1 || true
    fi
  fi

  # 恢复标准 DNS
  chattr -i /etc/resolv.conf 2>/dev/null || true
  rm -f /etc/resolv.conf
  printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > /etc/resolv.conf
  sysctl --system >/dev/null 2>&1 || true

  ok "卸载完成(已移除所有核心、配置、证书、自建 nft 表与 drop-in 配置; 重装可直接跑一键脚本)"
}


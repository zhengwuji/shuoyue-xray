# -----------------------------------------------------------------------------
# 基础工具
# -----------------------------------------------------------------------------
log() { printf '%s [%s] %s\n' "$(date '+%F %T')" "${1:-INFO}" "${*:2}" >>"$LOG_FILE" 2>/dev/null || true; }
ok()   { echo -e "${WHITE}[ ${GREEN}✓${WHITE} ]${cRES} $*"; log OK "$*"; }
warn() { echo -e "${WHITE}[ ${YELLOW}!${WHITE} ]${cRES} $*"; log WARN "$*"; }
err()  { echo -e "${WHITE}[ ${RED}✕${WHITE} ]${cRES} $*"; log ERROR "$*"; }
die()  { err "$*"; exit 1; }

ask()        { local v; read -r -p "$1" v; printf '%s' "$v"; }
ask_secret() { local v; read -r -s -p "$1" v; echo >&2; printf '%s' "$v"; }
yesno()      { local v; read -r -p "$1 [y/N]: " v; [[ ${v,,} == "y" || ${v,,} == "yes" ]]; }

# 原子写: $1=路径 $2=权限, 内容从 stdin
write_atomic() {
  local f="$1" m="${2:-644}" d t
  d=$(dirname "$f"); mkdir -p "$d" 2>/dev/null || return 1
  t=$(mktemp "$d/.$(basename "$f").XXXXXX") || return 1
  cat >"$t" || { rm -f "$t"; return 1; }
  chmod "$m" "$t" 2>/dev/null
  mv -f "$t" "$f" || { rm -f "$t"; return 1; }
  return 0
}

# 端口合法性: 1-65535 且不与保留端口冲突
RESERVED_PORTS=" 53 80 443 3000 6053 8442 8443 8444 8445 8446 8388 9896 10808 51820 "
port_valid() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  (( p >= 1 && p <= 65535 )) || return 1
  [[ $RESERVED_PORTS == *" $p "* ]] && return 1
  return 0
}


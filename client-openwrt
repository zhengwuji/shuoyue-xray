pkg_installed() { opkg list-installed 2>/dev/null | grep -q "^$1 "; }
pkg_dep() {
  local need=() p
  for p in bash jq curl ca-bundle coreutils-base64 flock openssl-util; do
    pkg_installed "$p" || need+=("$p")
  done
  # smartdns 用于 DNS 分流(与 dnsmasq 共存于 127.0.0.1:6053)
  pkg_installed smartdns || need+=(smartdns)
  pkg_installed qrencode || need+=(qrencode)

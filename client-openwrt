# -----------------------------------------------------------------------------
# WireGuard 服务端
# -----------------------------------------------------------------------------
wg_keygen() { command -v wg >/dev/null 2>&1 && wg genkey 2>/dev/null || openssl rand -base64 32; }
wg_pubkey() { command -v wg >/dev/null 2>&1 && printf '%s' "$1" | wg pubkey 2>/dev/null; }

wg_menu() {
  while :; do
    echo
    echo -e "${CYAN}---- WireGuard 服务端 ----${cRES}"
    local en; en=$(conf_get '.wg.enable')
    echo "  状态: $([[ $en == "true" ]] && echo "${GREEN}已启用${cRES}" || echo "未启用")"
    echo "  端口: $(conf_get '.wg.port')   网段: $WG_NET"
    local ccl; ccl=$(conf_get '.wg.clients | length'); echo "  客户端: ${ccl:-0} 个"
    echo "  [1] 启用 WireGuard"
    echo "  [2] 停用 WireGuard"
    echo "  [3] 添加客户端"
    echo "  [4] 列出客户端配置"
    echo "  [5] 删除客户端"
    echo "  [0] 返回"
    local c; c=$(ask "选择: ")
    case "$c" in
      1) wg_enable ;;
      2) wg_disable ;;
      3) wg_add_client ;;
      4) wg_list_clients ;;
      5) wg_del_client ;;
      0|"") return 0 ;;
      *) warn "无效选择" ;;
    esac
    [[ -n $c ]] && echo && read -r -p "回车继续..." _
  done
}

wg_enable() {
  command -v wg >/dev/null 2>&1 || { err "缺少 wireguard-tools, 请 opkg install wireguard-tools"; return 1; }
  local port; port=$(conf_get '.wg.port'); [[ -z $port ]] && port=51820
  local priv pub
  priv=$(conf_get '.wg.serverPriv')
  if [[ -z $priv ]]; then
    priv=$(wg_keygen); pub=$(wg_pubkey "$priv")
    conf_set '.wg.serverPriv' "$priv"
    conf_set '.wg.serverPub' "$pub"
  fi
  pub=$(conf_get '.wg.serverPub')
  local wanip; wanip=$(wan_ip)

  # 用 uci 建接口(可逆, 不覆盖既有配置)
  : >/etc/config/degwd 2>/dev/null
  uci -q get network.degwdwg >/dev/null 2>&1 && uci -q delete network.degwdwg
  uci set network.degwdwg=interface
  uci set network.degwdwg.proto='wireguard'
  uci set network.degwdwg.private_key="$priv"
  uci set network.degwdwg.listen_port="$port"
  uci set network.degwdwg.mtu='1420'
  uci add_list network.degwdwg.addresses="$WG_PREFIX.1/24"
  uci commit network
  uci set firewall.degwdwg=rule 2>/dev/null
  uci set firewall.degwdwg.name='Allow-deGWD-WG'
  uci set firewall.degwdwg.src='wan'
  uci set firewall.degwdwg.proto='udp'
  uci set firewall.degwdwg.dest_port="$port"
  uci set firewall.degwdwg.target='ACCEPT'
  uci commit firewall
  # 仅 reload, 绝不 restart(会短暂断网)
  /etc/init.d/network reload >/dev/null 2>&1
  /etc/init.d/firewall reload >/dev/null 2>&1
  conf_raw '.wg.enable' "true"
  ok "WireGuard 已启用 端口 $port"
  [[ -n $wanip ]] && ok "客户端 EndPoint: $wanip:$port"
  return 0
}

wg_disable() {
  uci -q delete network.degwdwg 2>/dev/null
  uci -q delete firewall.degwdwg 2>/dev/null
  uci commit network 2>/dev/null
  uci commit firewall 2>/dev/null
  /etc/init.d/network reload >/dev/null 2>&1
  /etc/init.d/firewall reload >/dev/null 2>&1
  conf_raw '.wg.enable' "false"
  ok "WireGuard 已停用"
  return 0
}

wg_add_client() {
  local spub; spub=$(conf_get '.wg.serverPub')
  [[ -z $spub ]] && { err "请先启用 WireGuard"; return 1; }
  local name; name=$(ask "  客户端名称: "); [[ -z $name ]] && return 1
  local cpriv cpub idx ip
  cpriv=$(wg_keygen); cpub=$(wg_pubkey "$cpriv")
  idx=$(conf_get '.wg.clients | length'); [[ -z $idx ]] && idx=0
  ip="$WG_PREFIX.$((idx+2))"
  local cl; cl=$(jq -n --arg n "$name" --arg pub "$cpub" --arg ip "$ip" \
    '{name:$n, pubkey:$pub, ip:$ip}')
  conf_write '.wg.clients += [$c]' --argjson c "$cl" || return 1

  # 把客户端公钥加入服务端 peer
  local i=1
  uci -q delete network.degwdwg_$name 2>/dev/null
  uci set "network.degwdwg_$name=wireguard_degwdwg"
  uci set "network.degwdwg_$name.public_key=$cpub"
  uci set "network.degwdwg_$name.allowed_ips=$ip/32"
  uci commit network
  /etc/init.d/network reload >/dev/null 2>&1

  local port wanip; port=$(conf_get '.wg.port'); wanip=$(wan_ip)
  echo
  ok "客户端配置(复制到 WireGuard 客户端):"
  echo "-----------------------------------------------"
  cat <<EOF
[Interface]
PrivateKey = $cpriv
Address = $ip/24
DNS = $(conf_get '.lanCidr' | cut -d/ -f1)

[Peer]
PublicKey = $spub
AllowedIPs = 0.0.0.0/0
Endpoint = ${wanip:-<你的公网IP>}:${port}
PersistentKeepalive = 25
EOF
  echo "-----------------------------------------------"
  [[ -n $name ]] && printf '%s' "$cpriv" | write_atomic "$BASE/wg-$name.conf" 600 2>/dev/null
  return 0
}

wg_list_clients() {
  local n; n=$(conf_get '.wg.clients | length'); [[ -z $n || $n -eq 0 ]] && { warn "暂无客户端"; return 1; }
  local i=0
  while [[ $i -lt $n ]]; do
    printf '  %-3s %-16s %s\n' "$i" "$(conf_get ".wg.clients[$i].name")" "$(conf_get ".wg.clients[$i].ip")"
    i=$((i+1))
  done
  return 0
}

wg_del_client() {
  wg_list_clients || return 1
  local n idx nm
  n=$(conf_get '.wg.clients | length')
  idx=$(ask "  删除序号: ")
  [[ $idx =~ ^[0-9]+$ ]] || return 1
  (( idx >= 0 && idx < n )) || { err "序号超范围"; return 1; }
  nm=$(conf_get ".wg.clients[$idx].name")
  conf_write 'del(.wg.clients[$n])' --argjson n "$idx" || return 1
  uci -q delete "network.degwdwg_$nm" 2>/dev/null
  uci commit network 2>/dev/null
  /etc/init.d/network reload >/dev/null 2>&1
  ok "已删除客户端: $nm"
  return 0
}


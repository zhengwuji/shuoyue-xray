printRelay() {
  local n; n=$(conf_get '.relay.list | length'); [[ -z $n || $n -eq 0 ]] && { echo "  (无)"; return 0; }
  local i=0
  while [[ $i -lt $n ]]; do
    printf '  %s → %s:%s\n' "$(conf_get ".relay.list[$i].listen")" \
      "$(conf_get ".relay.list[$i].target")" "$(conf_get ".relay.list[$i].port")"
    i=$((i+1))
  done
}

# 用 nft 自建表做 DNAT (不触碰既有 nat 表)
relay_apply() {
  local n; n=$(conf_get '.relay.list | length'); [[ -z $n ]] && n=0
  nft delete table ip degwd_relay 2>/dev/null
  [[ $n -eq 0 ]] && return 0
  local rules="" i=0
  while [[ $i -lt $n ]]; do
    local lp th tp
    lp=$(conf_get ".relay.list[$i].listen"); th=$(conf_get ".relay.list[$i].target")
    tp=$(conf_get ".relay.list[$i].port")
    rules="$rules
    chain prerouting_$i {
        type nat hook prerouting priority dstnat - 10; policy accept;
        tcp dport $lp counter dnat to $th:$tp
        udp dport $lp counter dnat to $th:$tp
    }
    chain postrouting_$i {
        type nat hook postrouting priority srcnat; policy accept;
        ip daddr $th tcp dport $tp counter masquerade
        ip daddr $th udp dport $tp counter masquerade
    }"
    i=$((i+1))
  done
  local tmp; tmp=$(mktemp) || return 1
  printf 'table ip degwd_relay {%s\n}\n' "$rules" >"$tmp"
  if nft -c -f "$tmp" >/dev/null 2>&1; then
    nft -f "$tmp" || warn "中继规则加载失败"
  else
    warn "中继规则语法错误, 未应用"
  fi
  rm -f "$tmp"
  return 0
}

# -----------------------------------------------------------------------------
# 健康检查 / 内核 / 自动更新
# -----------------------------------------------------------------------------
health_check() {   # $1="full" 才跑外网探测
  local issues=0
  echo -e "${CYAN}---- 健康检查 ----${cRES}"

  # 代理开启但组件未运行
  if [[ $(conf_get '.proxyOn') == "true" ]]; then
    /etc/init.d/degwd-gw running >/dev/null 2>&1 || { err "xray 未运行"; issues=$((issues+1)); }
    /etc/init.d/degwd-nft running >/dev/null 2>&1 || true
    nft list table ip "$NFT_TABLE" >/dev/null 2>&1 || { err "nft 表 $NFT_TABLE 缺失"; issues=$((issues+1)); }
    route_rule_ok || { err "策略路由缺失(fwmark $NFT_MARK → table $RT_TABLE)"; issues=$((issues+1)); }
    [[ $(conf_get '.block53') == "true" ]] && true
    local act; act=$(conf_get '.nodeActive')
    if node_needs_bridge "$act"; then
      /etc/init.d/degwd-sb running >/dev/null 2>&1 || { err "sing-box 桥接未运行"; issues=$((issues+1)); }
    fi
  else
    echo "  代理未开启"
  fi

  # 关键文件
  [[ -f $XRAYDIR/config.json ]] && jq -e . "$XRAYDIR/config.json" >/dev/null 2>&1 || \
    { [[ $(conf_get '.proxyOn') == "true" ]] && { err "xray 配置无效"; issues=$((issues+1)); }; }
  [[ -s $LISTDIR/chnroute.txt ]] || warn "chnroute 名单缺失(运行 --lists)"

  # 与既有服务共存检查
  nft list table inet fw4 >/dev/null 2>&1 || warn "fw4 表不存在(可能被 flush 过)"
  nft list table inet passwall2 >/dev/null 2>&1 && echo "  passwall2 表存在(未受影响)"

  # 端口监听检查(不依赖 netstat: 直接读 /proc/net/tcp 的本地端口十六进制)
  if [[ $(conf_get '.proxyOn') == "true" ]]; then
    local hexport; hexport=$(printf '%04X' "$TPROXY_PORT")
    if awk -v p=":$hexport" 'NR>1 { split($2,a,":"); if (":" a[2] == p) { found=1; exit } } END { exit !found }' \
         /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
      echo "  tproxy 端口 $TPROXY_PORT: 监听中"
    else
      warn "tproxy 端口 $TPROXY_PORT 未监听"
      issues=$((issues+1))
    fi
  fi

  if [[ ${1:-} == "full" ]]; then
    local ip; ip=$(wan_ip)
    echo "  WAN IP: ${ip:-未知}"
    if [[ -n $ip ]]; then
      local code
      code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "http://www.gstatic.com/generate_204" 2>/dev/null)
      if [[ $code == "204" ]]; then
        echo -e "  代理连通性: ${GREEN}✓ 正常${cRES}"
      else
        warn "代理连通性异常 (HTTP $code)"
        issues=$((issues+1))
      fi
    fi
  fi

  [[ $issues -eq 0 ]] && ok "检查通过" || warn "发现 $issues 个问题"
  return $issues
}

installkernel() {
  warn "OpenWrt 内核由系统固件管理, 无法通过本脚本升级"
  echo "  如需新内核, 请使用官方固件升级流程(sysupgrade)"
  return 1
}

autoupdate_on() {
  grep -qF "shuoyue-gw --update" /etc/crontabs/root 2>/dev/null || {
    mkdir -p /etc/crontabs
    printf '0 5 * * * /usr/bin/shuoyue-gw --update >/dev/null 2>&1\n' >>/etc/crontabs/root
  }
  /etc/init.d/cron enable >/dev/null 2>&1
  /etc/init.d/cron restart >/dev/null 2>&1
  conf_raw '.autoUpdate' "true"
  ok "自动更新已开启(每天 05:00)"
  return 0
}
autoupdate_off() {
  if [[ -f /etc/crontabs/root ]]; then
    local t; t=$(mktemp)
    grep -vF "shuoyue-gw --update" /etc/crontabs/root >"$t" 2>/dev/null
    mv -f "$t" /etc/crontabs/root
  fi
  /etc/init.d/cron restart >/dev/null 2>&1
  conf_raw '.autoUpdate' "false"
  ok "自动更新已关闭"
  return 0
}

updateGWD() {
  local tmp; tmp=$(mktemp) || return 1
  ok "检查更新..."
  if ! dl_file "$REMOTE_BASE/client-openwrt" "$tmp"; then
    rm -f "$tmp"; err "下载失败"; return 1
  fi
  bash -n "$tmp" 2>/dev/null || { rm -f "$tmp"; err "新版本语法校验失败, 已放弃"; return 1; }
  grep -q '^start_menu()' "$tmp" || { rm -f "$tmp"; err "新版本内容校验失败"; return 1; }
  local newv; newv=$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2)
  if [[ "$newv" == "$VERSION" ]]; then
    rm -f "$tmp"; ok "已是最新版本 $VERSION"; return 0
  fi
  cp -f "$0" "$BASE/client-openwrt.bak" 2>/dev/null
  chmod 755 "$tmp"
  mv -f "$tmp" "$BASE/client-openwrt"
  ln -sf "$BASE/client-openwrt" /usr/bin/shuoyue-gw 2>/dev/null
  ok "已更新: $VERSION → $newv (旧版备份在 $BASE/client-openwrt.bak)"
  return 0
}

# -----------------------------------------------------------------------------
# 节点链接 / 二维码
# -----------------------------------------------------------------------------
gen_node_link() {   # $1 = idx
  local i="$1"
  local proto addr port uuid password path sni pbk sid flow method enc mode host
  proto=$(conf_get ".nodes[$i].proto")
  addr=$(conf_get ".nodes[$i].address")
  port=$(conf_get ".nodes[$i].port")
  uuid=$(conf_get ".nodes[$i].uuid")
  password=$(conf_get ".nodes[$i].password")
  path=$(conf_get ".nodes[$i].path")
  sni=$(conf_get ".nodes[$i].tls_sni"); [[ -z $sni ]] && sni=$addr
  pbk=$(conf_get ".nodes[$i].pbk"); sid=$(conf_get ".nodes[$i].sid")
  flow=$(conf_get ".nodes[$i].flow"); method=$(conf_get ".nodes[$i].method")
  enc=$(conf_get ".nodes[$i].enc"); mode=$(conf_get ".nodes[$i].mode")
  host=$(conf_get ".nodes[$i].host")
  local name; name=$(conf_get ".nodes[$i].name")
  local tag; tag=$(printf '%s' "$name" | jq -sRr @uri)

  case "$proto" in
    vmess-ws|vmess-tcp)
      jq -nc --arg ps "$name" --arg add "$addr" --argjson port "$port" --arg id "$uuid" \
             --arg net "${proto#vmess-}" --arg path "$path" --arg host "$host" \
             '{v:"2", ps:$ps, add:$add, port:$port, id:$id, aid:"0", scy:"auto",
               net:$net, type:"none", host:$host, path:$path, tls:"tls", sni:$host}' | \
        base64 | tr -d '\n' | { read -r b; printf 'vmess://%s#%s' "$b" "$tag"; } ;;
    vless-reality)
      printf 'vless://%s@%s:%s?encryption=none&security=reality&sni=%s&fp=chrome&pbk=%s&sid=%s&flow=%s&type=tcp#%s' \
        "$uuid" "$addr" "$port" "$sni" "$pbk" "$sid" "${flow:-xtls-rprx-vision}" "$tag" ;;
    vless-reality-xhttp)
      printf 'vless://%s@%s:%s?encryption=none&security=reality&sni=%s&fp=chrome&pbk=%s&sid=%s&type=xhttp&path=%s&mode=%s#%s' \
        "$uuid" "$addr" "$port" "$sni" "$pbk" "$sid" "${path:-/}" "${mode:-auto}" "$tag" ;;
    vless-xhttp-tls)
      printf 'vless://%s@%s:%s?encryption=none&security=tls&sni=%s&fp=chrome&type=xhttp&path=%s&mode=%s#%s' \
        "$uuid" "$addr" "$port" "$sni" "${path:-/}" "${mode:-auto}" "$tag" ;;
    vless-ws-enc)
      printf 'vless://%s@%s:%s?encryption=%s&security=tls&sni=%s&fp=chrome&type=ws&path=%s#%s' \
        "$uuid" "$addr" "$port" "$(urlenc "$enc")" "$sni" "$path" "$tag" ;;
    vless-xhttp-enc)
      printf 'vless://%s@%s:%s?encryption=%s&security=tls&sni=%s&fp=chrome&type=xhttp&path=%s&mode=%s#%s' \
        "$uuid" "$addr" "$port" "$(urlenc "$enc")" "$sni" "${path:-/}" "${mode:-auto}" "$tag" ;;
    vless-ws)
      printf 'vless://%s@%s:%s?encryption=none&security=tls&sni=%s&type=ws&path=%s#%s' \
        "$uuid" "$addr" "$port" "$sni" "$path" "$tag" ;;
    vless-tcp)
      printf 'vless://%s@%s:%s?encryption=none&security=tls&sni=%s&type=tcp#%s' \
        "$uuid" "$addr" "$port" "$sni" "$tag" ;;
    trojan-ws)
      printf 'trojan://%s@%s:%s?security=tls&sni=%s&type=ws&path=%s#%s' \
        "$password" "$addr" "$port" "$sni" "$path" "$tag" ;;
    trojan-tcp)
      printf 'trojan://%s@%s:%s?security=tls&sni=%s&type=tcp#%s' \
        "$password" "$addr" "$port" "$sni" "$tag" ;;
    ss)
      local ui; ui=$(b64url_encode "${method}:${password}")
      printf 'ss://%s@%s:%s#%s' "$ui" "$addr" "$port" "$tag" ;;
    hy2)
      printf 'hysteria2://%s@%s:%s?sni=%s#%s' "$password" "$addr" "$port" "$sni" "$tag" ;;
    tuic)
      printf 'tuic://%s:%s@%s:%s?sni=%s&alpn=h3#%s' "$uuid" "$password" "$addr" "$port" "$sni" "$tag" ;;
    anytls)
      printf 'anytls://%s@%s:%s?sni=%s#%s' "$password" "$addr" "$port" "$sni" "$tag" ;;
    naive)
      printf 'naive://%s@%s:%s?sni=%s#%s' "$(urlenc "$uuid:$password")" "$addr" "$port" "$sni" "$tag" ;;
    sssb)
      local ui; ui=$(b64url_encode "${method:-2022-blake3-aes-128-gcm}:${password}")
      printf 'ss://%s@%s:%s#%s' "$ui" "$addr" "$port" "$tag" ;;
    socks)
      local si; si=$(b64url_encode "${uuid}:${password}")
      printf 'socks://%s@%s:%s#%s' "$si" "$addr" "$port" "$tag" ;;
    *) return 1 ;;
  esac
  return 0
}

printNode() {
  local n; n=$(conf_get '.nodes | length'); [[ -z $n || $n -eq 0 ]] && { warn "暂无节点"; return 1; }
  local i; i=$(conf_get '.nodeActive'); [[ -z $i ]] && i=0
  local link; link=$(gen_node_link "$i") || { err "链接生成失败"; return 1; }
  echo
  echo -e "${CYAN}---- 当前节点分享链接 ----${cRES}"
  echo "$link"
  echo
  if command -v qrencode >/dev/null 2>&1; then
    qrencode -t ANSIUTF8 -m 1 "$link" 2>/dev/null || qrencode -t ANSI -m 1 "$link" 2>/dev/null
  else
    warn "未安装 qrencode, 无法显示二维码 (opkg install qrencode)"
  fi
  echo
  ok "复制上面的链接到 v2rayN: 服务器 → 从剪贴板导入批量URL"
  return 0
}

# -----------------------------------------------------------------------------
# 安装 / 卸载 / 状态
# -----------------------------------------------------------------------------
installGWD() {
  is_openwrt || die "本脚本仅支持 OpenWrt / Kwrt (未检测到 opkg)"
  echo
  echo -e "${CYAN}=============================================${cRES}"
  echo -e "${WHITE}   朔月 Shuoyue — OpenWrt 旁路网关客户端${cRES}"
  echo -e "${CYAN}=============================================${cRES}"
  echo

  pkg_dep

  if ! xray_ok; then
    warn "未找到 xray, 尝试通过 opkg 安装..."
    opkg install xray-core >/dev/null 2>&1
    xray_ok || die "xray 不可用, 请先 opkg install xray-core"
  fi
  ok "xray: $(xray_path) $( $(xray_path) version 2>/dev/null | head -n1 | awk '{print $2}' )"

  sb_ok && ok "sing-box: $(sb_path) (hy2/tuic/anytls 可用)" || warn "未找到 sing-box (hy2/tuic/anytls 节点将不可用)"

  conf_init
  mkdir -p "$XRAYDIR" "$SBDIR" "$SDNSDIR" "$LISTDIR" "$NFTDIR"

  # 写入 procd init 脚本(不启动, 避免影响现网)
  init_write_all
  ok "已写入 procd 服务脚本: degwd-gw / degwd-sb / degwd-nft / degwd-dns"

  smartdns_conf
  ok "smartdns 配置已生成 (127.0.0.1:${DNS_PORT}, 不占用 53)"

  # 下载名单
  download_lists

  # 命令软链 (OpenWrt 无 /usr/local/bin)
  ln -sf "$BASE/client-openwrt" /usr/bin/shuoyue-gw 2>/dev/null
  ln -sf "$BASE/client-openwrt" /usr/bin/shuoyue-gw 2>/dev/null || true
  ok "已安装命令: shuoyue-gw"

  echo
  echo -e "${YELLOW}注意: 未自动开启代理。${cRES}"
  echo "  1) 运行 shuoyue-gw 添加节点"
  echo "  2) 在主菜单选择「开启旁路网关」"
  echo
  local c; c=$(ask "现在添加节点? [Y/n]: ")
  if [[ -z $c || ${c,,} == "y" ]]; then
    nodes_add
    [[ -n $(conf_get '.nodeActive') ]] && {
      local c2; c2=$(ask "立即开启旁路网关? [Y/n]: ")
      [[ -z $c2 || ${c2,,} == "y" ]] && proxy_on
    }
  fi
  echo
  ok "安装完成"
  return 0
}

uninstallGWD() {
  yesno "确认卸载朔月 OpenWrt 客户端? (将关闭代理并还原 DNS)" || return 0

  # 停止并禁用自建服务
  local s
  for s in degwd-gw degwd-sb degwd-nft degwd-dns; do
    /etc/init.d/$s stop >/dev/null 2>&1
    /etc/init.d/$s disable >/dev/null 2>&1
    rm -f /etc/init.d/$s
  done

  # 只删自建表与策略路由
  nft delete table ip "$NFT_TABLE" 2>/dev/null
  nft delete table ip degwd_relay 2>/dev/null
  ip rule del fwmark "$NFT_MARK" table "$RT_TABLE" prio "$RT_PRIO" 2>/dev/null
  ip route del local default dev lo scope host table "$RT_TABLE" 2>/dev/null

  # 还原 dnsmasq
  dns_forward_off

  # 移除 cron
  if [[ -f /etc/crontabs/root ]]; then
    local t; t=$(mktemp)
    grep -vF "shuoyue-gw" /etc/crontabs/root >"$t" 2>/dev/null
    mv -f "$t" /etc/crontabs/root
  fi
  /etc/init.d/cron restart >/dev/null 2>&1

  # WireGuard 还原
  uci -q delete network.degwdwg 2>/dev/null
  uci -q delete firewall.degwdwg 2>/dev/null
  uci commit network 2>/dev/null
  uci commit firewall 2>/dev/null
  /etc/init.d/network reload >/dev/null 2>&1
  /etc/init.d/firewall reload >/dev/null 2>&1

  rm -f /usr/bin/shuoyue-gw
  rm -rf "$BASE"
  ok "卸载完成 (DNS 与网络配置已还原)"
  return 0
}


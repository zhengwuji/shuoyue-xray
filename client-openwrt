    echo "  ─────────────────────────────────────────────"
    local c; c=$(ask "选择: ")
    case "${c,,}" in
      1) nodes_menu ;;
      2) split_menu ;;
      3) dns_menu ;;
      4) proxy_toggle ;;
      5) block53_toggle ;;
      6) wg_menu ;;
      7) ddns_menu ;;
      8) relay_menu ;;
      9) download_lists; refresh_nft_sets ;;
      a) health_check full ;;
      b) printNode ;;

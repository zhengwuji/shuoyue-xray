# -----------------------------------------------------------------------------
# DNS: smartdns 分流 (127.0.0.1:6053) + dnsmasq 转发 (可逆)
# -----------------------------------------------------------------------------
smartdns_conf() {
  local doh china dnsport
  doh=$(conf_get '.dns.doh'); [[ -z $doh ]] && doh="$DEFAULT_DOH"
  china=$(conf_get '.dns.china[]' | tr '\n' ' '); [[ -z $china ]] && china="$DNS_ALI $DNS_TENCENT"

  local tmp; tmp=$(mktemp "$SDNSDIR/.smartdns.XXXXXX") || return 1
  cat >"$tmp" <<EOF
# 朔月 Shuoyue — smartdns (OpenWrt)
server-name de_GWD
bind 127.0.0.1:${DNS_PORT}
bind-tcp 127.0.0.1:${DNS_PORT}
speed-check-mode tcp:443,ping,tcp:80
response-mode first-ping
force-AAAA-SOA yes
force-qtype-soa 65
dualstack-ip-selection yes
cache-size 4096
cache-persist yes
cache-file $SDNSDIR/cache.dat
prefetch-domain yes
serve-expired yes
serve-expired-ttl 86400
rr-ttl-min 60
rr-ttl-max 86400
log-level warn
EOF
  if [[ -s $SDNSDIR/chn_domains.txt ]]; then
    printf 'domain-set -name chn -file %s\n' "$SDNSDIR/chn_domains.txt" >>"$tmp"
    printf 'nameserver /domain-set:chn/chn\n' >>"$tmp"
  fi
  local s
  for s in $china; do printf 'server %s -group chn -exclude-default-group\n' "$s" >>"$tmp"; done
  printf 'server-https %s -group global -exclude-default-group -no-check-certificate\n' "$doh" >>"$tmp"
  # 用户自定义 hosts
  conf_get '.dns.hosts' 2>/dev/null | jq -r 'to_entries[] | "address /\(.key)/\(.value)"' >>"$tmp" 2>/dev/null
  # 节点域名钉死 IP(防回环)
  local nodes i addr d ip ncnt
  nodes=$(conf_get '.nodes'); i=0
  ncnt=$(printf '%s' "$nodes" | jq 'length' 2>/dev/null || echo 0)
  while [[ $i -lt $ncnt ]]; do
    addr=$(conf_get ".nodes[$i].address"); split_hostport "$addr"; d=$HOST
    ip=$(conf_get ".nodes[$i].ip")
    [[ -n $ip && -n $d ]] && printf 'address /%s/%s\n' "$d" "$ip" >>"$tmp"
    i=$((i+1))
  done
  chmod 644 "$tmp"
  mv -f "$tmp" "$SDNSDIR/smartdns.conf"
  return 0
}

# 把 dnsmasq 的解析转给 smartdns (照抄 smartdns 官方 init 的可逆做法)
# 注意: UCI CLI 不支持 dhcp.@dnsmasq[0].server[N] 这种数组索引取值,
#       增删列表项必须用 add_list / del_list, 否则永远定位不到自己的那一项。
dns_forward_on() {
  local cur
  cur=$(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null)
  if printf '%s\n' "$cur" | grep -q "127.0.0.1#${DNS_PORT}"; then
    return 0   # 已配置, 幂等
  fi
  # 首次修改前记录原始值, 供卸载精确还原(不覆盖已存在的备份)
  if [[ $(conf_get '.dnsBackup.done' 2>/dev/null) != "true" ]]; then
    conf_raw '.dnsBackup' "$(jq -n \
      --arg srv "$cur" \
      --arg nr  "$(uci -q get dhcp.@dnsmasq[0].noresolv 2>/dev/null)" \
      --arg rp  "$(uci -q get dhcp.@dnsmasq[0].rebind_protection 2>/dev/null)" \
      --arg dn  "$(uci -q get dhcp.@dnsmasq[0].domainneeded 2>/dev/null)" \
      '{done:true, server:$srv, noresolv:$nr, rebind_protection:$rp, domainneeded:$dn}')" \
      || warn "无法记录 dnsmasq 原始配置(卸载时可能无法完全还原)"
  fi
  uci -q add_list "dhcp.@dnsmasq[0].server=127.0.0.1#${DNS_PORT}" || return 1
  uci -q set dhcp.@dnsmasq[0].noresolv='1' || return 1
  uci -q set dhcp.@dnsmasq[0].rebind_protection='0' || return 1
  uci -q set dhcp.@dnsmasq[0].domainneeded='0' || return 1
  uci commit dhcp || return 1
  conf_set '.dnsForward' "true"
  /etc/init.d/dnsmasq reload >/dev/null 2>&1
  return 0
}

dns_forward_off() {
  # 仅移除我们添加的那条 server 项, 其余保持原样
  uci -q del_list "dhcp.@dnsmasq[0].server=127.0.0.1#${DNS_PORT}" 2>/dev/null
  # 按备份还原被我们改过的三个键(有备份才动, 无备份则保持现状)
  if [[ $(conf_get '.dnsBackup.done' 2>/dev/null) == "true" ]]; then
    local k v
    for k in noresolv rebind_protection domainneeded; do
      v=$(conf_get ".dnsBackup.$k" 2>/dev/null)
      if [[ -n $v ]]; then
        uci -q set "dhcp.@dnsmasq[0].$k=$v" 2>/dev/null
      else
        uci -q delete "dhcp.@dnsmasq[0].$k" 2>/dev/null
      fi
    done
    conf_del '.dnsBackup'
  fi
  uci commit dhcp 2>/dev/null
  conf_set '.dnsForward' "false"
  /etc/init.d/dnsmasq reload >/dev/null 2>&1
  return 0
}

dns_forward_ok() {
  local cur; cur=$(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null)
  printf '%s\n' "$cur" | grep -q "127.0.0.1#${DNS_PORT}"
}

# 解析测试(不用 dig; 用 xray/smartdns 自带的查询能力, 回退 nc)
dns_query_test() {
  local host="${1:-www.baidu.com}"
  if command -v nslookup >/dev/null 2>&1; then
    nslookup "$host" 127.0.0.1 >/dev/null 2>&1 && return 0
  fi
  # 回退: 用 socat 发一个最小 DNS 查询(A 记录 0x0001)
  command -v socat >/dev/null 2>&1 || return 2
  printf '\xab\xcd\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x03www\x06baidu\x03com\x00\x00\x01\x00\x01' \
    | socat -T3 - "UDP:127.0.0.1:${DNS_PORT}" 2>/dev/null | head -c 4 | grep -q . && return 0
  return 1
}

# -----------------------------------------------------------------------------
# 名单下载
# -----------------------------------------------------------------------------
dl_file() {   # $1=url $2=out
  local url="$1" out="$2" t
  t=$(mktemp "$LISTDIR/.dl.XXXXXX") || return 1
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --max-time 120 -o "$t" "$url" 2>/dev/null || { rm -f "$t"; return 1; }
  else
    wget -qO "$t" --timeout=120 "$url" 2>/dev/null || { rm -f "$t"; return 1; }
  fi
  [[ -s $t ]] || { rm -f "$t"; return 1; }
  mv -f "$t" "$out"
  return 0
}

download_lists() {
  mkdir -p "$LISTDIR"
  local okc=0
  ok "下载 chnroute 名单..."
  if dl_file "$LIST_URL_CHNROUTE" "$LISTDIR/chnroute.txt"; then
    okc=1
  elif dl_file "$LIST_URL_CHNROUTE_ALT" "$LISTDIR/chnroute.txt"; then
    okc=1
  fi
  if [[ $okc -eq 1 ]]; then
    # 统一为纯 CIDR(剔除注释/空行/非法行)
    local tmp; tmp=$(mktemp "$LISTDIR/.cnr.XXXXXX")
    grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+' "$LISTDIR/chnroute.txt" 2>/dev/null | sort -u >"$tmp"
    local cnt; cnt=$(wc -l <"$tmp" | tr -d ' ')
    if [[ ${cnt:-0} -ge 1000 ]]; then
      mv -f "$tmp" "$LISTDIR/chnroute.txt"; ok "chnroute: $cnt 条"
    else
      rm -f "$tmp"; warn "chnroute 条数异常($cnt), 保留旧名单"
    fi
  else
    warn "chnroute 下载失败(保留旧名单)"
  fi

  ok "下载国内域名名单..."
  if dl_file "$LIST_URL_CHNDOMAIN" "$LISTDIR/china_domains.raw"; then
    local tmp; tmp=$(mktemp "$LISTDIR/.cnd.XXXXXX")
    sed -n 's|^server=/\([^/]*\)/.*|\1|p' "$LISTDIR/china_domains.raw" 2>/dev/null | sort -u >"$tmp"
    local cnt; cnt=$(wc -l <"$tmp" | tr -d ' ')
    if [[ ${cnt:-0} -ge 1000 ]]; then
      mv -f "$tmp" "$SDNSDIR/chn_domains.txt"
      rm -f "$LISTDIR/china_domains.raw"
      ok "chn_domains: $cnt 条"
    else
      rm -f "$tmp"; warn "域名名单条数异常($cnt), 保留旧名单"
    fi
  else
    warn "域名名单下载失败(保留旧名单)"
  fi
}

refresh_nft_sets() {
  if [[ -s $LISTDIR/chnroute.txt ]]; then
    ok "刷新 chnroute 集合..."
    nft_sets_reload chnroute "$LISTDIR/chnroute.txt"
  fi
  [[ -s $LISTDIR/v2node.txt ]] && nft_sets_reload v2node "$LISTDIR/v2node.txt"
  [[ -s $LISTDIR/listblan.txt ]] && nft_sets_reload listblan "$LISTDIR/listblan.txt"
  [[ -s $LISTDIR/listwlan.txt ]] && nft_sets_reload listwlan "$LISTDIR/listwlan.txt"
  # 节点 IP 钉死
  local nodes i ncnt addr ip
  nodes=$(conf_get '.nodes'); i=0
  ncnt=$(printf '%s' "$nodes" | jq 'length' 2>/dev/null || echo 0)
  if [[ ${ncnt:-0} -gt 0 ]]; then
    : >"$LISTDIR/v2node.txt"
    while [[ $i -lt $ncnt ]]; do
      addr=$(conf_get ".nodes[$i].address"); ip=$(conf_get ".nodes[$i].ip")
      if [[ -n $ip ]]; then printf '%s\n' "$ip" >>"$LISTDIR/v2node.txt"
      elif [[ $addr =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then printf '%s\n' "$addr" >>"$LISTDIR/v2node.txt"
      fi
      i=$((i+1))
    done
    [[ -s $LISTDIR/v2node.txt ]] && nft_sets_reload v2node "$LISTDIR/v2node.txt"
  fi
  return 0
}

# -----------------------------------------------------------------------------
# 代理开关
# -----------------------------------------------------------------------------
proxy_on() {
  local n; n=$(conf_get '.nodes | length')
  [[ -z $n || $n -eq 0 ]] && { err "请先添加节点"; return 1; }

  local i; i=$(conf_get '.nodeActive')
  if [[ -z $i ]]; then
    i=0; conf_raw '.nodeActive' "$i"
  fi

  smartdns_conf
  /etc/init.d/degwd-dns restart >/dev/null 2>&1
  dns_forward_on || warn "dnsmasq 转发设置失败(DNS 分流可能不生效)"

  xray_gen_config || { err "xray 配置生成失败, 未开启代理"; return 1; }
  init_write_all
  /etc/init.d/degwd-gw restart >/dev/null 2>&1
  sleep 1
  /etc/init.d/degwd-gw running >/dev/null 2>&1 || { err "xray 启动失败, 查看 $XRAYDIR/error.log"; return 1; }

  apply_node_bridge

  # 生成 nft 规则并应用
  local f; f=$(nft_gen) || return 1
  cp -f "$f" "$NFTDIR/de_GWD.nft" 2>/dev/null
  rm -f "$f"
  nft_apply "$NFTDIR/de_GWD.nft" || return 1
  route_rule_on
  refresh_nft_sets
  /etc/init.d/degwd-nft enable >/dev/null 2>&1
  /etc/init.d/degwd-gw enable >/dev/null 2>&1
  /etc/init.d/degwd-dns enable >/dev/null 2>&1
  conf_raw '.proxyOn' "true"
  ok "旁路网关已开启 (节点: $(conf_get ".nodes[$i].name"))"
  return 0
}

proxy_off() {
  /etc/init.d/degwd-gw stop >/dev/null 2>&1
  /etc/init.d/degwd-gw disable >/dev/null 2>&1
  sb_bridge_off
  /etc/init.d/degwd-nft stop >/dev/null 2>&1
  /etc/init.d/degwd-nft disable >/dev/null 2>&1
  route_rule_off
  conf_raw '.proxyOn' "false"
  ok "旁路网关已关闭 (流量恢复直连)"
  return 0
}

proxy_toggle() {
  if [[ $(conf_get '.proxyOn') == "true" ]]; then
    proxy_off
  else
    proxy_on
  fi
}

# -----------------------------------------------------------------------------
# 节点管理
# -----------------------------------------------------------------------------
nodes_list() {
  local n i
  n=$(conf_get '.nodes | length'); [[ -z $n ]] && n=0
  if [[ $n -eq 0 ]]; then
    warn "暂无节点, 请先添加"
    return 1
  fi
  local act; act=$(conf_get '.nodeActive')
  printf '  %-3s %-20s %-14s %-8s %s\n' "序号" "名称" "地址" "协议" "状态"
  i=0
  while [[ $i -lt $n ]]; do
    local nm ad pt pr mk=""
    nm=$(conf_get ".nodes[$i].name")
    ad=$(conf_get ".nodes[$i].address")
    pt=$(conf_get ".nodes[$i].port")
    pr=$(conf_get ".nodes[$i].proto")
    [[ $i == "$act" ]] && mk="${GREEN}● 当前${cRES}"
    printf '  %-3s %-20s %-14s %-8s %b\n' "$i" "${nm:0:20}" "${ad:0:14}" "$pr" "$mk"
    i=$((i+1))
  done
  return 0
}

nodes_add() {
  echo "  支持: vmess:// vless:// trojan:// ss:// hysteria2:// tuic:// anytls:// socks5://"
  local url; url=$(ask "  粘贴分享链接(可多个, 空格分隔): ")
  [[ -z $url ]] && return 1
  local added=0 fail=0 u node
  for u in $url; do
    node=$(parse_share_link "$u") || { warn "无法解析: ${u:0:40}..."; fail=$((fail+1)); continue; }
    [[ -z $node ]] && { fail=$((fail+1)); continue; }
    # 解析地址为 IP(用于防回环钉死); 有 nslookup 才做
    local h ip=""
    h=$(printf '%s' "$node" | jq -r '.address')
    if [[ $h =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      ip=$h
    elif command -v nslookup >/dev/null 2>&1; then
      ip=$(nslookup "$h" "$DNS_ALI" 2>/dev/null | awk '/^Address: /{print $2}' | grep -E '^[0-9.]+$' | head -n1)
    fi
    [[ -n $ip ]] && node=$(printf '%s' "$node" | jq -c --arg ip "$ip" '. + {ip:$ip}')
    if conf_write '.nodes += [$n]' --argjson n "$node"; then
      added=$((added+1))
    else
      fail=$((fail+1))
    fi
  done
  [[ $added -gt 0 ]] && ok "已添加 $added 个节点"
  [[ $fail -gt 0 ]] && warn "$fail 个链接解析失败"
  # 首个节点自动激活
  [[ -z $(conf_get '.nodeActive') && $added -gt 0 ]] && conf_raw '.nodeActive' "0"
  [[ $added -gt 0 ]] && [[ $(conf_get '.proxyOn') == "true" ]] && proxy_on
  return 0
}

nodes_switch() {
  nodes_list || return 1
  local n i; n=$(conf_get '.nodes | length')
  local idx; idx=$(ask "  选择节点序号: ")
  [[ -z $idx ]] && return 1
  [[ $idx =~ ^[0-9]+$ ]] || { err "请输入数字"; return 1; }
  (( idx >= 0 && idx < n )) || { err "序号超范围 (0-$((n-1)))"; return 1; }
  conf_raw '.nodeActive' "$idx"
  ok "已切换到: $(conf_get ".nodes[$idx].name")"
  [[ $(conf_get '.proxyOn') == "true" ]] && proxy_on
  return 0
}

nodes_ping() {
  local n i; n=$(conf_get '.nodes | length'); [[ -z $n || $n -eq 0 ]] && { warn "暂无节点"; return 1; }
  command -v nc >/dev/null 2>&1 || { warn "缺少 nc, 无法测试"; return 1; }
  ok "测试节点连通性..."
  i=0
  while [[ $i -lt $n ]]; do
    local h p nm
    h=$(conf_get ".nodes[$i].address"); p=$(conf_get ".nodes[$i].port")
    nm=$(conf_get ".nodes[$i].name" | cut -c1-20)
    # busybox nc 只支持 nc IP PORT, 无 -z; 用 timeout 包一层判断退出码
    if timeout 3 nc "$h" "$p" </dev/null >/dev/null 2>&1; then
      printf '  %-3s %-20s %b\n' "$i" "$nm" "${GREEN}✓ 可达${cRES}"
    else
      # 443/8443 等 TLS 端口 nc 无数据即断开属正常, 再用 /dev/tcp 兜底
      if timeout 3 bash -c "exec 3<>/dev/tcp/$h/$p" 2>/dev/null; then
        printf '  %-3s %-20s %b\n' "$i" "$nm" "${GREEN}✓ 可达${cRES}"
      else
        printf '  %-3s %-20s %b\n' "$i" "$nm" "${RED}✕ 不可达${cRES}"
      fi
    fi
    i=$((i+1))
  done
  return 0
}

nodes_speed() {
  local n; n=$(conf_get '.nodes | length'); [[ -z $n || $n -eq 0 ]] && { warn "暂无节点"; return 1; }
  local idx; idx=$(ask "  选择节点序号测速: ")
  [[ $idx =~ ^[0-9]+$ ]] || return 1
  (( idx >= 0 && idx < n )) || { err "序号超范围"; return 1; }
  local h p t0 t1 ms
  h=$(conf_get ".nodes[$idx].address"); p=$(conf_get ".nodes[$idx].port")
  # 用 curl 的 time_connect 测 TCP 握手延迟(不依赖外网)
  local out
  out=$(curl -s -o /dev/null -w '%{time_connect}' --max-time 8 --connect-timeout 5 \
        "http://$h:$p/" 2>/dev/null)
  if [[ -z $out || $out == "0.000000" ]]; then
    warn "连接失败(节点不可达或端口未开放)"
    return 1
  fi
  ms=$(awk -v t="$out" 'BEGIN{printf "%.0f", t*1000}')
  ok "TCP 握手延迟: ${ms}ms"
  return 0
}

nodes_del() {
  nodes_list || return 1

# -----------------------------------------------------------------------------
# 分享链接解析
# -----------------------------------------------------------------------------
b64url_decode() {
  local s="${1//-/+}"; s="${s//_/\/}"
  case $(( ${#s} % 4 )) in 2) s="$s==" ;; 3) s="$s=" ;; esac
  printf '%s' "$s" | base64 -d 2>/dev/null
}
b64url_encode() { printf '%s' "$1" | base64 | tr -d '\n' | tr '+/' '-_' | tr -d '='; }

# URL 百分号编码 (与 server 的 urlenc 行为一致, 用于链接参数)
urlenc() {
  local s="$1" out="" c
  while [[ -n $s ]]; do
    c=${s:0:1}; s=${s:1}
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s' "$out"
}

urldecode() {
  local s="$1" out="" head c
  while [[ $s == *%* ]]; do
    head=${s%%\%*}; out+="$head"; s=${s#*%}
    c=${s:0:2}; s=${s:2}
    if [[ $c =~ ^[0-9A-Fa-f]{2}$ ]]; then out+=$(printf "\\x$c"); else out+="%$c"; fi
  done
  printf '%s' "$out$s"
}
# 取 query 参数。$2 允许传完整链接或已剥掉 '?' 的 query 串, 两种形态都支持。
# 注意: 生产调用方传入的 q 已剥掉前导 '?', 故必须补一个哨兵 '&',
# 否则第一个参数(如 encryption= 或 security=)永远匹配不到。
qget() {
  local q="$2" v
  q=${q%%#*}          # 去掉 fragment
  q=${q#*\?}          # 若含 '?' 则取其后的 query 部分
  v=$(printf '&%s' "$q" | grep -oE "[&#]$1=[^&]*" | head -n1 | cut -d= -f2-)
  printf '%s' "$(urldecode "$v")"
}
frag_of() { local f="${1##*#}"; [[ $f == "$1" ]] && f=""; printf '%s' "$(urldecode "$f")"; }
norm_bool() { case "${1,,}" in 1|true|yes) echo 1 ;; *) echo 0 ;; esac; }
# 拆分 host:port, 支持 [ipv6]:port
split_hostport() {
  local hp="$1"
  if [[ $hp == \[*\]* ]]; then
    HOST=${hp%%\]*}; HOST=${HOST#[}
    PORT=${hp##*\]:}
  else
    HOST=${hp%%:*}; PORT=${hp##*:}
  fi
  [[ $PORT =~ ^[0-9]+$ ]] || PORT=443
  return 0
}

parse_vmess() {
  local raw j
  raw=$(b64url_decode "${1#vmess://}")
  [[ -z $raw ]] && return 1
  j=$(printf '%s' "$raw" | jq -c . 2>/dev/null) || return 1
  jq -n --argjson j "$j" '{
    proto:   (if (($j.net // "tcp") | ascii_downcase) == "ws" then "vmess-ws" else "vmess-tcp" end),
    name:    ($j.ps // $j.add // "vmess"),
    address: ($j.add | tostring),
    port:    (($j.port // 443) | tonumber),
    uuid:    ($j.id | tostring),
    aid:     (($j.aid // 0) | tonumber),
    method:  ($j.scy // "auto"),
    network: ($j.net // "tcp"),
    path:    ($j.path // ""),
    host:    ($j.host // ""),
    tls:     ((($j.tls // "") | tostring) == "tls"),
    sni:     ($j.sni // $j.host // ""),
    alpn:    ($j.alpn // ""),
    fp:      ($j.fp // ""),
    insecure: (if (((($j.allowInsecure // false) | tostring) == "true") or ((($j.allowInsecure // 0) | tostring) == "1")) then 1 else 0 end)
  }' 2>/dev/null
}

parse_vless() {
  local url="$1" body frag q uuid hostport name
  local type security pbk sid fp sni flow path host mode alpn enc ins
  body=${url#vless://}
  frag=$(frag_of "$body"); name="$frag"
  body=${body%%#*}; q=""
  [[ $body == *\?* ]] && { q=${body#*\?}; body=${body%%\?*}; }
  uuid=${body%%@*}; hostport=${body#*@}
  split_hostport "$hostport"
  type=$(qget type "$q");      type=${type:-tcp}
  security=$(qget security "$q")
  pbk=$(qget pbk "$q");        sid=$(qget sid "$q")
  fp=$(qget fp "$q");          sni=$(qget sni "$q")
  flow=$(qget flow "$q");      path=$(qget path "$q")
  host=$(qget host "$q");      mode=$(qget mode "$q")
  alpn=$(qget alpn "$q");      enc=$(qget encryption "$q")
  ins=$(qget allowInsecure "$q")
  [[ -z $name ]] && name="$HOST"
  local proto
  # VLESS 加密(encryption=mlkem768x25519plus...) 需与传输层一起判定
  local venc=""; [[ -n $enc && $enc != "none" ]] && venc="1"
  case "$security:$type" in
    reality:tcp|reality:raw) proto="vless-reality" ;;
    reality:xhttp)           proto="vless-reality-xhttp" ;;
    tls:xhttp)               if [[ -n $venc ]]; then proto="vless-xhttp-enc"; else proto="vless-xhttp-tls"; fi ;;
    *:ws)                    if [[ -n $venc ]]; then proto="vless-ws-enc"; else proto="vless-ws"; fi ;;
    *:xhttp)                 if [[ -n $venc ]]; then proto="vless-xhttp-enc"; else proto="vless-xhttp-tls"; fi ;;
    *)                       proto="vless-tcp" ;;
  esac
  jq -n --arg p "$proto" --arg n "$name" --arg a "$HOST" --argjson pt "$PORT" \
        --arg u "$uuid" --arg ty "$type" --arg se "$security" --arg pbk "$pbk" \
        --arg sid "$sid" --arg fp "$fp" --arg sni "$sni" --arg flow "$flow" \
        --arg path "$path" --arg host "$host" --arg mode "$mode" \
        --arg alpn "$alpn" --arg enc "$enc" --argjson ins "$(norm_bool "$ins")" \
        '{proto:$p, name:$n, address:$a, port:$pt, uuid:$u, network:$ty, security:$se,
          pbk:$pbk, sid:$sid, fp:$fp, tls_sni:$sni, flow:$flow, path:$path,
          host:$host, mode:$mode, alpn:$alpn, enc:$enc, insecure:$ins}' 2>/dev/null
}

parse_trojan() {
  local url="$1" body frag q pass hostport name
  body=${url#trojan://}
  frag=$(frag_of "$body"); name="$frag"
  body=${body%%#*}; q=""
  [[ $body == *\?* ]] && { q=${body#*\?}; body=${body%%\?*}; }
  pass=${body%%@*}; hostport=${body#*@}
  split_hostport "$hostport"
  [[ -z $name ]] && name="$HOST"
  local type sni ins
  type=$(qget type "$q"); type=${type:-tcp}
  sni=$(qget sni "$q"); [[ -z $sni ]] && sni=$(qget peer "$q")
  ins=$(qget allowInsecure "$q")
  local proto; [[ $type == "ws" ]] && proto="trojan-ws" || proto="trojan-tcp"
  jq -n --arg p "$proto" --arg n "$name" --arg a "$HOST" --argjson pt "$PORT" \
        --arg pw "$pass" --arg ty "$type" --arg sni "$sni" --arg path "$(qget path "$q")" \
        --arg host "$(qget host "$q")" --argjson ins "$(norm_bool "$ins")" \
        '{proto:$p, name:$n, address:$a, port:$pt, password:$pw, network:$ty,
          tls_sni:$sni, path:$path, host:$host, insecure:$ins}' 2>/dev/null
}

parse_ss() {
  local url="$1" body frag name userinfo hp method password
  body=${url#ss://}
  frag=$(frag_of "$body"); name="$frag"
  body=${body%%#*}
  [[ $body == *\?* ]] && body=${body%%\?*}
  if [[ $body == *@* ]]; then
    userinfo=${body%%@*}; hp=${body#*@}
    [[ $userinfo != *:* ]] && userinfo=$(b64url_decode "$userinfo")
  else
    local dec; dec=$(b64url_decode "$body")
    [[ -z $dec ]] && return 1
    userinfo=${dec%%@*}; hp=${dec#*@}
  fi
  method=${userinfo%%:*}; password=${userinfo#*:}
  split_hostport "$hp"
  [[ -z $name ]] && name="$HOST"
  jq -n --arg n "$name" --arg a "$HOST" --argjson pt "$PORT" \
        --arg m "$method" --arg pw "$password" \
        '{proto:"ss", name:$n, address:$a, port:$pt, method:$m, password:$pw}' 2>/dev/null
}

parse_hy2() {
  local url="$1" body frag q hp name
  body=${url#hysteria2://}; [[ $body == "$url" ]] && body=${url#hy2://}
  frag=$(frag_of "$body"); name="$frag"
  body=${body%%#*}; q=""
  [[ $body == *\?* ]] && { q=${body#*\?}; body=${body%%\?*}; }
  local pass hp2; pass=${body%%@*}; hp2=${body#*@}
  [[ $hp2 == "$body" ]] && { hp2=$body; pass=""; }
  split_hostport "$hp2"
  [[ -z $name ]] && name="$HOST"
  jq -n --arg n "$name" --arg a "$HOST" --argjson pt "$PORT" --arg pw "$pass" \
        --arg sni "$(qget sni "$q")" --arg obfs "$(qget obfs "$q")" \
        --argjson ins "$(norm_bool "$(qget insecure "$q")")" \
        '{proto:"hy2", name:$n, address:$a, port:$pt, password:$pw,
          tls_sni:$sni, obfs:$obfs, insecure:$ins}' 2>/dev/null
}

parse_tuic() {
  local url="$1" body frag q hp name uuid pass
  body=${url#tuic://}
  frag=$(frag_of "$body"); name="$frag"
  body=${body%%#*}; q=""
  [[ $body == *\?* ]] && { q=${body#*\?}; body=${body%%\?*}; }
  hp=${body#*@}; [[ $hp == "$body" ]] && hp=$body
  uuid=${body%%@*}; [[ $uuid == "$body" ]] && uuid=""
  pass=""
  [[ $uuid == *:* ]] && { pass=${uuid#*:}; uuid=${uuid%%:*}; }
  split_hostport "$hp"
  [[ -z $name ]] && name="$HOST"
  jq -n --arg n "$name" --arg a "$HOST" --argjson pt "$PORT" --arg u "$uuid" --arg pw "$pass" \
        --arg sni "$(qget sni "$q")" --arg alpn "$(qget alpn "$q")" \
        --argjson ins "$(norm_bool "$(qget allow_insecure "$q")")" \
        '{proto:"tuic", name:$n, address:$a, port:$pt, uuid:$u, password:$pw,
          tls_sni:$sni, alpn:$alpn, insecure:$ins}' 2>/dev/null
}

parse_anytls() {
  local url="$1" body frag q hp name pass
  body=${url#anytls://}
  frag=$(frag_of "$body"); name="$frag"
  body=${body%%#*}; q=""
  [[ $body == *\?* ]] && { q=${body#*\?}; body=${body%%\?*}; }
  hp=${body#*@}; pass=${body%%@*}
  [[ $hp == "$body" ]] && { hp=$body; pass=""; }
  split_hostport "$hp"
  [[ -z $name ]] && name="$HOST"
  jq -n --arg n "$name" --arg a "$HOST" --argjson pt "$PORT" --arg pw "$pass" \
        --arg sni "$(qget sni "$q")" \
        --argjson ins "$(norm_bool "$(qget insecure "$q")")" \
        '{proto:"anytls", name:$n, address:$a, port:$pt, password:$pw,
          tls_sni:$sni, insecure:$ins}' 2>/dev/null
}

parse_socks() {
  local url="$1" body frag q hp name user pass
  body=${url#socks5://}; [[ $body == "$url" ]] && body=${url#socks://}
  frag=$(frag_of "$body"); name="$frag"
  body=${body%%#*}; q=""
  [[ $body == *\?* ]] && { q=${body#*\?}; body=${body%%\?*}; }
  if [[ $body == *@* ]]; then hp=${body#*@}; user=${body%%@*}
  else hp=$body; user=""
  fi
  pass=""; [[ $user == *:* ]] && { pass=${user#*:}; user=${user%%:*}; }
  split_hostport "$hp"
  [[ -z $name ]] && name="$HOST"
  jq -n --arg n "$name" --arg a "$HOST" --argjson pt "$PORT" --arg u "$user" --arg pw "$pass" \
        '{proto:"socks", name:$n, address:$a, port:$pt, uuid:$u, password:$pw}' 2>/dev/null
}

# naive+https (NaiveProxy; 服务端由 sing-box naive inbound 提供, 仅 sing-box 客户端可用)
parse_naive() {
  local url="$1" body frag q hp name user pass
  body=${url#naive://}; [[ $body == "$url" ]] && body=${url#naive+https://}
  frag=$(frag_of "$body"); name="$frag"
  body=${body%%#*}; q=""
  [[ $body == *\?* ]] && { q=${body#*\?}; body=${body%%\?*}; }
  if [[ $body == *@* ]]; then hp=${body#*@}; user=$(urldecode "${body%%@*}")
  else hp=$body; user=""
  fi
  pass=""; [[ $user == *:* ]] && { pass=${user#*:}; user=${user%%:*}; }
  split_hostport "$hp"
  local sni ins; sni=$(qget sni "$q"); [[ -z $sni ]] && sni=$HOST
  ins=$(qget insecure "$q"); [[ -z $ins ]] && ins=$(qget allow_insecure "$q")
  [[ -z $name ]] && name="$HOST"
  jq -n --arg n "$name" --arg a "$HOST" --argjson pt "$PORT" --arg u "$user" --arg pw "$pass" \
        --arg sn "$sni" --argjson ins "$(norm_bool "$ins")" \
        '{proto:"naive", name:$n, address:$a, port:$pt, uuid:$u, password:$pw,
          tls_sni:$sn, insecure:$ins}' 2>/dev/null
}

# 统一入口: 输出节点 JSON(失败返回 1)
parse_share_link() {
  local url="$1" s
  url=$(printf '%s' "$url" | tr -d ' \t\r\n')
  s=${url%%://*}
  case "$s" in
    vmess)               parse_vmess   "$url" ;;
    vless)               parse_vless   "$url" ;;
    trojan)              parse_trojan  "$url" ;;
    ss)                  parse_ss      "$url" ;;
    hysteria2|hy2)       parse_hy2     "$url" ;;
    tuic)                parse_tuic    "$url" ;;
    anytls)              parse_anytls  "$url" ;;
    naive|naive+https)   parse_naive   "$url" ;;
    socks|socks5|socks4) parse_socks   "$url" ;;
    *) return 1 ;;
  esac
}

# -----------------------------------------------------------------------------
# Xray 出站 / 配置生成
# -----------------------------------------------------------------------------
node_needs_bridge() {
  local p; p=$(conf_get ".nodes[$1].proto" 2>/dev/null)
  [[ $p == "hy2" || $p == "tuic" || $p == "anytls" || $p == "naive" || $p == "sssb" ]]
}

node_outbound() {   # $1=节点下标 $2=tag
  local i="$1" tag="$2"
  local proto addr host port uuid password path sni pbk sid flow method ins scy net alpn fp enc mode
  addr=$(conf_get ".nodes[$i].address")
  proto=$(conf_get ".nodes[$i].proto")
  port=$(conf_get ".nodes[$i].port")
  host=${addr}
  [[ -z $port ]] && port=$(conf_get ".nodes[$i].port")
  uuid=$(conf_get ".nodes[$i].uuid")
  password=$(conf_get ".nodes[$i].password")
  path=$(conf_get ".nodes[$i].path")
  sni=$(conf_get ".nodes[$i].tls_sni"); [[ -z $sni ]] && sni=$host
  pbk=$(conf_get ".nodes[$i].pbk"); sid=$(conf_get ".nodes[$i].sid")
  flow=$(conf_get ".nodes[$i].flow"); method=$(conf_get ".nodes[$i].method")
  scy=$(conf_get ".nodes[$i].method"); net=$(conf_get ".nodes[$i].network")
  alpn=$(conf_get ".nodes[$i].alpn"); fp=$(conf_get ".nodes[$i].fp")
  enc=$(conf_get ".nodes[$i].enc"); mode=$(conf_get ".nodes[$i].mode")
  ins=$(conf_get ".nodes[$i].insecure"); [[ $ins == "1" ]] && ins=true || ins=false

  local sockopt='{"mark":255,"tcpFastOpen":true,"tcpNoDelay":true}'

  case "$proto" in
    vmess-ws)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg path "$path" \
            --arg h "$(conf_get ".nodes[$i].host")" --arg sn "$sni" --argjson ins "$ins" \
            --argjson so "$sockopt" \
            '{protocol:"vmess", tag:$tag,
              settings:{vnext:[{address:$s, port:$p, users:[{id:$u, alterId:0, security:"auto"}]}]},
              streamSettings:{network:"ws", security:"tls",
                tlsSettings:{serverName:$sn, allowInsecure:$ins, fingerprint:"chrome"},
                wsSettings:{path:$path, headers:(if $h=="" then {} else {Host:$h} end)},
                sockopt:$so}}' ;;
    vmess-tcp)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --argjson so "$sockopt" \
            '{protocol:"vmess", tag:$tag,
              settings:{vnext:[{address:$s, port:$p, users:[{id:$u, alterId:0, security:"auto"}]}]},
              streamSettings:{network:"tcp", sockopt:$so}}' ;;
    vless-reality)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg sn "$sni" \
            --arg pbk "$pbk" --arg sid "$sid" --arg fp "${fp:-chrome}" --arg flow "${flow:-xtls-rprx-vision}" \
            --argjson so "$sockopt" \
            '{protocol:"vless", tag:$tag,
              settings:{vnext:[{address:$s, port:$p, users:[{id:$u, encryption:"none", flow:$flow}]}]},
              streamSettings:{network:"tcp", security:"reality",
                realitySettings:{serverName:$sn, publicKey:$pbk, shortId:$sid, fingerprint:$fp, spiderX:"/"},
                sockopt:$so}}' ;;
    vless-reality-xhttp)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg sn "$sni" \
            --arg pbk "$pbk" --arg sid "$sid" --arg fp "${fp:-chrome}" --arg path "$path" \
            --arg h "$(conf_get ".nodes[$i].host")" --arg mode "${mode:-auto}" --argjson so "$sockopt" \
            '{protocol:"vless", tag:$tag,
              settings:{vnext:[{address:$s, port:$p, users:[{id:$u, encryption:"none"}]}]},
              streamSettings:{network:"xhttp", security:"reality",
                xhttpSettings:{path:$path, host:$h, mode:$mode},
                realitySettings:{serverName:$sn, publicKey:$pbk, shortId:$sid, fingerprint:$fp, spiderX:"/"},
                sockopt:$so}}' ;;
    vless-xhttp-tls)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg sn "$sni" --arg path "$path" \
            --arg h "$(conf_get ".nodes[$i].host")" --arg mode "${mode:-auto}" --argjson ins "$ins" \
            --argjson so "$sockopt" \
            '{protocol:"vless", tag:$tag,
              settings:{vnext:[{address:$s, port:$p, users:[{id:$u, encryption:"none"}]}]},
              streamSettings:{network:"xhttp", security:"tls",
                xhttpSettings:{path:$path, host:$h, mode:$mode},
                tlsSettings:{serverName:$sn, allowInsecure:$ins, fingerprint:"chrome"},
                sockopt:$so}}' ;;
    vless-ws-enc)
      # VLESS 加密: users[].encryption 携带客户端 encryption 串 (xray vlessenc 输出)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg path "$path" \
            --arg h "$(conf_get ".nodes[$i].host")" --arg sn "$sni" --arg enc "$enc" \
            --argjson ins "$ins" --argjson so "$sockopt" \
            '{protocol:"vless", tag:$tag,
              settings:{vnext:[{address:$s, port:$p, users:[{id:$u, encryption:$enc}]}]},
              streamSettings:{network:"ws", security:"tls",
                tlsSettings:{serverName:$sn, allowInsecure:$ins, fingerprint:"chrome"},
                wsSettings:{path:$path, headers:(if $h=="" then {} else {Host:$h} end)},
                sockopt:$so}}' ;;
    vless-xhttp-enc)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg sn "$sni" \
            --arg path "$path" --arg h "$(conf_get ".nodes[$i].host")" --arg mode "${mode:-auto}" \
            --arg enc "$enc" --argjson ins "$ins" --argjson so "$sockopt" \
            '{protocol:"vless", tag:$tag,
              settings:{vnext:[{address:$s, port:$p, users:[{id:$u, encryption:$enc}]}]},
              streamSettings:{network:"xhttp", security:"tls",
                xhttpSettings:{path:$path, host:$h, mode:$mode},
                tlsSettings:{serverName:$sn, allowInsecure:$ins, fingerprint:"chrome"},
                sockopt:$so}}' ;;
    vless-ws)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg path "$path" \
            --arg h "$(conf_get ".nodes[$i].host")" --arg sn "$sni" --argjson ins "$ins" \
            --argjson so "$sockopt" \
            '{protocol:"vless", tag:$tag,
              settings:{vnext:[{address:$s, port:$p, users:[{id:$u, encryption:"none"}]}]},
              streamSettings:{network:"ws", security:"tls",
                tlsSettings:{serverName:$sn, allowInsecure:$ins, fingerprint:"chrome"},
                wsSettings:{path:$path, headers:(if $h=="" then {} else {Host:$h} end)},
                sockopt:$so}}' ;;
    vless-tcp)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg sn "$sni" --argjson ins "$ins" \
            --argjson so "$sockopt" \
            '{protocol:"vless", tag:$tag,
              settings:{vnext:[{address:$s, port:$p, users:[{id:$u, encryption:"none"}]}]},
              streamSettings:{network:"tcp", security:"tls",
                tlsSettings:{serverName:$sn, allowInsecure:$ins, fingerprint:"chrome"},
                sockopt:$so}}' ;;
    trojan-ws)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg pw "$password" --arg path "$path" \
            --arg h "$(conf_get ".nodes[$i].host")" --arg sn "$sni" --argjson ins "$ins" \
            --argjson so "$sockopt" \
            '{protocol:"trojan", tag:$tag,
              settings:{servers:[{address:$s, port:$p, password:$pw}]},
              streamSettings:{network:"ws", security:"tls",
                tlsSettings:{serverName:$sn, allowInsecure:$ins, fingerprint:"chrome"},
                wsSettings:{path:$path, headers:(if $h=="" then {} else {Host:$h} end)},
                sockopt:$so}}' ;;
    trojan-tcp)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg pw "$password" --arg sn "$sni" --argjson ins "$ins" \
            --argjson so "$sockopt" \
            '{protocol:"trojan", tag:$tag,
              settings:{servers:[{address:$s, port:$p, password:$pw}]},
              streamSettings:{network:"tcp", security:"tls",
                tlsSettings:{serverName:$sn, allowInsecure:$ins, fingerprint:"chrome"},
                sockopt:$so}}' ;;
    ss)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg m "${method:-chacha20-ietf-poly1305}" --arg pw "$password" \
            --argjson so "$sockopt" \
            '{protocol:"shadowsocks", tag:$tag,
              settings:{servers:[{address:$s, port:$p, method:$m, password:$pw, uot:true}]},
              streamSettings:{network:"tcp", sockopt:$so}}' ;;
    socks)
      jq -n --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg pw "$password" --argjson so "$sockopt" \
            '{protocol:"socks", tag:$tag,
              settings:{servers:[{address:$s, port:$p,
                users:(if $u=="" then [] else [{user:$u, pass:$pw}] end)}]},
              streamSettings:{network:"tcp", sockopt:$so}}' ;;
    hy2|tuic|anytls|naive|sssb)
      # 由 sing-box 桥接: xray 出口指向 127.0.0.1:10808 (socks)
      jq -n --arg tag "$tag" --argjson so "$sockopt" \
            '{protocol:"socks", tag:$tag,
              settings:{servers:[{address:"127.0.0.1", port:10808}]},
              streamSettings:{network:"tcp", sockopt:$so}}' ;;
    *) return 1 ;;
  esac
}

# 生成 sing-box 客户端配置(仅 hy2/tuic/anytls 需要)
sb_client_gen() {
  local i; i=$(conf_get '.nodeActive')
  [[ -z $i ]] && return 1
  local proto addr host port uuid password sni insecure
  addr=$(conf_get ".nodes[$i].address"); split_hostport "$addr"; host=$HOST; port=$PORT
  proto=$(conf_get ".nodes[$i].proto")
  uuid=$(conf_get ".nodes[$i].uuid"); password=$(conf_get ".nodes[$i].password")
  sni=$(conf_get ".nodes[$i].tls_sni"); [[ -z $sni ]] && sni=$host
  insecure=$(conf_get ".nodes[$i].insecure"); [[ $insecure == "1" ]] && insecure=true || insecure=false
  local out
  case "$proto" in
    hy2)
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg pw "$password" --arg sn "$sni" --argjson ins "$insecure" \
        '{type:"hysteria2", tag:"sbproxy", server:$s, server_port:$p, password:$pw,
          tls:{enabled:true, server_name:$sn, insecure:$ins}}') ;;
    tuic)
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg pw "$password" --arg sn "$sni" --argjson ins "$insecure" \
        '{type:"tuic", tag:"sbproxy", server:$s, server_port:$p, uuid:$u, password:$pw,
          congestion_control:"bbr",
          tls:{enabled:true, server_name:$sn, insecure:$ins, alpn:["h3"]}}') ;;
    anytls)
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg pw "$password" --arg sn "$sni" --argjson ins "$insecure" \
        '{type:"anytls", tag:"sbproxy", server:$s, server_port:$p, password:$pw,
          tls:{enabled:true, server_name:$sn, insecure:$ins}}') ;;
    naive)
      # sing-box 1.14 的 naive outbound 既不支持 insecure 也不支持 alpn, 仅保留 TLS 基本项
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg pw "$password" --arg sn "$sni" \
        '{type:"naive", tag:"sbproxy", server:$s, server_port:$p, username:$u, password:$pw,
          quic:false,
          tls:{enabled:true, server_name:$sn}}') ;;
    sssb)
      local m; m=$(conf_get ".nodes[$i].method"); [[ -z $m ]] && m="2022-blake3-aes-128-gcm"
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg m "$m" --arg pw "$password" \
        '{type:"shadowsocks", tag:"sbproxy", server:$s, server_port:$p, method:$m, password:$pw}') ;;
    *) return 1 ;;
  esac
  [[ -z $out ]] && return 1
  # 注意: sing-box 1.12+ 已移除 inbound 的 sniff 字段, 改为 route.rules action=sniff
  jq -n --argjson o "$out" '{
    log: { level: "warn", timestamp: true },
    inbounds: [{
      type: "socks", tag: "sb-in", listen: "127.0.0.1", listen_port: 10808,
      udp_timeout: "5m"
    }],
    outbounds: [ ($o + { routing_mark: 255 }), { type: "direct", tag: "direct", routing_mark: 255 } ],
    route: {
      rules: [ { action: "sniff" } ],
      final: "sbproxy"
    }
  }' | write_atomic "$SBDIR/client.json" 600
}

sb_bridge_on() {
  sb_ok || { warn "未找到 sing-box, hy2/tuic/anytls 节点不可用"; return 1; }
  sb_client_gen || { warn "sing-box 配置生成失败"; return 1; }
  /etc/init.d/degwd-sb enable >/dev/null 2>&1
  /etc/init.d/degwd-sb restart >/dev/null 2>&1
  sleep 1
  /etc/init.d/degwd-sb running >/dev/null 2>&1
}
sb_bridge_off() {
  /etc/init.d/degwd-sb stop >/dev/null 2>&1
  /etc/init.d/degwd-sb disable >/dev/null 2>&1
  return 0
}
apply_node_bridge() {
  local act; act=$(conf_get '.nodeActive'); [[ -z $act ]] && return 0
  if node_needs_bridge "$act"; then
    sb_bridge_on || warn "sing-box 桥接未就绪(hy2/tuic/anytls 节点将不可用)"
  else
    sb_bridge_off
  fi
}

# 生成 xray 配置
xray_gen_config() {
  local i act mode
  i=$(conf_get '.nodeActive')
  [[ -z $i ]] && { warn "未选择节点"; return 1; }
  mode=$(conf_get '.split.mode'); [[ -z $mode ]] && mode=proxy

  local ob; ob=$(node_outbound "$i" "proxy") || { err "节点配置生成失败(协议不支持?)"; return 1; }

  # DNS: 优先 smartdns(分流), 回退直连
  local dnsport=$DNS_PORT
  local dnsservers
  dnsservers=$(jq -n --argjson p "$dnsport" --arg a "$DNS_ALI" \
    '[{address:"127.0.0.1", port:$p, skipFallback:false}, $a, "1.1.1.1"]')

  # hosts: 用户自定义 + 节点域名钉死
  local hosts
  hosts=$(jq -n --argjson u "$(conf_get '.dns.hosts' | jq -c '. // {}' 2>/dev/null || echo '{}')" '$u')

  local nodes_cnt; nodes_cnt=$(conf_get '.nodes | length'); [[ -z $nodes_cnt ]] && nodes_cnt=0
  local k=0 nh="{}"
  while [[ $k -lt $nodes_cnt ]]; do
    local d ip
    split_hostport "$(conf_get ".nodes[$k].address")"; d=$HOST
    ip=$(conf_get ".nodes[$k].ip")
    [[ -n $ip && -n $d ]] && nh=$(jq -n --argjson h "$nh" --arg d "$d" --arg ip "$ip" '$h + {($d): $ip}')
    k=$((k+1))
  done
  hosts=$(jq -n --argjson a "$hosts" --argjson b "$nh" '$a + $b')

  # 分流规则
  local sdom sips rules
  sdom=$(conf_get '.split.domains' | jq -c '. // []' 2>/dev/null || echo '[]')
  sips=$(conf_get '.split.ips'     | jq -c '. // []' 2>/dev/null || echo '[]')
  if [[ $mode == "direct" ]]; then
    # 白名单: 列表内直连, 其余走代理
    rules=$(jq -n --argjson d "$sdom" --argjson p "$sips" '[
      {type:"field", inboundTag:["tproxy-in"], domain:$d, outboundTag:"direct"},
      {type:"field", inboundTag:["tproxy-in"], ip:$p,      outboundTag:"direct"},
      {type:"field", inboundTag:["tproxy-in"], ip:["geoip:private"], outboundTag:"direct"}
    ]')
  else
    # 黑名单(默认): 国内直连, 其余代理
    rules=$(jq -n --argjson d "$sdom" --argjson p "$sips" '[
      {type:"field", inboundTag:["tproxy-in"], domain:$d, outboundTag:"proxy"},
      {type:"field", inboundTag:["tproxy-in"], ip:$p,      outboundTag:"proxy"},
      {type:"field", inboundTag:["tproxy-in"], ip:["geoip:private"], outboundTag:"direct"},
      {type:"field", inboundTag:["tproxy-in"], domain:["geosite:cn"], outboundTag:"direct"},
      {type:"field", inboundTag:["tproxy-in"], ip:["geoip:cn"], outboundTag:"direct"}
    ]')
  fi

  local tmp; tmp=$(mktemp "$XRAYDIR/.config.XXXXXX") || return 1
  jq -n --argjson ob "$ob" --argjson dns "$dnsservers" --argjson hosts "$hosts" \
        --argjson rules "$rules" --argjson tp "$TPROXY_PORT" --arg errlog "$XRAYDIR/error.log" '
    {
      log: { loglevel: "warning", access: "none", error: $errlog },
      dns: { servers: $dns, hosts: $hosts, queryStrategy: "UseIPv4", disableFallbackIfMatch: true },
      inbounds: [{
        tag: "tproxy-in", listen: "127.0.0.1", port: $tp, protocol: "dokodemo-door",
        settings: { network: "tcp,udp", followRedirect: true },
        streamSettings: { sockopt: { tproxy: "tproxy", mark: 255, tcpFastOpen: true, tcpMptcp: true } },
        sniffing: { enabled: true, destOverride: ["http", "tls", "quic"], routeOnly: true }
      }],
      outbounds: [ $ob, { protocol: "freedom", tag: "direct" }, { protocol: "blackhole", tag: "block" } ],
      routing: { domainMatcher: "hybrid", domainStrategy: "AsIs", rules: $rules }
    }' >"$tmp" 2>/dev/null

  if [[ ! -s $tmp ]] || ! jq -e . "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"; err "Xray 配置生成失败(已保留旧配置)"; return 1
  fi
  chmod 600 "$tmp"
  mv -f "$tmp" "$XRAYDIR/config.json"
  return 0
}

# -----------------------------------------------------------------------------
# nftables 平面 (table ip de_GWD, priority -280, 与 passwall2/mwan3/fw4 共存)
# -----------------------------------------------------------------------------
# 重要: 绝不可调用 /etc/init.d/firewall stop 或 fw4 flush —— 那会删除机器上所有 nft 表
nft_gen() {
  local lanif lanip reserved gfdns
  lanif=$(conf_get '.lanIf'); [[ -z $lanif ]] && lanif=$(lan_if)
  lanip=$(conf_get '.lanCidr')
  local lanbase; lanbase=${lanip%%/*}

  reserved=""
  local n; for n in $RESERVED_NETS; do reserved="$reserved$n,"; done
  reserved="${reserved%,}"
  gfdns=""
  for n in $GF_DNS_NETS; do gfdns="$gfdns$n,"; done
  gfdns="${gfdns%,}"

  local block53_line=""
  if [[ $(conf_get '.block53') == "true" ]]; then
    block53_line='        meta l4proto tcp th dport 853 counter reject with tcp reset comment "block DoT"'
  fi

  local tmp; tmp=$(mktemp "$NFTDIR/.de_GWD.XXXXXX") || return 1
  cat >"$tmp" <<EOF
#!/usr/sbin/nft -f
# 朔月 Shuoyue — OpenWrt 旁路网关 (自建表, 不影响 fw4/passwall2/mwan3)
# priority -280: 早于 mangle(-150) 与 passwall2 的 mangle-1(-151), 晚于 raw(-300)
table ip ${NFT_TABLE} {
    set selfip {
        type ipv4_addr
        flags interval
        elements = { 127.0.0.1, ${lanbase}, 172.17.0.1 }
    }

    set reserved {
        type ipv4_addr
        flags interval
        elements = { ${reserved} }
    }

    set gfdns {
        type ipv4_addr
        flags interval
        elements = { ${gfdns} }
    }

    # chnroute / 节点 IP / 分流名单: 由 refresh_nft_sets 动态填充
    set chnroute {
        type ipv4_addr
        flags interval
        auto-merge
    }

    set v2node {
        type ipv4_addr
        flags interval
        auto-merge
    }

    set listblan {
        type ipv4_addr
        flags interval
        auto-merge
    }

    set listwlan {
        type ipv4_addr
        flags interval
        auto-merge
    }

    chain prerouting {
        type filter hook prerouting priority -280; policy accept;

        # 本机自身流量不代理
        ip saddr @selfip accept comment "self"

        # 基础服务端口(仅本机)
        udp dport { 53, 67, 68, 123, 1900, 5350, 5351, 5353 } accept comment "udp svc"
        tcp dport { 53, 67, 68, 123 } accept comment "tcp svc"

        # 国内 DNS 直连(防止解析节点域名成环)
        ip daddr @gfdns accept comment "china dns"

        # 分流名单
        meta l4proto { tcp, udp } ip saddr @listblan tproxy to 127.0.0.1:${TPROXY_PORT} meta mark set ${NFT_MARK} comment "blacklist"
        ip saddr @listwlan accept comment "whitelist"

        # 内网/保留/节点 IP/国内 IP 直连
        ip daddr @reserved accept comment "reserved"
        ip daddr @v2node accept comment "v2node"
        ip daddr @chnroute accept comment "chnroute direct"
${block53_line}

        # 本机所有本地地址(含公网 WAN IP)不代理, 保护路由器自身服务(nginx/dnsmasq/ssh/luci)
        fib daddr type local accept comment "router local addr"

        # 其余全部 tproxy 到 xray
        meta l4proto { tcp, udp } tproxy to 127.0.0.1:${TPROXY_PORT} meta mark set ${NFT_MARK} comment "tproxy all"
    }

    chain output {
        type route hook output priority -280; policy accept;

        oifname "lo" accept comment "loopback"
        meta mark 0xff accept comment "xray own"
        # 本机发起的连接标记后交由 prerouting 之外的 route 决策
        meta l4proto tcp socket transparent 1 meta mark set ${NFT_MARK} comment "local tcp"
    }
}
EOF
  printf '%s' "$tmp"
}

nft_apply() {
  local f="$1"
  [[ -f $f ]] || { err "nft 规则文件不存在"; return 1; }
  if ! nft -c -f "$f" >/dev/null 2>&1; then
    err "nft 规则语法校验失败:"; nft -c -f "$f" 2>&1 | head -n 5
    return 1
  fi
  # 只删除自建表, 绝不触碰其他表
  nft list table ip "$NFT_TABLE" >/dev/null 2>&1 && nft delete table ip "$NFT_TABLE" 2>/dev/null
  nft -f "$f" || { err "nft 规则加载失败"; return 1; }
  return 0
}

nft_sets_reload() {   # $1=集合名 $2=文本列表(每行一个 CIDR/IP)
  local setname="$1" file="$2"
  [[ -s $file ]] || return 0
  local total; total=$(wc -l <"$file" | tr -d ' ')
  [[ -z $total || $total -eq 0 ]] && return 0
  # 重建集合元素: 先清空, 再分批 add(500/批)
  nft flush set ip "$NFT_TABLE" "$setname" 2>/dev/null
  local batch="" cnt=0 line
  while IFS= read -r line; do
    line=$(printf '%s' "$line" | tr -d ' \t\r')
    [[ -z $line || $line == \#* ]] && continue
    batch="$batch$line,"
    cnt=$((cnt+1))
    if [[ $cnt -ge 500 ]]; then
      nft add element ip "$NFT_TABLE" "$setname" "{ ${batch%,} }" 2>/dev/null
      batch=""; cnt=0
    fi
  done <"$file"
  [[ -n $batch ]] && nft add element ip "$NFT_TABLE" "$setname" "{ ${batch%,} }" 2>/dev/null
  return 0
}

nft_reserved_only() {   # 只放行保留网段(关闭代理时用)
  nft flush chain ip "$NFT_TABLE" prerouting 2>/dev/null
  nft add rule ip "$NFT_TABLE" prerouting ip daddr @reserved accept 2>/dev/null
  nft add rule ip "$NFT_TABLE" prerouting ip saddr @selfip accept 2>/dev/null
  return 0
}

# 路由策略: fwmark 0x9 → table 220 (local default dev lo)
route_rule_on() {
  ip rule list 2>/dev/null | grep -q "fwmark ${NFT_MARK} lookup ${RT_TABLE}" || \
    ip rule add fwmark "$NFT_MARK" table "$RT_TABLE" prio "$RT_PRIO" 2>/dev/null
  ip route show table "$RT_TABLE" 2>/dev/null | grep -q "^local default dev lo" || \
    ip route add local default dev lo scope host table "$RT_TABLE" 2>/dev/null
  return 0
}
route_rule_off() {
  ip rule del fwmark "$NFT_MARK" table "$RT_TABLE" prio "$RT_PRIO" 2>/dev/null
  ip route del local default dev lo scope host table "$RT_TABLE" 2>/dev/null
  return 0
}
route_rule_ok() {
  ip rule list 2>/dev/null | grep -q "fwmark ${NFT_MARK} lookup ${RT_TABLE}" && \
  ip route show table "$RT_TABLE" 2>/dev/null | grep -q "^local default dev lo"
}


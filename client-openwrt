# 环境探测
# -----------------------------------------------------------------------------
# WAN 出口网卡(只读内核路由表, 绝不走外部回显服务)
wan_if() {
  ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}'
}
# WAN IP(同上; 外部回显服务在本机会被代理, 返回的是 VPS IP)
wan_ip() {
  ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'
}
lan_if() {
  local i
  for i in $(uci -q get network.lan.device 2>/dev/null) $(uci -q get network.lan.ifname 2>/dev/null); do
    [[ -d /sys/class/net/$i ]] && { printf '%s' "$i"; return 0; }
  done
  for i in br-lan br0; do [[ -d /sys/class/net/$i ]] && { printf '%s' "$i"; return 0; }; done
  for i in /sys/class/net/*; do
    i=${i##*/}
    [[ $i == lo || $i == eth* || $i == wlan* || $i == docker* || $i == tailscale* ]] && continue
    [[ -d /sys/class/net/$i/brif ]] && { printf '%s' "$i"; return 0; }
  done
  return 1
}
lan_cidr() {
  local i ip
  i=$(lan_if) || return 1
  ip=$(ip -4 -o addr show dev "$i" 2>/dev/null | awk 'NR==1{split($4,a,"/"); print a[1]"/"a[2]}')
  [[ -n $ip ]] && printf '%s' "$ip"
}

# -----------------------------------------------------------------------------
# 配置层 (flock 串行化 + 密钥不经 argv)
# -----------------------------------------------------------------------------
conf_init() {
  mkdir -p "$BASE" "$XRAYDIR" "$SBDIR" "$SDNSDIR" "$LISTDIR" "$NFTDIR" 2>/dev/null
  [[ -f $CONF ]] && return 0
  local doh="$DEFAULT_DOH" lanip
  lanip=$(lan_cidr)
  write_atomic "$CONF" 600 <<EOF
{
  "version": "$VERSION",
  "lanIf": "$(lan_if)",
  "lanCidr": "${lanip:-10.10.10.6/24}",
  "proxyOn": false,
  "block53": false,
  "nodeActive": null,
  "nodes": [],
  "split": { "domains": [], "ips": [], "mode": "proxy" },
  "dns": { "doh": "$doh", "china": ["$DNS_ALI", "$DNS_TENCENT"], "hosts": {} },
  "ddns": { "provider": "", "domain": "", "cfToken": "", "zoneId": "", "recordId": "", "last": "" },
  "wg": { "enable": false, "serverPriv": "", "serverPub": "", "port": 51820, "clients": [] },
  "relay": { "enable": false, "port": 0, "target": "" },
  "autoUpdate": false
}
EOF
  chmod 600 "$CONF" 2>/dev/null
}

conf_get() { [[ -f $CONF ]] && jq -r "$1 // empty" "$CONF" 2>/dev/null; }

# conf_write <jq filter> [jq args...]  — flock 保护, 写坏即回滚
conf_write() {
  local f="$1"; shift
  [[ -f $CONF ]] || return 1
  exec 9>"$CONF.lock" 2>/dev/null || return 1
  flock 9 2>/dev/null
  local t; t=$(mktemp "$BASE/.conf.XXXXXX") || { flock -u 9; exec 9>&-; return 1; }
  if jq "$@" "$f" "$CONF" >"$t" 2>/dev/null && jq -e . "$t" >/dev/null 2>&1; then
    chmod 600 "$t" 2>/dev/null
    mv -f "$t" "$CONF"
    flock -u 9 2>/dev/null; exec 9>&-
    return 0
  fi
  rm -f "$t"; flock -u 9 2>/dev/null; exec 9>&-
  err "配置写入失败(已保留原配置)"
  return 1
}

# conf_set <路径> <字符串>  — 经临时文件传入, 密钥不出现在 ps 中
conf_set() {
  local tf r; tf=$(mktemp "$BASE/.v.XXXXXX") || return 1
  printf '%s' "$2" >"$tf"
  conf_write "$1 = \$v" --rawfile v "$tf"; r=$?
  rm -f "$tf"; return $r
}
# conf_raw <路径> <单个 JSON 值>
conf_raw() {
  local tf r; tf=$(mktemp "$BASE/.v.XXXXXX") || return 1
  printf '%s' "$2" >"$tf"
  conf_write "$1 = \$v[0]" --slurpfile v "$tf"; r=$?
  rm -f "$tf"; return $r
}
conf_del() { conf_write "del($1)"; }


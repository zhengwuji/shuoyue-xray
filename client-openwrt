usage() {
  cat <<EOF
朔月 Shuoyue — OpenWrt 旁路网关客户端 $VERSION

用法: shuoyue-gw [选项]

  --install     安装并初始化(不自动开启代理)
  --uninstall   卸载并还原 DNS / 网络配置
  --status      显示运行状态
  --update      检查并更新到最新版本
  --lists       下载/更新 chnroute 与国内域名名单
  --ddns        执行一次 Cloudflare DDNS 更新(cron 调用)
  --proxy on|off 开启/关闭旁路网关
  --version     显示版本
  --help        显示本帮助

无参数时进入交互菜单。
EOF
}

# -----------------------------------------------------------------------------
# 入口
# -----------------------------------------------------------------------------
case "${1:-}" in
  --install)   installGWD ;;
  --uninstall) uninstallGWD ;;
  --status)    status_panel ;;
  --update)    updateGWD ;;
  --lists)     download_lists; refresh_nft_sets ;;
  --ddns)      ddns_update_cf ;;
  --proxy)
    case "${2:-}" in
      on)  proxy_on ;;
      off) proxy_off ;;
      *)   err "用法: shuoyue-gw --proxy on|off"; exit 1 ;;
    esac ;;
  --version)   echo "$VERSION" ;;
  --help|-h)   usage ;;
  "")
    is_openwrt || die "本脚本仅支持 OpenWrt / Kwrt"
    [[ -f $CONF ]] || die "尚未安装, 请先运行: shuoyue-gw --install"
    start_menu ;;
  *) err "未知参数: $1"; usage; exit 1 ;;
esac

    opkg update >/dev/null 2>&1
    opkg install "${need[@]}" >/dev/null 2>&1
  fi
  local miss=()
  for p in bash jq curl; do pkg_installed "$p" || command -v "$p" >/dev/null 2>&1 || miss+=("$p"); done
  [[ ${#miss[@]} -gt 0 ]] && die "依赖缺失: ${miss[*]} (请先 opkg update && opkg install ${miss[*]})"
  return 0
}

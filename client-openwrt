# -----------------------------------------------------------------------------
# 分流规则
# -----------------------------------------------------------------------------
ip_cidr_ok() {
  local v="$1"
  [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && {
    local IFS=. a; read -r -a a <<<"$v"
    local o; for o in "${a[@]}"; do (( o >= 0 && o <= 255 )) || return 1; done
    return 0
  }
  [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$ ]] || return 1
  local ip="${v%%/*}" pf="${v##*/}"
  (( pf >= 0 && pf <= 32 )) || return 1
  local IFS=. a; read -r -a a <<<"$ip"
  local o; for o in "${a[@]}"; do (( o >= 0 && o <= 255 )) || return 1; done
  return 0
}

split_domains() {
  echo "  当前域名规则:"
  conf_get '.split.domains[]' 2>/dev/null | sed 's/^/    /'
  echo "  输入域名(逗号/空格分隔, 支持 geosite:xxx, 空回车=不修改):"
  local v; v=$(ask "  > ")
  [[ -z $v ]] && return 0
  local arr; arr=$(printf '%s' "$v" | tr ',' '\n' | tr ' ' '\n' | grep -v '^$' | \
    jq -R . | jq -s -c .)
  conf_raw '.split.domains' "$arr" && ok "域名规则已更新"
  return 0
}

split_ips() {
  echo "  当前 IP 规则:"
  conf_get '.split.ips[]' 2>/dev/null | sed 's/^/    /'
  echo "  输入 IP/CIDR(逗号/空格分隔, 支持 geoip:xxx, 空回车=不修改):"
  local v; v=$(ask "  > ")
  [[ -z $v ]] && return 0
  local tok bad=0 good=()
  for tok in $(printf '%s' "$v" | tr ',' ' '); do
    [[ -z $tok ]] && continue
    if [[ $tok == geoip:* ]] || ip_cidr_ok "$tok"; then
      good+=("$tok")
    else
      warn "非法条目已忽略: $tok"; bad=$((bad+1))
    fi
  done
  [[ ${#good[@]} -eq 0 ]] && { err "无有效条目"; return 1; }
  local arr; arr=$(printf '%s\n' "${good[@]}" | jq -R . | jq -s -c .)
  conf_raw '.split.ips' "$arr" && ok "IP 规则已更新 (忽略 $bad 条非法项)"
  return 0
}

split_mode_set() {
  local m; m=$(conf_get '.split.mode')
  echo "  当前模式: ${m:-proxy}  (proxy=国内直连其余代理 / direct=仅名单走代理)"
  local c; c=$(ask "  选择 [1] proxy(默认) [2] direct: ")
  case "$c" in
    1) conf_set '.split.mode' "proxy" ;;
    2) conf_set '.split.mode' "direct" ;;
    *) return 0 ;;
  esac
  ok "模式已更新"
  [[ $(conf_get '.proxyOn') == "true" ]] && proxy_on
  return 0
}

split_clear() {
  yesno "确认清空所有分流规则?" || return 0
  conf_raw '.split.domains' "[]"
  conf_raw '.split.ips' "[]"
  ok "分流规则已清空"
  return 0
}


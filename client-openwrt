    ok "活动节点已重置为 0"
  elif [[ $act -gt $idx ]]; then
    conf_raw '.nodeActive' "$((act-1))"
  fi
  ok "已删除节点: $nm"
  [[ $(conf_get '.proxyOn') == "true" ]] && proxy_on
  return 0
}


  echo -e "${WHITE}   朔月 Shuoyue — OpenWrt 旁路网关${cRES}"
  echo -e "${CYAN}=============================================${cRES}"
  local on; on=$(conf_get '.proxyOn')
  echo "  版本:     $VERSION"
  echo "  系统:     $(grep -m1 DISTRIB_DESCRIPTION /etc/openwrt_release 2>/dev/null | cut -d"'" -f2)"
  echo "  代理状态: $([[ $on == "true" ]] && echo -e "${GREEN}● 已开启${cRES}" || echo -e "${YELLOW}○ 已关闭${cRES}")"
  echo "  LAN:      $(lan_if) $(lan_cidr)"
  echo "  WAN IP:   $(wan_ip)"
  echo "  节点:     $(conf_get '.nodes | length' 2>/dev/null || echo 0) 个 (当前: $(conf_get '.nodeActive' 2>/dev/null || echo -))"
  echo
  printf '  %-12s %s\n' "xray:"    "$(/etc/init.d/degwd-gw running >/dev/null 2>&1 && echo -e "${GREEN}运行中${cRES}" || echo "已停止")"
  printf '  %-12s %s\n' "sing-box:" "$(/etc/init.d/degwd-sb running >/dev/null 2>&1 && echo -e "${GREEN}运行中${cRES}" || echo "已停止")"
  printf '  %-12s %s\n' "smartdns:" "$(/etc/init.d/degwd-dns running >/dev/null 2>&1 && echo -e "${GREEN}运行中${cRES}" || echo "已停止")"
  printf '  %-12s %s\n' "nft 表:"   "$(nft list table ip "$NFT_TABLE" >/dev/null 2>&1 && echo -e "${GREEN}已加载${cRES}" || echo "未加载")"

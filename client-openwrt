  idx=$(ask "  删除哪个节点序号: ")
  [[ $idx =~ ^[0-9]+$ ]] || { err "请输入数字"; return 1; }
  (( idx >= 0 && idx < n )) || { err "序号超范围"; return 1; }
  local nm; nm=$(conf_get ".nodes[$idx].name")
  yesno "确认删除 [$idx] $nm ?" || return 0
  conf_write 'del(.nodes[$n])' --argjson n "$idx" || return 1
  # 修正活动节点
  local act newn
  act=$(conf_get '.nodeActive')
  newn=$(conf_get '.nodes | length')
  if [[ $newn -eq 0 ]]; then
    conf_write 'del(.nodeActive)'

# 从完整域名推导 zone: 从最长后缀开始试, 找到 token 有权访问的 zone
ddns_zone_of() {
  local domain="$1" token="$2" cand
  local IFS='.'; local -a parts; read -r -a parts <<<"$domain"
  local cnt=${#parts[@]} i
  for (( i=1; i<cnt; i++ )); do
    cand=$(IFS=.; echo "${parts[*]:i}")
    local zid
    zid=$(curl -s --max-time 15 -H "Authorization: Bearer $token" \
      "https://api.cloudflare.com/client/v4/zones?name=$cand" 2>/dev/null | \
      jq -r 'if .success then (.result[0].id // empty) else empty end' 2>/dev/null)
    if [[ -n $zid ]]; then printf '%s' "$zid"; return 0; fi
  done
  return 1
}

ddns_update_cf() {
  local token domain
  token=$(conf_get '.ddns.cfToken')
  domain=$(conf_get '.ddns.domain')
  [[ -z $token || -z $domain ]] && { err "请先设置 Token 与域名"; return 1; }
  local ip; ip=$(wan_ip)
  [[ -z $ip ]] && { err "无法获取 WAN IP"; return 1; }

  local zone; zone=$(ddns_zone_of "$domain" "$token") || { err "无法确定 zone(检查 Token 权限)"; return 1; }
  conf_set '.ddns.zoneId' "$zone"

  local sub="$domain"
  local root
  local IFS='.'; local -a parts; read -r -a parts <<<"$domain"
  # 记录名 = 域名去掉 zone 后缀
  local zname
  zname=$(curl -s --max-time 15 -H "Authorization: Bearer $token" \
    "https://api.cloudflare.com/client/v4/zones/$zone" 2>/dev/null | jq -r '.result.name // empty')
  if [[ -n $zname && $domain == *".$zname" ]]; then
    sub=${domain%".$zname"}
  elif [[ $domain == "$zname" ]]; then
    sub="@"
  fi

  local rec recid
  rec=$(curl -s --max-time 15 -H "Authorization: Bearer $token" \
    "https://api.cloudflare.com/client/v4/zones/$zone/dns_records?type=A&name=$domain" 2>/dev/null)
  recid=$(printf '%s' "$rec" | jq -r 'if .success then (.result[0].id // empty) else empty end' 2>/dev/null)

  local resp
  if [[ -n $recid ]]; then
    resp=$(curl -s --max-time 20 -X PUT \
      -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
      --data "{\"type\":\"A\",\"name\":\"$sub\",\"content\":\"$ip\",\"ttl\":120,\"proxied\":false}" \
      "https://api.cloudflare.com/client/v4/zones/$zone/dns_records/$recid" 2>/dev/null)
  else
    resp=$(curl -s --max-time 20 -X POST \
      -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
      --data "{\"type\":\"A\",\"name\":\"$sub\",\"content\":\"$ip\",\"ttl\":120,\"proxied\":false}" \
      "https://api.cloudflare.com/client/v4/zones/$zone/dns_records" 2>/dev/null)
  fi

  if printf '%s' "$resp" | jq -e '.success == true' >/dev/null 2>&1; then
    conf_set '.ddns.last' "$(date '+%F %T') → $ip"
    conf_set '.ddns.recordId' "${recid:-new}"
    ok "DDNS 已更新: $domain → $ip"
    return 0
  fi
  err "DDNS 更新失败: $(printf '%s' "$resp" | jq -r '.errors[0].message // "未知错误"' 2>/dev/null)"
  return 1
}

ddns_cron_on() {
  grep -qF "shuoyue-gw --ddns" /etc/crontabs/root 2>/dev/null || {
    mkdir -p /etc/crontabs
    printf '*/5 * * * * /usr/bin/shuoyue-gw --ddns >/dev/null 2>&1\n' >>/etc/crontabs/root
  }
  /etc/init.d/cron enable >/dev/null 2>&1
  /etc/init.d/cron restart >/dev/null 2>&1
  ok "DDNS 定时任务已安装(每 5 分钟)"
  return 0
}
ddns_cron_off() {
  if [[ -f /etc/crontabs/root ]]; then
    local t; t=$(mktemp)
    grep -vF "shuoyue-gw --ddns" /etc/crontabs/root >"$t" 2>/dev/null
    mv -f "$t" /etc/crontabs/root
  fi
  /etc/init.d/cron restart >/dev/null 2>&1
  ok "DDNS 定时任务已移除"
  return 0
}


# ================================================================ 自动更新 =====
autoupdate_on() {
  (crontab -l 2>/dev/null | grep -v de_GWD/autoUpdate; echo "0 5 * * * $BASE/autoUpdate") | crontab -
  cat <<EOF >"$BASE/autoUpdate"
#!/bin/bash
lv="$VERSION"
rv=\$(curl -fsSL --max-time 15 "$REMOTE_BASE/version" 2>/dev/null | head -n1)
[[ -z \$rv ]] && exit 0
if [[ \$(printf '%s\n%s\n' "\$lv" "\$rv" | sort -V | head -n1) == "\$lv" && "\$lv" != "\$rv" ]]; then
  curl -fsSL --max-time 60 "$REMOTE_BASE/client" -o /tmp/de_GWD_client_new || exit 0
  [[ \$(du -sk /tmp/de_GWD_client_new | awk '{print\$1}') -lt 30 ]] && exit 0
  bash /tmp/de_GWD_client_new --update
  rm -f /tmp/de_GWD_client_new
fi
EOF
  chmod +x "$BASE/autoUpdate"
  ok "自动更新已开启(每日 05:00)"
}
autoupdate_off() {
  (crontab -l 2>/dev/null | grep -v de_GWD/autoUpdate) | crontab -
  rm -f "$BASE/autoUpdate"; ok "自动更新已关闭"
}

# ================================================================ 信息输出 ====
# 节点 → 分享链接(v2rayN 兼容)
gen_node_link() {   # $1 = idx
  local i="$1" addr host port proto uuid password path sni pbk sid flow method insecure name
  addr=$(conf_get ".nodes[$i].address"); host=${addr%%:*}; port=${addr##*:}
  proto=$(conf_get ".nodes[$i].proto"); proto=${proto:-vmess}
  uuid=$(conf_get ".nodes[$i].uuid"); password=$(conf_get ".nodes[$i].password")
  path=$(conf_get ".nodes[$i].path"); sni=$(conf_get ".nodes[$i].tls"); [[ -z $sni ]] && sni=$host
  pbk=$(conf_get ".nodes[$i].pbk"); sid=$(conf_get ".nodes[$i].sid")
  flow=$(conf_get ".nodes[$i].flow"); method=$(conf_get ".nodes[$i].method")
  name=$(conf_get ".nodes[$i].name"); name=${name// /%20}; [[ -z $name ]] && name="node"
  case $proto in
    vmess)
      local vj
      if [[ -n $path && "$path" != "null" ]]; then
        vj=$(jq -cn --arg add "$host" --arg port "$port" --arg id "$uuid" --arg path "$path" \
                  --arg host "$sni" --arg ps "$name" \
          '{v:"2",ps:$ps,add:$add,port:$port,id:$id,aid:"0",scy:"auto",net:"ws",type:"none",host:$host,path:$path,tls:"tls",sni:$host}')
      else
        vj=$(jq -cn --arg add "$host" --arg port "$port" --arg id "$uuid" --arg ps "$name" \
          '{v:"2",ps:$ps,add:$add,port:$port,id:$id,aid:"0",scy:"auto",net:"tcp",type:"none",tls:""}')
      fi
      echo "vmess://$(printf %s "$vj" | base64 -w0)"
      ;;
    vless)
      if [[ -n $pbk && "$pbk" != "null" ]]; then
        echo "vless://$uuid@$host:$port?security=reality&encryption=none&pbk=$pbk&fp=chrome&type=tcp&flow=${flow:-xtls-rprx-vision}&sni=$sni&sid=$sid#$name"
      else
        echo "vless://$uuid@$host:$port?encryption=none&security=tls&sni=$sni&fp=chrome&type=ws&host=$sni&path=$path#$name"
      fi
      ;;
    trojan)
      if [[ -n $path && "$path" != "null" ]]; then
        echo "trojan://$password@$host:$port?security=tls&sni=$sni&type=ws&host=$sni&path=$path#$name"
      else
        echo "trojan://$password@$host:$port?security=tls&sni=$sni&type=tcp#$name"
      fi
      ;;
    ss)
      echo "ss://$(b64url_encode "$method:$password")@$host:$port#$name"
      ;;
    hy2)
      [[ $(conf_get ".nodes[$i].insecure") == "1" ]] && insecure=1 || insecure=0
      echo "hy2://$password@$host:$port?sni=$sni&insecure=$insecure#$name"
      ;;
    tuic)
      echo "tuic://$uuid:$password@$host:$port?congestion_control=bbr&alpn=h3&sni=$sni#$name"
      ;;
    anytls)
      [[ $(conf_get ".nodes[$i].insecure") == "1" ]] && insecure=1 || insecure=0
      echo "anytls://$password@$host:$port?sni=$sni&insecure=$insecure#$name"
      ;;
  esac
}

printNode() {
  conf_init
  local n act laddr i link
  n=$(conf_get '.nodes' | jq 'length' 2>/dev/null || echo 0)
  act=$(conf_get '.nodeActive')
  laddr=$(conf_get '.net.localCIDR' | cut -d/ -f1)
  echo
  echo -e "${CYAN}=============== 网关信息 ===============${cRES}"
  echo -e "${WHITE}网关 IP: ${GREEN}$laddr${cRES}  (LAN 设备网关+DNS 指向此地址)"
  if [[ $n -gt 0 ]]; then
    echo
    i=0
    while [[ $i -lt $n ]]; do
      link=$(gen_node_link "$i")
      [[ $i -eq $act ]] && echo -e "${GREEN}▶ 当前节点${cRES}"
      echo -e "${WHITE}$link${cRES}"
      if [[ $i -eq $act ]]; then
        echo
        qrencode -t UTF8 -s 1 -m 2 "$link" 2>/dev/null
        echo
      fi
      i=$((i+1))
    done
  fi
  printRelay
  echo -e "${CYAN}-----------------------------------------${cRES}"
  echo "  v2rayN 导入: 复制链接 → 主界面 Ctrl+V(从剪贴板导入批量URL)"
  echo "  网关上的节点同样可在 v2rayN 单设备直连使用"
  echo -e "${CYAN}=========================================${cRES}"
}


net_static() {   # 静态 IP (四种网络管理器自适应: nmcli/netplan/systemd-networkd/ifupdown)
  local nic cidr gw
  nic=$(conf_get '.net.nic'); cidr=$(conf_get '.net.localCIDR'); gw=$(conf_get '.net.gateway')
  [[ -z $nic || -z $cidr || -z $gw ]] && { warn "网络参数不完整, 跳过静态 IP 配置"; return 1; }
  echo "  即将把 $nic 设为静态 $cidr (网关 $gw)"
  local c_ok; c_ok=$(ask "确认写入? [y/N]: ")
  [[ ! "$c_ok" =~ ^[Yy] ]] && { warn "已跳过静态 IP 配置"; return 1; }
  # 写入前备份, 自检失败可回滚
  local bdir="/var/backups/de_GWD/net-$(date +%s)"; mkdir -p "$bdir"
  cp -a /etc/netplan "$bdir/" 2>/dev/null
  cp -a /etc/network "$bdir/" 2>/dev/null
  cp -a /etc/systemd/network "$bdir/" 2>/dev/null
  cp -a /etc/NetworkManager "$bdir/" 2>/dev/null
  ok "已备份原网络配置到 $bdir"

  if command -v nmcli >/dev/null 2>&1 && nmcli -t -f DEVICE,STATE device status 2>/dev/null | grep -q "connected"; then
    local con; con=$(nmcli -t -f DEVICE,NAME,STATE connection show --active 2>/dev/null | grep "^$nic:" | cut -d: -f2 | head -n1)
    if [[ -n $con ]]; then
      local ipaddr prefix; ipaddr=${cidr%%/*}; prefix=${cidr##*/}
      # dns=none: 交给 resolv_setup 手写的 /etc/resolv.conf, 避免 NM 覆盖
      nmcli con mod "$con" ipv4.method manual ipv4.addresses "$ipaddr/$prefix" ipv4.gateway "$gw" \
        ipv4.dns "$DNS_ALI" ipv4.ignore-auto-dns yes ipv4.dns-priority 0 2>/dev/null
      nmcli con mod "$con" ipv4.dns-search "" 2>/dev/null
      printf '[main]\ndns=none\n' >/etc/NetworkManager/conf.d/90-degwd-dns.conf
      systemctl reload NetworkManager >/dev/null 2>&1
      ok "nmcli 已配置静态 IP: $cidr (网关 $gw)"
      return
    fi
  fi
  if command -v netplan >/dev/null 2>&1; then
    # Ubuntu Server: netplan 是默认网络配置器
    write_atomic /etc/netplan/60-degwd.yaml 600 <<EOF
network:
  version: 2
  ethernets:
    $nic:
      dhcp4: no
      addresses: [$cidr]
      routes:
        - to: default
          via: $gw
      nameservers:
        addresses: [127.0.0.1, $DNS_ALI]
EOF
    netplan apply >/dev/null 2>&1
    ok "netplan 已配置静态 IP: $cidr (网关 $gw)"
    return
  fi
  if [[ -d /etc/systemd/network ]] && systemctl is-enabled systemd-networkd >/dev/null 2>&1; then
    write_atomic /etc/systemd/network/10-degwd.network 644 <<EOF
[Match]
Name=$nic

[Network]
Address=$cidr
Gateway=$gw
DNS=127.0.0.1
EOF
    systemctl restart systemd-networkd
    ok "systemd-networkd 已配置静态 IP: $cidr"
    return
  fi
  apt-get install -y -qq ifupdown >/dev/null 2>&1
  write_atomic /etc/network/interfaces 644 <<EOF
auto lo
iface lo inet loopback

auto $nic
iface $nic inet static
    address $cidr
    gateway $gw
    dns-nameservers 127.0.0.1
EOF
  systemctl restart networking 2>/dev/null || ifdown "$nic" 2>/dev/null; ifup "$nic" 2>/dev/null
  ok "ifupdown 已配置静态 IP: $cidr"
}

# 静态 IP 应用后自检: 60 秒内仍能 ping 通网关, 否则回滚备份
net_static_verify() {
  local gw; gw=$(conf_get '.net.gateway')
  local bdir; bdir=$(ls -1d /var/backups/de_GWD/net-* 2>/dev/null | tail -n1)
  [[ -z $gw ]] && return 0
  echo "  60 秒网络自检(网关 $gw)... 若失联将自动回滚"
  local k=0
  while [[ $k -lt 60 ]]; do
    if ping -c1 -W1 "$gw" >/dev/null 2>&1; then
      ok "网络自检通过"; return 0
    fi
    sleep 1; k=$((k+1))
  done
  err "网络自检失败(60s 内未 ping 通 $gw)"
  [[ -z $bdir ]] && { err "无可用备份, 请手工检查 /etc/network/interfaces"; return 1; }
  warn "正在从 $bdir 回滚..."
  cp -a "$bdir/netplan/." /etc/netplan/ 2>/dev/null
  cp -a "$bdir/network/." /etc/network/ 2>/dev/null
  cp -a "$bdir/network/." /etc/systemd/network/ 2>/dev/null
  cp -a "$bdir/NetworkManager/." /etc/NetworkManager/ 2>/dev/null
  systemctl restart NetworkManager >/dev/null 2>&1
  systemctl restart networking >/dev/null 2>&1
  netplan apply >/dev/null 2>&1
  warn "已回滚网络配置, 请重新执行安装"
  return 1
}

# ============================================ DNS 分流 (smartdns 单组件重制) ====
# 原版四级链 pihole->mosdns->smartdns->上游 重制为 smartdns 直管:
#   chn 域名集 -> 国内直连组(UDP 快速) ; 其余 -> 全球组(DoH)
smartdns_conf() {
  local doh china dnsport
  doh=$(conf_get '.dns.doh'); dnsport=$(conf_get '.dnsPort')
  china=$(conf_get '.dns.china[]' | tr '\n' ' ')

  # 端口决策在此处完成: AGH 开启时 smartdns 退居 127.0.0.1:5330, 否则独占 53。
  # (原先靠安装后 sed 改写, 一旦重跑 smartdns_conf 就把 53 抢回, AGH 上游无人监听)
  local bindaddr bindport
  if [[ $(conf_get '.adblock') == "true" ]]; then
    bindaddr="127.0.0.1"; bindport=5330
  else
    bindaddr="0.0.0.0"; bindport=${dnsport:-53}
  fi

  # DoH 域名则预解析 IP 作 bootstrap, 防止"鸡生蛋"
  local dohhost boot=""
  dohhost=$(echo "$doh" | sed -E 's|^https?://||; s|[/:].*$||')
  if [[ ! "$dohhost" =~ ^[0-9.]+$ ]]; then
    local b; b=$(dig +short +time=3 +tries=1 @"${china%% *}" "$dohhost" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1)
    [[ -n $b ]] && boot="-bootstrap $b"
  fi

  write_atomic "$SDNSDIR/smartdns.conf" 644 <<EOF
server-name de_GWD
bind $bindaddr:$bindport
bind-tcp $bindaddr:$bindport
speed-check-mode tcp:443,ping,tcp:80
response-mode first-ping
force-AAAA-SOA yes
force-qtype-soa 65
dualstack-ip-selection yes
cache-size 16384
cache-persist yes
cache-file $SDNSDIR/cache.dat
cache-checkpoint-time 28800
prefetch-domain yes
serve-expired yes
serve-expired-ttl 86400
rr-ttl-min 60
rr-ttl-max 86400
log-level warn
domain-set -name chn -file $SDNSDIR/chn_domains.txt
EOF
  # 国内组
  for s in $china; do echo "server $s -group chn -exclude-default-group" >>"$SDNSDIR/smartdns.conf"; done
  # 全球组(默认组): DoH
  echo "server-https $doh $boot -group global -exclude-default-group -no-check-certificate" >>"$SDNSDIR/smartdns.conf"
  echo "nameserver /domain-set:chn/chn" >>"$SDNSDIR/smartdns.conf"
  # 用户自定义 hosts
  conf_get '.dns.hosts' | jq -r 'to_entries[] | "address /\(.key)/\(.value)"' >>"$SDNSDIR/smartdns.conf" 2>/dev/null
  # 节点域名钉死 IP(防回环)
  local nodes i addr d ip ncnt
  nodes=$(conf_get '.nodes'); i=0
  ncnt=$(echo "$nodes" | jq 'length' 2>/dev/null || echo 0)
  while [[ $i -lt $ncnt ]]; do
    addr=$(echo "$nodes" | jq -r ".[$i].address")
    split_hostport "$addr"; d=$SP_HOST
    ip=$(echo "$nodes" | jq -r ".[$i].ip // empty")
    [[ -n $ip ]] && echo "address /$d/$ip" >>"$SDNSDIR/smartdns.conf"
    i=$((i+1))
  done
  chmod 644 "$SDNSDIR/smartdns.conf"

  # 动态解析 smartdns 实际安装路径(Debian 包为 /usr/sbin/smartdns, 原写死 /usr/bin 会起不来)
  local sdbin; sdbin=$(command -v smartdns 2>/dev/null)
  [[ -z $sdbin ]] && { warn "未找到 smartdns 可执行文件, 单元按 /usr/sbin/smartdns 生成"; sdbin=/usr/sbin/smartdns; }
  write_atomic /etc/systemd/system/smartdns.service 644 <<EOF
[Unit]
Description=de_GWD smartdns
After=network.target

[Service]
ExecStart=$sdbin -f -c $SDNSDIR/smartdns.conf
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=$SDNSDIR/smartdns.conf

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable smartdns >/dev/null 2>&1
}

# 广告拦截: AdGuard Home 置于 smartdns 之前 (53 -> 5330)
agh_pass_hash() {   # $1=明文口令 → 输出 bcrypt 哈希(失败输出空)
  local pw="$1" h
  command -v htpasswd >/dev/null 2>&1 || apt-get install -y -qq apache2-utils >/dev/null 2>&1
  if command -v htpasswd >/dev/null 2>&1; then
    h=$(htpasswd -B -C 10 -n -b "" "$pw" 2>/dev/null | cut -d: -f2)
    [[ -n $h ]] && { printf '%s' "$h"; return 0; }
  fi
  return 1
}

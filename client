installkernel() {
  local codename; codename=$(. /etc/os-release; echo "$VERSION_CODENAME")
  mkdir -p /etc/apt/keyrings
  curl -fsSL https://zabbly.com/key.asc -o /etc/apt/keyrings/zabbly.asc
  cat <<EOF >/etc/apt/sources.list.d/zabbly-kernels-stable.sources
Enabled: yes
Types: deb
URIs: https://zabbly.com/kernel/stable
Suites: $codename
Components: main
Signed-By: /etc/apt/keyrings/zabbly.asc
EOF
  apt-get update -qq && apt-get install -y -qq linux-zabbly

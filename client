# ================================================================ DDNS =========
ddns_menu() {
  conf_init
  read -rsp "[1] 设置 Cloudflare DDNS  [2] 关闭: " -n1 c; echo
  case $c in
    1)
      local token dom
      token=$(ask_secret "CF API Token (Zone.DNS Edit): ")
      dom=$(ask "DDNS 域名 (如 home.example.com): ")
      conf_set '.ddns.cfToken' "$token"; conf_set '.ddns.cfDomain' "$dom"
      ddns_update_cf && (crontab -l 2>/dev/null | grep -v de_GWD/ddns; echo "*/5 * * * * $BASE/ddns") | crontab -
      cat <<EOF >"$BASE/ddns"
#!/bin/bash
bash $(readlink -f "$0" 2>/dev/null || echo "$0") --ddns
EOF
      chmod +x "$BASE/ddns"
      ;;
    2)
      (crontab -l 2>/dev/null | grep -v de_GWD/ddns) | crontab -
      rm -f "$BASE/ddns"
      ok "DDNS 已关闭"
      ;;
  esac
}
ddns_update_cf() {
  local token dom wan zone rec id
  token=$(conf_get '.ddns.cfToken'); dom=$(conf_get '.ddns.cfDomain')
  [[ -z $token || -z $dom ]] && return 1
  wan=$(wan_ip); [[ -z $wan ]] && return 1
  # 当前解析相同则跳过
  [[ $(dig +short +time=5 +tries=1 @223.5.5.5 "$dom" A 2>/dev/null | head -n1) == "$wan" ]] && return 0
  zone=$(echo "$dom" | rev | awk -F. '{print $2"."$1}' | rev)
  zone=$(curl -fsS -H "Authorization: Bearer $token" "https://api.cloudflare.com/client/v4/zones?name=$zone" | jq -r '.result[0].id // empty')
  [[ -z $zone ]] && { warn "DDNS: zone 未找到"; return 1; }
  rec=$(curl -fsS -H "Authorization: Bearer $token" "https://api.cloudflare.com/client/v4/zones/$zone/dns_records?name=$dom&type=A" | jq -r '.result[0].id // empty')
  if [[ -n $rec ]]; then
    curl -fsS -X PUT -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
      -d "{\"type\":\"A\",\"name\":\"$dom\",\"content\":\"$wan\",\"ttl\":300,\"proxied\":false}" \
      "https://api.cloudflare.com/client/v4/zones/$zone/dns_records/$rec" >/dev/null
  else
    curl -fsS -X POST -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
      -d "{\"type\":\"A\",\"name\":\"$dom\",\"content\":\"$wan\",\"ttl\":300,\"proxied\":false}" \
      "https://api.cloudflare.com/client/v4/zones/$zone/dns_records" >/dev/null
  fi
  ok "DDNS 已更新: $dom -> $wan"
}


# 原子写: $1=目标路径 $2=权限, 内容从 stdin
write_atomic() {
  local t; t=$(mktemp "$1.XXXXXX") || return 1
  cat > "$t" || { rm -f "$t"; return 1; }
  chmod "$2" "$t" && mv -f "$t" "$1"
}

# 拆分 host:port, 支持 [ipv6]:port 与裸 IPv6; 结果写入全局 SP_HOST/SP_PORT
# 原写法 `host=${x%%:*}; port=${x##*:}` 有两个坑:
#   1. [2001:db8::1]:443 会被切成 host="[" port="db8::1]:443"
#   2. 没有冒号时 port 会等于整个 host(而非空), 后续 --argjson port 直接报错
split_hostport() {
  local hp="$1"
  SP_HOST=""; SP_PORT=""
  if [[ $hp == \[*\]* ]]; then
    SP_HOST=${hp%%\]*}; SP_HOST=${SP_HOST#[}
    [[ $hp == *\]:* ]] && SP_PORT=${hp##*\]:}
  elif [[ $hp == *:*:* ]]; then
    SP_HOST=$hp                      # 裸 IPv6(多冒号且无方括号): 无端口
  else
    SP_HOST=${hp%%:*}; SP_PORT=${hp##*:}
    [[ $SP_PORT == "$SP_HOST" ]] && SP_PORT=""
  fi
}

detect_nic() {
  find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \
    | grep 'device' | grep -v 'virtual' | grep -v 'ifb' | awk -F'/' '{print$NF}' | head -n1
}
svc_ok() { systemctl is-active "$1" >/dev/null 2>&1; }
svc_restart() {
  local s="$1"
  systemctl daemon-reload >/dev/null 2>&1
  systemctl restart "$s" >/dev/null 2>&1
  if ! svc_ok "$s"; then
    local u="/etc/systemd/system/$s.service"
    [[ -f $u && $(grep -c '^Nice=' "$u" 2>/dev/null || echo 0) -gt 0 ]] || return 1
    # 不修改磁盘上的 unit: 用 /run 下的临时 drop-in 覆盖 Nice=-9(重启后自动失效)
    local d="/run/systemd/system/$s.service.d"
    if mkdir -p "$d" && printf '[Service]\nNice=0\n' >"$d/10-nice.conf"; then
      systemctl daemon-reload >/dev/null 2>&1
      systemctl restart "$s" >/dev/null 2>&1
    else
      return 1
    fi
  fi
  svc_ok "$s"
}


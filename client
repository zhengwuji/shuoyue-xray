# ================================================================ 安装流程 ====
installGWD() {
  echo
  echo -e "${CYAN}=== de_GWD Remake 旁路网关安装 ===${cRES}"
  local nic nicIP cidr
  nic=$(detect_nic)
  [[ -z $nic ]] && die "未检测到物理网卡"
  nicIP=$(ip -4 a show "$nic" | grep -Po 'inet \K\d{1,3}(\.\d{1,3}){3}/\d{1,2}' | head -n1)
  echo "  检测到网卡: $nic ($nicIP)"
  local cidr_in; cidr_in=$(ask "本机静态 IP (CIDR, 回车=$nicIP): ")
  cidr=${cidr_in:-$nicIP}
  local gw; gw=$(ask "上级路由 IP (如 192.168.1.1): ")
  [[ ! "$gw" =~ ^[0-9.]+$ ]] && die "网关格式错误"

  conf_init
  conf_set '.net.nic' "$nic"
  conf_set '.net.localCIDR' "$cidr"
  conf_set '.net.gateway' "$gw"

  # 节点
  local addr uuid path tls
  while :; do
    addr=$(ask "服务端地址 (domain:port): ")
    [[ "$addr" =~ ^[A-Za-z0-9.-]+:[0-9]+$ ]] && break
    warn "格式: domain:port"
  done
  uuid=$(ask "UUID: "); [[ -z $uuid ]] && die "UUID 不能为空"
  path=$(ask "WS path (回车=tcp 直连): ")
  tls=${addr%%:*}
  local dip; dip=$(dig +short +time=3 +tries=1 @223.5.5.5 "${addr%%:*}" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1)
  conf_raw '.nodes' "[{\"name\":\"$(echo $tls | cut -d. -f1)\",\"address\":\"$addr\",\"tls\":\"$tls\",\"uuid\":\"$uuid\",\"path\":\"$path\",\"ip\":\"${dip:-}\"}]"

  local doh; doh=$(ask "全球分流 DoH (回车=https://1.1.1.1/dns-query): "); doh=${doh:-https://1.1.1.1/dns-query}
  conf_set '.dns.doh' "$doh"

  ok "基线环境..."
  apt_baseline; pkg_dep; chrony_conf; limits_conf; sysctl_conf
  resolv_setup
  net_static

  ok "流量整形 + nftables..."
  shaping_conf; nftables_conf

  ok "安装 Xray 并下载分流规则列表..."
  install_xray
  download_lists

  smartdns_conf
  xray_gen_config || die "Xray 配置生成失败(检查节点信息)"
  apply_node_bridge
  svc_restart xray && ok "Xray" || { err "Xray 未启动"; journalctl -u xray -n 15 --no-pager; }

  svc_restart smartdns && ok "smartdns (DNS 分流 :53)" || err "smartdns 未启动"
  svc_restart nftables || err "nftables 未启动"
  refresh_nft_sets

  (crontab -l 2>/dev/null | grep -v 'de_GWD/updateLists'; echo "0 4 * * * $BASE/updateLists") | crontab -
  cat <<EOF >"$BASE/updateLists"
#!/bin/bash
bash $(readlink -f "$0" 2>/dev/null || echo "$0") --lists
EOF
  chmod +x "$BASE/updateLists"

  printNode
  echo
  ok "安装完成! 将 LAN 设备的 网关 与 DNS 指向 $(echo $cidr | cut -d/ -f1) 即可。"
  ok "随时输入 shuoyue-gw 打开管理菜单(一键脚本用户)或 bash client。"
}

resolv_setup() {
  # 直接落实体文件, 兼容 Ubuntu systemd-resolved 的 stub 符号链接场景;
  # 223.5.5.5 为安装期回退(此时 smartdns 尚未启动), 装完后本地 53 优先应答
  systemctl stop systemd-resolved >/dev/null 2>&1
  systemctl disable systemd-resolved >/dev/null 2>&1
  systemctl mask systemd-resolved >/dev/null 2>&1
  rm -f /etc/resolv.conf
  printf 'nameserver 127.0.0.1\nnameserver 223.5.5.5\n' > /etc/resolv.conf
}

updateGWD() {
  echo -e "${CYAN}=== 更新 de_GWD Remake ===${cRES}"
  conf_init
  pkg_dep
  install_xray
  [[ -x $BASE/singbox/sing-box ]] && install_singbox --force
  download_lists
  smartdns_conf
  xray_gen_config 2>/dev/null
  apply_node_bridge 2>/dev/null
  svc_restart xray 2>/dev/null
  svc_restart smartdns 2>/dev/null
  nftables_conf 2>/dev/null
  svc_restart nftables 2>/dev/null
  refresh_nft_sets 2>/dev/null
  ok "更新完成"
}

# ================================================================ 节点管理 ====
# ------------------------- 分享链接解析(兼容 v2rayN 7.25.4 全部出站协议) ----
b64url_decode() {
  local s="$1"; s=${s//-/+}; s=${s//_//}
  case $((${#s} % 4)) in 2) s="${s}==";; 3) s="${s}=";; esac
  printf %s "$s" | tr '_-' '/+' | base64 -d 2>/dev/null
}
b64url_encode() { printf %s "$1" | base64 -w0 | tr '+/' '-_' | tr -d '='; }
qget() { echo "$2" | grep -oE "[?&]$1=[^&]*" | head -n1 | cut -d= -f2-; }
frag_of() { local f="${1##*#}"; [[ "$f" == "$1" ]] && f=""; printf %s "$f" | sed 's/%20/ /g'; }
norm_insecure() { [[ "$1" == "1" || "$1" == "true" ]] && echo 1 || echo 0; }

# $1=完整链接 → 输出节点 JSON(单行); 失败返回 1
parse_share_link() {
  local link="$1" scheme body auth hostport host port uuid password path sni pbk sid flow method insecure name q
  [[ "$link" != *"://"* ]] && return 1
  scheme=${link%%://*}
  body=${link#*://}
  body=${body%%#*}
  name=$(frag_of "$link"); [[ -z $name ]] && name="node"
  case $scheme in
    vmess)
      local j add nid npath nhost nport
      j=$(b64url_decode "$body")
      [[ -z $j ]] && return 1
      add=$(echo "$j" | jq -r '.add // empty' 2>/dev/null)
      nid=$(echo "$j" | jq -r '.id // empty' 2>/dev/null)
      nport=$(echo "$j" | jq -r '.port // "443"' 2>/dev/null)
      npath=$(echo "$j" | jq -r '.path // ""' 2>/dev/null)
      nhost=$(echo "$j" | jq -r '(.sni // .host // .add // empty)' 2>/dev/null)
      [[ -z $add || -z $nid ]] && return 1
      jq -cn --arg n "$name" --arg a "$add:$nport" --arg u "$nid" --arg p "$npath" --arg s "$nhost" \
        '{proto:"vmess", name:$n, address:$a, uuid:$u, path:$p, tls:$s}'
      ;;
    vless)
      auth=${body%%\?*}
      uuid=${auth%%@*}; hostport=${auth#*@}
      host=${hostport%%:*}; port=${hostport##*:}
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); pbk=$(qget pbk "$q"); sid=$(qget sid "$q")
      path=$(qget path "$q"); flow=$(qget flow "$q")
      local sec; sec=$(qget security "$q")
      if [[ $sec == "reality" ]]; then
        jq -cn --arg n "$name" --arg a "$host:$port" --arg u "$uuid" --arg s "$sni" \
              --arg pk "$pbk" --arg sd "$sid" --arg f "$flow" \
          '{proto:"vless", name:$n, address:$a, uuid:$u, tls:$s, pbk:$pk, sid:$sd, flow:$f, path:""}'
      else
        jq -cn --arg n "$name" --arg a "$host:$port" --arg u "$uuid" --arg p "$path" --arg s "$sni" \
          '{proto:"vless", name:$n, address:$a, uuid:$u, path:$p, tls:$s}'
      fi
      ;;
    trojan)
      auth=${body%%\?*}
      password=${auth%%@*}; hostport=${auth#*@}
      host=${hostport%%:*}; port=${hostport##*:}
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); path=$(qget path "$q")
      jq -cn --arg n "$name" --arg a "$host:$port" --arg pw "$password" --arg p "$path" --arg s "$sni" \
        '{proto:"trojan", name:$n, address:$a, password:$pw, path:$p, tls:$s}'
      ;;
    ss)
      local mainpart="${body%%#*}" userinfo methodpass
      if [[ "$mainpart" == *"@"* ]]; then
        userinfo=${mainpart%%@*}; hostport=${mainpart#*@}
        methodpass=$(b64url_decode "$userinfo")
      else
        methodpass=$(b64url_decode "$mainpart")
        hostport=${methodpass#*@}; methodpass=${methodpass%%@*}
      fi
      [[ -z $methodpass ]] && return 1
      host=${hostport%%:*}; port=${hostport##*:}
      method=${methodpass%%:*}; password=${methodpass#*:}
      jq -cn --arg n "$name" --arg a "$host:$port" --arg m "$method" --arg pw "$password" \
        '{proto:"ss", name:$n, address:$a, method:$m, password:$pw}'
      ;;
    hy2|hysteria2)
      auth=${body%%\?*}
      password=${auth%%@*}; hostport=${auth#*@}
      host=${hostport%%:*}; port=${hostport##*:}
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); insecure=$(norm_insecure "$(qget insecure "$q")")
      jq -cn --arg n "$name" --arg a "$host:$port" --arg pw "$password" --arg s "$sni" --argjson i "$insecure" \
        '{proto:"hy2", name:$n, address:$a, password:$pw, tls:$s, insecure:$i}'
      ;;
    tuic)
      auth=${body%%\?*}
      local userpass; userpass=${auth%%@*}; hostport=${auth#*@}
      uuid=${userpass%%:*}; password=${userpass#*:}
      host=${hostport%%:*}; port=${hostport##*:}
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); insecure=$(norm_insecure "$(qget allow_insecure "$q")")
      jq -cn --arg n "$name" --arg a "$host:$port" --arg u "$uuid" --arg pw "$password" \
            --arg s "$sni" --argjson i "$insecure" \
        '{proto:"tuic", name:$n, address:$a, uuid:$u, password:$pw, tls:$s, insecure:$i}'
      ;;
    anytls)
      auth=${body%%\?*}
      password=${auth%%@*}; hostport=${auth#*@}
      host=${hostport%%:*}; port=${hostport##*:}
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); insecure=$(norm_insecure "$(qget insecure "$q")")
      jq -cn --arg n "$name" --arg a "$host:$port" --arg pw "$password" --arg s "$sni" --argjson i "$insecure" \
        '{proto:"anytls", name:$n, address:$a, password:$pw, tls:$s, insecure:$i}'
      ;;
    *) return 1 ;;
  esac
}

nodes_list() {
  local nodes n i=0
  nodes=$(conf_get '.nodes'); n=$(echo "$nodes" | jq 'length' 2>/dev/null || echo 0)
  [[ $n -eq 0 ]] && { warn "尚无节点"; return; }
  local act; act=$(conf_get '.nodeActive')
  while [[ $i -lt $n ]]; do
    local proto addr u p name
    proto=$(echo "$nodes" | jq -r ".[$i].proto // \"vmess\"")
    name=$(echo "$nodes" | jq -r ".[$i].name"); addr=$(echo "$nodes" | jq -r ".[$i].address")
    u=$(echo "$nodes" | jq -r ".[$i].uuid // .[$i].password // \"\""); p=$(echo "$nodes" | jq -r ".[$i].path")
    local flag=" "; [[ $i -eq $act ]] && flag="*"
    echo "  [$((i+1))]$flag $name  ($proto)  $addr  key=${u:0:8}...  path=${p:-tcp}"
    i=$((i+1))
  done
}

nodes_add() {
  echo "添加节点 — 粘贴 v2rayN 分享链接(可连续粘多条):"
  echo "  支持: vmess:// vless://(含Reality) trojan:// ss:// hy2:// tuic:// anytls://"
  local link j host dip
  while :; do
    link=$(ask "粘贴链接 (回车=结束): ")
    [[ -z $link ]] && break
    j=$(parse_share_link "$link") || { warn "无法解析该链接"; continue; }
    host=$(echo "$j" | jq -r '.address' | cut -d: -f1)
    if [[ ! "$host" =~ ^[0-9.]+$ ]]; then
      dip=$(dig +short +time=3 +tries=1 @223.5.5.5 "$host" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1)
    else
      dip=$host
    fi
    j=$(echo "$j" | jq --arg ip "$dip" '. + {ip:$ip}')
    conf_raw '.nodes' "$(conf_get '.nodes' | jq --argjson n "$j" '. + [$n]')"
    ok "已添加: $(echo "$j" | jq -r '.name') [$(echo "$j" | jq -r '.proto')] $(echo "$j" | jq -r '.address')"
  done
  xray_gen_config 2>/dev/null
  apply_node_bridge
  svc_restart xray 2>/dev/null
  refresh_v2node 2>/dev/null
}

nodes_switch() {
  nodes_list
  local i; i=$(ask "切换到节点序号(1-based): ")
  [[ ! "$i" =~ ^[0-9]+$ || $i -lt 1 ]] && return
  local n; n=$(conf_get '.nodes' | jq 'length')
  [[ $i -gt $n ]] && die "序号不存在"
  local idx=$((i-1))
  conf_set '.nodeActive' "$idx"
  apply_node_bridge
  refresh_v2node
  xray_gen_config
  svc_restart xray && ok "已切换到节点 $i ($(conf_get ".nodes[$idx].name"))"
}
nodes_ping() {
  nodes_list
  local i; i=$(ask "测延迟节点序号(1-based): ")
  [[ ! "$i" =~ ^[0-9]+$ || $i -lt 1 ]] && return
  local idx=$((i-1))
  local addr tls proto
  addr=$(conf_get ".nodes[$idx].address"); tls=${addr%%:*}
  local port; port=${addr##*:}
  proto=$(conf_get ".nodes[$idx].proto")
  if [[ $proto == "hy2" || $proto == "tuic" ]]; then
    warn "$proto 为纯 UDP 协议, TCP 握手测试仅供参考"
  fi
  local ms
  ms=$(curl -o /dev/null -m 5 -kIs -w '%{time_connect}' "https://$tls:$port" 2>/dev/null | awk '{printf "%.0f", $1*1000}')
  [[ -n $ms ]] && echo "  TCP 握手延迟: ${ms}ms" || warn "测不通"
}
nodes_speed() {
  nodes_list
  local i; i=$(ask "测速节点序号(1-based, 需服务端有 /spt): ")
  [[ ! "$i" =~ ^[0-9]+$ || $i -lt 1 ]] && return
  local idx=$((i-1))
  local addr tls
  addr=$(conf_get ".nodes[$idx].address"); tls=${addr%%:*}; port=${addr##*:}
  local url="https://$tls:$port/spt"; [[ $port == "443" ]] && url="https://$tls/spt"
  echo "  下载测速中(100MB)..."
  wget -O /dev/null "$url" 2>&1 | tail -n2
}
nodes_del() {
  nodes_list
  local i; i=$(ask "删除节点序号(1-based): ")
  [[ ! "$i" =~ ^[0-9]+$ || $i -lt 1 ]] && return
  local idx=$((i-1))
  conf_raw '.nodes' "$(conf_get '.nodes' | jq "del(.[$idx])")"
  conf_set '.nodeActive' "0"
  apply_node_bridge
  xray_gen_config 2>/dev/null; svc_restart xray 2>/dev/null
  ok "已删除"
}
nodes_menu() {
  conf_init
  while :; do
    echo
    echo "--- 节点管理 ---"
    nodes_list
    echo "  [a] 添加(粘贴分享链接)  [s] 切换  [p] 测延迟  [d] 测速  [x] 删除  [q] 返回"
    read -rsp "选择: " -n1 c; echo
    case $c in
      a) nodes_add ;;
      s) nodes_switch ;;
      p) nodes_ping ;;
      d) nodes_speed ;;
      x) nodes_del ;;
      q) return ;;
    esac
  done
}

# ================================================================ 分流规则 ====
split_sm() {
  echo
  echo "流媒体/服务 分流 (0=直连, N=节点列表第N项, x=清除, 回车=不变):"
  nodes_list
  local cats="youtube netflix hbo tvb bahamut openai apple steam" cat cur ni
  for cat in $cats; do
    cur=$(conf_get ".split.sm.$cat // empty")
    ni=$(ask "  $cat (当前=${cur:-未设置}): ")
    [[ -z $ni ]] && continue
    if [[ "$ni" == "x" ]]; then
      conf_raw ".split.sm" "$(conf_get '.split.sm' | jq 'del(.'$cat')')"
    else
      conf_raw ".split.sm" "$(conf_get '.split.sm' | jq --argjson v "$ni" '. + {'\"$cat\"':$v}')"
    fi
  done
  xray_gen_config && svc_restart xray && ok "分流规则已生效"
}
split_domains() {
  echo "自定义域名分流(每行一个, 支持后缀匹配如 google.com):"
  echo "输入以 empty 结束. 以 ! 开头 = 强制直连, 否则强制代理"
  local arrB="[]" arrW="[]" line
  while :; do
    line=$(ask "  域名: ")
    [[ "$line" == "empty" || -z $line ]] && break
    if [[ "$line" == !* ]]; then
      arrW=$(echo "$arrW" | jq --arg d "${line#!}" '. + [$d]')
    else
      arrB=$(echo "$arrB" | jq --arg d "$line" '. + [$d]')
    fi
  done
  conf_raw '.split.listB' "$arrB"; conf_raw '.split.listW' "$arrW"
  xray_gen_config && svc_restart xray && ok "域名分流已生效"
}
split_ips() {
  echo "源 IP 分流(本局域网设备):"
  echo "  代理 IP 列表(强制走代理, 空行结束):"
  local arr="[]" line
  while :; do line=$(ask "  IP: "); [[ -z $line ]] && break; arr=$(echo "$arr" | jq --arg d "$line" '. + [$d]'); done
  conf_raw '.split.proxyIPs' "$arr"
  echo "  直连 IP 列表(强制直连, 空行结束):"
  arr="[]"
  while :; do line=$(ask "  IP: "); [[ -z $line ]] && break; arr=$(echo "$arr" | jq --arg d "$line" '. + [$d]'); done
  conf_raw '.split.directIPs' "$arr"
  refresh_nft_sets
  xray_gen_config && svc_restart xray && ok "源 IP 分流已生效"
}
split_clear() {
  conf_raw '.split' '{"sm":{},"listB":[],"listW":[],"proxyIPs":[],"directIPs":[]}'
  xray_gen_config && svc_restart xray && refresh_nft_sets 2>/dev/null
  ok "所有分流已清空"
}

printRelay() {
  local relays r=0 wan laddr
  relays=$(conf_get '.relay'); wan=$(wan_ip); laddr=$(conf_get '.net.localCIDR' | cut -d/ -f1)
  while [[ $r -lt $(echo "$relays" | jq 'length' 2>/dev/null || echo 0) ]]; do
    local port uuid
    port=$(echo "$relays" | jq -r ".[$r].port"); uuid=$(echo "$relays" | jq -r ".[$r].uuid")
    local vmj b64
    vmj=$(jq -cn --arg add "$wan" --arg port "$port" --arg id "$uuid" \
      '{v:"2",ps:"relay'"$port"'",add:$add,port:$port,id:$id,aid:"0",scy:"auto",net:"tcp",type:"none",tls:""}')
    b64=$(echo -n "$vmj" | base64 -w0)
    echo -e "${WHITE}中转线 $port : vmess://$b64${cRES}"
    r=$((r+1))
  done
}


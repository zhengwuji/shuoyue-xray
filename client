# ================================================================ 内核 =========
installkernel() {
  local codename; codename=$(. /etc/os-release 2>/dev/null; echo "${VERSION_CODENAME:-}")
  [[ -z $codename ]] && { err "无法识别发行版 codename"; return 1; }
  mkdir -p /etc/apt/keyrings
  # 源 URI 原写 zabbly.com/kernel/stable(实测 404/502), 官方仓库在 pkgs.zabbly.com
  curl -fsSL --max-time 30 https://pkgs.zabbly.com/key.asc -o /etc/apt/keyrings/zabbly.asc \
    || { err "Zabbly GPG key 下载失败"; return 1; }
  # 校验指纹: 只信任 Zabbly Kernel Builds 官方 key, 防止上游被投毒
  local ZABBLY_FPR="4EFC590696CB15B87C73A3AD82CC8797C838DCFD" fpr=""
  fpr=$(gpg --show-keys --with-fingerprint --with-colons /etc/apt/keyrings/zabbly.asc 2>/dev/null \
        | awk -F: '/^fpr:/{print $10; exit}')
  if [[ -z $fpr ]]; then
    # 老版本 gpg 无 --show-keys: 导到临时 keyring 再取指纹, 不污染用户 keyring
    local kd; kd=$(mktemp -d)
    GNUPGHOME="$kd" gpg --import /etc/apt/keyrings/zabbly.asc >/dev/null 2>&1
    fpr=$(GNUPGHOME="$kd" gpg --with-colons --fingerprint 2>/dev/null | awk -F: '/^fpr:/{print $10; exit}')
    rm -rf "$kd"
  fi
  if [[ "$fpr" != "$ZABBLY_FPR" ]]; then
    rm -f /etc/apt/keyrings/zabbly.asc
    err "Zabbly GPG key 指纹不匹配(期望 $ZABBLY_FPR, 实际 ${fpr:-无法读取}), 已中止安装"
    return 1
  fi
  ok "Zabbly GPG key 指纹校验通过: ${fpr:0:16}..."
  write_atomic /etc/apt/sources.list.d/zabbly-kernels-stable.sources 644 <<EOF
Enabled: yes
Types: deb
URIs: https://pkgs.zabbly.com/kernel/stable
Suites: $codename
Components: main
Signed-By: /etc/apt/keyrings/zabbly.asc
EOF
  apt-get update -qq
  apt-get install -y -qq linux-zabbly \
    || { err "Zabbly 内核不支持该发行版/套件($codename), 仅支持 Debian 12/13 与 Ubuntu 22.04/24.04"; return 1; }
  ok "内核已安装, 重启生效"
  read -rsp "现在重启? [y/N]: " -n1 r; echo
  [[ "$r" =~ ^[Yy] ]] && reboot
  return 0
}

# ================================================================ 自动更新 =====
autoupdate_on() {
  # 先写脚本再写 cron(原顺序相反)
  write_atomic "$BASE/autoUpdate" 755 <<'EOF'
#!/bin/bash
# 自更新: 下载 → 校验 → 落盘覆盖自身 → exec 重跑
BASE="${DEGWD_BASE:-/opt/de_GWD}"
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
VERSION_FILE="$BASE/.version"
lv=$(cat "$VERSION_FILE" 2>/dev/null)
[[ -z $lv ]] && lv=$(bash "$SELF" --version 2>/dev/null | awk '{print $NF}')
# 仓库地址由外层注入(占位符 __REMOTE_BASE__ 在写入后替换),
# 避免这里再抄一份 URL 导致改地址时漏改
REMOTE_BASE="__REMOTE_BASE__"
rv=$(curl -fsSL --max-time 15 "$REMOTE_BASE/version" 2>/dev/null | head -n1)
[[ -z $rv || -z $lv ]] && exit 0
[[ "$lv" == "$rv" ]] && exit 0
new=$(mktemp /tmp/degwd-client.XXXXXX) || exit 0
chk=$(mktemp /tmp/degwd-sha.XXXXXX) || { rm -f "$new"; exit 0; }
trap 'rm -f "$new" "$chk"' EXIT
curl -fsSL --max-time 60 "$REMOTE_BASE/client" -o "$new" || exit 0
[[ $(wc -c <"$new") -lt 30000 ]] && { echo "下载内容过小, 放弃" >&2; exit 0; }
# 语法自检 + sha256 校验(有 checksums 文件时必须匹配)
bash -n "$new" || { echo "新脚本语法错误, 放弃" >&2; exit 1; }
if curl -fsSL --max-time 20 "$REMOTE_BASE/checksums.txt" -o "$chk" 2>/dev/null; then
  want=$(awk -v n="client" '$2==n || $2=="*client" {print $1; exit}' "$chk")
  if [[ -n $want ]]; then
    got=$(sha256sum "$new" | awk '{print $1}')
    [[ "$got" != "$want" ]] && { echo "sha256 不匹配, 放弃更新" >&2; exit 1; }
  fi
fi
# 原版只 bash --update 再 rm, 从未落盘覆盖自身 → 更新永远不生效
install -m 755 "$new" "$SELF" || exit 1
echo "$rv" > "$VERSION_FILE"
exec bash "$SELF" --update
EOF
  # 注入仓库地址(heredoc 用 <<'EOF' 保持字面, 占位符在此替换)
  sed -i "s|__REMOTE_BASE__|$REMOTE_BASE|" "$BASE/autoUpdate"
  if command -v crontab >/dev/null 2>&1; then
    (crontab -l 2>/dev/null | grep -F -v -- "$BASE/autoUpdate"; echo "0 5 * * * $BASE/autoUpdate") | crontab -
  else
    warn "crontab 不可用, 无法注册自动更新任务"
  fi
  ok "自动更新已开启(每日 05:00, 校验 sha256 后覆盖自身)"
}
autoupdate_off() {
  if command -v crontab >/dev/null 2>&1; then
    (crontab -l 2>/dev/null | grep -F -v -- "$BASE/autoUpdate") | crontab -
  fi
  rm -f "$BASE/autoUpdate"; ok "自动更新已关闭"
}

# ================================================================ 信息输出 ====
# 节点 → 分享链接(v2rayN 兼容)
gen_node_link() {   # $1 = idx
  local i="$1" addr host port proto uuid password path sni pbk sid flow method insecure name
  local enc mode nhost fp
  addr=$(conf_get ".nodes[$i].address"); split_hostport "$addr"; host=$SP_HOST; port=$SP_PORT
  proto=$(conf_get ".nodes[$i].proto"); proto=${proto:-vmess}
  uuid=$(conf_get ".nodes[$i].uuid"); password=$(conf_get ".nodes[$i].password")
  path=$(conf_get ".nodes[$i].path"); sni=$(conf_get ".nodes[$i].tls"); [[ -z $sni ]] && sni=$host
  pbk=$(conf_get ".nodes[$i].pbk"); sid=$(conf_get ".nodes[$i].sid")
  flow=$(conf_get ".nodes[$i].flow"); method=$(conf_get ".nodes[$i].method")
  enc=$(conf_get ".nodes[$i].enc"); mode=$(conf_get ".nodes[$i].mode")
  nhost=$(conf_get ".nodes[$i].host"); [[ -z $nhost || $nhost == "null" ]] && nhost=$sni
  fp=$(conf_get ".nodes[$i].fp"); [[ -z $fp || $fp == "null" ]] && fp="chrome"
  [[ $(conf_get ".nodes[$i].insecure") == "1" ]] && insecure=1 || insecure=0
  name=$(conf_get ".nodes[$i].name"); name=${name// /%20}; [[ -z $name ]] && name="node"
  case $proto in
    vmess|vmess-ws|vmess-tcp)
      local vj nnet
      nnet=$(conf_get ".nodes[$i].net"); [[ -z $nnet || $nnet == "null" ]] && nnet="tcp"
      [[ $proto == "vmess-ws" ]] && nnet="ws"
      [[ $proto == "vmess-tcp" ]] && nnet="tcp"
      if [[ $nnet == "ws" ]]; then
        vj=$(jq -cn --arg add "$host" --arg port "$port" --arg id "$uuid" --arg path "$path" \
                  --arg host "$sni" --arg ps "$name" \
          '{v:"2",ps:$ps,add:$add,port:$port,id:$id,aid:"0",scy:"auto",net:"ws",type:"none",host:$host,path:$path,tls:"tls",sni:$host}')
      else
        vj=$(jq -cn --arg add "$host" --arg port "$port" --arg id "$uuid" --arg ps "$name" \
          '{v:"2",ps:$ps,add:$add,port:$port,id:$id,aid:"0",scy:"auto",net:"tcp",type:"none",tls:""}')
      fi
      echo "vmess://$(printf %s "$vj" | base64 -w0)"
      ;;
    vless|vless-reality|vless-ws|vless-tcp|vless-ws-enc|vless-xhttp-tls|vless-xhttp-enc|vless-reality-xhttp)
      # 旧配置的 proto 只有 "vless": 按 pbk/path 回退推断
      local vk="$proto"
      if [[ $vk == "vless" ]]; then
        if [[ -n $pbk && $pbk != "null" ]]; then
          if [[ -n $path && $path != "null" ]]; then vk="vless-reality-xhttp"; else vk="vless-reality"; fi
        elif [[ -n $path && $path != "null" ]]; then
          if [[ -n $enc && $enc != "null" && $enc != "none" ]]; then vk="vless-ws-enc"; else vk="vless-ws"; fi
        else
          vk="vless-tcp"
        fi
      fi
      case $vk in
        vless-reality)
          echo "vless://$uuid@$host:$port?security=reality&encryption=none&pbk=$pbk&fp=$fp&type=tcp&flow=${flow:-xtls-rprx-vision}&sni=$sni&sid=$sid#$name"
          ;;
        vless-reality-xhttp)
          echo "vless://$uuid@$host:$port?security=reality&encryption=none&pbk=$pbk&fp=$fp&type=xhttp&path=$(urlenc "$path")&mode=${mode:-auto}&sni=$sni&sid=$sid#$name"
          ;;
        vless-xhttp-tls)
          echo "vless://$uuid@$host:$port?encryption=none&security=tls&sni=$sni&fp=$fp&type=xhttp&host=$nhost&path=$(urlenc "$path")&mode=${mode:-auto}#$name"
          ;;
        vless-xhttp-enc)
          echo "vless://$uuid@$host:$port?encryption=$(urlenc "$enc")&security=tls&sni=$sni&fp=$fp&type=xhttp&host=$nhost&path=$(urlenc "$path")&mode=${mode:-auto}#$name"
          ;;
        vless-ws-enc)
          echo "vless://$uuid@$host:$port?encryption=$(urlenc "$enc")&security=tls&sni=$sni&fp=$fp&type=ws&host=$nhost&path=$(urlenc "$path")#$name"
          ;;
        vless-ws)
          echo "vless://$uuid@$host:$port?encryption=none&security=tls&sni=$sni&fp=$fp&type=ws&host=$nhost&path=$(urlenc "$path")#$name"
          ;;
        vless-tcp)
          echo "vless://$uuid@$host:$port?encryption=none&security=tls&sni=$sni&fp=$fp&type=tcp#$name"
          ;;
      esac
      ;;
    trojan|trojan-ws|trojan-tcp)
      local tk="$proto"
      if [[ $tk == "trojan" ]]; then
        if [[ -n $path && $path != "null" ]]; then tk="trojan-ws"; else tk="trojan-tcp"; fi
      fi
      if [[ $tk == "trojan-ws" ]]; then
        echo "trojan://$password@$host:$port?security=tls&sni=$sni&type=ws&host=$nhost&path=$(urlenc "$path")#$name"
      else
        echo "trojan://$password@$host:$port?security=tls&sni=$sni&type=tcp#$name"
      fi
      ;;
    ss|sssb)
      local sm="$method"; [[ -z $sm || $sm == "null" ]] && sm="2022-blake3-aes-128-gcm"
      echo "ss://$(b64url_encode "$sm:$password")@$host:$port#$name"
      ;;
    socks|socks5)
      if [[ -n $uuid && $uuid != "null" && -n $password && $password != "null" ]]; then
        echo "socks://$(b64url_encode "$uuid:$password")@$host:$port#$name"
      else
        echo "socks://$host:$port#$name"
      fi
      ;;
    hy2)
      echo "hysteria2://$password@$host:$port?sni=$sni&insecure=$insecure#$name"
      ;;
    tuic)
      echo "tuic://$uuid:$password@$host:$port?congestion_control=bbr&alpn=h3&sni=$sni&allow_insecure=$insecure#$name"
      ;;
    anytls)
      echo "anytls://$password@$host:$port?sni=$sni&insecure=$insecure#$name"
      ;;
    naive)
      echo "naive://$(urlenc "$uuid:$password")@$host:$port?sni=$sni&insecure=$insecure#$name"
      ;;
    *)
      err "节点协议不支持导出链接: $proto"; return 1
      ;;
  esac
}

printNode() {
  conf_init
  local n act laddr i link
  n=$(conf_get '.nodes' | jq 'length' 2>/dev/null || echo 0)
  act=$(conf_get '.nodeActive')
  laddr=$(conf_get '.net.localCIDR' | cut -d/ -f1)
  echo
  echo -e "${CYAN}=============== 网关信息 ===============${cRES}"
  echo -e "${WHITE}网关 IP: ${GREEN}$laddr${cRES}  (LAN 设备网关+DNS 指向此地址)"
  if [[ $n -gt 0 ]]; then
    echo
    i=0
    while [[ $i -lt $n ]]; do
      link=$(gen_node_link "$i") || { warn "节点 $i 无法导出分享链接"; i=$((i+1)); continue; }
      [[ $i -eq $act ]] && echo -e "${GREEN}▶ 当前节点${cRES}"
      echo -e "${WHITE}$link${cRES}"
      if [[ $i -eq $act ]]; then
        echo
        qrencode -t UTF8 -s 1 -m 2 "$link" 2>/dev/null
        echo
      fi
      i=$((i+1))
    done
  fi
  printRelay
  echo -e "${CYAN}-----------------------------------------${cRES}"
  echo "  v2rayN 导入: 复制链接 → 主界面 Ctrl+V(从剪贴板导入批量URL)"
  echo "  网关上的节点同样可在 v2rayN 单设备直连使用"
  echo -e "${CYAN}=========================================${cRES}"
}

# ================================================================ 卸载 ========
uninstallGWD() {
  echo -e "${RED}=== 卸载 de_GWD ===${cRES}"
  local yn; yn=$(ask "确认卸载? 将停止服务、删除 nft 表/自建单元/ifb/定时任务并恢复 DNS 配置 [y/N]: ")
  [[ $yn != "y" && $yn != "Y" ]] && { warn "已取消"; return; }

  # 1. 停服务 + 删单元(不含发行版 nftables.service: 那是系统自带单元, 不擅自改动)
  local u
  for u in xray smartdns adguardhome wg-quick@wg0 degwd-nftables degwd-shaping; do
    systemctl stop "$u" >/dev/null 2>&1
    systemctl disable "$u" >/dev/null 2>&1
  done
  if [[ -f /etc/systemd/system/nftables.service ]]; then
    warn "检测到自建 /etc/systemd/system/nftables.service, 已删除(如需恢复请重装 nftables 包)"
    rm -f /etc/systemd/system/nftables.service
  fi
  rm -f /etc/systemd/system/xray.service \
        /etc/systemd/system/smartdns.service \
        /etc/systemd/system/degwd-nftables.service \
        /etc/systemd/system/degwd-shaping.service \
        /etc/systemd/system/networking.service.d/override.conf
  rm -f /etc/systemd/system/multi-user.target.wants/xray.service \
        /etc/systemd/system/multi-user.target.wants/smartdns.service \
        /etc/systemd/system/multi-user.target.wants/degwd-nftables.service \
        /etc/systemd/system/multi-user.target.wants/degwd-shaping.service
  systemctl daemon-reload >/dev/null 2>&1

  # 2. 只删自建 nft 表, 绝不动 flush ruleset
  local t
  for t in "ip de_GWD" "inet degwd_filter" "inet degwd_router" "inet degwd_offload"; do
    nft delete table $t 2>/dev/null
  done
  ip rule del fwmark 0x9 table 220 2>/dev/null
  ip route del local default dev lo table 220 2>/dev/null

  # 3. ifb 接口
  local i
  for i in $(ip -o link show 2>/dev/null | awk -F': ' '/ifb/{print $2}' | cut -d@ -f1); do
    ip link del "$i" 2>/dev/null
  done

  # 4. cron 任务(不卸载系统 cron 服务本身, 只摘掉本项目的三条定时任务)
  if command -v crontab >/dev/null 2>&1; then
    (crontab -l 2>/dev/null | grep -F -v -- "$BASE/updateLists" | grep -F -v -- "$BASE/ddns" \
      | grep -F -v -- "$BASE/autoUpdate") | crontab - 2>/dev/null
  fi

  # 5. 恢复 DNS 与 systemd-resolved
  systemctl unmask systemd-resolved >/dev/null 2>&1
  rm -f /etc/NetworkManager/conf.d/90-degwd-dns.conf
  if [[ -f /etc/resolv.conf.degwd.bak ]]; then
    cp -a /etc/resolv.conf.degwd.bak /etc/resolv.conf
    rm -f /etc/resolv.conf.degwd.bak
  else
    write_atomic /etc/resolv.conf 644 <<EOF
nameserver $DNS_ALI
nameserver $DNS_TENCENT
EOF
  fi
  command -v nmcli >/dev/null 2>&1 && systemctl reload NetworkManager >/dev/null 2>&1
  systemctl enable --now systemd-resolved >/dev/null 2>&1

  # 6. 备份目录与日志保留, 运行数据可选清理
  local clean; clean=$(ask "同时删除 $BASE (含 conf.json/节点)? [y/N]: ")
  if [[ $clean == "y" || $clean == "Y" ]]; then
    rm -rf "$BASE"
    ok "已删除 $BASE"
  else
    ok "保留 $BASE (配置与节点未删)"
  fi
  ok "卸载完成。日志: $LOG_FILE"
}

# ==================================================================== 菜单 ====
start_menu() {
  clear
  while :; do
    clear
    echo -e "${CYAN}=====================================================${cRES}"
    echo -e "${WHITE}   朔月 Shuoyue ${VERSION}  -  旁路网关客户端${cRES}"
    echo -e "${CYAN}=====================================================${cRES}"
    health_check
    echo
    echo "  0. Update (更新)"
    echo "  1. Install de_GWD (安装)"
    echo "  2. Nodes (节点管理)"
    echo "  3. Split rules (分流规则)"
    echo "  4. DNS settings (DNS 设置)"
    echo "  5. AdGuard Home (广告拦截)"
    echo "  6. WireGuard (服务端)"
    echo "  7. DDNS (Cloudflare)"
    echo "  8. block53 (DNS 劫持开关)"
    echo "  9. Proxy on/off (代理开关)"
    echo " 10. Relay lines (对外中转线)"
    echo " 11. Print node (节点信息)"
    echo " 12. Install new kernel (Zabbly)"
    echo " 13. AutoUpdate on/off"
    echo " 14. Status / Health (完整连通性检测)"
    echo " 99. Uninstall (卸载)"
    echo " CTRL+C EXIT"
    echo
    read -rp "请输入数字: " num
    case $num in
      0) updateGWD ;;
      1) installGWD ;;
      2) nodes_menu ;;
      3) split_menu ;;
      4) dns_menu ;;
      5)
        # 原版用 && || 串联, agh_remove 返回非 0 时会反向再执行 agh_install
        if [[ $(conf_get '.adblock') == "true" ]]; then agh_remove; else agh_install; fi
        ;;
      6) wg_menu ;;
      7) ddns_menu ;;
      8) block53_toggle ;;
      9) proxy_toggle ;;
      10) relay_menu ;;
      11) printNode ;;
      12) installkernel ;;
      13)
        # 原版 `svc_ok cron || true` 是死代码, 且部分发行版单元名是 crond.service
        if ! command -v crontab >/dev/null 2>&1; then
          warn "crontab 不可用, 请先安装 cron (apt-get install -y cron)"
        elif [[ -f $BASE/autoUpdate ]]; then
          autoupdate_off
        else
          autoupdate_on
        fi
        ;;
      14) health_check full ;;
      99) uninstallGWD ;;
      *) warn "输入有误" ;;
    esac
  done
}

# -------------------------------------------------------------------- 入口 ---
# set -u 下 $1 未定义会直接报错, 必须用 ${1:-}
case "${1:-}" in
  --update)    updateGWD; exit 0 ;;
  --install)   installGWD; exit 0 ;;
  --lists)     download_lists && refresh_nft_sets; exit 0 ;;
  --ddns)      ddns_update_cf; exit 0 ;;
  --status)    conf_init; health_check full; exit 0 ;;
  --node-switch)
    # 非交互切换活动节点: --node-switch N (1-based)
    [[ -z ${2:-} ]] && { err "用法: bash client --node-switch <序号>"; exit 2; }
    nodes_switch_idx "$2" || exit 1
    exit 0 ;;
  --regen)
    # 仅重新生成配置与规则并重启服务(不下载、不装包)
    conf_init
    xray_gen_config || { err "Xray 配置生成失败"; exit 1; }
    apply_node_bridge
    svc_restart xray || { err "Xray 重启失败"; exit 1; }
    nftables_apply || { err "nftables 重建失败"; exit 1; }
    ok "配置与规则已重建"
    exit 0 ;;
  --uninstall) uninstallGWD; exit 0 ;;
  --version)   echo "$VERSION"; exit 0 ;;
  --help|-h)
    cat <<EOF
朔月 Shuoyue $VERSION — 旁路网关客户端

用法: bash client [子命令]
  --install          安装并初始化 de_GWD
  --update           更新 Xray/规则/配置并重启服务
  --lists            仅更新分流规则列表(供 cron 调用)
  --ddns             更新 Cloudflare DDNS 记录(供 cron 调用)
  --status           打印服务状态与完整连通性检测
  --node-switch N    切换到第 N 个节点(1-based, 非交互)
  --regen            仅重建配置与 nftables 规则并重启服务
  --uninstall        卸载 de_GWD(恢复 DNS, 删除 nft 表与自建单元)
  --version          显示版本
  --help             显示本帮助

无参数 = 打开交互式管理菜单。
日志: $LOG_FILE
EOF
    exit 0 ;;
esac
start_menu

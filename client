}

# =============================================== 流量整形 (同服务端, CAKE+ifb) ==
shaping_conf() {
  cat <<'EOF' >/etc/rc_online.local
#!/bin/bash
THP=/sys/kernel/mm/transparent_hugepage/enabled
[[ -f $THP ]] && echo madvise > "$THP" 2>/dev/null

nic_phys() {
  find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \
    | grep 'device' | grep -v 'virtual' | grep -v 'ifb' | awk -F'/' '{print$NF}'
}
del_ifb() {
  local d
  for d in $(find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \
      | grep 'ifb' | awk -F'/' '{print$NF}'); do
    ip link set "$d" down 2>/dev/null; ip link delete "$d" 2>/dev/null
  done
}

for r in $(ip route show table local | grep -Ev 'linkdown|broadcast' | awk '{print$1}'); do
  ip route change "$r" mtu 1500 initcwnd 32 initrwnd 32 fastopen_no_cookie 1 congctl lock cubic 2>/dev/null
done
ip route change local 127.0.0.0/8 dev lo table local mtu 65520 initcwnd 32 initrwnd 32 fastopen_no_cookie 1 congctl lock cubic 2>/dev/null

ip link set lo qlen 10000 mtu 65520
del_ifb

# lo 只做 egress 整形: TPROXY 把 LAN 流量交付到 127.0.0.1:9896, 整条链路都在 lo 上,
# 再对 lo 做 ingress→ifb4lo 属于自伤(原版 ifb4lo 已删除)
tc qdisc del dev lo root 2>/dev/null
tc qdisc add dev lo root cake unlimited rtt 50us diffserv4 dual-srchost nonat nowash no-split-gso ack-filter-aggressive raw egress

# 只整形物理/WAN/LAN 网卡(veth/br-* 等虚拟口不整形, 避免与容器网络互相串流)
ifb_name() {   # 由接口名哈希出稳定且唯一的 ifb 名(原 cut -c1-11 会截断冲突)
  local h
  h=$(printf '%s' "$1" | md5sum | cut -c1-10)
  printf 'ifb%s' "$h"
}

for line in $(nic_phys); do
  tc qdisc del dev "$line" root 2>/dev/null
  tc qdisc add dev "$line" root cake unlimited rtt 200us diffserv4 dual-srchost nonat nowash no-split-gso ack-filter raw overhead 18 mpu 64 egress
  tc qdisc del dev "$line" ingress 2>/dev/null
  tc qdisc add dev "$line" handle ffff: ingress 2>/dev/null
  ifb=$(ifb_name "$line")
  if ! ip link show "$ifb" >/dev/null 2>&1; then ip link add name "$ifb" type ifb; fi
  ip link set "$ifb" up
  tc qdisc del dev "$ifb" root 2>/dev/null
  tc qdisc add dev "$ifb" root cake unlimited rtt 200us diffserv4 dual-dsthost nonat nowash no-split-gso no-ack-filter raw overhead 18 mpu 64 ingress
  tc filter del dev "$line" ingress 2>/dev/null
  tc filter add dev "$line" parent ffff: matchall action mirred egress redirect dev "$ifb" 2>/dev/null
  # GRO/GSO/TSO 保持开启: 关闭会让 CAKE 走逐包路径, 吞吐显著下降
  # (不再强制 duplex full: 2.5G/10G 网卡可能因此掉链路; ufo 在 5.x 内核已移除)
  ethtool -K "$line" rx on tx on sg on gro on gso on tso on lro off 2>/dev/null
done

ip tcp_metrics flush >/dev/null 2>&1
ip route flush cache >/dev/null 2>&1
EOF
  chmod +x /etc/rc_online.local
  # 原 networking.service.d 覆盖在 NetworkManager/systemd-networkd 系统上不存在 → 永不执行;
  # 改为独立单元, 在网卡 up 之后再整形
  write_atomic /etc/systemd/system/degwd-shaping.service 644 <<'EOF'
[Unit]
Description=de_GWD traffic shaping (CAKE + ifb)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/rc_online.local

[Install]
WantedBy=multi-user.target
EOF
  rm -f /etc/systemd/system/networking.service.d/override.conf 2>/dev/null
  systemctl daemon-reload
  systemctl enable degwd-shaping >/dev/null 2>&1
}

# ============================================== nftables (TPROXY 透明代理) =====
nft_sets_reload() {   # 从文本 IP 列表刷新 nft 集合
  local set_name file chunk="" n=0 tmp
  set_name="$1"; file="$2"
  # 表不存在时 add element 会静默失败并留下"集合为空"的假象 → 先显式判断
  if ! nft list table ip de_GWD >/dev/null 2>&1; then
    warn "nft 表 ip de_GWD 不存在, 跳过刷新 $set_name (请先执行 nftables_apply)"
    return 1
  fi
  nft flush set ip de_GWD "$set_name" 2>/dev/null
  [[ ! -s $file ]] && return 0
  tmp=$(mktemp /tmp/degwd-elem.XXXXXX) || return 1   # 固定名 /tmp/nft_elements.tmp 会被并发实例互相覆盖
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    chunk="$chunk$line, "; n=$((n+1))
    if [[ $n -ge 500 ]]; then echo "$chunk" >>"$tmp"; chunk=""; n=0; fi
  done < "$file"
  [[ -n $chunk ]] && echo "$chunk" >>"$tmp"
  while IFS= read -r c; do
    nft add element ip de_GWD "$set_name" { "${c%, }" } 2>/dev/null
  done < "$tmp"
  rm -f "$tmp"
  return 0
}

# flowtable 设备(物理口 + wg0/docker0; 纯虚拟口不参与 offload)
ft_devices() {
  find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \
    | grep 'device' | grep -v 'virtual' | grep -v 'ifb' | awk -F'/' '{print$NF}'
  local d
  for d in wg0 docker0; do [[ -e /sys/class/net/$d ]] && echo "$d"; done
}

nftables_conf() {
  local cidr reserved ft_devs ipaddr
  cidr=$(conf_get '.net.localCIDR')
  ipaddr=${cidr%%/*}
  # RFC1918/保留网段 + 本机 IP + 国内 DNS + IP 回显域名(去重)
  reserved=$({ printf '%s\n' $RESERVED_NETS; [[ -n $ipaddr ]] && printf '%s\n' "$ipaddr"; \
               printf '%s\n' "$DNS_ALI" "$DNS_TENCENT"; \
               conf_get '.dns.china[]' 2>/dev/null; \
               for h in $IP_ECHO_HOSTS; do dig +short +time=3 +tries=1 @"$DNS_ALI" "$h" A 2>/dev/null | grep -E '^[0-9.]+$'; done; \
             } | grep -v '^$' | sort -u | tr '\n' ',' | sed 's/,$//; s/,/, /g')

  # flowtable 设备在生成器内直接产出: 原 include 依赖单元 ExecStart 的生成顺序,
  # 一旦生成脚本失败, 整个 nft -f 会因缺文件而报错(表与集合全部不加载)
  ft_devs=$(ft_devices | tr '\n' ',' | sed 's/,$//; s/,/, /g')
  [[ -z $ft_devs ]] && ft_devs="lo"

  write_atomic "$BASE/nftables/default.nft" 644 <<EOF
define flowtable_eth = { $ft_devs }

define RESERVED_IP = $reserved

table ip de_GWD {
    set CHNROUTE  { type ipv4_addr; flags interval; auto-merge; }
    set GLOBALDNS { type ipv4_addr; flags interval; auto-merge; }
    set V2NODE    { type ipv4_addr; flags interval; auto-merge; }
    set LISTBLAN  { type ipv4_addr; flags interval; auto-merge; }
    set LISTWLAN  { type ipv4_addr; flags interval; auto-merge; }

    chain prerouting {
        type filter hook prerouting priority -280; policy accept;
        meta l4proto udp th dport { 53, 67, 68, 123, 1900, 5350, 5351, 5353 } accept
        meta l4proto tcp th dport { 53, 67, 68, 123 } accept
        ip daddr @GLOBALDNS accept
        # 入口端口豁免: WG / 中转线 / 本地 socks 入站不得被 TPROXY 劫持
        meta l4proto { tcp, udp } th dport { $ENTRY_PORTS } accept
        ip saddr @LISTBLAN meta l4proto { tcp, udp } tproxy to 127.0.0.1:9896 meta mark set 0x9
        ip saddr @LISTWLAN accept
        ip daddr \$RESERVED_IP accept
        ip daddr @V2NODE accept
        ip daddr @CHNROUTE accept
        ip protocol { tcp, udp } tproxy to 127.0.0.1:9896 meta mark set 0x9
    }
    chain output {
        type route hook output priority -280; policy accept;
        oifname "lo" accept
        meta l4proto udp th dport { 53, 67, 68, 123, 5330, 1900, 5353 } accept
        meta l4proto tcp th dport { 53, 67, 68, 123 } accept
        meta l4proto { tcp, udp } th dport { $ENTRY_PORTS } accept
        meta mark 0xff accept
        ip daddr @GLOBALDNS accept
        ip daddr \$RESERVED_IP accept
        ip daddr @V2NODE accept
        ip daddr @CHNROUTE accept
        ip protocol { tcp, udp } meta mark set 0x9
    }
}

table inet degwd_filter {
    chain INPUT {
        type filter hook input priority 0; policy accept;
        iifname "lo" accept
        iifname "wg0" accept
        iifname "docker0" accept
        iifname "ifb*" accept
        ct state established,related accept
        tcp flags != syn ct state new drop
        tcp flags & (fin|syn) == (fin|syn) drop
        tcp flags & (syn|rst) == (syn|rst) drop
        tcp flags & (fin|syn|rst|psh|ack|urg) == 0 drop
        ct state invalid counter drop
    }
    chain FORWARD {
        type filter hook forward priority 0; policy accept;
        iifname "wg0" accept
        oifname "wg0" accept
        iifname "docker0" oifname != "docker0" counter accept
        oifname "docker0" ct state related,established counter accept
    }
    chain OUTPUT { type filter hook output priority 0; policy accept; }
}

table inet degwd_router {
    chain PREROUTING {
        type nat hook prerouting priority dstnat; policy accept;
        tcp flags & (syn|rst) == syn counter tcp option maxseg size set 1460
        __BLOCK53__
    }
    chain POSTROUTING {
        type nat hook postrouting priority srcnat; policy accept;
        oifname != "lo" ip saddr $WG_NET counter masquerade
        oifname != "docker0" ip saddr $DOCKER_NET counter masquerade
    }
}

# flowtable 硬件卸载: 把 wg0/docker0 也纳入 devices, 否则 bypasschain 的
# flow offload 找不到任何可卸载的入口设备, 整张表是死配置
table inet degwd_offload {
    flowtable Acceleration {
        hook ingress priority -300; devices = \$flowtable_eth;
    }
    chain bypasschain {
        type filter hook forward priority -300; policy accept;
        ip daddr $WG_NET flow offload @Acceleration
        ip saddr $WG_NET flow offload @Acceleration
        ip daddr $DOCKER_NET flow offload @Acceleration
        ip saddr $DOCKER_NET flow offload @Acceleration
    }
}
EOF

  # block53 = DNS 劫持: LAN 设备查询外部 DNS 一律重定向到本机
  # 明文 53 之外必须 reject DoT(853): 否则设备改用加密 DNS 即可完全绕过劫持
  if [[ $(conf_get '.block53') == "true" ]]; then
    sed -i 's|__BLOCK53__|ip daddr != $RESERVED_IP meta l4proto { tcp, udp } th dport 53 counter redirect to :53\n        meta l4proto { tcp, udp } th dport 853 counter reject|' "$BASE/nftables/default.nft"
  else
    sed -i '/__BLOCK53__/d' "$BASE/nftables/default.nft"
  fi

  # 不覆盖发行版自带的 /etc/systemd/system/nftables.service: 本单元独立命名为 degwd-nftables
  write_atomic /etc/systemd/system/degwd-nftables.service 644 <<EOF
[Unit]
Description=de_GWD nftables TPROXY + CAKE
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=null
ProtectSystem=full
ProtectHome=true
ExecStart=/usr/sbin/nft -f $BASE/nftables/default.nft
ExecStart=/bin/bash -c 'ip route add local default dev lo scope host table 220 2>/dev/null; ip rule add fwmark 0x9 table 220 prio 100 2>/dev/null'
ExecStop=/bin/bash -c '/usr/sbin/nft delete table ip de_GWD 2>/dev/null; /usr/sbin/nft delete table inet degwd_filter 2>/dev/null; /usr/sbin/nft delete table inet degwd_router 2>/dev/null; /usr/sbin/nft delete table inet degwd_offload 2>/dev/null; ip rule del fwmark 0x9 table 220 2>/dev/null; ip route del local default dev lo table 220 2>/dev/null'

[Install]
WantedBy=sysinit.target
EOF
  # 只清理自建表: 原 ExecStop 用 nft flush ruleset 会清空整机所有表(含 Docker/firewalld)
  systemctl disable nftables >/dev/null 2>&1
  rm -f /etc/systemd/system/nftables.service 2>/dev/null
  systemctl daemon-reload
  systemctl enable degwd-nftables >/dev/null 2>&1
}

# 重建 nftables 表并立刻回填所有集合。裸 nft -f 之后 CHNROUTE/V2NODE/GLOBALDNS/
# LISTBLAN/LISTWLAN 全是空集, 透明代理会瞬间失效 → 所有重建点统一走这里
nftables_apply() {
  nftables_conf || { err "nftables 规则生成失败"; return 1; }
  svc_restart degwd-nftables || { err "nftables 服务启动失败"; return 1; }
  refresh_nft_sets
}

# 只更新 RESERVED_IP 集合(国内 DNS 等小改动), 不重写整份规则、不重启 nftables,
# 避免一次 DNS 修改就打断所有既有连接
nft_reserved_only() {
  local reserved ipaddr
  ipaddr=$(conf_get '.net.localCIDR'); ipaddr=${ipaddr%%/*}
  reserved=$({ printf '%s\n' $RESERVED_NETS; [[ -n $ipaddr ]] && printf '%s\n' "$ipaddr"; \
               printf '%s\n' "$DNS_ALI" "$DNS_TENCENT"; \
               conf_get '.dns.china[]' 2>/dev/null; \
               for h in $IP_ECHO_HOSTS; do dig +short +time=3 +tries=1 @"$DNS_ALI" "$h" A 2>/dev/null | grep -E '^[0-9.]+$'; done; \
             } | grep -v '^$' | sort -u)
  local elt=""
  local e
  while IFS= read -r e; do [[ -n $e ]] && elt="$elt$e, "; done <<<"$reserved"
  elt=${elt%, }
  [[ -z $elt ]] && return 0
  # RESERVED_IP 是文件内 define, 用 sed 原地替换该行即可生效
  local line; line="define RESERVED_IP = $elt"
  sed -i "s|^define RESERVED_IP = .*|$line|" "$BASE/nftables/default.nft" 2>/dev/null || return 1
  nft list table ip de_GWD >/dev/null 2>&1 || return 0
  # 只重建 ip de_GWD 这一张表: 抽出文件里的 define 行 + 该表块单独加载,
  # 既不动 degwd_filter/degwd_router/degwd_offload, 也不重启单元(不断现有连接)
  local tmp; tmp=$(mktemp /tmp/degwd-resv.XXXXXX) || return 1
  awk '/^define /{print; next} /^table ip de_GWD \{/{p=1} p{print} p&&/^\}$/{p=0}' \
    "$BASE/nftables/default.nft" > "$tmp"
  if [[ -s $tmp ]]; then
    nft delete table ip de_GWD 2>/dev/null
    if ! nft -f "$tmp" 2>/dev/null; then
      rm -f "$tmp"; err "nft 规则重载失败, 请执行菜单 0 更新重建"; return 1
    fi
    refresh_nft_sets
  fi
  rm -f "$tmp"
  return 0
}

# 全局 DoH 服务器 IP 直连集
refresh_globaldns() {
  local doh; doh=$(conf_get '.dns.doh')
  local host; host=$(echo "$doh" | sed -E 's|^https?://||; s|[/:].*$||')
  : > "$BASE/nftables/IP_GLOBALDNS"
  if [[ "$host" =~ ^[0-9.]+$ ]]; then
    echo "$host" >> "$BASE/nftables/IP_GLOBALDNS"
  else
    dig +short +time=3 +tries=1 @"$DNS_ALI" "$host" A 2>/dev/null | grep -E '^[0-9.]+$' >> "$BASE/nftables/IP_GLOBALDNS"
  fi
  nft_sets_reload GLOBALDNS "$BASE/nftables/IP_GLOBALDNS"
}

# 节点 IP 直连集(防回环)
refresh_v2node() {
  : > "$BASE/nftables/IP_V2NODE"
  local nodes i=0 addr d ip ncnt
  nodes=$(conf_get '.nodes')
  ncnt=$(echo "$nodes" | jq 'length' 2>/dev/null || echo 0)
  while [[ $i -lt $ncnt ]]; do
    addr=$(echo "$nodes" | jq -r ".[$i].address"); split_hostport "$addr"; d=$SP_HOST
    ip=$(echo "$nodes" | jq -r ".[$i].ip // empty")
    [[ -z $ip ]] && ip=$(dig +short +time=3 +tries=1 @"$DNS_ALI" "$d" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1)
    [[ -n $ip ]] && { echo "$ip" >> "$BASE/nftables/IP_V2NODE"; conf_raw ".nodes[$i].ip" "\"$ip\""; }
    i=$((i+1))
  done
  nft_sets_reload V2NODE "$BASE/nftables/IP_V2NODE"
}

# ================================================================ Xray ========
install_xray() {
  ok "安装 Xray-core (官方源)..."
  # 不直接 curl|bash: 先落盘、语法校验、再执行(供应链完整性)
  local ish; ish=$(mktemp /tmp/xray-install.XXXXXX.sh) || die "无法创建临时文件"
  if ! curl -fsSL --max-time 120 -o "$ish" https://github.com/XTLS/Xray-install/raw/main/install-release.sh; then
    rm -f "$ish"; die "Xray 安装脚本下载失败"
  fi
  if ! bash -n "$ish"; then rm -f "$ish"; die "Xray 安装脚本语法校验失败(可能被篡改)"; fi
  bash "$ish" @ install; local irc=$?
  rm -f "$ish"
  [[ $irc -ne 0 ]] && die "Xray 安装脚本返回非 0 ($irc)"
  [[ ! -x /usr/local/bin/xray ]] && die "Xray 安装失败"
  mkdir -p "$XRAYDIR" /usr/local/share/xray
  write_atomic /etc/systemd/system/xray.service 644 <<EOF
[Unit]
Description=de_GWD Xray TPROXY Service
After=network.target nss-lookup.target

[Service]
ExecStart=/usr/local/bin/xray run -confdir $XRAYDIR
Restart=on-failure
RestartPreventExitStatus=23
Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray
LimitNOFILE=10000000
LimitNPROC=10000000
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
Nice=-9

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

# ------------------------------------- sing-box 桥接 (hy2/tuic/anytls/naive/sssb) ----
# Xray 不支持这几个协议; 由 sing-box 提供本地 socks 入站(127.0.0.1:10808),
# Xray 对应出站走 socks 桥接, 分流/TPROXY 逻辑完全不变。
node_needs_bridge() {
  local p; p=$(conf_get ".nodes[$1].proto" 2>/dev/null)
  [[ $p == "hy2" || $p == "tuic" || $p == "anytls" || $p == "naive" || $p == "sssb" ]]
}

install_singbox() {
  [[ $1 != "--force" && -x $BASE/singbox/sing-box ]] && return 0
  ok "安装 sing-box (官方 release, hy2/tuic/anytls/naive/sssb 需要)..."
  mkdir -p "$BASE/singbox"
  fetch_release "SagerNet/sing-box" "sing-box-.*-linux-${ARCH}\\.tar\\.gz$" /tmp/singbox.tar.gz || { err "sing-box 下载失败"; return 1; }
  rm -rf /tmp/sb-ex && mkdir -p /tmp/sb-ex
  tar -xzf /tmp/singbox.tar.gz -C /tmp/sb-ex
  local bin; bin=$(find /tmp/sb-ex -name sing-box -type f | head -n1)
  [[ -z $bin ]] && { rm -rf /tmp/singbox.tar.gz /tmp/sb-ex; return 1; }
  mv -f "$bin" "$BASE/singbox/sing-box" && chmod 755 "$BASE/singbox/sing-box"
  rm -rf /tmp/singbox.tar.gz /tmp/sb-ex
  cat <<EOF >/etc/systemd/system/sb-bridge.service
[Unit]
Description=de_GWD sing-box bridge (hy2/tuic/anytls outbound)
After=network.target

[Service]
ExecStart=$BASE/singbox/sing-box run -c $BASE/singbox/client.json
Restart=on-failure
NoNewPrivileges=true
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  return 0
}

sb_client_gen() {   # 为当前活动节点生成 client.json
  local i; i=$(conf_get '.nodeActive'); [[ -z $i ]] && return 1
  local addr host port proto uuid password sni insecure
  addr=$(conf_get ".nodes[$i].address"); split_hostport "$addr"; host=$SP_HOST; port=$SP_PORT
  proto=$(conf_get ".nodes[$i].proto")
  uuid=$(conf_get ".nodes[$i].uuid"); password=$(conf_get ".nodes[$i].password")
  sni=$(conf_get ".nodes[$i].tls"); [[ -z $sni ]] && sni=$host
  insecure=$(conf_get ".nodes[$i].insecure")
  if [[ $insecure == "1" ]]; then insecure=true; else insecure=false; fi
  local out
  case $proto in
    hy2)
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg pw "$password" --arg sn "$sni" --argjson ins "$insecure" \
        '{type:"hysteria2", tag:"sbproxy", server:$s, server_port:$p, password:$pw,
          tls:{enabled:true, server_name:$sn, insecure:$ins}}')
      ;;
    tuic)
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg pw "$password" --arg sn "$sni" --argjson ins "$insecure" \
        '{type:"tuic", tag:"sbproxy", server:$s, server_port:$p, uuid:$u, password:$pw,
          congestion_control:"bbr",
          tls:{enabled:true, server_name:$sn, insecure:$ins, alpn:["h3"]}}')
      ;;
    anytls)
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg pw "$password" --arg sn "$sni" --argjson ins "$insecure" \
        '{type:"anytls", tag:"sbproxy", server:$s, server_port:$p, password:$pw,
          tls:{enabled:true, server_name:$sn, insecure:$ins}}')
      ;;
    naive)
      # sing-box 1.14 的 naive outbound 既不支持 insecure 也不支持 alpn, 只能保留 TLS 基本项
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg u "$uuid" --arg pw "$password" --arg sn "$sni" \
        '{type:"naive", tag:"sbproxy", server:$s, server_port:$p, username:$u, password:$pw,
          quic:false,
          tls:{enabled:true, server_name:$sn}}')
      ;;
    sssb)
      local m; m=$(conf_get ".nodes[$i].method"); [[ -z $m || $m == "null" ]] && m="2022-blake3-aes-128-gcm"
      out=$(jq -n --arg s "$host" --argjson p "$port" --arg m "$m" --arg pw "$password" \
        '{type:"shadowsocks", tag:"sbproxy", server:$s, server_port:$p, method:$m, password:$pw}')
      ;;
    *) return 1 ;;
  esac
  [[ -z $out ]] && return 1
  # 注意: sing-box 1.12+ 已移除 inbound 的 sniff 字段, 改为 route.rules action=sniff
  jq -n --argjson o "$out" '{
    log: { level: "warn" },
    inbounds: [{ type: "socks", tag: "sb-in", listen: "127.0.0.1", listen_port: 10808 }],
    outbounds: [$o, { type: "direct", tag: "direct" }],
    route: { rules: [ { action: "sniff" } ], final: "sbproxy" }
  }' | write_atomic "$BASE/singbox/client.json" 600
}

sb_bridge_on() {
  install_singbox || return 1
  sb_client_gen || return 1
  systemctl enable sb-bridge >/dev/null 2>&1
  systemctl restart sb-bridge >/dev/null 2>&1
  sleep 1
  svc_ok sb-bridge
}
sb_bridge_off() {
  systemctl disable sb-bridge >/dev/null 2>&1
  systemctl stop sb-bridge >/dev/null 2>&1
  return 0
}
# 按活动节点协议决定桥接启停
apply_node_bridge() {
  local act; act=$(conf_get '.nodeActive'); [[ -z $act ]] && return 0
  if node_needs_bridge "$act"; then
    sb_bridge_on || warn "sing-box 桥接未就绪(hy2/tuic/anytls/naive/sssb 节点将不可用)"
  else
    sb_bridge_off
  fi
}

# 单个节点的出站(多协议; proto 由 parse_share_link 精确判定, 旧配置回退推断)
node_outbound() {   # $1 = node index, $2 = tag
  local i="$1" tag="$2"
  local addr host port proto uuid password path sni pbk sid flow method ins insecure scy
  local enc mode nhost fp alpn
  addr=$(conf_get ".nodes[$i].address")
  split_hostport "$addr"; host=$SP_HOST; port=$SP_PORT
  proto=$(conf_get ".nodes[$i].proto"); proto=${proto:-vmess}
  uuid=$(conf_get ".nodes[$i].uuid"); password=$(conf_get ".nodes[$i].password")
  path=$(conf_get ".nodes[$i].path"); sni=$(conf_get ".nodes[$i].tls"); [[ -z $sni ]] && sni=$host
  pbk=$(conf_get ".nodes[$i].pbk"); sid=$(conf_get ".nodes[$i].sid")
  flow=$(conf_get ".nodes[$i].flow"); method=$(conf_get ".nodes[$i].method")
  enc=$(conf_get ".nodes[$i].enc"); mode=$(conf_get ".nodes[$i].mode")
  nhost=$(conf_get ".nodes[$i].host"); [[ -z $nhost || $nhost == "null" ]] && nhost=$sni
  fp=$(conf_get ".nodes[$i].fp"); alpn=$(conf_get ".nodes[$i].alpn")
  scy=$(conf_get ".nodes[$i].scy"); [[ -z $scy || $scy == "null" ]] && scy="auto"
  # allowInsecure 从分享链接透传(自签证书节点写死 false 会直接连不上)
  ins=$(conf_get ".nodes[$i].insecure")
  if [[ $ins == "1" || $ins == "true" ]]; then insecure=true; else insecure=false; fi
  case $proto in
    vmess)
      local nnet
      nnet=$(conf_get ".nodes[$i].net"); [[ -z $nnet || $nnet == "null" ]] && nnet="tcp"
      if [[ $nnet == "ws" ]]; then
        jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" \
              --arg uuid "$uuid" --arg path "$path" --arg host "$sni" --argjson ins "$insecure" \
              --arg scy "$scy" \
          '{tag:$tag, protocol:"vmess",
            settings:{vnext:[{address:$addr, port:$port, users:[{id:$uuid, alterId:0, security:$scy}]}]},
            streamSettings:{network:"ws", security:"tls",
              tlsSettings:{serverName:$host, allowInsecure:$ins},
              wsSettings:{path:$path, headers:{Host:$host}},
              sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}},
            mux:{enabled:false, concurrency:1}}'
      else
        jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" \
              --arg uuid "$uuid" --arg scy "$scy" \
          '{tag:$tag, protocol:"vmess",
            settings:{vnext:[{address:$addr, port:$port, users:[{id:$uuid, alterId:0, security:$scy}]}]},
            streamSettings:{network:"tcp", security:"none",
              sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}},
            mux:{enabled:false, concurrency:1}}'
      fi
      ;;
    vless|vless-reality|vless-ws|vless-tcp|vless-ws-enc|vless-xhttp-tls|vless-xhttp-enc|vless-reality-xhttp)
      # 新配置的 proto 由 parse_share_link 精确判定; 旧配置只有 "vless", 按 pbk/path 回退推断
      local vkind="$proto"
      if [[ $vkind == "vless" ]]; then
        if [[ -n $pbk && $pbk != "null" ]]; then
          if [[ -n $path && $path != "null" ]]; then vkind="vless-reality-xhttp"; else vkind="vless-reality"; fi
        elif [[ -n $path && $path != "null" ]]; then
          if [[ -n $enc && $enc != "null" && $enc != "none" ]]; then vkind="vless-ws-enc"; else vkind="vless-ws"; fi
        else
          vkind="vless-tcp"
        fi
      fi
      local venc="none"; [[ -n $enc && $enc != "null" && $enc != "none" ]] && venc="$enc"
      local vfp="$fp"; [[ -z $vfp || $vfp == "null" ]] && vfp="chrome"
      local vmode="$mode"; [[ -z $vmode || $vmode == "null" ]] && vmode="auto"
      case $vkind in
        vless-reality)
          jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" --arg uuid "$uuid" \
                --arg sni "$sni" --arg pbk "$pbk" --arg sid "$sid" --arg flow "$flow" --arg fp "$vfp" \
            '{tag:$tag, protocol:"vless",
              settings:{vnext:[{address:$addr, port:$port,
                users:[{id:$uuid, encryption:"none",
                        flow:($flow | if . == "" or . == "null" then "xtls-rprx-vision" else . end)}]}]},
              streamSettings:{network:"tcp", security:"reality",
                realitySettings:{show:false, fingerprint:$fp, serverName:$sni,
                  publicKey:$pbk, shortId:$sid, spiderX:""},
                sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}}'
          ;;
        vless-reality-xhttp)
          jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" --arg uuid "$uuid" \
                --arg path "$path" --arg h "$nhost" --arg mode "$vmode" \
                --arg sni "$sni" --arg pbk "$pbk" --arg sid "$sid" --arg fp "$vfp" \
            '{tag:$tag, protocol:"vless",
              settings:{vnext:[{address:$addr, port:$port, users:[{id:$uuid, encryption:"none"}]}]},
              streamSettings:{network:"xhttp", security:"reality",
                xhttpSettings:{path:$path, host:$h, mode:$mode},
                realitySettings:{show:false, fingerprint:$fp, serverName:$sni,
                  publicKey:$pbk, shortId:$sid, spiderX:"/"},
                sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}}'
          ;;
        vless-xhttp-tls|vless-xhttp-enc)
          # -enc 变体: 加密串放进 users[].encryption(而非 streamSettings)
          jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" --arg uuid "$uuid" \
                --arg path "$path" --arg h "$nhost" --arg mode "$vmode" \
                --arg sni "$sni" --argjson ins "$insecure" --arg fp "$vfp" --arg enc "$venc" \
            '{tag:$tag, protocol:"vless",
              settings:{vnext:[{address:$addr, port:$port, users:[{id:$uuid, encryption:$enc}]}]},
              streamSettings:{network:"xhttp", security:"tls",
                xhttpSettings:{path:$path, host:$h, mode:$mode},
                tlsSettings:{serverName:$sni, allowInsecure:$ins, fingerprint:$fp},
                sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}}'
          ;;
        vless-ws-enc|vless-ws)
          jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" --arg uuid "$uuid" \
                --arg path "$path" --arg h "$nhost" --argjson ins "$insecure" \
                --arg sni "$sni" --arg fp "$vfp" --arg enc "$venc" \
            '{tag:$tag, protocol:"vless",
              settings:{vnext:[{address:$addr, port:$port, users:[{id:$uuid, encryption:$enc}]}]},
              streamSettings:{network:"ws", security:"tls",
                tlsSettings:{serverName:$sni, allowInsecure:$ins, fingerprint:$fp},
                wsSettings:{path:$path, headers:(if $h == "" then {} else {Host:$h} end)},
                sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}}'
          ;;
        vless-tcp)
          jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" --arg uuid "$uuid" \
                --arg host "$sni" --argjson ins "$insecure" --arg fp "$vfp" \
            '{tag:$tag, protocol:"vless",
              settings:{vnext:[{address:$addr, port:$port, users:[{id:$uuid, encryption:"none"}]}]},
              streamSettings:{network:"tcp", security:"tls",
                tlsSettings:{serverName:$host, allowInsecure:$ins, fingerprint:$fp},
                sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}}'
          ;;
        *) return 1 ;;
      esac
      ;;
    trojan|trojan-ws|trojan-tcp)
      local tkind="$proto"
      [[ $tkind == "trojan" ]] && { if [[ -n $path && $path != "null" ]]; then tkind="trojan-ws"; else tkind="trojan-tcp"; fi; }
      if [[ $tkind == "trojan-ws" ]]; then
        jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" --arg pw "$password" \
              --arg path "$path" --arg host "$sni" --argjson ins "$insecure" \
          '{tag:$tag, protocol:"trojan",
            settings:{servers:[{address:$addr, port:$port, password:$pw}]},
            streamSettings:{network:"ws", security:"tls",
              tlsSettings:{serverName:$host, allowInsecure:$ins},
              wsSettings:{path:$path, headers:{Host:$host}},
              sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}}'
      else
        jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" --arg pw "$password" \
              --arg host "$sni" --argjson ins "$insecure" \
          '{tag:$tag, protocol:"trojan",
            settings:{servers:[{address:$addr, port:$port, password:$pw}]},
            streamSettings:{network:"tcp", security:"tls",
              tlsSettings:{serverName:$host, allowInsecure:$ins},
              sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}}'
      fi
      ;;
    ss)
      local ssm="$method"; [[ -z $ssm || $ssm == "null" ]] && ssm="chacha20-ietf-poly1305"
      jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" \
            --arg m "$ssm" --arg pw "$password" \
        '{tag:$tag, protocol:"shadowsocks",
          settings:{servers:[{address:$addr, port:$port, method:$m, password:$pw}]},
          streamSettings:{sockopt:{mark:255, tcpFastOpen:true}}}'
      ;;
    socks|socks5)
      # Xray 原生 socks 出站; 仅当用户名与密码都非空时才带 users 数组
      local su="$uuid" sp="$password"
      if [[ -n $su && $su != "null" && -n $sp && $sp != "null" ]]; then
        jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" --arg u "$su" --arg pw "$sp" \
          '{tag:$tag, protocol:"socks",
            settings:{servers:[{address:$addr, port:$port, users:[{user:$u, pass:$pw}]}]},
            streamSettings:{network:"tcp", sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}}'
      else
        jq -n --arg tag "$tag" --arg addr "$host" --argjson port "$port" \
          '{tag:$tag, protocol:"socks",
            settings:{servers:[{address:$addr, port:$port, users:[]}]},
            streamSettings:{network:"tcp", sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}}'
      fi
      ;;
    hy2|tuic|anytls|naive|sssb)
      # 由 sing-box 桥接承载(见 sb_bridge_on)
      jq -n --arg tag "$tag" \
        '{tag:$tag, protocol:"socks",
          settings:{servers:[{address:"127.0.0.1", port:10808}]},
          streamSettings:{sockopt:{mark:255}}}'
      ;;
    *)
      # 明确报错而不是静默产出空串(否则 Xray 配置会缺 outbound)
      err "节点协议不支持: $proto"
      return 1
      ;;
  esac
}

xray_gen_config() {
  local nodes n i outbs act dnsport
  # 旧版配置迁移: 无 proto 字段的节点视为 vmess(失败则保留原样, 不静默吞错)
  if [[ -f $CONF ]]; then
    local mig; mig=$(conf_get '.nodes' | jq -c 'map(if .proto then . else (. + {proto:"vmess"}) end)' 2>/dev/null)
    if [[ -n $mig && $mig != "null" ]]; then
      conf_raw '.nodes' "$mig" || warn "节点 proto 字段迁移失败(不影响已有节点)"
    fi
  fi
  nodes=$(conf_get '.nodes')
  n=$(echo "$nodes" | jq 'length' 2>/dev/null || echo 0)
  act=$(conf_get '.nodeActive'); dnsport=$(conf_get '.dnsPort')
  [[ $n -eq 0 ]] && { warn "尚无节点"; return 1; }

  local act_out
  act_out=$(node_outbound "$act" "proxy") || { err "活动节点配置生成失败(协议不支持?)"; return 1; }
  outbs=$(echo "$act_out" | jq '[.]')
  i=0
  while [[ $i -lt $n ]]; do
    [[ $i -eq $act ]] && { i=$((i+1)); continue; }
    local o_i
    o_i=$(node_outbound "$i" "node$i") || { warn "节点 $i 配置生成失败, 已跳过"; i=$((i+1)); continue; }
    outbs=$(echo "$outbs" | jq --argjson o "$o_i" '. + [$o]')
    i=$((i+1))
  done
  # direct / block 出站(直连带 mark 255 防回环)
  outbs=$(echo "$outbs" | jq '. + [
    {tag:"direct", protocol:"freedom", streamSettings:{sockopt:{mark:255, tcpFastOpen:true, tcpNoDelay:true}}},
    {tag:"block", protocol:"blackhole", settings:{response:{type:"http"}}}
  ]')
  # relay 中转线: 每个 entry 生成 vmess/tcp 入站 + 对应出站与 inboundTag 路由
  local relays r=0 tag_r inbs="[]" rrules="[]" nrelay
  relays=$(conf_get '.relay')
  [[ -z $relays || $relays == "null" ]] && relays="[]"
  nrelay=$(echo "$relays" | jq 'length' 2>/dev/null || echo 0)
  while [[ $r -lt $nrelay ]]; do
    tag_r="relayline$r"
    local rport ruuid rni
    rport=$(echo "$relays" | jq -r ".[$r].port")
    ruuid=$(echo "$relays" | jq -r ".[$r].uuid")
    rni=$(echo "$relays" | jq -r ".[$r].node // -1")
    inbs=$(echo "$inbs" | jq --arg t "$tag_r" --argjson p "$rport" --arg u "$ruuid" \
      '. + [{tag:$t, listen:"0.0.0.0", port:$p, protocol:"vmess",
             settings:{clients:[{id:$u, alterId:0}]},
             streamSettings:{network:"tcp", security:"none", sockopt:{tcpFastOpen:true}},
             sniffing:{enabled:false}}]')
    if [[ $rni -ge 0 ]]; then
      local o_r; o_r=$(node_outbound "$rni" "$tag_r") || o_r=""
      [[ -n $o_r ]] && outbs=$(echo "$outbs" | jq --argjson o "$o_r" '. + [$o]')
    fi
    local rout; rout="direct"; [[ $rni -ge 0 ]] && rout="$tag_r"
    rrules=$(echo "$rrules" | jq --arg t "$tag_r" --arg o "$rout" '. + [{type:"field", inboundTag:[$t], outboundTag:$o}]')
    r=$((r+1))
  done

  # ---- 路由规则 ----
  local rules='[]'
  # 源 IP 分流: proxyIPs -> proxy
  local pips; pips=$(conf_get '.split.proxyIPs[]' 2>/dev/null | tr '\n' ' ')
  pips=$(echo "$pips" | grep -v '^$' || true)
  if [[ -n ${pips// /} ]]; then
    local arr; arr=$(echo "$pips" | tr ' ' '\n' | grep -v '^$' | jq -R . | jq -s .)
    rules=$(echo "$rules" | jq --argjson ips "$arr" '. + [{type:"field", source:$ips, outboundTag:"proxy"}]')
  fi
  # 自定义域名黑白名单
  local lb lw
  lb=$(conf_get '.split.listB[]' 2>/dev/null | grep -v '^$' | sed 's/^/domain:/' | jq -R . | jq -s '. // []')
  lw=$(conf_get '.split.listW[]' 2>/dev/null | grep -v '^$' | sed 's/^/domain:/' | jq -R . | jq -s '. // []')
  [[ $(echo "$lb" | jq 'length') -gt 0 ]] && rules=$(echo "$rules" | jq --argjson d "$lb" '. + [{type:"field", domain:$d, outboundTag:"proxy"}]')
  [[ $(echo "$lw" | jq 'length') -gt 0 ]] && rules=$(echo "$rules" | jq --argjson d "$lw" '. + [{type:"field", domain:$d, outboundTag:"direct"}]')
  # 流媒体预设(geosite): 0=直连, N=节点列表第 N 项(1-based)
  local sm cats cat tagname
  cats="youtube netflix hbo tvb bahamut openai apple steam"
  for cat in $cats; do
    local ni2; ni2=$(conf_get ".split.sm.$cat // empty")
    [[ -z $ni2 || "$ni2" == "null" ]] && continue
    local gs
    case $cat in
      youtube) gs='["geosite:youtube"]' ;;
      netflix) gs='["geosite:netflix"]' ;;
      hbo)     gs='["geosite:hbo","geosite:disney","geosite:hulu","geosite:primevideo"]' ;;
      tvb)     gs='["geosite:tvb","domain:mytvsuper.com","domain:tvb.com"]' ;;
      bahamut) gs='["geosite:bahamut","domain:gamer.com.tw"]' ;;
      openai)  gs='["geosite:openai","geosite:bing"]' ;;
      apple)   gs='["geosite:apple","geosite:icloud"]' ;;
      steam)   gs='["geosite:steam","domain:steamserver.net"]' ;;
    esac
    local out
    if [[ $ni2 -eq 0 ]]; then
      out="direct"
    else
      local idx=$((ni2-1))
      out=$([[ $idx -eq $act ]] && echo proxy || echo "node$idx")
    fi
    rules=$(echo "$rules" | jq --argjson d "$gs" --arg o "$out" '. + [{type:"field", domain:$d, outboundTag:$o}]')
  done
  # 固定: 内网/中国 直连(双保险: nft 层已有 chnroute)
  rules=$(echo "$rules" | jq '. + [
    {type:"field", ip:["geoip:private"], outboundTag:"direct"},
    {type:"field", ip:["geoip:cn"], outboundTag:"direct"},
    {type:"field", domain:["geosite:cn"], outboundTag:"direct"}
  ]')

  local nodehosts
  nodehosts=$(conf_get '.nodes' | jq -r '[.[] | select(.ip != null and .ip != "")] | map({(.address | split(":")[0]): .ip}) | add // {}')

  # inboundTag 中转线规则优先于其它规则
  rules=$(echo "$rrules" | jq --argjson r "$rules" '. + $r')

  # JSON 先落临时文件并用 jq -e 校验, 通过后才替换(Xray 读到半截配置会直接起不来)
  local cfgt; cfgt=$(mktemp "$XRAYDIR/config.json.XXXXXX") || return 1
  if ! jq -n --argjson outb "$outbs" --argjson rules "$rules" --argjson dnsport "$dnsport" \
        --argjson hosts "$nodehosts" --argjson rinb "$inbs" '{
    log: { access: "none", error: "/var/log/xray-error.log", loglevel: "warning" },
    dns: {
      tag: "dnsflow",
      queryStrategy: "UseIP",
      disableCache: true,
      hosts: $hosts,
      servers: ["tcp+local://127.0.0.1:" + ($dnsport|tostring)]
    },
    routing: { domainMatcher: "hybrid", domainStrategy: "AsIs", rules: $rules },
    inbounds: ([{
      listen: "127.0.0.1",
      port: 9896,
      protocol: "dokodemo-door",
      settings: { network: "tcp,udp", followRedirect: true },
      streamSettings: { sockopt: { tproxy: "tproxy", mark: 255, tcpFastOpen: true, tcpMptcp: true } },
      sniffing: { enabled: true, destOverride: ["http","tls","quic"], routeOnly: true }
    }] + $rinb),
    outbounds: $outb
  }' > "$cfgt"; then
    rm -f "$cfgt"; err "Xray 配置生成失败(jq 组装错误)"; return 1
  fi
  if ! jq -e . "$cfgt" >/dev/null 2>&1; then
    rm -f "$cfgt"; err "Xray 配置 JSON 校验失败, 保留旧配置"; return 1
  fi
  chmod 600 "$cfgt" && mv -f "$cfgt" "$XRAYDIR/config.json"
  return 0
}

# ================================================================ 规则列表 ====
download_lists() {
  ok "下载分流规则列表..."
  local tmpc tmpd cnt okc=1
  tmpc=$(mktemp /tmp/degwd-chn.XXXXXX) || return 1
  tmpd=$(mktemp /tmp/degwd-dom.XXXXXX) || { rm -f "$tmpc"; return 1; }

  # chnroute (nft CHNROUTE 集用)
  curl -fsSL --max-time 120 "$LIST_URL_CHNROUTE" -o "$tmpc" \
    || curl -fsSL --max-time 120 "$LIST_URL_CHNROUTE_ALT" -o "$tmpc" || true
  if [[ -s $tmpc ]]; then
    grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?' "$tmpc" | sed 's/;.*//' | sort -u > "$tmpc.clean"
    cnt=$(wc -l < "$tmpc.clean" 2>/dev/null || echo 0)
    # 条数下限校验: -s 对"半截文件"同样成立, 必须按行数判定
    if [[ ${cnt:-0} -ge 3000 ]]; then
      mv -f "$tmpc.clean" "$BASE/nftables/IP_CHNROUTE"
    else
      rm -f "$tmpc.clean"
      warn "chnroute 仅 $cnt 条(<3000), 疑似下载不完整, 保留旧表"
      okc=0
    fi
  else
    warn "chnroute 下载失败, 保留旧表"; okc=0
  fi
  rm -f "$tmpc"

  # chn 域名表(smartdns 分流用, felixonmars 是社区权威源)
  : > "$tmpd"
  if curl -fsSL --max-time 120 "$LIST_URL_CNDOMAIN" -o "$tmpd.raw"; then
    sed -E 's|^server=/([^/]+)/.*$|\1|' "$tmpd.raw" >> "$tmpd"
  else
    warn "国内域名列表下载失败, 保留旧表"
  fi
  rm -f "$tmpd.raw"
  if curl -fsSL --max-time 120 "$LIST_URL_APPLECN" -o "$tmpd.raw"; then
    sed -E 's|^server=/([^/]+)/.*$|\1|' "$tmpd.raw" >> "$tmpd"
  else
    warn "Apple 中国域名列表下载失败"
  fi
  rm -f "$tmpd.raw"
  cnt=$(grep -c . "$tmpd" 2>/dev/null || echo 0)
  if [[ ${cnt:-0} -ge 1000 ]]; then
    sort -u -o "$tmpd" "$tmpd"
    mv -f "$tmpd" "$SDNSDIR/chn_domains.txt"
  else
    warn "国内域名列表仅 $cnt 条, 疑似不完整, 保留旧表"
    rm -f "$tmpd"
  fi

  # geosite/geoip (Xray 路由用) — 关键组件, 失败必须显式报错而非静默吞掉
  fetch_release "Loyalsoldier/v2ray-rules-dat" "^geosite\\.dat$" /usr/local/share/xray/geosite.dat \
    || { err "geosite.dat 下载失败(geosite 分流规则将不可用)"; okc=0; }
  fetch_release "Loyalsoldier/v2ray-rules-dat" "^geoip\\.dat$" /usr/local/share/xray/geoip.dat \
    || { err "geoip.dat 下载失败(geoip 分流规则将不可用)"; okc=0; }
  if [[ $okc -eq 1 ]]; then
    ok "规则列表已更新 (chnroute $(wc -l < $BASE/nftables/IP_CHNROUTE 2>/dev/null || echo 0) 条, 域名 $(wc -l < $SDNSDIR/chn_domains.txt 2>/dev/null || echo 0) 条)"
    return 0
  fi
  err "部分规则列表更新失败(已保留旧表, 分流可能不完整)"
  return 1
}

refresh_nft_sets() {
  nft_sets_reload CHNROUTE "$BASE/nftables/IP_CHNROUTE"
  refresh_globaldns
  refresh_v2node
  # 源 IP 全局代理/直连
  local tb tw
  tb=$(mktemp /tmp/degwd-blan.XXXXXX) || return 1
  tw=$(mktemp /tmp/degwd-wlan.XXXXXX) || { rm -f "$tb"; return 1; }
  conf_get '.split.proxyIPs[]' 2>/dev/null | grep -v '^$' > "$tb" || true
  conf_get '.split.directIPs[]' 2>/dev/null | grep -v '^$' > "$tw" || true
  nft_sets_reload LISTBLAN "$tb"
  nft_sets_reload LISTWLAN "$tw"
  rm -f "$tb" "$tw"
}

# ================================================================ 安装流程 ====
installGWD() {
  echo
  echo -e "${CYAN}=== de_GWD Remake 旁路网关安装 ===${cRES}"
  local nic nicIP cidr
  nic=$(detect_nic)
  [[ -z $nic ]] && die "未检测到物理网卡"
  nicIP=$(ip -4 a show "$nic" | grep -Po 'inet \K\d{1,3}(\.\d{1,3}){3}/\d{1,2}' | head -n1)
  echo "  检测到网卡: $nic ($nicIP)"
  local cidr_in; cidr_in=$(ask "本机静态 IP (CIDR, 回车=$nicIP): ")
  cidr=${cidr_in:-$nicIP}
  local gw; gw=$(ask "上级路由 IP (如 192.168.1.1): ")
  [[ ! "$gw" =~ ^[0-9.]+$ ]] && die "网关格式错误"

  conf_init
  conf_set '.net.nic' "$nic"
  conf_set '.net.localCIDR' "$cidr"
  conf_set '.net.gateway' "$gw"

  # 节点(追加, 不覆盖已有节点)
  local addr uuid path host
  while :; do
    addr=$(ask "服务端地址 (domain:port): ")
    [[ "$addr" =~ ^[A-Za-z0-9.-]+:[0-9]+$ ]] && break
    warn "格式: domain:port"
  done
  uuid=$(ask "UUID: "); [[ -z $uuid ]] && die "UUID 不能为空"
  path=$(ask "WS path (回车=tcp 直连): ")
  # host 同时用作 SNI(裸 IP 节点没有域名时 tls 字段留空更准确)
  split_hostport "$addr"; host=$SP_HOST
  local dip; dip=$(dig +short +time=3 +tries=1 @"$DNS_ALI" "$host" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1)
  # 用 jq -n 组装(手拼 JSON 遇引号/反斜杠会产出非法配置); 追加而非整体替换
  local newnode nf sni
  sni="$host"; [[ "$host" =~ ^[0-9.]+$ ]] && sni=""
  newnode=$(jq -cn --arg n "$(echo "$host" | cut -d. -f1)" --arg a "$addr" --arg t "$sni" \
                 --arg u "$uuid" --arg p "$path" --arg i "${dip:-}" \
    '{proto:"vmess", name:$n, address:$a, tls:$t, uuid:$u, path:$p, ip:$i}') || die "节点组装失败"
  nf=$(mktemp "$BASE/.node.XXXXXX") || die "无法创建临时文件"
  printf '%s' "$newnode" > "$nf"; chmod 600 "$nf"
  conf_write '.nodes = ((.nodes // []) + [$c[0]])' --slurpfile c "$nf" || { rm -f "$nf"; die "节点写入失败"; }
  rm -f "$nf"

  local doh; doh=$(ask "全球分流 DoH (回车=https://1.1.1.1/dns-query): "); doh=${doh:-https://1.1.1.1/dns-query}
  conf_set '.dns.doh' "$doh"

  ok "基线环境..."
  # 关键步骤显式判断: 依赖/规则失败时立即中止, 不留下半成品系统
  apt_baseline; pkg_dep || die "依赖安装失败, 中止安装"; chrony_conf; limits_conf; sysctl_conf
  resolv_setup
  # 静态 IP 写入后做 60s 自检, 失联自动回滚备份(避免远程装完直接断网)
  if net_static; then
    net_static_verify || die "静态 IP 自检失败, 已回滚原网络配置"
  fi

  ok "流量整形 + nftables..."
  shaping_conf; nftables_apply

  ok "安装 Xray 并下载分流规则列表..."
  install_xray || die "Xray 安装失败, 中止安装"
  download_lists || warn "部分分流规则下载失败(保留旧表, 可稍后执行菜单 0 重试)"

  smartdns_conf
  xray_gen_config || die "Xray 配置生成失败(检查节点信息)"
  apply_node_bridge
  svc_restart xray && ok "Xray" || { err "Xray 未启动"; journalctl -u xray -n 15 --no-pager; }

  svc_restart smartdns && ok "smartdns (DNS 分流 :53)" || err "smartdns 未启动"
  # 表已由 nftables_apply 建好, 这里只需确保服务在跑(不再重复 nft flush/重建)
  svc_restart degwd-nftables || err "nftables 未启动"

  # 先写脚本再写 cron(原顺序相反: cron 先落地而脚本尚不存在, 首次触发必失败)
  write_atomic "$BASE/updateLists" 755 <<EOF
#!/bin/bash
bash $(readlink -f "$0" 2>/dev/null || echo "$0") --lists
EOF
  if command -v crontab >/dev/null 2>&1; then
    (crontab -l 2>/dev/null | grep -F -v -- "$BASE/updateLists"; echo "0 4 * * * $BASE/updateLists") | crontab -
  else
    apt-get install -y -qq cron >/dev/null 2>&1 || true
    command -v crontab >/dev/null 2>&1 && \
      (crontab -l 2>/dev/null | grep -F -v -- "$BASE/updateLists"; echo "0 4 * * * $BASE/updateLists") | crontab - \
      || warn "crontab 不可用, 跳过规则自动更新定时任务"
  fi

  printNode
  echo
  ok "安装完成! 将 LAN 设备的 网关 与 DNS 指向 $(echo $cidr | cut -d/ -f1) 即可。"
  ok "随时输入 shuoyue-gw 打开管理菜单(一键脚本用户)或 bash client。"
}

resolv_setup() {
  # 与 net_static 的 nmcli 分支统一: NM 系统走 dns=none, 由本函数统一手写 resolv.conf;
  # 非 NM 系统才停用 systemd-resolved 的 stub 监听。
  if [[ -f /etc/resolv.conf && ! -f /etc/resolv.conf.degwd.bak ]]; then
    cp -a /etc/resolv.conf /etc/resolv.conf.degwd.bak 2>/dev/null
  fi
  if command -v nmcli >/dev/null 2>&1; then
    mkdir -p /etc/NetworkManager/conf.d
    printf '[main]\ndns=none\n' >/etc/NetworkManager/conf.d/90-degwd-dns.conf
    systemctl reload NetworkManager >/dev/null 2>&1
    rm -f /etc/resolv.conf
    write_atomic /etc/resolv.conf 644 <<EOF
nameserver 127.0.0.1
nameserver $DNS_ALI
EOF
    return 0
  fi
  systemctl stop systemd-resolved >/dev/null 2>&1
  systemctl disable systemd-resolved >/dev/null 2>&1
  systemctl mask systemd-resolved >/dev/null 2>&1
  rm -f /etc/resolv.conf
  write_atomic /etc/resolv.conf 644 <<EOF
nameserver 127.0.0.1
nameserver $DNS_ALI
EOF
}

updateGWD() {
  echo -e "${CYAN}=== 更新 de_GWD Remake ===${cRES}"
  conf_init
  # 关键步骤显式判断: 原版全部 2>/dev/null, 失败时静默留下"更新成功"的假象
  pkg_dep || { err "依赖安装失败"; return 1; }
  install_xray || { err "Xray 安装失败"; return 1; }
  [[ -x $BASE/singbox/sing-box ]] && { install_singbox --force || warn "sing-box 更新失败"; }
  download_lists || warn "部分规则列表更新失败"
  smartdns_conf || warn "smartdns 配置生成失败"
  if xray_gen_config; then
    apply_node_bridge
    svc_restart xray || err "Xray 重启失败, 详见 journalctl -u xray"
  else
    err "Xray 配置生成失败, 保留旧配置并跳过重启"
  fi
  svc_restart smartdns || err "smartdns 重启失败"
  nftables_apply || err "nftables 重建失败"
  ok "更新完成"
}

# ================================================================ 节点管理 ====
# ------------------------- 分享链接解析(兼容 v2rayN 7.25.4 全部出站协议) ----
b64url_decode() {
  local s="$1"; s=${s//-/+}; s=${s//_//}
  case $((${#s} % 4)) in 2) s="${s}==";; 3) s="${s}=";; esac
  printf %s "$s" | tr '_-' '/+' | base64 -d 2>/dev/null
}
b64url_encode() { printf %s "$1" | base64 -w0 | tr '+/' '-_' | tr -d '='; }
# URL 百分号编码(与 server 的 urlenc 行为一致: 仅 [a-zA-Z0-9.~_-] 原样保留)
urlenc() {
  local s="$1" out="" c
  while [[ -n $s ]]; do
    c=${s:0:1}; s=${s:1}
    case $c in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf %s "$out"
}
# URL 百分号解码: 只处理 %XX, 不把 '+' 当空格(否则会破坏 reality 公钥等 base64 值)
urldecode() {
  local s="$1" out="" head c
  while [[ $s == *%* ]]; do
    head=${s%%\%*}; out+="$head"; s=${s#*%}
    c=${s:0:2}; s=${s:2}
    if [[ $c =~ ^[0-9A-Fa-f]{2}$ ]]; then out+=$(printf "\\x$c"); else out+="%$c"; fi
  done
  printf %s "$out$s"
}
# 取 query 参数(值做百分号解码, 否则 xhttp 的 %2F 路径与 VLESS 加密串会带进配置)
qget() { local v; v=$(echo "$2" | grep -oE "[?&]$1=[^&]*" | head -n1 | cut -d= -f2-); urldecode "$v"; }
frag_of() { local f="${1##*#}"; [[ "$f" == "$1" ]] && f=""; printf %s "$f" | sed 's/%20/ /g'; }
norm_insecure() { [[ "$1" == "1" || "$1" == "true" ]] && echo 1 || echo 0; }

# $1=完整链接 → 输出节点 JSON(单行); 失败返回 1
parse_share_link() {
  local link="$1" scheme body auth hostport host port uuid password path sni pbk sid flow method insecure name q
  [[ "$link" != *"://"* ]] && return 1
  scheme=${link%%://*}
  body=${link#*://}
  body=${body%%#*}
  name=$(frag_of "$link"); [[ -z $name ]] && name="node"
  case $scheme in
    vmess)
      local j add nid npath nhost nport nnet ntls
      j=$(b64url_decode "$body")
      [[ -z $j ]] && return 1
      add=$(echo "$j" | jq -r '.add // empty' 2>/dev/null)
      nid=$(echo "$j" | jq -r '.id // empty' 2>/dev/null)
      nport=$(echo "$j" | jq -r '.port // "443"' 2>/dev/null)
      npath=$(echo "$j" | jq -r '.path // ""' 2>/dev/null)
      nhost=$(echo "$j" | jq -r '(.sni // .host // .add // empty)' 2>/dev/null)
      # v2rayN 的 net/type/tls 必须解析: 原版忽略后一律按 tcp 生成, ws 节点全部连不上
      nnet=$(echo "$j" | jq -r '(.net // .type // "tcp")' 2>/dev/null)
      ntls=$(echo "$j" | jq -r '.tls // ""' 2>/dev/null)
      [[ -z $add || -z $nid ]] && return 1
      case $nnet in
        tcp|ws) : ;;
        "") nnet="tcp" ;;
        *) die "不支持的 vmess 传输类型: $nnet (本脚本仅支持 tcp/ws)" ;;
      esac
      local nins nsec nscy nalpn nfp
      nins=$(norm_insecure "$(echo "$j" | jq -r '.allowInsecure // .insecure // "0"' 2>/dev/null)")
      nsec=$(echo "$j" | jq -r '.scy // "auto"' 2>/dev/null); [[ -z $nsec || $nsec == "null" ]] && nsec="auto"
      nscy=$nsec
      nalpn=$(echo "$j" | jq -r '(.alpn // "") | tostring' 2>/dev/null)
      nfp=$(echo "$j" | jq -r '.fp // ""' 2>/dev/null)
      jq -cn --arg n "$name" --arg a "$add:$nport" --arg u "$nid" --arg p "$npath" --arg s "$nhost" \
            --arg net "$nnet" --arg tls "$ntls" --argjson ins "$nins" --arg scy "$nscy" \
            --arg alpn "$nalpn" --arg fp "$nfp" \
        '{proto:"vmess", name:$n, address:$a, uuid:$u, path:$p, tls:$s,
          net:$net, tlsEnabled:$tls, insecure:$ins, scy:$scy, alpn:$alpn, fp:$fp}'
      ;;
    vless)
      auth=${body%%\?*}
      uuid=${auth%%@*}; hostport=${auth#*@}
      split_hostport "$hostport"; host=$SP_HOST; port=$SP_PORT
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); pbk=$(qget pbk "$q"); sid=$(qget sid "$q")
      path=$(qget path "$q"); flow=$(qget flow "$q")
      local sec typ enc venc hst md fp
      sec=$(qget security "$q"); [[ -z $sec ]] && sec="none"
      typ=$(qget type "$q"); [[ -z $typ ]] && typ="tcp"
      enc=$(qget encryption "$q")
      hst=$(qget host "$q"); md=$(qget mode "$q"); fp=$(qget fp "$q")
      # security+type+encryption 三者共同决定 proto(与 client-openwrt 命名一致)
      venc=""; [[ -n $enc && $enc != "none" ]] && venc="1"
      local vproto
      case "$sec:$typ" in
        reality:tcp|reality:raw) vproto="vless-reality" ;;
        reality:xhttp)           vproto="vless-reality-xhttp" ;;
        tls:xhttp)               if [[ -n $venc ]]; then vproto="vless-xhttp-enc"; else vproto="vless-xhttp-tls"; fi ;;
        *:ws)                    if [[ -n $venc ]]; then vproto="vless-ws-enc"; else vproto="vless-ws"; fi ;;
        *:xhttp)                 if [[ -n $venc ]]; then vproto="vless-xhttp-enc"; else vproto="vless-xhttp-tls"; fi ;;
        *)                       vproto="vless-tcp" ;;
      esac
      # 空值统一落空串, 避免 jq 里出现字面 "null"
      [[ $sni == "null" ]] && sni=""
      [[ -z $sni && $vproto != "vless-reality" && $vproto != "vless-reality-xhttp" ]] && sni=$host
      jq -cn --arg n "$name" --arg a "$host:$port" --arg u "$uuid" --arg p "$path" --arg s "$sni" \
            --arg pk "$pbk" --arg sd "$sid" --arg f "$flow" --arg pr "$vproto" \
            --arg sec "$sec" --arg typ "$typ" --arg enc "$enc" --arg h "$hst" --arg md "$md" --arg fp "$fp" \
        '{proto:$pr, name:$n, address:$a, uuid:$u, path:$p, tls:$s, pbk:$pk, sid:$sd, flow:$f,
          security:$sec, net:$typ, enc:$enc, host:$h, mode:$md, fp:$fp}'
      ;;
    trojan)
      auth=${body%%\?*}
      password=${auth%%@*}; hostport=${auth#*@}
      split_hostport "$hostport"; host=$SP_HOST; port=$SP_PORT
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); path=$(qget path "$q")
      local ttyp tproto
      ttyp=$(qget type "$q")
      [[ -z $ttyp ]] && { if [[ -n $path && $path != "null" ]]; then ttyp="ws"; else ttyp="tcp"; fi; }
      if [[ $ttyp == "ws" ]]; then tproto="trojan-ws"; else tproto="trojan-tcp"; fi
      jq -cn --arg n "$name" --arg a "$host:$port" --arg pw "$password" --arg p "$path" --arg s "$sni" \
            --arg pr "$tproto" --arg typ "$ttyp" \
        '{proto:$pr, name:$n, address:$a, password:$pw, path:$p, tls:$s, net:$typ}'
      ;;
    ss)
      local mainpart="${body%%#*}" userinfo methodpass
      if [[ "$mainpart" == *"@"* ]]; then
        userinfo=${mainpart%%@*}; hostport=${mainpart#*@}
        # SS2022 的 base64url 里不含 ':', 含 ':' 说明是明文 user:pass
        if [[ $userinfo == *":"* ]]; then methodpass="$userinfo"; else methodpass=$(b64url_decode "$userinfo"); fi
      else
        methodpass=$(b64url_decode "$mainpart")
        hostport=${methodpass#*@}; methodpass=${methodpass%%@*}
      fi
      [[ -z $methodpass ]] && return 1
      split_hostport "$hostport"; host=$SP_HOST; port=$SP_PORT
      # 只按第一个 ':' 切分: SS2022 密钥(可能含 / + =)不会被切坏
      method=${methodpass%%:*}; password=${methodpass#*:}
      [[ -z $password || $password == "$methodpass" ]] && return 1
      # 端口 8452 是 sing-box 侧的 SS2022(sssb), 必须交给 sing-box 桥接而非 Xray
      local sproto="ss"; [[ $port == "8452" ]] && sproto="sssb"
      jq -cn --arg n "$name" --arg a "$host:$port" --arg m "$method" --arg pw "$password" --arg pr "$sproto" \
        '{proto:$pr, name:$n, address:$a, method:$m, password:$pw}'
      ;;
    socks|socks5|socks4)
      auth=${body%%\?*}
      local sinfo
      if [[ "$auth" == *"@"* ]]; then
        sinfo=${auth%%@*}; hostport=${auth#*@}
      else
        sinfo=""; hostport=$auth
      fi
      split_hostport "$hostport"; host=$SP_HOST; port=$SP_PORT
      [[ -z $port || $port == "$host" ]] && port="1080"
      uuid=""; password=""
      if [[ -n $sinfo ]]; then
        # server 发的是 base64url(user:pass), client-openwrt 发的是明文 user:pass: 两种都兼容
        if [[ $sinfo == *":"* ]]; then
          uuid=${sinfo%%:*}; password=${sinfo#*:}
        else
          local sdec; sdec=$(b64url_decode "$sinfo")
          if [[ $sdec == *":"* ]]; then uuid=${sdec%%:*}; password=${sdec#*:}; else uuid="$sdec"; fi
        fi
      fi
      jq -cn --arg n "$name" --arg a "$host:$port" --arg u "$uuid" --arg pw "$password" \
        '{proto:"socks", name:$n, address:$a, uuid:$u, password:$pw}'
      ;;
    naive|naive+https)
      local nbody
      nbody=${body#naive://}; [[ $nbody == "$body" ]] && nbody=${body#naive+https://}
      auth=${nbody%%\?*}
      if [[ "$auth" == *"@"* ]]; then
        local uinfo; uinfo=$(urldecode "${auth%%@*}"); hostport=${auth#*@}
      else
        uinfo=""; hostport=$auth
      fi
      uuid=${uinfo%%:*}; password=${uinfo#*:}
      split_hostport "$hostport"; host=$SP_HOST; port=$SP_PORT
      q="?${nbody#*\?}"; [[ "$q" == "?$nbody" ]] && q=""
      sni=$(qget sni "$q"); [[ -z $sni || $sni == "null" ]] && sni=$host
      insecure=$(norm_insecure "$(qget insecure "$q")")
      jq -cn --arg n "$name" --arg a "$host:$port" --arg u "$uuid" --arg pw "$password" \
            --arg s "$sni" --argjson i "$insecure" \
        '{proto:"naive", name:$n, address:$a, uuid:$u, password:$pw, tls:$s, insecure:$i}'
      ;;
    hy2|hysteria2)
      auth=${body%%\?*}
      password=${auth%%@*}; hostport=${auth#*@}
      split_hostport "$hostport"; host=$SP_HOST; port=$SP_PORT
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); insecure=$(norm_insecure "$(qget insecure "$q")")
      jq -cn --arg n "$name" --arg a "$host:$port" --arg pw "$password" --arg s "$sni" --argjson i "$insecure" \
        '{proto:"hy2", name:$n, address:$a, password:$pw, tls:$s, insecure:$i}'
      ;;
    tuic)
      auth=${body%%\?*}
      local userpass; userpass=${auth%%@*}; hostport=${auth#*@}
      uuid=${userpass%%:*}; password=${userpass#*:}
      split_hostport "$hostport"; host=$SP_HOST; port=$SP_PORT
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); insecure=$(norm_insecure "$(qget allow_insecure "$q")")
      jq -cn --arg n "$name" --arg a "$host:$port" --arg u "$uuid" --arg pw "$password" \
            --arg s "$sni" --argjson i "$insecure" \
        '{proto:"tuic", name:$n, address:$a, uuid:$u, password:$pw, tls:$s, insecure:$i}'
      ;;
    anytls)
      auth=${body%%\?*}
      password=${auth%%@*}; hostport=${auth#*@}
      split_hostport "$hostport"; host=$SP_HOST; port=$SP_PORT
      q="?${body#*\?}"; [[ "$q" == "?$body" ]] && q=""
      sni=$(qget sni "$q"); insecure=$(norm_insecure "$(qget insecure "$q")")
      jq -cn --arg n "$name" --arg a "$host:$port" --arg pw "$password" --arg s "$sni" --argjson i "$insecure" \
        '{proto:"anytls", name:$n, address:$a, password:$pw, tls:$s, insecure:$i}'
      ;;
    *) return 1 ;;
  esac
}

nodes_list() {
  local nodes n i=0
  nodes=$(conf_get '.nodes'); n=$(echo "$nodes" | jq 'length' 2>/dev/null || echo 0)
  [[ $n -eq 0 ]] && { warn "尚无节点"; return; }
  local act; act=$(conf_get '.nodeActive')
  while [[ $i -lt $n ]]; do
    local proto addr u p name
    proto=$(echo "$nodes" | jq -r ".[$i].proto // \"vmess\"")
    name=$(echo "$nodes" | jq -r ".[$i].name"); addr=$(echo "$nodes" | jq -r ".[$i].address")
    u=$(echo "$nodes" | jq -r ".[$i].uuid // .[$i].password // \"\""); p=$(echo "$nodes" | jq -r ".[$i].path")
    local flag=" "; [[ $i -eq $act ]] && flag="*"
    echo "  [$((i+1))]$flag $name  ($proto)  $addr  key=${u:0:8}...  path=${p:-tcp}"
    i=$((i+1))
  done
}

nodes_add() {
  echo "添加节点 — 粘贴 v2rayN 分享链接(可连续粘多条):"
  echo "  支持: vmess:// vless://(含Reality/xhttp/加密) trojan:// ss:// socks:// socks5://"
  echo "        hysteria2:// tuic:// anytls:// naive://"
  local link j host dip
  while :; do
    link=$(ask "粘贴链接 (回车=结束): ")
    [[ -z $link ]] && break
    j=$(parse_share_link "$link") || { warn "无法解析该链接"; continue; }
    host=$(echo "$j" | jq -r '.address' | cut -d: -f1)
    if [[ ! "$host" =~ ^[0-9.]+$ ]]; then
      dip=$(dig +short +time=3 +tries=1 @"$DNS_ALI" "$host" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1)
    else
      dip=$host
    fi
    j=$(echo "$j" | jq --arg ip "$dip" '. + {ip:$ip}')
    # 节点 JSON 经文件交给 jq: uuid/password 不出现在 argv(原版 --argjson 会被 ps 看到)
    local nf; nf=$(mktemp "$BASE/.node.XXXXXX") || { warn "无法创建临时文件"; continue; }
    printf '%s' "$j" >"$nf"; chmod 600 "$nf"
    conf_write '.nodes = ((.nodes // []) + [$c[0]])' --slurpfile c "$nf" || warn "节点写入失败"
    rm -f "$nf"
    ok "已添加: $(echo "$j" | jq -r '.name') [$(echo "$j" | jq -r '.proto')] $(echo "$j" | jq -r '.address')"
  done
  # 关键步骤显式判断: 原版全部 2>/dev/null, 生成失败时节点看似"已添加"却根本不生效
  xray_gen_config || { err "Xray 配置生成失败"; return 1; }
  apply_node_bridge
  svc_restart xray || err "Xray 重启失败"
  refresh_v2node || warn "V2NODE 集合刷新失败"
}

nodes_switch() {
  nodes_list
  local i; i=$(ask "切换到节点序号(1-based): ")
  [[ ! "$i" =~ ^[0-9]+$ || $i -lt 1 ]] && return
  nodes_switch_idx "$i"
}
# $1 = 1-based 序号; 菜单与 --node-switch 共用, 非交互
nodes_switch_idx() {
  local i="$1" n idx
  conf_init
  n=$(conf_get '.nodes' | jq 'length' 2>/dev/null || echo 0)
  [[ ! "$i" =~ ^[0-9]+$ || $i -lt 1 ]] && { err "节点序号必须为正整数: ${i:-空}"; return 1; }
  [[ $i -gt $n ]] && { err "节点序号不存在(共 $n 个)"; return 1; }
  idx=$((i-1))
  conf_set '.nodeActive' "$idx"
  apply_node_bridge
  refresh_v2node
  xray_gen_config || { err "Xray 配置生成失败"; return 1; }
  svc_restart xray && ok "已切换到节点 $i ($(conf_get ".nodes[$idx].name"))"
}
nodes_ping() {
  nodes_list
  local i; i=$(ask "测延迟节点序号(1-based): ")
  [[ ! "$i" =~ ^[0-9]+$ || $i -lt 1 ]] && return
  local idx=$((i-1))
  local addr host proto
  addr=$(conf_get ".nodes[$idx].address"); split_hostport "$addr"; host=$SP_HOST
  local port; port=$SP_PORT
  proto=$(conf_get ".nodes[$idx].proto")
  if [[ $proto == "hy2" || $proto == "tuic" ]]; then
    warn "$proto 为纯 UDP 协议, TCP 握手测试仅供参考"
  fi
  local ms rc
  ms=$(curl -o /dev/null -m 5 -kIs -w '%{time_connect}' "https://$host:$port" 2>/dev/null); rc=$?
  ms=$(printf '%s' "$ms" | awk '{printf "%.0f", $1*1000}')
  # 原版不判返回码: curl 失败时 time_connect 输出 0, 会谎报 0ms
  if [[ $rc -ne 0 || -z $ms ]]; then
    warn "测不通 (curl 返回码 $rc)"
  else
    echo "  TCP 握手延迟: ${ms}ms"
  fi
}
nodes_speed() {
  nodes_list
  local i; i=$(ask "测速节点序号(1-based, 需服务端有 /spt): ")
  [[ ! "$i" =~ ^[0-9]+$ || $i -lt 1 ]] && return
  local idx=$((i-1))
  local addr host port spd rc
  addr=$(conf_get ".nodes[$idx].address"); split_hostport "$addr"; host=$SP_HOST; port=$SP_PORT
  local url="https://$host:$port/spt"; [[ $port == "443" ]] && url="https://$host/spt"
  echo "  下载测速中(限时 20s)..."
  # 原版用 wget + tail -n2 解析, 无超时且输出格式随版本变化
  spd=$(curl -o /dev/null -k -s --max-time 20 -w '%{speed_download}' "$url" 2>/dev/null); rc=$?
  if [[ $rc -ne 0 || -z $spd ]]; then
    warn "测不通或超时 (curl 返回码 $rc)"
  else
    echo "  下载速度: $(printf '%s' "$spd" | awk '{printf "%.2f", $1*8/1000000}') Mbps"
  fi
}
nodes_del() {
  nodes_list
  local i; i=$(ask "删除节点序号(1-based): ")
  [[ ! "$i" =~ ^[0-9]+$ || $i -lt 1 ]] && return
  local idx=$((i-1))
  local n; n=$(conf_get '.nodes' | jq 'length')
  [[ $idx -ge $n ]] && die "序号不存在"
  local dname; dname=$(conf_get ".nodes[$idx].name")
  local yn; yn=$(ask "确认删除节点 [$((idx+1))] $dname ? [y/N]: ")
  [[ $yn != "y" && $yn != "Y" ]] && { warn "已取消"; return; }
  local act; act=$(conf_get '.nodeActive'); [[ -z $act || $act == "null" ]] && act=0
  conf_raw '.nodes' "$(conf_get '.nodes' | jq "del(.[$idx])")"
  # 原版删任意节点都重置为 0: 删除活动节点应回落到 0, 删除其前面的节点则索引前移
  if [[ $idx -eq $act ]]; then
    conf_set '.nodeActive' "0"
  elif [[ $idx -lt $act ]]; then
    conf_set '.nodeActive' "$((act-1))"
  fi
  apply_node_bridge
  xray_gen_config || { err "配置生成失败"; return 1; }
  svc_restart xray || err "Xray 重启失败"
  refresh_v2node
  ok "已删除节点 [$((idx+1))] $dname"
}
nodes_menu() {
  conf_init
  while :; do
    echo
    echo "--- 节点管理 ---"
    nodes_list
    echo "  [a] 添加(粘贴分享链接)  [s] 切换  [p] 测延迟  [d] 测速  [x] 删除  [q] 返回"
    read -rsp "选择: " -n1 c; echo
    case $c in
      a) nodes_add ;;
      s) nodes_switch ;;
      p) nodes_ping ;;
      d) nodes_speed ;;
      x) nodes_del ;;
      q) return ;;
    esac
  done
}

# ================================================================ 分流规则 ====
split_sm() {
  echo
  echo "流媒体/服务 分流 (0=直连, N=节点列表第N项, x=清除, 回车=不变):"
  nodes_list
  local cats="youtube netflix hbo tvb bahamut openai apple steam" cat cur ni
  for cat in $cats; do
    cur=$(conf_get ".split.sm.$cat // empty")
    ni=$(ask "  $cat (当前=${cur:-未设置}): ")
    [[ -z $ni ]] && continue
    if [[ "$ni" == "x" ]]; then
      # 用 --arg 传键名, 不再用 shell 插值拼 jq 过滤器
      # (原 '. + {'"$cat"':$v}' 在键名含特殊字符时会拼出非法过滤器)
      conf_raw ".split.sm" "$(conf_get '.split.sm' | jq --arg c "$cat" 'del(.[$c])')"
    elif [[ "$ni" =~ ^[0-9]+$ ]]; then
      conf_raw ".split.sm" "$(conf_get '.split.sm' | jq --arg c "$cat" --argjson v "$ni" '. + {($c): $v}')"
    else
      warn "  $cat: 请输入 0(直连) / 节点序号 / x(清除) / 回车(不变), 已跳过"
    fi
  done
  xray_gen_config && svc_restart xray && ok "分流规则已生效"
}
split_domains() {
  echo "自定义域名分流(每行一个, 支持后缀匹配如 google.com):"
  echo "输入以 empty 结束. 以 ! 开头 = 强制直连, 否则强制代理"
  local curB curW
  curB=$(conf_get '.split.listB'); curW=$(conf_get '.split.listW')
  [[ -z $curB || $curB == "null" ]] && curB="[]"
  [[ -z $curW || $curW == "null" ]] && curW="[]"
  echo "  当前: 代理 $(echo "$curB" | jq -c .)  直连 $(echo "$curW" | jq -c .)"
  # 原版直接以空数组起步: 只想追加一条也会把既有规则全部清掉
  local mode; mode=$(ask "追加到现有规则 [a] 还是覆盖 [o]? (回车=a): ")
  [[ $mode == "o" || $mode == "O" ]] && { curB="[]"; curW="[]"; }
  local arrB="$curB" arrW="$curW" line
  while :; do
    line=$(ask "  域名: ")
    [[ "$line" == "empty" || -z $line ]] && break
    if [[ "$line" == !* ]]; then
      arrW=$(echo "$arrW" | jq --arg d "${line#!}" '. + [$d]')
    else
      arrB=$(echo "$arrB" | jq --arg d "$line" '. + [$d]')
    fi
  done
  conf_raw '.split.listB' "$arrB"; conf_raw '.split.listW' "$arrW"
  xray_gen_config && svc_restart xray && ok "域名分流已生效"
}
# IPv4 或 CIDR 合法性校验(非法值写进 nft 集合会导致整表加载失败)
ip_cidr_ok() {
  local v="$1" pfx o bad=0
  [[ "$v" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$ ]] || return 1
  if [[ "$v" == */* ]]; then
    pfx=${v#*/}; (( pfx >= 0 && pfx <= 32 )) || return 1
  fi
  for o in $(printf '%s' "${v%%/*}" | tr '.' ' '); do (( o <= 255 )) || bad=1; done
  [[ $bad -eq 0 ]]
}
split_ips() {
  echo "源 IP 分流(本局域网设备):"
  echo "  代理 IP 列表(强制走代理, 空行结束; 支持 1.2.3.4 或 1.2.3.0/24):"
  local arr="[]" line
  while :; do
    line=$(ask "  IP: "); [[ -z $line ]] && break
    ip_cidr_ok "$line" || { warn "非法 IP/CIDR: $line (已跳过)"; continue; }
    arr=$(echo "$arr" | jq --arg d "$line" '. + [$d]')
  done
  conf_raw '.split.proxyIPs' "$arr"
  echo "  直连 IP 列表(强制直连, 空行结束; 支持 1.2.3.4 或 1.2.3.0/24):"
  arr="[]"
  while :; do
    line=$(ask "  IP: "); [[ -z $line ]] && break
    ip_cidr_ok "$line" || { warn "非法 IP/CIDR: $line (已跳过)"; continue; }
    arr=$(echo "$arr" | jq --arg d "$line" '. + [$d]')
  done
  conf_raw '.split.directIPs' "$arr"
  refresh_nft_sets
  xray_gen_config && svc_restart xray && ok "源 IP 分流已生效"
}
split_clear() {
  conf_raw '.split' '{"sm":{},"listB":[],"listW":[],"proxyIPs":[],"directIPs":[]}'
  xray_gen_config && svc_restart xray && refresh_nft_sets
  ok "所有分流已清空"
}
split_menu() {
  conf_init
  read -rsp "[1] 流媒体预设  [2] 自定义域名  [3] 源IP分流  [4] 清空全部分流: " -n1 c; echo
  case $c in
    1) split_sm ;;
    2) split_domains ;;
    3) split_ips ;;
    4) split_clear ;;
  esac
}

# ================================================================ DNS 设置 ====
dns_menu() {
  conf_init
  echo "当前 DoH: $(conf_get '.dns.doh')"
  echo "当前国内DNS: $(conf_get '.dns.china' | jq -r 'join(" ")')"
  read -rsp "[1] 改 DoH  [2] 改国内DNS  [3] 自定义hosts: " -n1 c; echo
  case $c in
    1)
      local d; d=$(ask "DoH URL: ")
      conf_set '.dns.doh' "$d"; smartdns_conf; refresh_globaldns; svc_restart smartdns && ok "DoH 已更新"
      ;;
    2)
      local s; s=$(ask "国内 DNS (空格分隔多个, 回车=默认): ")
      [[ -z $s ]] && s="$DNS_ALI $DNS_TENCENT"
      conf_raw '.dns.china' "$(echo $s | tr ' ' '\n' | jq -R . | jq -s .)"
      # 原版重写整个 default.nft 并重启 nftables: 只需同步 RESERVED_IP 里的国内 DNS
      nft_reserved_only
      smartdns_conf; svc_restart smartdns && ok "国内 DNS 已更新"
      ;;
    3)
      echo "输入 hosts (域名=IP, 空行结束; 输入 clear 清空全部):"
      local h line k v; h=$(conf_get '.dns.hosts'); [[ -z $h || $h == "null" ]] && h='{}'
      local cur; cur=$(echo "$h" | jq -r 'to_entries|map("\(.key)=\(.value)")|join(" ")')
      [[ -n $cur ]] && echo "  当前: $cur"
      while :; do
        line=$(ask "  ")
        [[ -z $line ]] && break
        if [[ $line == "clear" ]]; then h='{}'; continue; fi
        k=${line%%=*}; v=${line##*=}
        [[ -z $k || -z $v || $k == "$line" ]] && { warn "格式应为 域名=IP"; continue; }
        h=$(echo "$h" | jq --arg k "$k" --arg v "$v" '. + {($k):$v}')
      done
      conf_raw '.dns.hosts' "$h"
      smartdns_conf; svc_restart smartdns && ok "hosts 已更新(已保留原有条目)"
      ;;
  esac
}

# ================================================================ block53 =====
block53_toggle() {
  conf_init
  if [[ $(conf_get '.block53') == "true" ]]; then
    conf_set '.block53' "false"
  else
    conf_set '.block53' "true"
  fi
  nftables_apply && ok "DNS 劫持(block53): $(conf_get '.block53')"
}

# ================================================================ 代理开关 =====
proxy_toggle() {
  conf_init
  local on; on=$(conf_get '.proxyOn'); [[ -z $on || $on == "null" ]] && on="true"
  # 原版用"服务是否在跑"判断方向: 服务崩溃时按"开启"处理, 状态机错乱
  if [[ $on == "true" ]]; then
    systemctl stop xray 2>/dev/null
    systemctl stop degwd-nftables 2>/dev/null
    nft delete table ip de_GWD 2>/dev/null
    nft delete table inet degwd_filter 2>/dev/null
    nft delete table inet degwd_router 2>/dev/null
    nft delete table inet degwd_offload 2>/dev/null
    ip rule del fwmark 0x9 table 220 2>/dev/null
    ip route del local default dev lo table 220 2>/dev/null
    conf_set '.proxyOn' "false"
    ok "代理已关闭(全机直连, 下次开机仍保持关闭)"
  else
    nftables_apply
    svc_restart xray
    svc_restart smartdns
    conf_set '.proxyOn' "true"
    ok "代理已恢复"
  fi
}

# ================================================================ WireGuard ====
wg_menu() {
  conf_init
  local wgport spub spri
  read -rsp "[1] 启用 WG 服务端  [2] 添加客户端  [3] 客户端配置/二维码  [4] 关闭: " -n1 c; echo
  case $c in
    1)
      wgport=$(conf_get '.wg.port'); [[ -z $wgport ]] && wgport=51820
      if [[ -z $(conf_get '.wg.serverPriv') ]]; then
        spri=$(wg genkey); spub=$(echo "$spri" | wg pubkey)
        conf_set '.wg.serverPriv' "$spri"; conf_set '.wg.serverPub' "$spub"
      fi
      spri=$(conf_get '.wg.serverPriv')
      {
        echo "[Interface]"
        echo "PrivateKey = $spri"
        echo "Address = $WG_PREFIX.1/24"
        echo "ListenPort = $wgport"
        echo "MTU = 1420"
        local peers i=0 wan
        peers=$(conf_get '.wg.peers'); wan=$(wan_ip)
        local npcnt; npcnt=$(echo "$peers" | jq 'length' 2>/dev/null || echo 0)
        while [[ $i -lt $npcnt ]]; do
          echo ""
          echo "[Peer]"
          echo "PublicKey = $(echo "$peers" | jq -r ".[$i].pub")"
          echo "AllowedIPs = $WG_PREFIX.$((i+11))/32"
          i=$((i+1))
        done
      } > /etc/wireguard/wg0.conf
      chmod 600 /etc/wireguard/wg0.conf
      systemctl enable wg-quick@wg0 >/dev/null 2>&1
      systemctl restart wg-quick@wg0 >/dev/null 2>&1
      /etc/rc_online.local 2>/dev/null
      conf_set '.wg.enabled' "true"
      ok "WG 服务端已启用 (端口 $wgport)"
      ;;
    2)
      [[ ! -f /etc/wireguard/wg0.conf ]] && die "请先启用 WG 服务端"
      local cpri cpub cname
      cpri=$(wg genkey); cpub=$(echo "$cpri" | wg pubkey)
      cname=$(ask "客户端名: ")
      conf_raw '.wg.peers' "$(conf_get '.wg.peers' | jq --arg p "$cpub" --arg n "$cname" '. + [{pub:$p, name:$n}]')"
      local i cnt wan laddr
      cnt=$(conf_get '.wg.peers' | jq 'length'); i=$((cnt-1))
      wan=$(wan_ip); laddr=$(conf_get '.net.localCIDR' | cut -d/ -f1)
      local wgport; wgport=$(conf_get '.wg.port')
      cat <<EOF >/etc/wireguard/client$i.conf
[Interface]
PrivateKey = $cpri
Address = $WG_PREFIX.$((i+11))/32
DNS = $laddr
MTU = 1400

[Peer]
PublicKey = $(conf_get '.wg.serverPub')
EndPoint = $wan:$wgport
# 网关是 IPv4-only(sysctl 里 disable_ipv6=1), 写 ::/0 会让 wg-quick 尝试加
# IPv6 路由并在部分内核上直接报错, 故只保留 IPv4 全路由
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 15
EOF
      chmod 600 "/etc/wireguard/client$i.conf"
      systemctl restart wg-quick@wg0 >/dev/null 2>&1
      ok "客户端 $cname 已添加: 配置文件 /etc/wireguard/client$i.conf"
      ;;
    3)
      local i; i=$(ask "客户端序号(从0): ")
      [[ "$i" =~ ^[0-9]+$ ]] || die "序号错误"
      [[ ! -f /etc/wireguard/client$i.conf ]] && die "配置不存在"
      qrencode -t UTF8 -s 1 -m 2 < "/etc/wireguard/client$i.conf"
      ;;
    4)
      systemctl disable wg-quick@wg0 >/dev/null 2>&1
      systemctl stop wg-quick@wg0 >/dev/null 2>&1
      conf_set '.wg.enabled' "false"
      ok "WG 已关闭"
      ;;
  esac
}

wan_ip() {
  # IP 回显域名已在 output/prerouting 链豁免直连, 否则此处返回的是 VPS 出口 IP
  local ip
  for h in $IP_ECHO_HOSTS; do
    ip=$(curl -4fsS --max-time 8 "$h" 2>/dev/null | tr -d '[:space:]')
    [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && { echo "$ip"; return 0; }
  done
  return 1
}

# ================================================================ DDNS =========
ddns_menu() {
  conf_init
  read -rsp "[1] 设置 Cloudflare DDNS  [2] 关闭: " -n1 c; echo
  case $c in
    1)
      local token dom
      token=$(ask_secret "CF API Token (Zone.DNS Edit): ")
      dom=$(ask "DDNS 域名 (如 home.example.com): ")
      conf_set '.ddns.cfToken' "$token"; conf_set '.ddns.cfDomain' "$dom"
      ddns_update_cf && {
        # 先写脚本再写 cron(原顺序相反, cron 首次触发时脚本尚不存在)
        write_atomic "$BASE/ddns" 755 <<EOF
#!/bin/bash
bash $(readlink -f "$0" 2>/dev/null || echo "$0") --ddns
EOF
        if command -v crontab >/dev/null 2>&1; then
          (crontab -l 2>/dev/null | grep -F -v -- "$BASE/ddns"; echo "*/5 * * * * $BASE/ddns") | crontab -
        else
          warn "crontab 不可用, 跳过 DDNS 定时任务"
        fi
      }
      ;;
    2)
      command -v crontab >/dev/null 2>&1 && \
        (crontab -l 2>/dev/null | grep -F -v -- "$BASE/ddns") | crontab -
      rm -f "$BASE/ddns"
      ok "DDNS 已关闭"
      ;;
  esac
}
ddns_update_cf() {
  local token dom wan zone rec id cfg rc
  token=$(conf_get '.ddns.cfToken'); dom=$(conf_get '.ddns.cfDomain')
  [[ -z $token || -z $dom ]] && return 1
  wan=$(wan_ip); [[ -z $wan ]] && { warn "DDNS: 无法获取公网 IP"; return 1; }
  # 当前解析相同则跳过
  [[ $(dig +short +time=5 +tries=1 @"$DNS_ALI" "$dom" A 2>/dev/null | head -n1) == "$wan" ]] && return 0
  # Token 走 --config 文件, 避免出现在 argv(ps aux 可见)
  cfg=$(mktemp "$BASE/.cf.XXXXXX"); chmod 600 "$cfg"
  printf 'header = "Authorization: Bearer %s"\n' "$token" > "$cfg"
  # 原版只取后两段: home.example.co.uk 会被截成 co.uk, zone 查不到
  # 用 CF 的 zones?name= 后缀匹配, 从最长后缀开始试
  local try parts n i
  parts=$(echo "$dom" | tr '.' ' '); n=$(echo $parts | wc -w)
  zone=""
  for ((i=2; i<=n; i++)); do
    try=$(echo "$parts" | cut -d' ' -f$((n-i+1))- | tr ' ' '.')
    zone=$(curl -fsS --max-time 10 --config "$cfg" \
             "https://api.cloudflare.com/client/v4/zones?name=$try" 2>/dev/null \
           | jq -r 'if .success then (.result[0].id // empty) else empty end')
    [[ -n $zone ]] && break
  done
  [[ -z $zone ]] && { rm -f "$cfg"; warn "DDNS: zone 未找到"; return 1; }
  rec=$(curl -fsS --max-time 10 --config "$cfg" \
          "https://api.cloudflare.com/client/v4/zones/$zone/dns_records?name=$dom&type=A" 2>/dev/null \
        | jq -r '.result[0].id // empty')
  local resp
  if [[ -n $rec ]]; then
    resp=$(curl -fsS --max-time 10 -X PUT --config "$cfg" -H "Content-Type: application/json" \
      -d "{\"type\":\"A\",\"name\":\"$dom\",\"content\":\"$wan\",\"ttl\":300,\"proxied\":false}" \
      "https://api.cloudflare.com/client/v4/zones/$zone/dns_records/$rec" 2>/dev/null); rc=$?
  else
    resp=$(curl -fsS --max-time 10 -X POST --config "$cfg" -H "Content-Type: application/json" \
      -d "{\"type\":\"A\",\"name\":\"$dom\",\"content\":\"$wan\",\"ttl\":300,\"proxied\":false}" \
      "https://api.cloudflare.com/client/v4/zones/$zone/dns_records" 2>/dev/null); rc=$?
  fi
  rm -f "$cfg"
  [[ $rc -ne 0 ]] && { warn "DDNS: curl 失败(返回码 $rc)"; return 1; }
  # 原版只看 curl 退出码, CF 返回 {"success":false} 时仍报"已更新"
  if [[ $(printf '%s' "$resp" | jq -r '.success // false' 2>/dev/null) != "true" ]]; then
    warn "DDNS 更新被拒绝: $(printf '%s' "$resp" | jq -c '.errors // []' 2>/dev/null)"
    return 1
  fi
  ok "DDNS 已更新: $dom -> $wan"
}

# ================================================================ 中转线 =======
relay_menu() {
  conf_init
  nodes_list
  read -rsp "[1] 添加中转线  [2] 删除全部: " -n1 c; echo
  case $c in
    1)
      local port uuid ni
      port=$(ask "对外端口: ")
      [[ "$port" =~ ^[0-9]+$ ]] || die "端口错误"
      (( port >= 1 && port <= 65535 )) || die "端口越界(1-65535)"
      local p
      for p in $ENTRY_PORTS 53 853 3000; do
        [[ $port == "$p" ]] && die "端口 $port 为保留端口, 不可用于中转线"
      done
      uuid=$(cat /proc/sys/kernel/random/uuid)
      ni=$(ask "上游节点序号(-1=不套上游,直接vmess入口): ")
      [[ "$ni" =~ ^-?[0-9]+$ ]] || die "序号错误"
      conf_raw '.relay' "$(conf_get '.relay' | jq --arg p "$port" --arg u "$uuid" --argjson n "$ni" '. + [{port:($p|number), uuid:$u, node:$n}]')"
      xray_gen_config && svc_restart xray && printRelay
      ;;
    2)
      conf_raw '.relay' '[]'
      xray_gen_config && svc_restart xray && ok "中转线已清空"
      ;;
  esac
}
printRelay() {
  local relays r=0 wan laddr nrelay
  relays=$(conf_get '.relay'); wan=$(wan_ip); laddr=$(conf_get '.net.localCIDR' | cut -d/ -f1)
  nrelay=$(echo "$relays" | jq 'length' 2>/dev/null || echo 0)   # 循环内每轮 fork jq 取 length 太贵
  while [[ $r -lt $nrelay ]]; do
    local port uuid
    port=$(echo "$relays" | jq -r ".[$r].port"); uuid=$(echo "$relays" | jq -r ".[$r].uuid")
    local vmj b64
    # ps 也用 --arg 传入: 原写法 ps:"relay'"$port"'" 是把 shell 值拼进 jq 过滤器
    vmj=$(jq -cn --arg add "$wan" --arg port "$port" --arg id "$uuid" --arg ps "relay$port" \
      '{v:"2",ps:$ps,add:$add,port:$port,id:$id,aid:"0",scy:"auto",net:"tcp",type:"none",tls:""}')
    b64=$(echo -n "$vmj" | base64 -w0)
    echo -e "${WHITE}中转线 $port : vmess://$b64${cRES}"
    r=$((r+1))
  done
}


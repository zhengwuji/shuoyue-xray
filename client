#!/bin/bash
# =============================================================================
#  朔月 Shuoyue — Debian 旁路网关 & DNS (Client)
#  原 de_GWD 重制版: nftables TPROXY 透明代理 + Xray(vmess/vless/trojan/ss)
#                + sing-box 桥接(hy2/tuic/anytls) + smartdns DNS 分流
#                + BBR/CAKE 流量整形 + WireGuard + DDNS + 可选 AdGuard Home
#  节点支持直接导入 v2rayN 7.25.4 分享链接。
#  基于原版 jacyl4/de_GWD (EPL-2.0) 的功能规格重写,全部组件改用官方上游。
#  LAN 设备将网关与 DNS 指向本机即可生效。仅供学习与研究。
# =============================================================================
VERSION="v1.2.0"
REMOTE_BASE="https://raw.githubusercontent.com/zhengwuji/shuoyue-xray/main"

export DEBIAN_FRONTEND=noninteractive
RED='\E[1;31m'; GREEN='\E[1;32m'; YELLOW='\E[1;33m'; BLUE='\E[1;34m'
PURPLE='\E[1;35m'; CYAN='\E[1;36m'; WHITE='\E[1;37m'; GREY='\E[1;30m'; cRES='\E[0m'

BASE=/opt/de_GWD
CONF=$BASE/conf.json
XRAYDIR=$BASE/xray
SDNSDIR=$BASE/smartdns
ARCH=$(dpkg --print-architecture 2>/dev/null || uname -m)
[[ "$ARCH" == "x86_64" ]] && ARCH=amd64
[[ "$ARCH" == "aarch64" ]] && ARCH=arm64

[[ $(id -u) -ne 0 ]] && echo -e "${RED}请以 root 运行${cRES}" && exit 1

# ---------------------------------------------------------------- helpers ---
ok()   { echo -e "${WHITE}[ ${GREEN}✓${WHITE} ]${cRES} $*"; }
warn() { echo -e "${WHITE}[ ${YELLOW}!${WHITE} ]${cRES} $*"; }
err()  { echo -e "${WHITE}[ ${RED}✕${WHITE} ]${cRES} $*"; }
die()  { err "$*"; exit 1; }
ask()  { local v; read -rp "$1" v; echo "$v"; }
ask_secret() { local v; read -rsp "$1" v; echo; echo "$v"; }

detect_nic() {
  find /sys/class/net ! -type d 2>/dev/null | xargs --max-args=1 realpath 2>/dev/null \
    | grep 'device' | grep -v 'virtual' | grep -v 'ifb' | awk -F'/' '{print$NF}' | head -n1
}
svc_ok() { systemctl is-active "$1" >/dev/null 2>&1; }
svc_restart() {
  local s="$1"
  systemctl daemon-reload >/dev/null 2>&1
  systemctl restart "$s" >/dev/null 2>&1
  if ! svc_ok "$s"; then
    local u="/etc/systemd/system/$s.service"
    [[ -f $u && $(grep -c '^Nice=' "$u" 2>/dev/null || echo 0) -gt 0 ]] || return 1
    sed -i '/^Nice=/d' "$u"; systemctl daemon-reload
    systemctl restart "$s" >/dev/null 2>&1
  fi
  svc_ok "$s"
}

conf_init() {
  mkdir -p "$BASE" "$BASE/.repo" "$XRAYDIR" "$SDNSDIR" "$BASE/nftables"
  [[ -f $CONF ]] && return
  echo '{
    "net": {"localCIDR":"","gateway":"","nic":""},
    "dns": {"doh":"https://1.1.1.1/dns-query","china":["223.5.5.5","119.29.29.29"],"hosts":{}},
    "nodes": [], "nodeActive": 0,
    "split": {"sm":{},"listB":[],"listW":[],"proxyIPs":[],"directIPs":[]},
    "adblock": false, "block53": false, "dnsPort": 53,
    "wg": {"enabled":false,"port":51820,"serverPriv":"","serverPub":"","peers":[]},
    "ddns": {"cfToken":"","cfDomain":""},
    "relay": []
  }' > "$CONF"; chmod 600 "$CONF"
}
conf_get() { [[ -f $CONF ]] && jq -r "$1 // empty" "$CONF" 2>/dev/null; }
conf_set() {
  # 值先经 jq -Rs 压成单行 JSON 字符串, 规避多行 argv 在部分平台的问题
  jq --argjson v "$(printf '%s' "$2" | jq -Rs .)" "$1 = \$v" "$CONF" > "${CONF}.tmp" \
    && mv -f "${CONF}.tmp" "$CONF" && chmod 600 "$CONF"
}
conf_raw() {
  # 值先压缩校验为单行 JSON
  local compact; compact=$(printf '%s' "$2" | jq -c . 2>/dev/null) || return 1
  jq "$1 = $compact" "$CONF" > "${CONF}.tmp" \
    && mv -f "${CONF}.tmp" "$CONF" && chmod 600 "$CONF"
}

fetch_release() {
  local repo="$1" pattern="$2" dest="$3"
  local api json url name
  api="https://api.github.com/repos/$repo/releases/latest"
  json=$(curl -fsSL --max-time 30 "$api" 2>/dev/null) || return 1
  url=$(echo "$json" | jq -r --arg re "$pattern" \
        '[.assets[] | select(.name | test($re))][0].browser_download_url // empty')
  [[ -z $url ]] && return 1
  name="${url##*/}"
  curl -fsSL --max-time 600 -o "/tmp/$name" "$url" || return 1
  local sums sumurl
  sumurl=$(echo "$json" | jq -r '.assets[] | select(.name=="checksums.txt" or .name=="sha256sums.txt") | .browser_download_url' | head -n1)
  if [[ -n $sumurl ]]; then
    sums=$(curl -fsSL --max-time 30 "$sumurl" 2>/dev/null)
    local want; want=$(echo "$sums" | awk -v n="$name" '$2==n || index($0,n){print$1}' | head -n1)
    if [[ -n $want ]]; then
      local got; got=$(sha256sum "/tmp/$name" | awk '{print$1}')
      [[ "$got" != "$want" ]] && { rm -f "/tmp/$name"; return 1; }
    fi
  fi
  mv -f "/tmp/$name" "$dest"; return 0
}

# ============================================================ 系统基线 =========
apt_baseline() {
  cat <<'EOF' >/etc/apt/apt.conf.d/01deGWD
APT::Get::Assume-Yes "true";
APT::Install-Recommends "false";
APT::Install-Suggests "false";
EOF
  echo "debconf debconf/frontend select Noninteractive" | debconf-set-selections
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get -y -qq full-upgrade || warn "系统升级未完全成功(继续安装)"
  DEBIAN_FRONTEND=noninteractive apt-get -y -qq autoremove --purge >/dev/null 2>&1 || true
}

pkg_dep() {
  local need="" p
  for p in jq qrencode curl wget dnsutils nftables chrony ethtool screen bc \
           ca-certificates gnupg unzip wireguard-tools socat resolvconf; do
    dpkg -s "$p" >/dev/null 2>&1 || need="$need $p"
  done
  dpkg -s smartdns >/dev/null 2>&1 || need="$need smartdns"
  if [[ -n $need ]]; then
    apt-get update -qq
    if ! apt-get install -y -qq $need; then
      # 旧发行版可能缺个别包(如 smartdns): 逐个尝试, 缺的跳过不中断
      local failed="" p2
      warn "批量安装失败, 逐个尝试(旧系统可能缺少个别包)..."
      for p2 in $need; do
        apt-get install -y -qq "$p2" >/dev/null 2>&1 || failed="$failed $p2"
      done
      [[ -n $failed ]] && warn "以下包不可用已跳过:${failed}"
    fi
  fi
  command -v smartdns >/dev/null || die "smartdns 不可用(该发行版未收录)。请先手动安装 smartdns(参考 README 支持矩阵), 或改用 Debian 12+/Ubuntu 22.04+"
}


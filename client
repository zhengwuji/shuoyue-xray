# ---------------------------------------------------------------- helpers ---
log()  { printf '%s [%s] %s\n' "$(date '+%F %T')" "${1:-INFO}" "${*:2}" >>"$LOG_FILE" 2>/dev/null || true; }
ok()   { echo -e "${WHITE}[ ${GREEN}✓${WHITE} ]${cRES} $*"; log OK "$*"; }
warn() { echo -e "${WHITE}[ ${YELLOW}!${WHITE} ]${cRES} $*"; log WARN "$*"; }
err()  { echo -e "${WHITE}[ ${RED}✕${WHITE} ]${cRES} $*"; log ERROR "$*"; }
die()  { err "$*"; exit 1; }
# -r: UUID/口令/路径中的反斜杠必须原样保留
ask()  { local v; read -r -p "$1" v; echo "$v"; }

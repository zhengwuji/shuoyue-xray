[Install]
WantedBy=multi-user.target
EOF
  chmod 600 "$BASE/agh/AdGuardHome.yaml"
  conf_set '.adblock' "true"
  conf_set '.dnsPort' "5330"
  # 端口决策已移入 smartdns_conf 生成器(不再事后 sed 改写)
  smartdns_conf
  systemctl daemon-reload
  systemctl enable adguardhome >/dev/null 2>&1
  systemctl restart adguardhome >/dev/null 2>&1
  svc_restart smartdns
  xray_gen_config || err "Xray 配置生成失败"

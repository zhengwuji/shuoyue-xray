}

pkg_dep() {
  local need="" p
  # 只装真正用到的包。已删除(全文无调用, 计数为 1 即只出现在本列表):
  #   socat/screen/bc/unzip/gnupg/wget —— 无任何调用
  #   resolvconf —— 会接管 /etc/resolv.conf, 与 resolv_setup() 手写的内容冲突
  # 保留: util-linux(flock), wireguard-tools(wg/wg-quick), dnsutils(dig),
  #       gnupg(installkernel 校验 Zabbly key 指纹), ca-certificates(HTTPS 信任链)
  for p in jq qrencode curl dnsutils nftables chrony ethtool \
           ca-certificates gnupg wireguard-tools util-linux; do
    dpkg -s "$p" >/dev/null 2>&1 || need="$need $p"
  done
  dpkg -s smartdns >/dev/null 2>&1 || need="$need smartdns"
  if [[ -n $need ]]; then
    apt-get update -qq
    if ! apt-get install -y -qq $need; then
      # 旧发行版可能缺个别包(如 smartdns): 逐个尝试, 缺的跳过不中断
      local failed="" p2
      warn "批量安装失败, 逐个尝试(旧系统可能缺少个别包)..."
      for p2 in $need; do
        apt-get install -y -qq "$p2" >/dev/null 2>&1 || failed="$failed $p2"
      done
      [[ -n $failed ]] && warn "以下包不可用已跳过:${failed}"
    fi
  fi
  command -v smartdns >/dev/null || die "smartdns 不可用(该发行版未收录)。请先手动安装 smartdns(参考 README 支持矩阵), 或改用 Debian 12+/Ubuntu 22.04+"
}


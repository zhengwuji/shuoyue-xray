  else
    listen_addr="127.0.0.1:3000"
  fi
  write_atomic "$BASE/agh/AdGuardHome.yaml" 600 <<EOF
http:
  address: $listen_addr
dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
